<Window x:Class="PosElectro.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:PosElectro.Desktop.Views"
        xmlns:vm="clr-namespace:PosElectro.Desktop.ViewModels"
        xmlns:services="clr-namespace:PosElectro.Desktop.Services"
        mc:Ignorable="d"
        Title="Line kassa" 
        Icon="Assets/app_logo.png"
        Height="750" Width="1200" MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        InputLanguageManager.InputLanguage="en-US"
        InputLanguageManager.RestoreInputLanguage="True"
        Activated="Window_Activated"
        PreviewTextInput="Window_PreviewTextInput"
        PreviewKeyDown="Window_PreviewKeyDown">

<Window.Resources>
        <!-- Yuqori paneldagi bo'lim tugmasi (faol bo'lim Tag=True bilan belgilanadi) -->
        <Style x:Key="NavTab" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Sozlamalar tugmasi -->
        <Style x:Key="GearButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sozlamalar menyusi qatori -->
        <Style x:Key="MenuRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MenuRowDanger" TargetType="Button" BasedOn="{StaticResource MenuRowButton}">
            <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
            <Setter Property="Background" Value="{DynamicResource BadSoft}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="NavIc" TargetType="Path">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Yuqori Menyu Paneli -->
            <RowDefinition Height="56"/>
            <!-- Asosiy Ish Maydoni (Yagona Sahifa) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- YUQORI NAVIGATSIYA PANELI (maket: TopBar). Qayta qurilgan: yorug' tema shu panel ichida. -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,0">
            <Border.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/SmartControls.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Border.Resources>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logotip: Line kassa belgisi (yozuvsiz) -->
                <Image Grid.Column="0" Source="Assets/app_logo.png" Width="34" Height="34" VerticalAlignment="Center" Margin="0,0,24,0"
                       RenderOptions.BitmapScalingMode="HighQuality" ToolTip="Line kassa"/>

                <!-- Bo'limlar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource NavTab}" Command="{Binding NavigateCashierCommand}" Tag="{Binding IsCashierSelected}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                <Path Style="{StaticResource NavIc}" Data="M7 21a1 1 0 1 0 2 0a1 1 0 1 0-2 0 M18 21a1 1 0 1 0 2 0a1 1 0 1 0-2 0 M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
                            </Viewbox>
                            <TextBlock Text="Kassa" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavTab}" Command="{Binding NavigateInventoryCommand}" Tag="{Binding IsInventorySelected}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                <Path Style="{StaticResource NavIc}" Data="M21 8L12 3L3 8v8l9 5l9-5z M3 8l9 5l9-5 M12 13v8"/>
                            </Viewbox>
                            <TextBlock Text="Ombor" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavTab}" Command="{Binding NavigateDebtsCommand}" Tag="{Binding IsDebtsSelected}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                <Path Style="{StaticResource NavIc}" Data="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M5 7a4 4 0 1 0 8 0a4 4 0 1 0-8 0 M22 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75"/>
                            </Viewbox>
                            <TextBlock Text="Qarzlar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavTab}" Command="{Binding NavigateReportsCommand}" Tag="{Binding IsReportsSelected}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                <Path Style="{StaticResource NavIc}" Data="M3 3v18h18 M7 15l4-4l3 3l5-6"/>
                            </Viewbox>
                            <TextBlock Text="Hisobotlar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavTab}" Command="{Binding NavigateSyncCommand}" Tag="{Binding IsSyncSelected}"
                            ToolTip="{Binding LiveSyncStatusText}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                <Path Style="{StaticResource NavIc}" Data="M5 12.55a11 11 0 0 1 14 0 M8.5 16.1a6 6 0 0 1 7 0 M2 8.82a15 15 0 0 1 20 0 M12 20h.01"/>
                            </Viewbox>
                            <TextBlock Text="Wi-Fi Sinxron" VerticalAlignment="Center"/>
                            <!-- Ulangan telefonlar soni (faqat ulanish bo'lsa) -->
                            <Border Margin="8,0,0,0" Padding="8,2" CornerRadius="10" VerticalAlignment="Center" Background="{DynamicResource OkSoft}"
                                    Visibility="{Binding IsLiveSyncActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Ok}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LiveClientsCount}" Margin="4,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Ok}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Admin rejimi ochiq belgisi (PIN yoqilgan va qulf ochilgan bo'lsa) -->
                <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                        Command="{Binding LockAdminCommand}" Cursor="Hand" ToolTip="Yashirin ma'lumotlarni qayta yopish"
                        Foreground="{DynamicResource Warn}"
                        Visibility="{Binding ShowUnlockedChip, Source={x:Static services:AdminGate.Current}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="36">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                        <Path Style="{StaticResource NavIc}" Data="M6 11h12a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2z M8 11V7a4 4 0 0 1 7.9-1"/>
                                    </Viewbox>
                                    <TextBlock Text="Admin rejimi ochiq · Qulflash" Foreground="{DynamicResource Warn}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Warn}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- O'ng tomon: soat va sozlamalar menyusi -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ClockText}" FontSize="13" Foreground="{DynamicResource Ink2}" Margin="8,0,16,0" VerticalAlignment="Center"/>
                <Grid VerticalAlignment="Center">
                    <ToggleButton x:Name="SettingsToggle" Style="{StaticResource GearButton}" ToolTip="Sozlamalar" AutomationProperties.Name="Sozlamalar">
                        <Viewbox Width="18" Height="18">
                            <Path Style="{StaticResource NavIc}" Data="M9 12a3 3 0 1 0 6 0a3 3 0 1 0-6 0 M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                        </Viewbox>
                    </ToggleButton>
                    <Popup IsOpen="{Binding IsChecked, ElementName=SettingsToggle, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=SettingsToggle}" Placement="Custom"
                           CustomPopupPlacementCallback="SettingsPopup_Placement" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="312" Margin="24,8,24,40" Padding="6" CornerRadius="12" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.18" Color="#0F1B21"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Ko'rinish: yorug' / qorong'i / Windows bo'yicha. Tanlov bazada saqlanadi. -->
                                <Grid Margin="10,6,6,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                        <Path Style="{StaticResource NavIc}" Stroke="{DynamicResource Ink2}" Data="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="Ko'rinish" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource Ink}"/>
                                </Grid>
                                <Border Margin="6,0,6,6" Padding="3" CornerRadius="10" Background="{DynamicResource Surface2}">
                                    <UniformGrid Rows="1">
                                        <Button Style="{StaticResource SegTab}" Height="34" FontSize="13" Content="Yorug'"
                                                Command="{Binding SetThemeCommand}" CommandParameter="light"
                                                Tag="{Binding ThemeModeSetting, Converter={StaticResource EqualsConverter}, ConverterParameter=light}"/>
                                        <Button Style="{StaticResource SegTab}" Height="34" FontSize="13" Content="Qorong'i"
                                                Command="{Binding SetThemeCommand}" CommandParameter="dark"
                                                Tag="{Binding ThemeModeSetting, Converter={StaticResource EqualsConverter}, ConverterParameter=dark}"/>
                                        <Button Style="{StaticResource SegTab}" Height="34" FontSize="13" Content="Windows"
                                                ToolTip="Windows sozlamasiga qarab o'zi almashadi"
                                                Command="{Binding SetThemeCommand}" CommandParameter="system"
                                                Tag="{Binding ThemeModeSetting, Converter={StaticResource EqualsConverter}, ConverterParameter=system}"/>
                                    </UniformGrid>
                                </Border>
                                <Border Height="1" Margin="6,2,6,6" Background="{DynamicResource LineSoft}"/>
                                <Button Style="{StaticResource MenuRowButton}" Command="{Binding ExportWarehouseCostReportCommand}" Click="SettingsMenuItem_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                            <Path Style="{StaticResource NavIc}" Stroke="{DynamicResource Ink2}" Data="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M3 9h18M3 15h18M9 3v18"/>
                                        </Viewbox>
                                        <TextBlock Grid.Column="1" Text="Ombor hisoboti (Excel)" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource MenuRowButton}" Command="{Binding OpenCardTaxModalCommand}" Click="SettingsMenuItem_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                            <Path Style="{StaticResource NavIc}" Stroke="{DynamicResource Ink2}" Data="M19 5L5 19 M4 6.5a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0-5 0 M15 17.5a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0-5 0"/>
                                        </Viewbox>
                                        <TextBlock Grid.Column="1" Text="Karta solig'i" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CashierVM.CurrentCardTaxRate, StringFormat='{}{0:0.##}%'}" FontSize="13" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center"/>
                                            <Viewbox Width="14" Height="14" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Admin PIN bilan himoyalangan">
                                                <Path Style="{StaticResource NavIc}" Stroke="{DynamicResource Ink3}" Data="M6 11h12a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2z M8 11V7a4 4 0 0 1 8 0v4"/>
                                            </Viewbox>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource MenuRowButton}" Command="{Binding BackupDatabaseCommand}" Click="SettingsMenuItem_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                            <Path Style="{StaticResource NavIc}" Stroke="{DynamicResource Ink2}" Data="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
                                        </Viewbox>
                                        <TextBlock Grid.Column="1" Text="Zaxira nusxa olish" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource MenuRowButton}" Command="{Binding OpenContactModalCommand}" Click="SettingsMenuItem_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                            <Path Style="{StaticResource NavIc}" Stroke="{DynamicResource Ink2}" Data="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/>
                                        </Viewbox>
                                        <TextBlock Grid.Column="1" Text="Yordam va aloqa" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Button>
                                <Border Height="1" Background="{DynamicResource Line}" Margin="4,6"/>
                                <StackPanel Orientation="Horizontal" Margin="10,6,10,2">
                                    <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                        <Path Style="{StaticResource NavIc}" Stroke="{DynamicResource Ink3}" StrokeThickness="2.4" Data="M6 11h12a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2z M8 11V7a4 4 0 0 1 8 0v4"/>
                                    </Viewbox>
                                    <TextBlock Text="ADMIN BO'LIMI · PIN" Foreground="{DynamicResource Ink3}" FontSize="11" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Style="{StaticResource MenuRowButton}" Command="{Binding OpenAdminPinSettingsCommand}" Click="SettingsMenuItem_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                            <Path Style="{StaticResource NavIc}" Stroke="{DynamicResource Ink2}" Data="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z M9 12l2 2 4-4"/>
                                        </Viewbox>
                                        <TextBlock Grid.Column="1" Text="Admin PIN · yashirin ma'lumotlar" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource MenuRowDanger}" Command="{Binding RestoreDatabaseCommand}" Click="SettingsMenuItem_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                            <Path Style="{StaticResource NavIc}" Data="M3 12a9 9 0 1 0 3-6.7L3 8 M3 3v5h5"/>
                                        </Viewbox>
                                        <TextBlock Grid.Column="1" Text="Bazani zaxiradan tiklash…" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
                </StackPanel>
            </Grid>
        </Border>
        <!-- ASOSIY ISH MAYDONI: Doimiy yuklangan Grid (0ms lahzalik almashish, qayta yuklanmaydi) -->
        <Grid Grid.Row="1">
            <views:CashierView DataContext="{Binding CashierVM}"
                               Visibility="{Binding DataContext.IsCashierSelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <views:InventoryView DataContext="{Binding InventoryVM}"
                                 Visibility="{Binding DataContext.IsInventorySelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <views:DebtsView DataContext="{Binding DebtsVM}"
                             Visibility="{Binding DataContext.IsDebtsSelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <views:ReportsView DataContext="{Binding ReportsVM}"
                               Visibility="{Binding DataContext.IsReportsSelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <views:SyncView DataContext="{Binding SyncVM}"
                            Visibility="{Binding DataContext.IsSyncSelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>

        <!-- ======================================================== -->
        <!-- Maket 6.1: DASTUR YOPIQ — AKTIVATSIYA (butun oynani qoplaydi) -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="9999"
              Background="{DynamicResource Bg}" TextElement.Foreground="{DynamicResource Ink}"
              Visibility="{Binding IsDeviceLocked, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/SmartControls.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Grid.Resources>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Brend (logoga 3 marta tez bosish — yashirin amal, o'zgarmagan) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Surface}" Cursor="Hand" ClipToBounds="True">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding LogoClickCommand}"/>
                        </Border.InputBindings>
                        <Image Source="Assets/app_logo.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Line kassa" FontSize="20" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <Border Width="540" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="20" Padding="40,32,40,26">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.10" Color="#0F1B21"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center">
                            <Viewbox Width="34" Height="34">
                                <Path Style="{StaticResource Ic}" Stroke="{DynamicResource AccentInk}" Data="M7 11h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2z M8 11V7a4 4 0 0 1 8 0v4"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Dastur yopiq" FontSize="22" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock Text="Ishga tushirish uchun dasturchi bergan aktivatsiya parolini kiriting yoki dasturchi telefondan masofadan ruxsat bersin."
                                   Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22" MaxWidth="400" Margin="0,14,0,0"/>

                        <!-- Qurilma ma'lumotlari -->
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Margin="0,14,0,0">
                            <StackPanel>
                                <Border Padding="14,10" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="Model" Foreground="{DynamicResource Ink3}" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding DeviceModel}" FontWeight="SemiBold" TextAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceModel}"/>
                                    </DockPanel>
                                </Border>
                                <DockPanel Margin="14,8,8,8">
                                    <TextBlock DockPanel.Dock="Left" Text="Qurilma ID" Foreground="{DynamicResource Ink3}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button DockPanel.Dock="Right" Content="Nusxa" Command="{Binding CopyDeviceIdCommand}" Style="{StaticResource BtnSecondary}"
                                            Height="36" Padding="12,0" Margin="10,0,0,0" ToolTip="Qurilma ID'ni nusxalash"/>
                                    <TextBlock Text="{Binding DeviceId}" FontFamily="Consolas" FontSize="15" TextAlignment="Right" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceId}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource OkSoft}" CornerRadius="8" Padding="10,6" Margin="0,8,0,0"
                                Visibility="{Binding IsCopiedNoticeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Qurilma ID nusxalandi. Endi uni dasturchiga yuboring." Foreground="{DynamicResource Ok}" FontSize="13" FontWeight="SemiBold"
                                       TextAlignment="Center" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Masofaviy ruxsat holati -->
                        <Border Background="{DynamicResource Surface2}" CornerRadius="10" Padding="14,10" Margin="0,14,0,0">
                            <DockPanel>
                                <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Ellipse Stroke="{DynamicResource LineStrong}" StrokeThickness="2"/>
                                    <Path Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M8 1a7 7 0 0 1 7 7"/>
                                </Grid>
                                <TextBlock Text="Masofaviy ruxsat kutilmoqda — dasturchi telefondan yoqsa, o'zi ochiladi" FontSize="13" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap"/>
                            </DockPanel>
                        </Border>

                        <Button Command="{Binding OpenPinModalCommand}" Style="{StaticResource BtnPrimary}" Height="52" FontSize="15" Margin="0,18,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                    <Path Style="{StaticResource Ic}" Data="M8 11a4 4 0 1 0 0.01 0 M11 12l9-9 M17 6l3 3"/>
                                </Viewbox>
                                <TextBlock Text="Aktivatsiya paroli bilan ochish" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Content="Dasturchi bilan bog'lanish (Telegram)" Command="{Binding OpenContactModalCommand}" Style="{StaticResource BtnBase}"
                                Height="40" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ Maket 6.2: AKTIVATSIYA PAROLI ============ -->
            <Grid Panel.ZIndex="10000" Background="{DynamicResource Scrim}"
                  Visibility="{Binding IsPinModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Style="{StaticResource ModalCard}" Width="460" Padding="24,22,24,20" Margin="24">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoft}" Margin="0,0,12,0">
                                <Viewbox Width="20" Height="20">
                                    <Path Style="{StaticResource Ic}" Stroke="{DynamicResource AccentInk}" Data="M12 3l8 3v6c0 5-3.5 8-8 9c-4.5-1-8-4-8-9V6z"/>
                                </Viewbox>
                            </Border>
                            <Button DockPanel.Dock="Right" Command="{Binding ClosePinModalCommand}" Style="{StaticResource CloseBtn}" Background="{DynamicResource Surface2}" ToolTip="Yopish (Esc)">
                                <Viewbox Width="18" Height="18">
                                    <Path Style="{StaticResource Ic}" Data="M6 6l12 12 M18 6L6 18"/>
                                </Viewbox>
                            </Button>
                            <TextBlock Text="Aktivatsiya paroli" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="Dasturni shu kompyuterda ochish uchun dasturchi bergan aktivatsiya parolini kiriting."
                                   Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" LineHeight="21" Margin="0,14,0,0"/>

                        <!-- Parol maydoni: xato bo'lsa hoshiya qizil -->
                        <Border Height="52" CornerRadius="10" BorderThickness="1.5" Padding="8,0,6,0" Margin="0,14,0,0" Background="{DynamicResource Surface}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Bad}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PinErrorMessage}" Value="">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding TogglePinVisibilityCommand}" ToolTip="{Binding EyeButtonTooltip}"
                                        Style="{StaticResource CloseBtn}" Focusable="False">
                                    <Viewbox Width="20" Height="20">
                                        <Path Style="{StaticResource Ic}" Data="M2 12s3.5-7 10-7s10 7 10 7s-3.5 7-10 7S2 12 2 12z M12 9a3 3 0 1 0 0.01 0"/>
                                    </Viewbox>
                                </Button>
                                <Grid>
                                    <PasswordBox x:Name="PinPasswordBox" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ink}"
                                                 CaretBrush="{DynamicResource AccentInk}" FontSize="20" FontWeight="Bold" Padding="6,0"
                                                 VerticalContentAlignment="Center" MaxLength="6"
                                                 PasswordChanged="PinPasswordBox_PasswordChanged"
                                                 Visibility="{Binding PasswordBoxVisibility}"/>
                                    <TextBox x:Name="PinTextBox" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ink}"
                                             CaretBrush="{DynamicResource AccentInk}" FontSize="20" FontWeight="Bold" Padding="6,0"
                                             VerticalContentAlignment="Center" MaxLength="6"
                                             TextChanged="PinTextBox_TextChanged"
                                             Visibility="{Binding TextBoxVisibility}"/>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <!-- Xato xabari -->
                        <DockPanel Margin="0,10,0,0" MinHeight="20">
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PinErrorMessage}" Value="">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>
                            <Viewbox DockPanel.Dock="Left" Width="16" Height="16" Margin="0,2,8,0" VerticalAlignment="Top">
                                <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Bad}" Data="M12 3a9 9 0 1 0 0.01 0 M12 8v5 M12 16v0.5"/>
                            </Viewbox>
                            <TextBlock Text="{Binding PinErrorMessage}" Foreground="{DynamicResource Bad}" FontSize="13" FontWeight="Medium" TextWrapping="Wrap"/>
                        </DockPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Bekor" Command="{Binding ClosePinModalCommand}" Style="{StaticResource BtnSecondary}"/>
                            <Button Grid.Column="2" Command="{Binding SubmitPinCommand}" Style="{StaticResource BtnPrimary}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Ochish" VerticalAlignment="Center"/>
                                    <TextBlock Text="Enter" FontFamily="Consolas" FontSize="11" Opacity="0.8" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ======================================================== -->
        <!-- Maket 6.5: DASTURCHI BILAN BOG'LANISH -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="100000"
              Background="{DynamicResource Scrim}" TextElement.Foreground="{DynamicResource Ink}"
              Visibility="{Binding IsContactModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/SmartControls.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Grid.Resources>
            <Border Style="{StaticResource ModalCard}" Width="420" Margin="24">
                <Grid>
                    <Button Command="{Binding CloseContactModalCommand}" Style="{StaticResource CloseBtn}" Background="{DynamicResource Surface2}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" ToolTip="Yopish (Esc)">
                        <Viewbox Width="18" Height="18">
                            <Path Style="{StaticResource Ic}" Data="M6 6l12 12 M18 6L6 18"/>
                        </Viewbox>
                    </Button>
                    <StackPanel Margin="28,28,28,22">
                        <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center">
                            <Viewbox Width="34" Height="34">
                                <Path Style="{StaticResource Ic}" Stroke="{DynamicResource AccentInk}" Data="M21 4L3 11l6 2l2 6l3-4l5 4z M9 13l7-5"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Dasturchi bilan bog'lanish" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock Text="Savol, xato yoki taklif bo'lsa Telegram orqali yozing yoki qo'ng'iroq qiling."
                                   Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="21" Margin="0,12,0,0"/>

                        <!-- Telegram -->
                        <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="12" Padding="16,10,10,10" Margin="0,16,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="Telegram" FontSize="12" Foreground="{DynamicResource Ink3}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="@S18_2003" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" MinHeight="38" Padding="0,7,0,0"/>
                            </DockPanel>
                        </Border>
                        <!-- Telefon -->
                        <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="12" Padding="16,10,10,10" Margin="0,8,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Nusxa" Command="{Binding CopyPhoneCommand}" Style="{StaticResource BtnSecondary}" Height="38" Padding="12,0"
                                        ToolTip="Telefon raqamini nusxalash"/>
                                <TextBlock DockPanel.Dock="Left" Text="Telefon" FontSize="12" Foreground="{DynamicResource Ink3}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="+998 95 720 88 33" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Border>

                        <Button Command="{Binding OpenTelegramCommand}" Style="{StaticResource BtnPrimary}" Height="50" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                    <Path Style="{StaticResource Ic}" Data="M21 4L3 11l6 2l2 6l3-4l5 4z"/>
                                </Viewbox>
                                <TextBlock Text="Telegramda ochish" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock FontSize="12" Foreground="{DynamicResource Ink3}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0">
                            <Run Text="Line kassa · Qurilma ID"/> <Run Text="{Binding DeviceId, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- Maket 6.3: KARTA SOLIG'I FOIZI -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="100000"
              Background="{DynamicResource Scrim}" TextElement.Foreground="{DynamicResource Ink}"
              Visibility="{Binding IsCardTaxModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/SmartControls.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Grid.Resources>
            <Border Style="{StaticResource ModalCard}" Width="480" Padding="24,22,24,20" Margin="24">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Padding="10,4" CornerRadius="12" Background="{DynamicResource OkSoft}" VerticalAlignment="Center" Margin="10,0,0,0"
                                Visibility="{Binding ShowUnlockedChip, Source={x:Static services:AdminGate.Current}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                                    <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ok}" Data="M7 11h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2z M8 11V7a4 4 0 0 1 7.5-2"/>
                                </Viewbox>
                                <TextBlock Text="Admin rejimi ochiq" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Ok}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Karta solig'i foizi" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Text="Karta orqali to'langan savdolardan ushlanadigan foiz. Hisobotlarda sof foydani to'g'ri ko'rsatish uchun xarajat sifatida hisobga olinadi."
                               Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" LineHeight="21" Margin="0,16,0,0"/>

                    <WrapPanel Margin="0,16,0,0">
                        <TextBox x:Name="CardTaxBox" Text="{Binding CardTaxRateInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBoxBig}"
                                 Width="160" Height="56" FontSize="24" FontWeight="ExtraBold" Tag="%" Margin="0,0,12,6"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                            <Button Content="1%" Tag="1" Click="CardTaxPreset_Click" Style="{StaticResource BtnSecondary}" Height="40" Padding="12,0" Margin="0,0,6,0" FontWeight="Normal"/>
                            <Button Content="1.8%" Tag="1.8" Click="CardTaxPreset_Click" Style="{StaticResource BtnSecondary}" Height="40" Padding="12,0" Margin="0,0,6,0" FontWeight="Normal"/>
                            <Button Content="2%" Tag="2" Click="CardTaxPreset_Click" Style="{StaticResource BtnSecondary}" Height="40" Padding="12,0" Margin="0,0,6,0" FontWeight="Normal"/>
                            <Button Content="3%" Tag="3" Click="CardTaxPreset_Click" Style="{StaticResource BtnSecondary}" Height="40" Padding="12,0" FontWeight="Normal"/>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding CardTaxErrorMessage}" Foreground="{DynamicResource Bad}" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding CardTaxErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Border Background="{DynamicResource Surface2}" CornerRadius="10" Padding="14,12" Margin="0,12,0,0">
                        <TextBlock FontSize="13" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" LineHeight="21"
                                   Text="Standart miqdor: 1.8%. Aralash to'lovda foiz faqat karta qismidan hisoblanadi."/>
                    </Border>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Bekor" Command="{Binding CloseCardTaxModalCommand}" Style="{StaticResource BtnSecondary}"/>
                        <Button Grid.Column="2" Content="Saqlash" Command="{Binding SaveCardTaxCommand}" Style="{StaticResource BtnPrimary}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- Maket 6.6: ZAXIRA NUSXA SAQLANDI (pastda bildirishnoma) -->
        <!-- ======================================================== -->
        <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24" Panel.ZIndex="99998"
                Width="560" CornerRadius="12" BorderThickness="1" ClipToBounds="True"
                Visibility="{Binding IsBackupToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/SmartControls.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Border.Resources>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Surface}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.18" Color="#0F1B21"/>
            </Border.Effect>
            <DockPanel TextElement.Foreground="{DynamicResource Ink}">
                <Border DockPanel.Dock="Left" Width="4" Background="{DynamicResource Ok}" CornerRadius="12,0,0,12"/>
                <DockPanel Margin="12,14,14,14">
                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource OkSoft}" Margin="0,0,14,0">
                        <Viewbox Width="20" Height="20">
                            <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ok}" Data="M5 12l5 5l9-10"/>
                        </Viewbox>
                    </Border>
                    <Button DockPanel.Dock="Right" Command="{Binding CloseBackupToastCommand}" Style="{StaticResource CloseBtn}" Width="32" Height="32" Margin="6,0,0,0" ToolTip="Yopish">
                        <Viewbox Width="16" Height="16">
                            <Path Style="{StaticResource Ic}" Data="M6 6l12 12 M18 6L6 18"/>
                        </Viewbox>
                    </Button>
                    <Button DockPanel.Dock="Right" Content="Papkani ochish" Command="{Binding OpenBackupFolderCommand}" Style="{StaticResource BtnSecondary}"
                            Height="38" Padding="12,0" Margin="12,0,0,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Zaxira nusxa saqlandi" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding BackupToastText}" FontSize="12" Foreground="{DynamicResource Ink3}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding BackupToastText}"/>
                    </StackPanel>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- Maket 2.9: FONDAGI STIKER CHOP ETISH VIDJETI (o'ng past) -->
        <!-- ======================================================== -->
        <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,20,20" Panel.ZIndex="99999" Width="320" CornerRadius="12" Padding="14,12"
                Visibility="{Binding PrintService.IsStickyVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/SmartControls.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                    <!-- Vidjet ichidagi kichik tugma (to'q fonda) -->
                    <Style x:Key="ToastBtn" TargetType="Button">
                        <Setter Property="Height" Value="28"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Foreground" Value="{DynamicResource ToastFg}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ToastLine}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ToastTrack}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ResourceDictionary>
            </Border.Resources>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource ToastBg}"/>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="16" Direction="270" Color="#0F1B21" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Printer ikonkasi -->
                    <Viewbox Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Path Style="{StaticResource Ic}" Stroke="{DynamicResource ToastFg}"
                              Data="M6 9V3h12v6 M5 9h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2z M7 14h10v7H7z"/>
                    </Viewbox>
                    <!-- Holat yozuvi: "Stiker: 27 / 61" -->
                    <TextBlock Grid.Column="1" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ToastFg}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding PrintService.ProductName}">
                        <Run>
                            <Run.Style>
                                <Style TargetType="Run">
                                    <Setter Property="Text" Value="Stiker:"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PrintService.IsCompleted}" Value="True">
                                            <Setter Property="Text" Value="Tayyor:"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PrintService.IsCancelled}" Value="True">
                                            <Setter Property="Text" Value="To'xtatildi:"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PrintService.HasError}" Value="True">
                                            <Setter Property="Text" Value="Xatolik:"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Run.Style>
                        </Run>
                        <Run Text="{Binding PrintService.CurrentCount, Mode=OneWay}"/>
                        <Run Text="/"/>
                        <Run Text="{Binding PrintService.TotalCount, Mode=OneWay}"/>
                    </TextBlock>
                    <!-- To'xtatish: faqat chop etilayotganda -->
                    <Button Grid.Column="2" Content="To'xtatish" Command="{Binding PrintService.CancelPrintCommand}"
                            Style="{StaticResource ToastBtn}" VerticalAlignment="Center"
                            Visibility="{Binding PrintService.CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <!-- Vidjetni yopish -->
                    <Button Grid.Column="3" Command="{Binding PrintService.CloseStickyCommand}" Style="{StaticResource ToastBtn}"
                            Width="28" Padding="0" BorderThickness="0" Margin="6,0,-4,0" VerticalAlignment="Center" ToolTip="Yopish">
                        <Viewbox Width="14" Height="14">
                            <Path Style="{StaticResource Ic}" Stroke="{DynamicResource ToastFg}" Data="M6 6l12 12 M18 6L6 18"/>
                        </Viewbox>
                    </Button>
                </Grid>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding PrintService.ProgressPercentage, Mode=OneWay}"
                             Height="6" Background="{DynamicResource ToastTrack}" Foreground="{DynamicResource ToastFill}" BorderThickness="0" Margin="0,8,0,0">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                                <Grid x:Name="PART_Track">
                                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
            </StackPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- Maket 2.8: STIKER CHOP ETISH JARAYONI (440px oyna)       -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="100005"
              Visibility="{Binding PrintService.IsModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/SmartControls.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Grid.Resources>
            <Border Background="{DynamicResource Scrim}"/>
            <Border Style="{StaticResource ModalCard}" Width="440" Padding="24,22"
                    HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Ink}">
                <StackPanel>
                    <!-- Sarlavha (holatga qarab) -->
                    <TextBlock FontSize="18" FontWeight="Bold" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Stiker chop etilmoqda…"/>
                                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PrintService.IsCompleted}" Value="True">
                                        <Setter Property="Text" Value="Stikerlar tayyor"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PrintService.IsCancelled}" Value="True">
                                        <Setter Property="Text" Value="Chop etish to'xtatildi"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PrintService.HasError}" Value="True">
                                        <Setter Property="Text" Value="Chop etib bo'lmadi"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Tovar nomi · 27 / 61 -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PrintService.ProductName}" FontSize="14" Foreground="{DynamicResource Ink2}"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Ink}">
                            <Run Text="{Binding PrintService.CurrentCount, Mode=OneWay}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding PrintService.TotalCount, Mode=OneWay}"/>
                        </TextBlock>
                    </Grid>

                    <!-- Jarayon chizig'i -->
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding PrintService.ProgressPercentage, Mode=OneWay}"
                                 Height="10" Background="{DynamicResource Surface2}" BorderThickness="0" Margin="0,14,0,0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PrintService.IsCompleted}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource OkSolid}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PrintService.HasError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource BadSolid}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Border Background="{TemplateBinding Background}" CornerRadius="5" ClipToBounds="True">
                                    <Grid x:Name="PART_Track">
                                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="5" HorizontalAlignment="Left"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>

                    <!-- Izoh qatori (holatga qarab) -->
                    <Grid Margin="0,14,0,0">
                        <!-- Chop etilmoqda: foiz -->
                        <TextBlock FontSize="13" Foreground="{DynamicResource Ink3}" TextWrapping="Wrap"
                                   Visibility="{Binding PrintService.CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Run Text="{Binding PrintService.ProgressPercentage, Mode=OneWay, StringFormat={}{0:0}}"/><Run Text="% bajarildi · fonda davom ettirish mumkin"/>
                        </TextBlock>
                        <TextBlock FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PrintService.IsCompleted}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Text" Value="Barcha stikerlar chop etildi"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Ok}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PrintService.IsCancelled}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Text" Value="Qolgan stikerlar chop etilmadi"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PrintService.HasError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Text" Value="{Binding PrintService.StatusText}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Tugmalar -->
                    <Grid Margin="0,18,0,0">
                        <!-- Chop etilayotganda -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PrintService.IsPrinting}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.4*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="To'xtatish" Command="{Binding PrintService.CancelPrintCommand}"
                                    Style="{StaticResource BtnDangerOutline}" Height="46"/>
                            <Button Grid.Column="2" Content="Fonda davom etsin" Command="{Binding PrintService.SendToBackgroundCommand}"
                                    Style="{StaticResource BtnPrimary}" Height="46"/>
                        </Grid>
                        <!-- Tugagan / to'xtatilgan / xato -->
                        <Button Command="{Binding PrintService.CloseModalCommand}" Height="46" IsDefault="True">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PrintService.IsPrinting}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Yopish" VerticalAlignment="Center"/>
                                <TextBlock Text="Enter" Style="{StaticResource Kbd}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- MAHSULOT RASMINI KATTA KO'RISH (LIGHTBOX MODAL) -->
        <!-- ============================================================== -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="1000"
              Visibility="{Binding IsImagePreviewOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Grid.Resources>
            <!-- To'q fon (maket: rgba(15,27,33,0.82)); bosilganda yopiladi -->
            <Border Background="#D10F1B21">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding CloseImagePreviewCommand}"/>
                </Border.InputBindings>
            </Border>

            <!-- 1.12 Tovar rasmi: 640px karta, 440px rasm maydoni, pastda nomi/narxi -->
            <Border Width="640" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                    Background="{DynamicResource Surface}" CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.3" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="440"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource IllusBg}" CornerRadius="16,16,0,0">
                        <Grid>
                            <Image Source="{Binding PreviewImagePath}" Stretch="Uniform" Margin="20"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Width="40" Height="40" Cursor="Hand"
                                    Command="{Binding CloseImagePreviewCommand}" ToolTip="Yopish (Esc)" AutomationProperties.Name="Yopish">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#FFFFFF" CornerRadius="10">
                                            <Viewbox Width="18" Height="18">
                                                <Path Data="M6 6l12 12M18 6L6 18" Stroke="#0F1B21" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Width="24" Height="24" Stretch="None"/>
                                            </Viewbox>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="20,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding PreviewImageTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding PreviewImageMeta}" FontSize="13" Foreground="{DynamicResource Ink3}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PreviewImageMeta}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Ink}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewImagePrice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="{Binding PreviewImagePrice, Mode=OneWay}" FontSize="22" FontWeight="ExtraBold"/>
                            <Run Text="so'm" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Ink3}"/>
                        </TextBlock>
                        <Button Grid.Column="2" Margin="16,0,0,0" Height="48" Padding="18,0" Cursor="Hand"
                                Command="{Binding PreviewAddToCartCommand}"
                                Visibility="{Binding HasPreviewAddToCart, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{DynamicResource Accent}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="Savatga +1" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource OnAccent}" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>