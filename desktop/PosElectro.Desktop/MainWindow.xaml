<Window x:Class="PosElectro.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:PosElectro.Desktop.Views"
        xmlns:vm="clr-namespace:PosElectro.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="Line kassa" 
        Icon="Assets/app_logo.png"
        Height="750" Width="1200" MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        InputLanguageManager.InputLanguage="en-US"
        InputLanguageManager.RestoreInputLanguage="True"
        Activated="Window_Activated"
        PreviewTextInput="Window_PreviewTextInput"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Navigatsiya Tugmasi Stili -->
        <Style x:Key="NavTabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Faol Tugma Stili (Oq Tabletka / Teal Matn) -->
        <Style x:Key="ActiveNavTabButton" TargetType="Button" BasedOn="{StaticResource NavTabButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0B6477"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Yuqori Menyu Paneli -->
            <RowDefinition Height="64"/>
            <!-- Asosiy Ish Maydoni (Yagona Sahifa) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- YUQORI NAVIGATSIYA PANELI (Line Kassa Brend Gradienti) -->
        <Border Grid.Row="0" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="20,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#073B4C" Offset="0.0"/>
                    <GradientStop Color="#0B6477" Offset="0.35"/>
                    <GradientStop Color="#115E59" Offset="0.75"/>
                    <GradientStop Color="#0F172A" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Tizim Logosi -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,32,0">
                    <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center" Background="#16A34A" Padding="1">
                        <Image Source="Assets/app_logo.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Line kassa" Foreground="#F8FAFC" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Menyu Tugmalari (Ishonchli Buttonlar) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Kassa -->
                    <Button Command="{Binding NavigateCashierCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCashierSelected}" Value="True">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="#0B6477"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsCashierSelected}" Value="True"/>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Foreground" Value="White"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"
                                  Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Kassa" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Ombor -->
                    <Button Command="{Binding NavigateInventoryCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInventorySelected}" Value="True">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="#0B6477"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsInventorySelected}" Value="True"/>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Foreground" Value="White"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M20 2H4c-1.1 0-2 .9-2 2v3.01c0 .72.38 1.36.95 1.7L3 9.7V20c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V9.7l.05-.99c.57-.34.95-.98.95-1.7V4c0-1.1-.9-2-2-2zm-1 18H5V10h14v10zm1-13H4V4h16v3z"
                                  Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ombor" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Hisobotlar -->
                    <Button Command="{Binding NavigateReportsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReportsSelected}" Value="True">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="#0B6477"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsReportsSelected}" Value="True"/>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Foreground" Value="White"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"
                                  Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Hisobotlar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Wi-Fi Sinxron -->
                    <Button Command="{Binding NavigateSyncCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSyncSelected}" Value="True">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="#0B6477"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSyncSelected}" Value="True"/>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Foreground" Value="White"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z"
                                  Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Wi-Fi Sinxron" VerticalAlignment="Center"/>
                            <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="8" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#25FFFFFF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLiveSyncActive}" Value="True">
                                                <Setter Property="Background" Value="#16A34A"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsSyncSelected}" Value="True"/>
                                                    <Condition Binding="{Binding IsLiveSyncActive}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="#E0F2FE"/>
                                                <Setter Property="BorderBrush" Value="#BAE6FD"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding LiveSyncStatusText}" FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#F8FAFC"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLiveSyncActive}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsSyncSelected}" Value="True"/>
                                                        <Condition Binding="{Binding IsLiveSyncActive}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Foreground" Value="#0369A1"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- O'ng tomon: Baza zaxirasi va Bog'lanish tugmalari -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Karta solig'i foizi (faqat icon, text siz) -->
                    <Button Command="{Binding OpenCardTaxModalCommand}"
                            ToolTip="Karta to'lovi solig'i foizini sozlash"
                            Background="#25FFFFFF" Foreground="#F8FAFC" BorderBrush="#45FFFFFF" BorderThickness="1"
                            Width="36" Height="36" Padding="0" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <Path Data="M7.5 4C5.57 4 4 5.57 4 7.5S5.57 11 7.5 11 11 9.43 11 7.5 9.43 4 7.5 4zm0 5c-.83 0-1.5-.67-1.5-1.5S6.67 6 7.5 6s1.5.67 1.5 1.5S8.33 9 7.5 9zm9 6c-1.93 0-3.5 1.57-3.5 3.5s1.57 3.5 3.5 3.5 3.5-1.57 3.5-3.5-1.57-3.5-3.5-3.5zm0 5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm3.21-15.71a.996.996 0 0 0-1.41 0L4.29 18.29a.996.996 0 1 0 1.41 1.41L19.71 5.7a.996.996 0 0 0 0-1.41z" 
                              Fill="#F8FAFC" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Baza zaxirasi (faqat icon) -->
                    <Button Command="{Binding BackupDatabaseCommand}"
                            ToolTip="Ma'lumotlar bazasini to'liq fayl qilib yuklab olish (Fleshka yoki kompyuterga)"
                            Background="#25FFFFFF" Foreground="#F8FAFC" BorderBrush="#45FFFFFF" BorderThickness="1"
                            Width="36" Height="36" Padding="0" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <Path Data="M12 3C7.58 3 4 4.79 4 7v10c0 2.21 3.58 4 8 4s8-1.79 8-4V7c0-2.21-3.58-4-8-4zm0 2c3.87 0 6 1.5 6 2s-2.13 2-6 2-6-1.5-6-2 2.13-2 6-2zm6 12c0 .5-2.13 2-6 2s-6-1.5-6-2v-2.23c1.61.78 3.73 1.23 6 1.23s4.39-.45 6-1.23V17zm0-5c0 .5-2.13 2-6 2s-6-1.5-6-2v-2.23c1.61.78 3.73 1.23 6 1.23s4.39-.45 6-1.23V12z" 
                              Fill="#F8FAFC" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Bog'lanish (faqat icon) -->
                    <Button Command="{Binding OpenContactModalCommand}"
                            ToolTip="Ishlab chiqaruvchi bilan bog'lanish"
                            Background="#2510B981" Foreground="#34D399" BorderBrush="#059669" BorderThickness="1"
                            Width="36" Height="36" Padding="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <Path Data="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 0 0-1.01.24l-2.2 2.2a15.053 15.053 0 0 1-6.59-6.59l2.2-2.21a.96.96 0 0 0 .25-1.01A11.36 11.36 0 0 1 8.57 3.99c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1C3 13.93 11.07 22 21 22c.55 0 1-.45 1-1v-3.62c0-.55-.45-1-.99-1z" 
                              Fill="#34D399" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ASOSIY ISH MAYDONI: Doimiy yuklangan Grid (0ms lahzalik almashish, qayta yuklanmaydi) -->
        <Grid Grid.Row="1">
            <views:CashierView DataContext="{Binding CashierVM}"
                               Visibility="{Binding DataContext.IsCashierSelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <views:InventoryView DataContext="{Binding InventoryVM}"
                                 Visibility="{Binding DataContext.IsInventorySelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <views:ReportsView DataContext="{Binding ReportsVM}"
                               Visibility="{Binding DataContext.IsReportsSelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <views:SyncView DataContext="{Binding SyncVM}"
                            Visibility="{Binding DataContext.IsSyncSelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>

        <!-- QURILMA FAOL EMAS (AKTIVATSIYA OYNASI) OVERLAY -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="9999"
              Background="#F20B1120"
              Visibility="{Binding IsDeviceLocked, Converter={StaticResource BooleanToVisibilityConverter}}">
            
            <!-- Markaziy Asosiy Karta -->
            <Border Background="#1E293B" CornerRadius="24" BorderBrush="#334155" BorderThickness="1.5"
                    Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.8" Color="#000000"/>
                </Border.Effect>
                
                <StackPanel HorizontalAlignment="Center">
                    <!-- App Logo (Bosganda 3 marta tez klik detektori) -->
                    <Border Width="80" Height="80" CornerRadius="20" Background="#0F172A"
                            BorderBrush="#0284C7" BorderThickness="1.5" Cursor="Hand" Margin="0,0,0,16">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding LogoClickCommand}"/>
                        </Border.InputBindings>
                        <Image Source="Assets/app_logo.png" Width="68" Height="68"
                               RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Sarlavha -->
                    <TextBlock Text="Qurilma Faollashtirilmagan" Foreground="#F8FAFC" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8"/>
                    
                    <!-- Tavsif -->
                    <TextBlock Text="Dasturdan foydalanish uchun Admindan ruxsat oling yoki aktivatsiya kodini kiriting."
                               Foreground="#94A3B8" FontSize="14" LineHeight="20" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24"/>

                    <!-- Qurilma Parametrlari Qutisi -->
                    <Border Background="#0F172A" CornerRadius="14" BorderBrush="#334155" BorderThickness="1"
                            Padding="16" Width="436" Margin="0,0,0,20">
                        <StackPanel>
                            <!-- Model -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="💻 Model: " Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DeviceModel}" Foreground="#F1F5F9" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- ID va Nusxalash -->
                            <TextBlock Text="Qurilma ID:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="10,6" Margin="0,0,8,0"
                                        BorderBrush="#334155" BorderThickness="1">
                                    <TextBlock Text="{Binding DeviceId}" Foreground="#38BDF8" FontFamily="Consolas"
                                               FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Border>

                                <Button Grid.Column="1" Content="📋 Nusxalash"
                                        Command="{Binding CopyDeviceIdCommand}"
                                        Background="#1E293B" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1"
                                        FontWeight="SemiBold" FontSize="12" Padding="12,6" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <!-- Nusxalandi bildirishnomasi -->
                            <Border Background="#064E3B" CornerRadius="6" Padding="8,4" Margin="0,8,0,0"
                                    Visibility="{Binding IsCopiedNoticeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="✓ Qurilma ID nusxalandi! Endi buni Adminga yuboring." 
                                           Foreground="#34D399" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </Border>

                            <!-- Masofaviy status -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                <Ellipse Width="8" Height="8" Fill="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Masofaviy ruxsat kutilmoqda (Admin telefondan yoqishi mumkin)..." 
                                           Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Aktivatsiya Kodini Kiritish Tugmasi -->
                    <Button Content="🔑 Aktivatsiya Kodini Kiritish"
                            Command="{Binding OpenPinModalCommand}"
                            Style="{StaticResource ModernButton}"
                            Width="436" Height="44" FontSize="15" FontWeight="Bold"/>

                    <!-- Dasturchi bilan bog'lanish havolasi -->
                    <Button Command="{Binding OpenContactModalCommand}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📞 " FontSize="13"/>
                            <TextBlock Text="Ishlab chiqaruvchi bilan bog'lanish" 
                                       Foreground="#38BDF8" FontSize="13" FontWeight="SemiBold" TextDecorations="Underline"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- PIN KODNI KIRITISH MODAL OYNASI -->
            <Grid Panel.ZIndex="10000" Background="#CC000000"
                  Visibility="{Binding IsPinModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="#1E293B" CornerRadius="20" BorderBrush="#0B6477" BorderThickness="1.5"
                        Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.9" Color="#000000"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#074F61" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                    <TextBlock Text="🛡️" FontFamily="Segoe UI Emoji" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Aktivatsiya Kodi" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Command="{Binding ClosePinModalCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,2">
                                <TextBlock Text="✕" Foreground="#94A3B8" FontSize="16" FontWeight="Bold"/>
                            </Button>
                        </Grid>

                        <Separator Background="#334155" Margin="0,0,0,14"/>

                        <TextBlock Text="Qurilmani ishga tushirish uchun do'kon aktivatsiya kodini kiriting:"
                                   Foreground="#94A3B8" FontSize="13" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- PIN / Kod Kiritish Qatori (Xavfsiz / Ko'zcha tugmasi bilan) -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>

                            <!-- Kod maydoni (Yashirin - Default holat) -->
                            <PasswordBox x:Name="PinPasswordBox"
                                         Grid.Column="0"
                                         Style="{StaticResource ModernPasswordBox}"
                                         FontSize="22" FontWeight="Bold"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Height="52"
                                         MaxLength="6"
                                         PasswordChanged="PinPasswordBox_PasswordChanged"
                                         Visibility="{Binding PasswordBoxVisibility}"/>

                            <!-- Kod maydoni (Ko'rinadigan - Ochiq holat) -->
                            <TextBox x:Name="PinTextBox"
                                     Grid.Column="0"
                                     Style="{StaticResource ModernTextBox}"
                                     FontSize="22" FontWeight="Bold"
                                     TextAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Height="52"
                                     MaxLength="6"
                                     TextChanged="PinTextBox_TextChanged"
                                     Visibility="{Binding TextBoxVisibility}"/>

                            <!-- Ko'zcha tugmasi (Parolni ko'rsatish/yashirish) -->
                            <Button Grid.Column="2"
                                    Command="{Binding TogglePinVisibilityCommand}"
                                    ToolTip="{Binding EyeButtonTooltip}"
                                    Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
                                    Height="52" Cursor="Hand" Padding="0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="8">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="#0B6477"/>
                                                            <Setter TargetName="btnBorder" Property="Background" Value="#1E293B"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding EyeButtonIcon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <!-- Xatolik xabari -->
                        <TextBlock Text="{Binding PinErrorMessage}" Foreground="#EF4444" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,0,0,14" TextWrapping="Wrap"/>

                        <!-- Tugmalar -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Bekor qilish"
                                    Command="{Binding ClosePinModalCommand}"
                                    Background="#334155" Foreground="#CBD5E1"
                                    Height="42" FontSize="14" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Grid.Column="2" Content="Faollashtirish"
                                    Command="{Binding SubmitPinCommand}"
                                    IsDefault="True"
                                    Style="{StaticResource ModernButton}"
                                    Height="42" FontSize="14" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ISHLAB CHIQARUVCHI BILAN BOG'LANISH MODAL OYNASI (OK MODAL) -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="100000"
              Background="#CC000000"
              Visibility="{Binding IsContactModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#1E293B" CornerRadius="20" BorderBrush="#059669" BorderThickness="1.5"
                    Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.9" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#064E3B" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0" BorderBrush="#059669" BorderThickness="1">
                                <TextBlock Text="👨‍💻" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Ishlab chiqaruvchi" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Texnik yordam va litsenziya bo'yicha" Foreground="#94A3B8" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Command="{Binding CloseContactModalCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,2">
                            <TextBlock Text="✕" Foreground="#94A3B8" FontSize="16" FontWeight="Bold"/>
                        </Button>
                    </Grid>

                    <Separator Background="#334155" Margin="0,0,0,16"/>

                    <!-- Aloqa Ma'lumotlari Qutisi -->
                    <Border Background="#0F172A" CornerRadius="12" Padding="16" Margin="0,0,0,20" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <!-- Telefon raqam -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📞" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Telefon raqam:" Foreground="#94A3B8" FontSize="11"/>
                                    <TextBlock Text="+998 95 720 88 33" Foreground="#F8FAFC" FontSize="15" FontWeight="Bold"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Nusxalash"
                                        Command="{Binding CopyPhoneCommand}"
                                        Background="#1E293B" Foreground="#34D399" BorderBrush="#059669" BorderThickness="1"
                                        FontSize="11" FontWeight="SemiBold" Padding="10,5" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <Separator Background="#1E293B" Margin="0,0,0,14"/>

                            <!-- Telegram -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="✈️" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Telegram:" Foreground="#94A3B8" FontSize="11"/>
                                    <TextBlock Text="@S18_2003" Foreground="#38BDF8" FontSize="15" FontWeight="Bold"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Ochish"
                                        Command="{Binding OpenTelegramCommand}"
                                        Background="#1E293B" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1"
                                        FontSize="11" FontWeight="SemiBold" Padding="14,5" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- OK Tugmasi -->
                    <Button Content="Tushundim (OK)" 
                            Command="{Binding CloseContactModalCommand}"
                            IsDefault="True"
                            Style="{StaticResource ModernButton}"
                            Height="42" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- KARTA SOLIG'I FOIZINI SOZLASH MODALI -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="100000"
              Background="#CC000000"
              Visibility="{Binding IsCardTaxModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#1E293B" BorderBrush="#0B6477" BorderThickness="1.5"
                    CornerRadius="16" Width="380" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.9" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#064E3B" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0" BorderBrush="#059669" BorderThickness="1">
                                <TextBlock Text="%" FontSize="20" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Karta solig'i foizi" Foreground="#F8FAFC" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="Karta to'lovlaridan ushlanadigan foiz" Foreground="#94A3B8" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Command="{Binding CloseCardTaxModalCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,2">
                            <TextBlock Text="✕" Foreground="#94A3B8" FontSize="16" FontWeight="Bold"/>
                        </Button>
                    </Grid>

                    <Separator Background="#334155" Margin="0,0,0,16"/>

                    <!-- Foiz input -->
                    <TextBlock Text="Ushlab qolinadigan foiz (%):" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding CardTaxRateInput, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="16" FontWeight="Bold" Padding="12,10" Margin="0,0,0,6"/>

                    <TextBlock Text="{Binding CardTaxErrorMessage}" Foreground="#EF4444" FontSize="12" Margin="0,0,0,10"
                               Visibility="{Binding CardTaxErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <TextBlock Text="Standart miqdor: 1.8%. Bu foiz karta orqali to'langan savdolardan hisoblanadi va hisobotlarda sof foydani to'g'ri ko'rsatish uchun xarajat sifatida hisobga olinadi."
                               Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <!-- Tugmalar -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Bekor qilish"
                                Command="{Binding CloseCardTaxModalCommand}"
                                Background="#334155" Style="{StaticResource ModernButton}" Margin="0,0,6,0" Padding="0,10"/>
                        <Button Grid.Column="1" Content="Saqlash"
                                Command="{Binding SaveCardTaxCommand}"
                                Style="{StaticResource SuccessButton}" Margin="6,0,0,0" Padding="0,10" IsDefault="True"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
