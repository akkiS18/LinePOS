                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Masofaviy ruxsat kutilmoqda (Admin telefondan yoqishi mumkin)..." 
                                           Foreground="{DynamicResource AccentInk}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Aktivatsiya Kodini Kiritish Tugmasi -->
