<Window x:Class="PosElectro.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:PosElectro.Desktop.Views"
        xmlns:vm="clr-namespace:PosElectro.Desktop.ViewModels"
        xmlns:services="clr-namespace:PosElectro.Desktop.Services"
        mc:Ignorable="d"
        Title="SMART kassa" 
        Icon="Assets/app_logo.png"
        Height="750" Width="1200" MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        InputLanguageManager.InputLanguage="en-US"
        InputLanguageManager.RestoreInputLanguage="True"
        Activated="Window_Activated"
        PreviewTextInput="Window_PreviewTextInput"
        PreviewKeyDown="Window_PreviewKeyDown">

<Window.Resources>
        <!-- Yuqori paneldagi bo'lim tugmasi (faol bo'lim Tag=True bilan belgilanadi) -->
        <Style x:Key="NavTab" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Sozlamalar tugmasi -->
        <Style x:Key="GearButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sozlamalar menyusi qatori -->
        <Style x:Key="MenuRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MenuRowDanger" TargetType="Button" BasedOn="{StaticResource MenuRowButton}">
            <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
            <Setter Property="Background" Value="{DynamicResource BadSoft}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Yuqori Menyu Paneli -->
            <RowDefinition Height="56"/>
            <!-- Asosiy Ish Maydoni (Yagona Sahifa) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- YUQORI NAVIGATSIYA PANELI -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logotip -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,0">
                    <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center" Background="{DynamicResource AccentSoft}" Padding="2">
                        <Image Source="Assets/app_logo.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="SMART kassa" Foreground="{DynamicResource Ink}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Bo'limlar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource NavTab}" Command="{Binding NavigateCashierCommand}" Tag="{Binding IsCashierSelected}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Kassa" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavTab}" Command="{Binding NavigateInventoryCommand}" Tag="{Binding IsInventorySelected}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M20 2H4c-1.1 0-2 .9-2 2v3.01c0 .72.38 1.36.95 1.7L3 9.7V20c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V9.7l.05-.99c.57-.34.95-.98.95-1.7V4c0-1.1-.9-2-2-2zm-1 18H5V10h14v10zm1-13H4V4h16v3z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ombor" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavTab}" Command="{Binding NavigateDebtsCommand}" Tag="{Binding IsDebtsSelected}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M18 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 4h5v8l-2.5-1.5L6 12V4z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Qarzlar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavTab}" Command="{Binding NavigateReportsCommand}" Tag="{Binding IsReportsSelected}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Hisobotlar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavTab}" Command="{Binding NavigateSyncCommand}" Tag="{Binding IsSyncSelected}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Wi-Fi Sinxron" VerticalAlignment="Center"/>
                            <Border Margin="8,0,0,0" Padding="7,2" CornerRadius="9" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Line}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLiveSyncActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource OkSolid}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding LiveSyncStatusText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OnAccent}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Admin rejimi ochiq belgisi (PIN yoqilgan va qulf ochilgan bo'lsa) -->
                <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                        Command="{Binding LockAdminCommand}" Cursor="Hand" ToolTip="Yashirin ma'lumotlarni qayta yopish"
                        Visibility="{Binding ShowUnlockedChip, Source={x:Static services:AdminGate.Current}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="18" Padding="12,0" Height="36">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M12 17c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm6-9h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6h1.9c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm0 12H6V10h12v10z" Fill="{DynamicResource Warn}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0"/>
                                    <TextBlock Text="Admin rejimi ochiq" Foreground="{DynamicResource Warn}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text=" · Qulflash" Foreground="{DynamicResource Ink}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Warn}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- O'ng tomon: bitta sozlamalar menyusi -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <ToggleButton x:Name="SettingsToggle" Style="{StaticResource GearButton}" ToolTip="Sozlamalar" AutomationProperties.Name="Sozlamalar">
                        <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.488.488 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="18" Height="18" Stretch="Uniform"/>
                    </ToggleButton>
                    <Popup IsOpen="{Binding IsChecked, ElementName=SettingsToggle, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=SettingsToggle}" Placement="Custom"
                           CustomPopupPlacementCallback="SettingsPopup_Placement" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="310" Margin="8" Padding="6" CornerRadius="12" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="SOZLAMALAR" Foreground="{DynamicResource Ink3}" FontSize="11" FontWeight="Bold" Margin="10,6,10,2"/>
                                <Button Style="{StaticResource MenuRowButton}" Command="{Binding OpenCardTaxModalCommand}" Click="SettingsMenuItem_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M7.5 4C5.57 4 4 5.57 4 7.5S5.57 11 7.5 11 11 9.43 11 7.5 9.43 4 7.5 4zm0 5c-.83 0-1.5-.67-1.5-1.5S6.67 6 7.5 6s1.5.67 1.5 1.5S8.33 9 7.5 9zm9 6c-1.93 0-3.5 1.57-3.5 3.5s1.57 3.5 3.5 3.5 3.5-1.57 3.5-3.5-1.57-3.5-3.5-3.5zm0 5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm3.21-15.71a.996.996 0 0 0-1.41 0L4.29 18.29a.996.996 0 1 0 1.41 1.41L19.71 5.7a.996.996 0 0 0 0-1.41z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Karta solig'i foizi" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource MenuRowButton}" Command="{Binding ExportWarehouseCostReportCommand}" Click="SettingsMenuItem_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 2v3H5V5h14zm-8 5v4H5v-4h6zm2 0h6v4h-6v-4zm-2 6v4H5v-4h6zm2 0h6v4h-6v-4z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ombor tan narxi hisoboti (Excel)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource MenuRowButton}" Command="{Binding BackupDatabaseCommand}" Click="SettingsMenuItem_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M12 3C7.58 3 4 4.79 4 7v10c0 2.21 3.58 4 8 4s8-1.79 8-4V7c0-2.21-3.58-4-8-4zm0 2c3.87 0 6 1.5 6 2s-2.13 2-6 2-6-1.5-6-2 2.13-2 6-2zm6 12c0 .5-2.13 2-6 2s-6-1.5-6-2v-2.23c1.61.78 3.73 1.23 6 1.23s4.39-.45 6-1.23V17zm0-5c0 .5-2.13 2-6 2s-6-1.5-6-2v-2.23c1.61.78 3.73 1.23 6 1.23s4.39-.45 6-1.23V12z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Zaxira nusxa saqlash" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource MenuRowButton}" Command="{Binding OpenAdminPinSettingsCommand}" Click="SettingsMenuItem_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zM9 8V6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Admin PIN · yashirin ma'lumotlar" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource MenuRowButton}" Command="{Binding OpenContactModalCommand}" Click="SettingsMenuItem_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 0 0-1.01.24l-2.2 2.2a15.053 15.053 0 0 1-6.59-6.59l2.2-2.21a.96.96 0 0 0 .25-1.01A11.36 11.36 0 0 1 8.57 3.99c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1C3 13.93 11.07 22 21 22c.55 0 1-.45 1-1v-3.62c0-.55-.45-1-.99-1z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Dasturchi bilan bog'lanish" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Border Height="1" Background="{DynamicResource Line}" Margin="4,6"/>
                                <TextBlock Text="XAVFLI AMALLAR" Foreground="{DynamicResource Ink3}" FontSize="11" FontWeight="Bold" Margin="10,4,10,2"/>
                                <Button Style="{StaticResource MenuRowDanger}" Command="{Binding RestoreDatabaseCommand}" Click="SettingsMenuItem_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Bazani zaxiradan tiklash…" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Border>
        <!-- ASOSIY ISH MAYDONI: Doimiy yuklangan Grid (0ms lahzalik almashish, qayta yuklanmaydi) -->
        <Grid Grid.Row="1">
            <views:CashierView DataContext="{Binding CashierVM}"
                               Visibility="{Binding DataContext.IsCashierSelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <views:InventoryView DataContext="{Binding InventoryVM}"
                                 Visibility="{Binding DataContext.IsInventorySelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <views:DebtsView DataContext="{Binding DebtsVM}"
                             Visibility="{Binding DataContext.IsDebtsSelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <views:ReportsView DataContext="{Binding ReportsVM}"
                               Visibility="{Binding DataContext.IsReportsSelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <views:SyncView DataContext="{Binding SyncVM}"
                            Visibility="{Binding DataContext.IsSyncSelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>

        <!-- QURILMA FAOL EMAS (AKTIVATSIYA OYNASI) OVERLAY -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="9999"
              Background="{DynamicResource Scrim}"
              Visibility="{Binding IsDeviceLocked, Converter={StaticResource BooleanToVisibilityConverter}}">
            
            <!-- Markaziy Asosiy Karta -->
            <Border Background="{DynamicResource Surface}" CornerRadius="24" BorderBrush="{DynamicResource Line}" BorderThickness="1.5"
                    Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.8" Color="#000000"/>
                </Border.Effect>
                
                <StackPanel HorizontalAlignment="Center">
                    <!-- App Logo (Bosganda 3 marta tez klik detektori) -->
                    <Border Width="80" Height="80" CornerRadius="20" Background="{DynamicResource Bg}"
                            BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" Cursor="Hand" Margin="0,0,0,16">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding LogoClickCommand}"/>
                        </Border.InputBindings>
                        <Image Source="Assets/app_logo.png" Width="68" Height="68"
                               RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Sarlavha -->
                    <TextBlock Text="Qurilma Faollashtirilmagan" Foreground="{DynamicResource Ink}" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8"/>
                    
                    <!-- Tavsif -->
                    <TextBlock Text="Dasturdan foydalanish uchun Admindan ruxsat oling yoki aktivatsiya kodini kiriting."
                               Foreground="{DynamicResource Ink2}" FontSize="14" LineHeight="20" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24"/>

                    <!-- Qurilma Parametrlari Qutisi -->
                    <Border Background="{DynamicResource Bg}" CornerRadius="14" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            Padding="16" Width="436" Margin="0,0,0,20">
                        <StackPanel>
                            <!-- Model -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="💻 Model: " Foreground="{DynamicResource Ink2}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DeviceModel}" Foreground="{DynamicResource Ink}" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- ID va Nusxalash -->
                            <TextBlock Text="Qurilma ID:" Foreground="{DynamicResource Ink2}" FontSize="12" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Grid.Column="0" Background="{DynamicResource Surface}" CornerRadius="8" Padding="10,6" Margin="0,0,8,0"
                                        BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                    <TextBlock Text="{Binding DeviceId}" Foreground="{DynamicResource AccentInk}" FontFamily="Consolas"
                                               FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Border>

                                <Button Grid.Column="1" Content="📋 Nusxalash"
                                        Command="{Binding CopyDeviceIdCommand}"
                                        Background="{DynamicResource Surface}" Foreground="{DynamicResource AccentInk}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                        FontWeight="SemiBold" FontSize="12" Padding="12,6" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
