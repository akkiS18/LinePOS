<Window x:Class="PosElectro.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:PosElectro.Desktop.Views"
        xmlns:vm="clr-namespace:PosElectro.Desktop.ViewModels"
        xmlns:services="clr-namespace:PosElectro.Desktop.Services"
        mc:Ignorable="d"
        Title="SMART kassa" 
        Icon="Assets/app_logo.png"
        Height="750" Width="1200" MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        InputLanguageManager.InputLanguage="en-US"
        InputLanguageManager.RestoreInputLanguage="True"
        Activated="Window_Activated"
        PreviewTextInput="Window_PreviewTextInput"
        PreviewKeyDown="Window_PreviewKeyDown">

<Window.Resources>
        <!-- Yuqori paneldagi bo'lim tugmasi (faol bo'lim Tag=True bilan belgilanadi) -->
        <Style x:Key="NavTab" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Sozlamalar tugmasi -->
        <Style x:Key="GearButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sozlamalar menyusi qatori -->
        <Style x:Key="MenuRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MenuRowDanger" TargetType="Button" BasedOn="{StaticResource MenuRowButton}">
            <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
            <Setter Property="Background" Value="{DynamicResource BadSoft}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="NavIc" TargetType="Path">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Yuqori Menyu Paneli -->
            <RowDefinition Height="56"/>
            <!-- Asosiy Ish Maydoni (Yagona Sahifa) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- YUQORI NAVIGATSIYA PANELI (maket: TopBar). Qayta qurilgan: yorug' tema shu panel ichida. -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,0">
            <Border.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/Theme.Light.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Border.Resources>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logotip: 32px "S" plitka + SMART -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Accent}" VerticalAlignment="Center">
                        <TextBlock Text="S" Foreground="{DynamicResource OnAccent}" FontWeight="ExtraBold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="SMART" Foreground="{DynamicResource Ink}" FontSize="17" FontWeight="ExtraBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Bo'limlar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource NavTab}" Command="{Binding NavigateCashierCommand}" Tag="{Binding IsCashierSelected}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                <Path Style="{StaticResource NavIc}" Data="M7 21a1 1 0 1 0 2 0a1 1 0 1 0-2 0 M18 21a1 1 0 1 0 2 0a1 1 0 1 0-2 0 M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
                            </Viewbox>
                            <TextBlock Text="Kassa" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavTab}" Command="{Binding NavigateInventoryCommand}" Tag="{Binding IsInventorySelected}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                <Path Style="{StaticResource NavIc}" Data="M21 8L12 3L3 8v8l9 5l9-5z M3 8l9 5l9-5 M12 13v8"/>
                            </Viewbox>
                            <TextBlock Text="Ombor" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavTab}" Command="{Binding NavigateDebtsCommand}" Tag="{Binding IsDebtsSelected}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                <Path Style="{StaticResource NavIc}" Data="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M5 7a4 4 0 1 0 8 0a4 4 0 1 0-8 0 M22 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75"/>
                            </Viewbox>
                            <TextBlock Text="Qarzlar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavTab}" Command="{Binding NavigateReportsCommand}" Tag="{Binding IsReportsSelected}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                <Path Style="{StaticResource NavIc}" Data="M3 3v18h18 M7 15l4-4l3 3l5-6"/>
                            </Viewbox>
                            <TextBlock Text="Hisobotlar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavTab}" Command="{Binding NavigateSyncCommand}" Tag="{Binding IsSyncSelected}"
                            ToolTip="{Binding LiveSyncStatusText}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                <Path Style="{StaticResource NavIc}" Data="M5 12.55a11 11 0 0 1 14 0 M8.5 16.1a6 6 0 0 1 7 0 M2 8.82a15 15 0 0 1 20 0 M12 20h.01"/>
                            </Viewbox>
                            <TextBlock Text="Wi-Fi Sinxron" VerticalAlignment="Center"/>
                            <!-- Ulangan telefonlar soni (faqat ulanish bo'lsa) -->
                            <Border Margin="8,0,0,0" Padding="8,2" CornerRadius="10" VerticalAlignment="Center" Background="{DynamicResource OkSoft}"
                                    Visibility="{Binding IsLiveSyncActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Ok}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LiveClientsCount}" Margin="4,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Ok}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Admin rejimi ochiq belgisi (PIN yoqilgan va qulf ochilgan bo'lsa) -->
                <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                        Command="{Binding LockAdminCommand}" Cursor="Hand" ToolTip="Yashirin ma'lumotlarni qayta yopish"
                        Foreground="{DynamicResource Warn}"
                        Visibility="{Binding ShowUnlockedChip, Source={x:Static services:AdminGate.Current}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="36">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                        <Path Style="{StaticResource NavIc}" Data="M6 11h12a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2z M8 11V7a4 4 0 0 1 7.9-1"/>
                                    </Viewbox>
                                    <TextBlock Text="Admin rejimi ochiq · Qulflash" Foreground="{DynamicResource Warn}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Warn}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- O'ng tomon: soat va sozlamalar menyusi -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ClockText}" FontSize="13" Foreground="{DynamicResource Ink2}" Margin="8,0,16,0" VerticalAlignment="Center"/>
                <Grid VerticalAlignment="Center">
                    <ToggleButton x:Name="SettingsToggle" Style="{StaticResource GearButton}" ToolTip="Sozlamalar" AutomationProperties.Name="Sozlamalar">
                        <Viewbox Width="18" Height="18">
                            <Path Style="{StaticResource NavIc}" Data="M9 12a3 3 0 1 0 6 0a3 3 0 1 0-6 0 M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                        </Viewbox>
                    </ToggleButton>
                    <Popup IsOpen="{Binding IsChecked, ElementName=SettingsToggle, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=SettingsToggle}" Placement="Custom"
                           CustomPopupPlacementCallback="SettingsPopup_Placement" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="312" Margin="24,8,24,40" Padding="6" CornerRadius="12" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.18" Color="#0F1B21"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="SOZLAMALAR" Foreground="{DynamicResource Ink3}" FontSize="11" FontWeight="Bold" Margin="10,6,10,2"/>
                                <Button Style="{StaticResource MenuRowButton}" Command="{Binding OpenCardTaxModalCommand}" Click="SettingsMenuItem_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M7.5 4C5.57 4 4 5.57 4 7.5S5.57 11 7.5 11 11 9.43 11 7.5 9.43 4 7.5 4zm0 5c-.83 0-1.5-.67-1.5-1.5S6.67 6 7.5 6s1.5.67 1.5 1.5S8.33 9 7.5 9zm9 6c-1.93 0-3.5 1.57-3.5 3.5s1.57 3.5 3.5 3.5 3.5-1.57 3.5-3.5-1.57-3.5-3.5-3.5zm0 5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm3.21-15.71a.996.996 0 0 0-1.41 0L4.29 18.29a.996.996 0 1 0 1.41 1.41L19.71 5.7a.996.996 0 0 0 0-1.41z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Karta solig'i foizi" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource MenuRowButton}" Command="{Binding ExportWarehouseCostReportCommand}" Click="SettingsMenuItem_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 2v3H5V5h14zm-8 5v4H5v-4h6zm2 0h6v4h-6v-4zm-2 6v4H5v-4h6zm2 0h6v4h-6v-4z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ombor tan narxi hisoboti (Excel)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource MenuRowButton}" Command="{Binding BackupDatabaseCommand}" Click="SettingsMenuItem_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M12 3C7.58 3 4 4.79 4 7v10c0 2.21 3.58 4 8 4s8-1.79 8-4V7c0-2.21-3.58-4-8-4zm0 2c3.87 0 6 1.5 6 2s-2.13 2-6 2-6-1.5-6-2 2.13-2 6-2zm6 12c0 .5-2.13 2-6 2s-6-1.5-6-2v-2.23c1.61.78 3.73 1.23 6 1.23s4.39-.45 6-1.23V17zm0-5c0 .5-2.13 2-6 2s-6-1.5-6-2v-2.23c1.61.78 3.73 1.23 6 1.23s4.39-.45 6-1.23V12z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Zaxira nusxa saqlash" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource MenuRowButton}" Command="{Binding OpenAdminPinSettingsCommand}" Click="SettingsMenuItem_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zM9 8V6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Admin PIN · yashirin ma'lumotlar" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource MenuRowButton}" Command="{Binding OpenContactModalCommand}" Click="SettingsMenuItem_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 0 0-1.01.24l-2.2 2.2a15.053 15.053 0 0 1-6.59-6.59l2.2-2.21a.96.96 0 0 0 .25-1.01A11.36 11.36 0 0 1 8.57 3.99c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1C3 13.93 11.07 22 21 22c.55 0 1-.45 1-1v-3.62c0-.55-.45-1-.99-1z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Dasturchi bilan bog'lanish" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Border Height="1" Background="{DynamicResource Line}" Margin="4,6"/>
                                <TextBlock Text="XAVFLI AMALLAR" Foreground="{DynamicResource Ink3}" FontSize="11" FontWeight="Bold" Margin="10,4,10,2"/>
                                <Button Style="{StaticResource MenuRowDanger}" Command="{Binding RestoreDatabaseCommand}" Click="SettingsMenuItem_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Bazani zaxiradan tiklash…" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
                </StackPanel>
            </Grid>
        </Border>
        <!-- ASOSIY ISH MAYDONI: Doimiy yuklangan Grid (0ms lahzalik almashish, qayta yuklanmaydi) -->
        <Grid Grid.Row="1">
            <views:CashierView DataContext="{Binding CashierVM}"
                               Visibility="{Binding DataContext.IsCashierSelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <views:InventoryView DataContext="{Binding InventoryVM}"
                                 Visibility="{Binding DataContext.IsInventorySelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <views:DebtsView DataContext="{Binding DebtsVM}"
                             Visibility="{Binding DataContext.IsDebtsSelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <views:ReportsView DataContext="{Binding ReportsVM}"
                               Visibility="{Binding DataContext.IsReportsSelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <views:SyncView DataContext="{Binding SyncVM}"
                            Visibility="{Binding DataContext.IsSyncSelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>

        <!-- QURILMA FAOL EMAS (AKTIVATSIYA OYNASI) OVERLAY -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="9999"
              Background="{DynamicResource Scrim}"
              Visibility="{Binding IsDeviceLocked, Converter={StaticResource BooleanToVisibilityConverter}}">
            
            <!-- Markaziy Asosiy Karta -->
            <Border Background="{DynamicResource Surface}" CornerRadius="24" BorderBrush="{DynamicResource Line}" BorderThickness="1.5"
                    Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.8" Color="#000000"/>
                </Border.Effect>
                
                <StackPanel HorizontalAlignment="Center">
                    <!-- App Logo (Bosganda 3 marta tez klik detektori) -->
                    <Border Width="80" Height="80" CornerRadius="20" Background="{DynamicResource Bg}"
                            BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" Cursor="Hand" Margin="0,0,0,16">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding LogoClickCommand}"/>
                        </Border.InputBindings>
                        <Image Source="Assets/app_logo.png" Width="68" Height="68"
                               RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Sarlavha -->
                    <TextBlock Text="Qurilma Faollashtirilmagan" Foreground="{DynamicResource Ink}" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8"/>
                    
                    <!-- Tavsif -->
                    <TextBlock Text="Dasturdan foydalanish uchun Admindan ruxsat oling yoki aktivatsiya kodini kiriting."
                               Foreground="{DynamicResource Ink2}" FontSize="14" LineHeight="20" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24"/>

                    <!-- Qurilma Parametrlari Qutisi -->
                    <Border Background="{DynamicResource Bg}" CornerRadius="14" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            Padding="16" Width="436" Margin="0,0,0,20">
                        <StackPanel>
                            <!-- Model -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="💻 Model: " Foreground="{DynamicResource Ink2}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DeviceModel}" Foreground="{DynamicResource Ink}" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- ID va Nusxalash -->
                            <TextBlock Text="Qurilma ID:" Foreground="{DynamicResource Ink2}" FontSize="12" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Grid.Column="0" Background="{DynamicResource Surface}" CornerRadius="8" Padding="10,6" Margin="0,0,8,0"
                                        BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                    <TextBlock Text="{Binding DeviceId}" Foreground="{DynamicResource AccentInk}" FontFamily="Consolas"
                                               FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Border>

                                <Button Grid.Column="1" Content="📋 Nusxalash"
                                        Command="{Binding CopyDeviceIdCommand}"
                                        Background="{DynamicResource Surface}" Foreground="{DynamicResource AccentInk}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                        FontWeight="SemiBold" FontSize="12" Padding="12,6" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <!-- Nusxalandi bildirishnomasi -->
                            <Border Background="{DynamicResource OkSoft}" CornerRadius="6" Padding="8,4" Margin="0,8,0,0"
                                    Visibility="{Binding IsCopiedNoticeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="✓ Qurilma ID nusxalandi! Endi buni Adminga yuboring." 
                                           Foreground="{DynamicResource Ok}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </Border>

                            <!-- Masofaviy status -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Masofaviy ruxsat kutilmoqda (Admin telefondan yoqishi mumkin)..." 
                                           Foreground="{DynamicResource AccentInk}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Aktivatsiya Kodini Kiritish Tugmasi -->
                    <Button Content="🔑 Aktivatsiya Kodini Kiritish"
                            Command="{Binding OpenPinModalCommand}"
                            Style="{StaticResource ModernButton}"
                            Width="436" Height="44" FontSize="15" FontWeight="Bold"/>

                    <!-- Dasturchi bilan bog'lanish havolasi -->
                    <Button Command="{Binding OpenContactModalCommand}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📞 " FontSize="13"/>
                            <TextBlock Text="Ishlab chiqaruvchi bilan bog'lanish" 
                                       Foreground="{DynamicResource AccentInk}" FontSize="13" FontWeight="SemiBold" TextDecorations="Underline"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- PIN KODNI KIRITISH MODAL OYNASI -->
            <Grid Panel.ZIndex="10000" Background="{DynamicResource Scrim}"
                  Visibility="{Binding IsPinModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="{DynamicResource Surface}" CornerRadius="20" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                        Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.9" Color="#000000"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource AccentHover}" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                    <TextBlock Text="🛡️" FontFamily="Segoe UI Emoji" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Aktivatsiya Kodi" Foreground="{DynamicResource Ink}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Command="{Binding ClosePinModalCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,2">
                                <TextBlock Text="✕" Foreground="{DynamicResource Ink2}" FontSize="16" FontWeight="Bold"/>
                            </Button>
                        </Grid>

                        <Separator Background="{DynamicResource Line}" Margin="0,0,0,14"/>

                        <TextBlock Text="Qurilmani ishga tushirish uchun do'kon aktivatsiya kodini kiriting:"
                                   Foreground="{DynamicResource Ink2}" FontSize="13" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- PIN / Kod Kiritish Qatori (Xavfsiz / Ko'zcha tugmasi bilan) -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>

                            <!-- Kod maydoni (Yashirin - Default holat) -->
                            <PasswordBox x:Name="PinPasswordBox"
                                         Grid.Column="0"
                                         Style="{StaticResource ModernPasswordBox}"
                                         FontSize="22" FontWeight="Bold"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Height="52"
                                         MaxLength="6"
                                         PasswordChanged="PinPasswordBox_PasswordChanged"
                                         Visibility="{Binding PasswordBoxVisibility}"/>

                            <!-- Kod maydoni (Ko'rinadigan - Ochiq holat) -->
                            <TextBox x:Name="PinTextBox"
                                     Grid.Column="0"
                                     Style="{StaticResource ModernTextBox}"
                                     FontSize="22" FontWeight="Bold"
                                     TextAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Height="52"
                                     MaxLength="6"
                                     TextChanged="PinTextBox_TextChanged"
                                     Visibility="{Binding TextBoxVisibility}"/>

                            <!-- Ko'zcha tugmasi (Parolni ko'rsatish/yashirish) -->
                            <Button Grid.Column="2"
                                    Command="{Binding TogglePinVisibilityCommand}"
                                    ToolTip="{Binding EyeButtonTooltip}"
                                    Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                    Height="52" Cursor="Hand" Padding="0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="8">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                            <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource Surface}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding EyeButtonIcon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <!-- Xatolik xabari -->
                        <TextBlock Text="{Binding PinErrorMessage}" Foreground="{DynamicResource Bad}" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,0,0,14" TextWrapping="Wrap"/>

                        <!-- Tugmalar -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Bekor qilish"
                                    Command="{Binding ClosePinModalCommand}"
                                    Background="{DynamicResource Line}" Foreground="{DynamicResource Ink2}"
                                    Height="42" FontSize="14" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Grid.Column="2" Content="Faollashtirish"
                                    Command="{Binding SubmitPinCommand}"
                                    IsDefault="True"
                                    Style="{StaticResource ModernButton}"
                                    Height="42" FontSize="14" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ISHLAB CHIQARUVCHI BILAN BOG'LANISH MODAL OYNASI (OK MODAL) -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="100000"
              Background="{DynamicResource Scrim}"
              Visibility="{Binding IsContactModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="{DynamicResource Surface}" CornerRadius="20" BorderBrush="{DynamicResource Ok}" BorderThickness="1.5"
                    Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.9" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource OkSoft}" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0" BorderBrush="{DynamicResource Ok}" BorderThickness="1">
                                <Path Data="M20 18c1.1 0 1.99-.9 1.99-2L22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 6h16v10H4V6z" 
                                      Fill="{DynamicResource OkSolid}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Ishlab chiqaruvchi" Foreground="{DynamicResource Ink}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Texnik yordam va litsenziya bo'yicha" Foreground="{DynamicResource Ink2}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Command="{Binding CloseContactModalCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,2">
                            <TextBlock Text="✕" Foreground="{DynamicResource Ink2}" FontSize="16" FontWeight="Bold"/>
                        </Button>
                    </Grid>

                    <Separator Background="{DynamicResource Line}" Margin="0,0,0,16"/>

                    <!-- Aloqa Ma'lumotlari Qutisi -->
                    <Border Background="{DynamicResource Bg}" CornerRadius="12" Padding="16" Margin="0,0,0,20" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <StackPanel>
                            <!-- Telefon raqam -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"
                                      Fill="{DynamicResource OkSolid}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Telefon raqam:" Foreground="{DynamicResource Ink2}" FontSize="11"/>
                                    <TextBlock Text="+998 95 720 88 33" Foreground="{DynamicResource Ink}" FontSize="15" FontWeight="Bold"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Nusxalash"
                                        Command="{Binding CopyPhoneCommand}"
                                        Background="{DynamicResource Surface}" Foreground="{DynamicResource Ok}" BorderBrush="{DynamicResource Ok}" BorderThickness="1"
                                        FontSize="11" FontWeight="SemiBold" Padding="10,5" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <Separator Background="{DynamicResource Surface}" Margin="0,0,0,14"/>

                            <!-- Telegram -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.56 2.94-1.28 4.91-2.12 5.9-2.54 2.81-1.17 3.39-1.38 3.77-1.38.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06-.01.19-.03.37z"
                                      Fill="{DynamicResource Accent}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Telegram:" Foreground="{DynamicResource Ink2}" FontSize="11"/>
                                    <TextBlock Text="@S18_2003" Foreground="{DynamicResource AccentInk}" FontSize="15" FontWeight="Bold"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Ochish"
                                        Command="{Binding OpenTelegramCommand}"
                                        Background="{DynamicResource Surface}" Foreground="{DynamicResource AccentInk}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                        FontSize="11" FontWeight="SemiBold" Padding="14,5" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- OK Tugmasi -->
                    <Button Content="Tushundim (OK)" 
                            Command="{Binding CloseContactModalCommand}"
                            IsDefault="True"
                            Style="{StaticResource ModernButton}"
                            Height="42" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- KARTA SOLIG'I FOIZINI SOZLASH MODALI -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="100000"
              Background="{DynamicResource Scrim}"
              Visibility="{Binding IsCardTaxModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                    CornerRadius="16" Width="380" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.9" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource OkSoft}" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0" BorderBrush="{DynamicResource Ok}" BorderThickness="1">
                                <TextBlock Text="%" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Ok}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Karta solig'i foizi" Foreground="{DynamicResource Ink}" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="Karta to'lovlaridan ushlanadigan foiz" Foreground="{DynamicResource Ink2}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Command="{Binding CloseCardTaxModalCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,2">
                            <TextBlock Text="✕" Foreground="{DynamicResource Ink2}" FontSize="16" FontWeight="Bold"/>
                        </Button>
                    </Grid>

                    <Separator Background="{DynamicResource Line}" Margin="0,0,0,16"/>

                    <!-- Foiz input -->
                    <TextBlock Text="Ushlab qolinadigan foiz (%):" Foreground="{DynamicResource Ink}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding CardTaxRateInput, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="16" FontWeight="Bold" Padding="12,10" Margin="0,0,0,6"/>

                    <TextBlock Text="{Binding CardTaxErrorMessage}" Foreground="{DynamicResource Bad}" FontSize="12" Margin="0,0,0,10"
                               Visibility="{Binding CardTaxErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <TextBlock Text="Standart miqdor: 1.8%. Bu foiz karta orqali to'langan savdolardan hisoblanadi va hisobotlarda sof foydani to'g'ri ko'rsatish uchun xarajat sifatida hisobga olinadi."
                               Foreground="{DynamicResource Ink3}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <!-- Tugmalar -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Bekor qilish"
                                Command="{Binding CloseCardTaxModalCommand}"
                                Background="{DynamicResource Line}" Style="{StaticResource ModernButton}" Margin="0,0,6,0" Padding="0,10"/>
                        <Button Grid.Column="1" Content="Saqlash"
                                Command="{Binding SaveCardTaxCommand}"
                                Style="{StaticResource SuccessButton}" Margin="6,0,0,0" Padding="0,10" IsDefault="True"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- PASTKI CHAP TOMONDAGI STICKY PROGRESS BAR VIDJETI        -->
        <!-- ======================================================== -->
        <Border Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="24,0,0,24" Panel.ZIndex="99999" Width="330" CornerRadius="12" Padding="14,12"
                Visibility="{Binding PrintService.IsStickyVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Surface}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PrintService.IsCompleted}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource OkSoft}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Ok}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PrintService.HasError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BadSoft}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Bad}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.8"/>
            </Border.Effect>
            <StackPanel>
                <!-- Yuqori qator: Ikonka, Mahsulot nomi va [X] Yopish tugmasi -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ikonka -->
                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PrintService.IsCompleted}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource OkSolid}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="🖨️"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PrintService.IsCompleted}" Value="True">
                                            <Setter Property="Text" Value="✓"/>
                                            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Sarlavha / Mahsulot nomi -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PrintService.ProductName}" Foreground="{DynamicResource Ink}" FontSize="13" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontSize="11" Foreground="{DynamicResource Ink2}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Orqa fonda chop etilmoqda..."/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PrintService.IsCompleted}" Value="True">
                                            <Setter Property="Text" Value="Stikerlar tayyor"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Ok}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PrintService.IsCancelled}" Value="True">
                                            <Setter Property="Text" Value="Chop etish to'xtatildi"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- [X] Yopish tugmasi -->
                    <Button Grid.Column="2" Command="{Binding PrintService.CloseStickyCommand}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,2" VerticalAlignment="Top">
                        <TextBlock Text="✕" Foreground="{DynamicResource Ink2}" FontSize="14" FontWeight="Bold"/>
                    </Button>
                </Grid>

                <!-- Mini Progress Bar (faqat chop etilayotganda ko'rinadi) -->
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding PrintService.ProgressPercentage, Mode=OneWay}"
                             Height="6" Background="{DynamicResource Line}" Foreground="{DynamicResource AccentInk}" BorderThickness="0" Margin="0,0,0,6">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PrintService.IsCompleted}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                                <Grid x:Name="PART_Track">
                                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>

                <!-- Pastki qator: Nechtasi chiqdi / To'xtatish yoki Tayyor nishoni -->
                <Grid>
                    <!-- Chop etilayotgandagi holat -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PrintService.IsCompleted}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Foreground="{DynamicResource AccentInk}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                            <Run Text="{Binding PrintService.CurrentCount}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding PrintService.TotalCount}"/>
                            <Run Text="dona ("/>
                            <Run Text="{Binding PrintService.ProgressPercentage, StringFormat={}{0:0}}"/>
                            <Run Text="%)"/>
                        </TextBlock>

                        <Button Grid.Column="1" Content="To'xtatish" Command="{Binding PrintService.CancelPrintCommand}"
                                Background="{DynamicResource Line}" Foreground="{DynamicResource Bad}" FontSize="10" FontWeight="SemiBold"
                                Padding="8,2" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Yakunlangandagi (Tayyor) holat -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PrintService.IsCompleted}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Foreground="{DynamicResource Ok}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                            <Run Text="Chop etildi: "/>
                            <Run Text="{Binding PrintService.TotalCount}" FontWeight="Bold"/>
                            <Run Text=" dona"/>
                        </TextBlock>

                        <Border Grid.Column="1" Background="{DynamicResource OkSolid}" CornerRadius="4" Padding="8,2">
                            <TextBlock Text="Tayyor" Foreground="{DynamicResource OnAccent}" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- STIKER CHOP ETISH PROGRESS MODALI (KATTA OYNA)           -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="100005"
              Background="{DynamicResource Scrim}"
              Visibility="{Binding PrintService.IsModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                    CornerRadius="16" Width="440" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.9" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource Accent}" CornerRadius="10" Width="42" Height="42" Margin="0,0,12,0" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                                <TextBlock Text="🖨️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Stikerlar chop etilmoqda" Foreground="{DynamicResource Ink}" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="{Binding PrintService.ProductName}" Foreground="{DynamicResource Ink2}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Command="{Binding PrintService.CloseModalCommand}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,2">
                            <TextBlock Text="✕" Foreground="{DynamicResource Ink2}" FontSize="16" FontWeight="Bold"/>
                        </Button>
                    </Grid>

                    <Separator Background="{DynamicResource Line}" Margin="0,0,0,18"/>

                    <!-- Nechtasi chiqdi info -->
                    <Grid Margin="0,0,0,8">
                        <TextBlock HorizontalAlignment="Left" Foreground="{DynamicResource Ink}" FontSize="14" FontWeight="SemiBold">
                            <Run Text="Nechtasi chiqdi: " Foreground="{DynamicResource Ink2}"/>
                            <Run Text="{Binding PrintService.CurrentCount}" FontWeight="Bold" Foreground="{DynamicResource AccentInk}"/>
                            <Run Text=" / " Foreground="{DynamicResource Ink3}"/>
                            <Run Text="{Binding PrintService.TotalCount}" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                            <Run Text=" dona" Foreground="{DynamicResource Ink2}"/>
                        </TextBlock>

                        <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource AccentInk}" FontSize="14" FontWeight="Bold">
                            <Run Text="{Binding PrintService.ProgressPercentage, StringFormat={}{0:0}}"/>
                            <Run Text="%"/>
                        </TextBlock>
                    </Grid>

                    <!-- Katta Progress Bar -->
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding PrintService.ProgressPercentage, Mode=OneWay}"
                                 Height="12" Background="{DynamicResource Bg}" Foreground="{DynamicResource AccentInk}" BorderThickness="0" Margin="0,0,0,16">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" ClipToBounds="True">
                                    <Grid x:Name="PART_Track">
                                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="6" HorizontalAlignment="Left"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>

                    <!-- Holat xabarlari -->
                    <!-- 1. Bajarildi -->
                    <Border Background="{DynamicResource OkSoft}" BorderBrush="{DynamicResource Ok}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PrintService.IsCompleted}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="✅ Barcha stikerlar muvaffaqiyatli chop etildi!" Foreground="{DynamicResource Ok}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center"/>
                    </Border>

                    <!-- 2. Bekor qilindi -->
                    <Border Background="{DynamicResource BadSoft}" BorderBrush="{DynamicResource Bad}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PrintService.IsCancelled}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="⚠️ Chop etish foydalanuvchi tomonidan to'xtatildi." Foreground="{DynamicResource Bad}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center"/>
                    </Border>

                    <!-- 3. Xatolik -->
                    <Border Background="{DynamicResource BadSoft}" BorderBrush="{DynamicResource Bad}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PrintService.HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding PrintService.StatusText}" Foreground="{DynamicResource Bad}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center"/>
                    </Border>

                    <!-- Tugmalar -->
                    <!-- Chop etilayotgandagi tugmalar -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PrintService.IsPrinting}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="⬇️ Orqa fonga o'tkazish"
                                Command="{Binding PrintService.SendToBackgroundCommand}"
                                Background="{DynamicResource Accent}" Style="{StaticResource ModernButton}" Height="42" FontSize="13" FontWeight="Bold"/>

                        <Button Grid.Column="2" Content="⏹ Bekor qilish"
                                Command="{Binding PrintService.CancelPrintCommand}"
                                Background="{DynamicResource Line}" Foreground="{DynamicResource Bad}" Style="{StaticResource ModernButton}" Height="42" Padding="16,0" FontSize="13" FontWeight="Bold"/>
                    </Grid>

                    <!-- Chop etish yakunlangandagi / to'xtatilgandagi tugma -->
                    <Button Content="Yopish (OK)"
                            Command="{Binding PrintService.CloseModalCommand}"
                            Height="42" FontSize="14" FontWeight="Bold" IsDefault="True">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PrintService.IsPrinting}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PrintService.IsCompleted}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource OkSolid}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    
        <!-- ============================================================== -->
        <!-- MAHSULOT RASMINI KATTA KO'RISH (LIGHTBOX MODAL) -->
        <!-- ============================================================== -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="1000"
              Visibility="{Binding IsImagePreviewOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!-- To'q yarim-shaffof fon (fonni bosganda yopiladi) -->
            <Border Background="{DynamicResource Scrim}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding CloseImagePreviewCommand}"/>
                </Border.InputBindings>
            </Border>

            <!-- Markaziy Rasm Konteyneri -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1.5"
                    CornerRadius="16" MaxWidth="1100" MaxHeight="780" Margin="40">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.8" ShadowDepth="10"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Yuqori qator: Tovar nomi va X yopish tugmasi -->
                    <Border Grid.Row="0" Background="{DynamicResource Surface}" CornerRadius="16,16,0,0" Padding="20,14" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" 
                                      Stroke="{DynamicResource AccentInk}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding PreviewImageTitle}" Foreground="{DynamicResource Ink}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="850"/>
                            </StackPanel>

                            <!-- X Yopish tugmasi -->
                            <Button Grid.Column="1" Command="{Binding CloseImagePreviewCommand}"
                                    ToolTip="Yopish (ESC)"
                                    Width="36" Height="36" Padding="0" Cursor="Hand"
                                    Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Foreground="{DynamicResource Ink}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                </Button.Resources>
                                <Path Data="M6 18L18 6M6 6l12 12" Stroke="{DynamicResource Ink}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Asosiy rasm maydoni -->
                    <Border Grid.Row="1" Background="{DynamicResource Bg}" CornerRadius="0,0,16,16" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="{Binding PreviewImagePath}"
                               Stretch="Uniform"
                               MaxWidth="1040" MaxHeight="680"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>