<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- SMART kassa — qorong'i tema rang tokenlari.
         Barcha XAML'da {DynamicResource <kalit>} orqali ishlatiladi, shuning uchun
         keyinchalik Theme.Light.xaml bilan almashtirish mumkin. -->

    <!-- Sirtlar -->
    <SolidColorBrush x:Key="Bg"          Color="#0B1215"/>
    <SolidColorBrush x:Key="Surface"     Color="#121B1F"/>
    <SolidColorBrush x:Key="Surface2"    Color="#182328"/>

    <!-- Chiziqlar -->
    <SolidColorBrush x:Key="LineSoft"    Color="#1C282E"/>
    <SolidColorBrush x:Key="Line"        Color="#24323A"/>
    <SolidColorBrush x:Key="LineStrong"  Color="#34454E"/>

    <!-- Matn -->
    <SolidColorBrush x:Key="Ink"         Color="#E7EEF1"/>
    <SolidColorBrush x:Key="Ink2"        Color="#A1B1BA"/>
    <SolidColorBrush x:Key="Ink3"        Color="#8A9BA4"/>
    <SolidColorBrush x:Key="OnAccent"    Color="#FFFFFF"/>

    <!-- Yagona aksent (teal) -->
    <SolidColorBrush x:Key="Accent"      Color="#0E7A8F"/>
    <SolidColorBrush x:Key="AccentHover" Color="#12899F"/>
    <SolidColorBrush x:Key="AccentInk"   Color="#5CC4D6"/>
    <SolidColorBrush x:Key="AccentSoft"  Color="#11313A"/>
    <SolidColorBrush x:Key="AccentRing"  Color="#2E5CC4D6"/>
    <SolidColorBrush x:Key="OnAccentChip" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="IllusBg"     Color="#172328"/>
    <!-- Chek qog'ozi: ikkala temada ham oq qog'oz, qora matn -->
    <SolidColorBrush x:Key="PaperBg"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PaperInk"    Color="#111111"/>
    <SolidColorBrush x:Key="PaperRule"   Color="#999999"/>
    <SolidColorBrush x:Key="ToastBg"     Color="#E7EEF1"/>
    <SolidColorBrush x:Key="ToastFg"     Color="#0F1B21"/>
    <SolidColorBrush x:Key="ToastBtnBg"  Color="#0F1B21"/>
    <SolidColorBrush x:Key="ToastBtnFg"  Color="#FFFFFF"/>
    <!-- Fondagi jarayon vidjeti (stiker chop etish): yo'lak, to'ldirish, tugma chizig'i -->
    <SolidColorBrush x:Key="ToastTrack"  Color="#2E0F1B21"/>
    <SolidColorBrush x:Key="ToastFill"   Color="#0B6477"/>
    <SolidColorBrush x:Key="ToastLine"   Color="#4D0F1B21"/>
    <SolidColorBrush x:Key="ModalShadow" Color="#000000"/>

    <!-- Holat ranglari (faqat holat uchun) -->
    <SolidColorBrush x:Key="Ok"          Color="#5BD38A"/>
    <SolidColorBrush x:Key="OkSolid"     Color="#157A3B"/>
    <SolidColorBrush x:Key="OkSoft"      Color="#12291C"/>
    <SolidColorBrush x:Key="OkLine"      Color="#1F4D31"/>
    <SolidColorBrush x:Key="Warn"        Color="#F2B35A"/>
    <SolidColorBrush x:Key="WarnSolid"   Color="#B45309"/>
    <SolidColorBrush x:Key="WarnSoft"    Color="#2B2112"/>
    <SolidColorBrush x:Key="WarnLine"    Color="#5A4220"/>
    <SolidColorBrush x:Key="Bad"         Color="#F58A8A"/>
    <SolidColorBrush x:Key="BadSolid"    Color="#C21F1F"/>
    <SolidColorBrush x:Key="BadSoft"     Color="#301819"/>
    <SolidColorBrush x:Key="BadLine"     Color="#5C2A2B"/>

    <!-- Modal orqa fon -->
    <SolidColorBrush x:Key="Scrim"       Color="#99000000"/>
    <!-- Windows standart elementlari (ro'yxat, kengaytirgich, scrollbar va h.k.) tizim ranglaridan foydalanadi.
         Ularni shu temaga bog'laymiz, aks holda qorong'i temada qora matn / oq doira bo'lib qoladi. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E7EEF1"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E7EEF1"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#121B1F"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#182328"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#182328"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#121B1F"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#34454E"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#8A9BA4"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0E7A8F"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#182328"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E7EEF1"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#121B1F"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E7EEF1"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#121B1F"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#E7EEF1"/>
</ResourceDictionary>
