<Window x:Class="PosElectro.Desktop.Views.BarcodePrintDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shtrix-kod etiketka chop etish" Height="620" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0F172A">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content (Preview + Settings) -->
            <RowDefinition Height="*"/>
            <!-- Status message -->
            <RowDefinition Height="Auto"/>
            <!-- Action buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Sarlavha -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#134E4A" CornerRadius="8" Padding="6,6" Margin="0,0,10,0">
                    <TextBlock Text="🏷️" FontSize="18" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="Shtrix-kod Etiketka Chop Etish" Foreground="#F8FAFC" FontSize="17" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtPrinterStatus" Text="🔍 Printer holati tekshirilmoqda..." Foreground="#38BDF8" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 2. Asosiy Maydon: Chapda Jonli Preview, O'ngda Sozlamalar -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <!-- Chap: Jonli Stiker Ko'rinishi (Preview) -->
                <ColumnDefinition Width="290"/>
                <!-- O'ng: Nusxalar va Elementlar sozlamasi -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CHAP: JONLI PREVIEW BLOKI -->
            <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,14,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="JONLI KO'RINISH (PREVIEW)" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                    <!-- Oq Fonli Termostiker modeli -->
                    <Border x:Name="StickerCard" Background="White" CornerRadius="6" Padding="8,10" 
                            Width="220" MinHeight="155" HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel x:Name="PreviewContentPanel" HorizontalAlignment="Center">
                            <!-- Mahsulot nomi (Kattaroq) -->
                            <TextBlock x:Name="PreviewName" Text="Mahsulot nomi" Foreground="#0F172A" FontSize="14" FontWeight="Bold" 
                                       TextAlignment="Center" TextWrapping="Wrap" MaxHeight="45" Margin="0,4,0,3"/>

                            <!-- Shtrix-kod rasmi -->
                            <StackPanel x:Name="PreviewBarcodePanel" HorizontalAlignment="Center" Margin="0,2,0,3">
                                <Image x:Name="ImgBarcode" Height="42" Width="180" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <TextBlock x:Name="PreviewBarcodeText" Text="200000000000" Foreground="#0F172A" 
                                           FontFamily="Consolas" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Sotish Narxi -->
                            <TextBlock x:Name="PreviewPrice" Text="0 SO'M" Foreground="#0F172A" FontSize="13" FontWeight="Bold" 
                                       HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="TxtLabelSizeCaption" Text="40 x 30 mm (Standart)" Foreground="#64748B" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- O'NG: NUSXALAR VA MOSLASHUVCHAN ELEMENTLAR -->
            <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel>
                    <!-- Printerni tanlash -->
                    <TextBlock Text="🖨️ Printer (Xprinter XP-365B):" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbPrinters" Height="34" FontSize="12" Margin="0,0,0,10" 
                              SelectionChanged="CmbPrinters_SelectionChanged"/>

                    <!-- Stiker o'lchamini tanlash -->
                    <TextBlock Text="📐 Stiker qog'oz o'lchami:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbLabelSize" Height="34" FontSize="12" Margin="0,0,0,10" 
                              SelectionChanged="CmbLabelSize_SelectionChanged"/>

                    <!-- Gorizontal siljitish (Chap/O'ng) -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="↔️ Siljitish (Chap/O'ng):" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="◀" Click="BtnOffsetLeft_Click"
                                    Style="{StaticResource ModernButton}" Width="30" Height="28" FontSize="11" Padding="0" Margin="0,0,4,0" ToolTip="0.5 mm chapga surish"/>
                            <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8,4" MinWidth="58">
                                <TextBlock x:Name="TxtOffset" Text="0.0 mm" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>
                            <Button Content="▶" Click="BtnOffsetRight_Click"
                                    Style="{StaticResource ModernButton}" Width="30" Height="28" FontSize="11" Padding="0" Margin="4,0,0,0" ToolTip="0.5 mm o'ngga surish"/>
                            <Button Content="↺" Click="BtnOffsetReset_Click"
                                    Background="#334155" Foreground="#94A3B8" Style="{StaticResource ModernButton}" Width="26" Height="28" FontSize="11" Padding="0" Margin="4,0,0,0" ToolTip="0 mm ga qaytarish"/>
                        </StackPanel>
                    </Grid>

                    <!-- 1. Nusxalar soni -->
                    <TextBlock Text="Chop etiladigan nusxalar soni:" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="42"/>
                        </Grid.ColumnDefinitions>

                        <!-- Minus -->
                        <Button Grid.Column="0" Content="-" Click="BtnMinus_Click"
                                Style="{StaticResource ModernButton}" Height="38" FontSize="18" FontWeight="Bold"/>

                        <!-- Input -->
                        <TextBox x:Name="TxtCopies" Grid.Column="1" Text="1" 
                                 Style="{StaticResource ModernTextBox}" Height="38"
                                 FontSize="16" FontWeight="Bold" TextAlignment="Center" Margin="6,0"
                                 Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 Foreground="#FFFFFF" Background="#0F172A" CaretBrush="#2DD4BF"
                                 TextChanged="TxtCopies_TextChanged"/>

                        <!-- Plus -->
                        <Button Grid.Column="2" Content="+" Click="BtnPlus_Click"
                                Style="{StaticResource ModernButton}" Height="38" FontSize="18" FontWeight="Bold"/>
                    </Grid>

                    <!-- Tezkor tugmalar -->
                    <WrapPanel Margin="0,0,0,14">
                        <Button Content="1 dona" Click="BtnQuickQty_Click" Tag="1"
                                Background="#334155" Foreground="#F8FAFC" Style="{StaticResource ModernButton}" 
                                Padding="10,4" Margin="0,0,6,6" FontSize="11"/>
                        <Button Content="5 dona" Click="BtnQuickQty_Click" Tag="5"
                                Background="#334155" Foreground="#F8FAFC" Style="{StaticResource ModernButton}" 
                                Padding="10,4" Margin="0,0,6,6" FontSize="11"/>
                        <Button Content="10 dona" Click="BtnQuickQty_Click" Tag="10"
                                Background="#334155" Foreground="#F8FAFC" Style="{StaticResource ModernButton}" 
                                Padding="10,4" Margin="0,0,6,6" FontSize="11"/>
                        <Button x:Name="BtnStockQty" Content="📦 Qoldiqcha (0)" Click="BtnStockQty_Click"
                                Background="#0F3642" BorderBrush="#0B6477" BorderThickness="1" Foreground="#2DD4BF" 
                                Style="{StaticResource ModernButton}" Padding="10,4" Margin="0,0,6,6" FontSize="11"/>
                    </WrapPanel>

                    <Separator Background="#334155" Margin="0,0,0,12"/>

                    <!-- 2. Moslashuvchan Elementlar (Toggles) -->
                    <TextBlock Text="Stikerda nimalar ko'rinsin?" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <!-- Checkbox: Mahsulot nomi -->
                    <CheckBox x:Name="ChkShowName" Content="Mahsulot nomi" IsChecked="True" 
                              Foreground="#E2E8F0" FontSize="13" Margin="0,0,0,8"
                              Checked="OnElementVisibilityChanged" Unchecked="OnElementVisibilityChanged"/>

                    <!-- Checkbox: Shtrix-kod va raqami -->
                    <CheckBox x:Name="ChkShowBarcode" Content="Shtrix-kod chiziqlari va raqami" IsChecked="True" 
                              Foreground="#E2E8F0" FontSize="13" Margin="0,0,0,8"
                              Checked="OnElementVisibilityChanged" Unchecked="OnElementVisibilityChanged"/>

                    <!-- Checkbox: Sotish narxi -->
                    <CheckBox x:Name="ChkShowPrice" Content="Sotish narxi (so'mda)" IsChecked="True" 
                              Foreground="#E2E8F0" FontSize="13" Margin="0,0,0,8"
                              Checked="OnElementVisibilityChanged" Unchecked="OnElementVisibilityChanged"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Status xabari -->
        <TextBlock x:Name="TxtStatus" Grid.Row="2" Text="" Foreground="#10B981" FontSize="12" 
                   Margin="0,0,0,10" HorizontalAlignment="Center" FontWeight="SemiBold" Visibility="Collapsed"/>

        <!-- 4. Tugmalar qatori -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <!-- Bekor qilish -->
                <ColumnDefinition Width="Auto"/>
                <!-- Oraliq -->
                <ColumnDefinition Width="*"/>
                <!-- 1 dona sinov -->
                <ColumnDefinition Width="Auto"/>
                <!-- Chop etish -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Bekor qilish -->
            <Button Grid.Column="0" Content="Bekor qilish" Click="BtnCancel_Click"
                    Background="#334155" Foreground="White" Style="{StaticResource ModernButton}" 
                    Padding="18,10" Height="42"/>

            <!-- 1 dona sinov (Test Print) -->
            <Button Grid.Column="2" Content="🖨️ 1 dona sinov" Click="BtnTestPrint_Click"
                    Background="#0F3642" BorderBrush="#0B6477" BorderThickness="1.5" Foreground="#2DD4BF" 
                    Style="{StaticResource ModernButton}" Padding="16,10" Height="42" Margin="0,0,10,0"/>

            <!-- Asosiy Chop Etish -->
            <Button x:Name="BtnPrint" Grid.Column="3" Content="🖨️ Chop etish (1 ta)" Click="BtnPrint_Click"
                    Style="{StaticResource SuccessButton}" Padding="22,10" Height="42" FontSize="14" FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>
