<Window x:Class="PosElectro.Desktop.Views.BarcodePrintDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stiker chop etish" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <!-- Maket 2.6 / 2.7: stiker chop etish. Oyna egasini qoplaydi (Scrim), markazda 900×640 karta. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/SmartControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Kichik tanlov tugmasi (Hammasiga: 1 / 5 / 10 / Qoldiq soni) -->
            <Style x:Key="MiniChip" TargetType="Button" BasedOn="{StaticResource ChoiceChip}">
                <Setter Property="Height" Value="32"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                <Setter Property="Margin" Value="0,0,6,6"/>
            </Style>
            <!-- − / + va siljitish tugmalari -->
            <Style x:Key="SqBtn" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
            </Style>
            <!-- Segment tugmasi (SegTab, bir oz past) -->
            <Style x:Key="Seg" TargetType="Button" BasedOn="{StaticResource SegTab}">
                <Setter Property="Height" Value="36"/>
            </Style>
            <!-- Belgilash katagi: 20px, radius 5, matn bilan -->
            <Style x:Key="Check" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="Margin" Value="0,0,18,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="box" Width="20" Height="20" CornerRadius="5" Background="{DynamicResource Surface}"
                                        BorderBrush="{DynamicResource LineStrong}" BorderThickness="1.5" VerticalAlignment="Center">
                                    <Viewbox x:Name="tick" Width="14" Height="14" Visibility="Collapsed">
                                        <Path Data="M5 12l5 5l9-10" Width="24" Height="24" Stretch="None" Stroke="{DynamicResource OnAccent}"
                                              StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Viewbox>
                                </Border>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                                    <Setter TargetName="box" Property="BorderThickness" Value="0"/>
                                    <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- "Printer va kalibrovka" ochiluvchi sarlavhasi -->
            <Style x:Key="ExpanderHead" TargetType="ToggleButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="bd" MinHeight="48" Padding="14,6" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1" CornerRadius="10">
                                <DockPanel>
                                    <Viewbox x:Name="chev" Width="18" Height="18" DockPanel.Dock="Left" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                                        <Path Data="M9 6l6 6l-6 6" Width="24" Height="24" Stretch="None" Stroke="{DynamicResource Ink2}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Viewbox>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="chev" Property="RenderTransform">
                                        <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="OffsetValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource Scrim}" TextElement.Foreground="{DynamicResource Ink}">
        <Border Style="{StaticResource ModalCard}" Width="900" Height="640" Margin="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sarlavha + printer holati -->
                <Border Padding="22,16" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Border x:Name="PrinterPill" DockPanel.Dock="Right" CornerRadius="16" Padding="12,6" Background="{DynamicResource Surface2}"
                                VerticalAlignment="Center" Margin="16,0,0,0" MaxWidth="380">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="PrinterDot" Width="8" Height="8" Fill="{DynamicResource Ink3}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtPrinterStatus" Text="Printer tekshirilmoqda…" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Ink2}" TextTrimming="CharacterEllipsis" MaxWidth="330"/>
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Stiker chop etish" FontSize="18" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtSubtitle" Text="" FontSize="13" Foreground="{DynamicResource Ink3}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- Chap: sozlamalar -->
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel Margin="22,16,22,16">
                                <!-- Nusxalar soni -->
                                <TextBlock Text="Nusxalar soni" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Click="BtnMinus_Click" Style="{StaticResource SqBtn}" ToolTip="Bitta kam">
                                                <Viewbox Width="16" Height="16"><Path Style="{StaticResource Ic}" Data="M5 12h14"/></Viewbox>
                                            </Button>
                                            <TextBox x:Name="TxtCopies" Text="1" Width="64" Height="34" Margin="6,0" Padding="0" FontSize="14" FontWeight="Bold"
                                                     Style="{StaticResource FieldBox}" HorizontalContentAlignment="Center" TextAlignment="Center"
                                                     TextChanged="TxtCopies_TextChanged"/>
                                            <Button Click="BtnPlus_Click" Style="{StaticResource SqBtn}" ToolTip="Bitta ko'p">
                                                <Viewbox Width="16" Height="16"><Path Style="{StaticResource Ic}" Data="M12 5v14 M5 12h14"/></Viewbox>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtStockInfo" DockPanel.Dock="Right" Text="qoldiq 0" FontSize="12" Foreground="{DynamicResource Ink3}"
                                                   VerticalAlignment="Center" Margin="10,0,12,0"/>
                                        <TextBlock x:Name="TxtProductName" Text="" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Border>
                                <WrapPanel Margin="0,8,0,0">
                                    <TextBlock Text="Tez tanlash:" FontSize="12" Foreground="{DynamicResource Ink3}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                    <Button Content="1" Tag="1" Click="BtnQuickQty_Click" Style="{StaticResource MiniChip}"/>
                                    <Button Content="5" Tag="5" Click="BtnQuickQty_Click" Style="{StaticResource MiniChip}"/>
                                    <Button Content="10" Tag="10" Click="BtnQuickQty_Click" Style="{StaticResource MiniChip}"/>
                                    <Button x:Name="BtnStockQty" Content="Qoldiq soni" Click="BtnStockQty_Click" Style="{StaticResource MiniChip}"
                                            Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" Foreground="{DynamicResource AccentInk}" FontWeight="SemiBold"/>
                                </WrapPanel>

                                <!-- Qatorlar / Joylashuv -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Qatorlar" Style="{StaticResource FieldLabel}"/>
                                        <Border Background="{DynamicResource Surface2}" CornerRadius="10" Padding="3">
                                            <UniformGrid Rows="1">
                                                <Button x:Name="BtnLines1" Content="1 qator" Click="BtnLines1_Click" Style="{StaticResource Seg}" ToolTip="Nom bitta qatorda"/>
                                                <Button x:Name="BtnLines2" Content="2 qator" Click="BtnLines2_Click" Style="{StaticResource Seg}" ToolTip="Nom ikki qatorga o'raladi"/>
                                            </UniformGrid>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Joylashuv" Style="{StaticResource FieldLabel}"/>
                                        <Border Background="{DynamicResource Surface2}" CornerRadius="10" Padding="3">
                                            <UniformGrid Rows="1">
                                                <Button x:Name="BtnAlignLeft" Content="Chap" Click="BtnAlignLeft_Click" Style="{StaticResource Seg}" ToolTip="Nom chapdan boshlanadi (boshi kesilmaydi)"/>
                                                <Button x:Name="BtnAlignCenter" Content="Markaz" Click="BtnAlignCenter_Click" Style="{StaticResource Seg}" ToolTip="Nom markazga tekislanadi"/>
                                            </UniformGrid>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Stikerda ko'rsatish -->
                                <TextBlock Text="Stikerda ko'rsatish" Style="{StaticResource FieldLabel}" Margin="0,14,0,8"/>
                                <WrapPanel>
                                    <CheckBox x:Name="ChkShowName" Content="Nomi" IsChecked="True" Style="{StaticResource Check}"
                                              Checked="OnElementVisibilityChanged" Unchecked="OnElementVisibilityChanged"/>
                                    <CheckBox x:Name="ChkShowBarcode" Content="Shtrix-kod" IsChecked="True" Style="{StaticResource Check}"
                                              Checked="OnElementVisibilityChanged" Unchecked="OnElementVisibilityChanged"/>
                                    <CheckBox x:Name="ChkShowPrice" Content="Narx" IsChecked="True" Style="{StaticResource Check}"
                                              Checked="OnElementVisibilityChanged" Unchecked="OnElementVisibilityChanged"/>
                                </WrapPanel>

                                <!-- Printer va kalibrovka (2.7) -->
                                <ToggleButton x:Name="BtnCalib" Style="{StaticResource ExpanderHead}" Margin="0,8,0,0">
                                    <DockPanel>
                                        <TextBlock x:Name="TxtCalibSummary" DockPanel.Dock="Right" Text="" FontSize="12" Foreground="{DynamicResource Ink3}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Printer va kalibrovka" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </ToggleButton>
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,8,0,0"
                                        Visibility="{Binding IsChecked, ElementName=BtnCalib, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Printer" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="CmbPrinters" Style="{StaticResource FieldCombo}" Height="40" SelectionChanged="CmbPrinters_SelectionChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Stiker o'lchami" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="CmbLabelSize" Style="{StaticResource FieldCombo}" Height="40" SelectionChanged="CmbLabelSize_SelectionChanged"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Nomni surish" Style="{StaticResource FieldLabel}"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Click="BtnNameOffsetLeft_Click" Style="{StaticResource SqBtn}" ToolTip="0,5 mm chapga">
                                                        <Viewbox Width="16" Height="16"><Path Style="{StaticResource Ic}" Data="M15 18l-6-6l6-6"/></Viewbox>
                                                    </Button>
                                                    <Border Width="76" Height="34" Margin="6,0" CornerRadius="8" Background="{DynamicResource Surface2}">
                                                        <TextBlock x:Name="TxtNameOffset" Text="0.0 mm" Style="{StaticResource OffsetValue}"/>
                                                    </Border>
                                                    <Button Click="BtnNameOffsetRight_Click" Style="{StaticResource SqBtn}" ToolTip="0,5 mm o'ngga">
                                                        <Viewbox Width="16" Height="16"><Path Style="{StaticResource Ic}" Data="M9 6l6 6l-6 6"/></Viewbox>
                                                    </Button>
                                                    <Button Click="BtnNameOffsetReset_Click" Style="{StaticResource SqBtn}" Margin="6,0,0,0" ToolTip="0 mm ga qaytarish">
                                                        <Viewbox Width="16" Height="16"><Path Style="{StaticResource Ic}" Data="M4 12a8 8 0 1 0 3-6.2 M4 4v4h4"/></Viewbox>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Umumiy surish (hammasi)" Style="{StaticResource FieldLabel}" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Click="BtnOffsetLeft_Click" Style="{StaticResource SqBtn}" ToolTip="0,5 mm chapga">
                                                        <Viewbox Width="16" Height="16"><Path Style="{StaticResource Ic}" Data="M15 18l-6-6l6-6"/></Viewbox>
                                                    </Button>
                                                    <Border Width="76" Height="34" Margin="6,0" CornerRadius="8" Background="{DynamicResource Surface2}">
                                                        <TextBlock x:Name="TxtOffset" Text="0.0 mm" Style="{StaticResource OffsetValue}"/>
                                                    </Border>
                                                    <Button Click="BtnOffsetRight_Click" Style="{StaticResource SqBtn}" ToolTip="0,5 mm o'ngga">
                                                        <Viewbox Width="16" Height="16"><Path Style="{StaticResource Ic}" Data="M9 6l6 6l-6 6"/></Viewbox>
                                                    </Button>
                                                    <Button Click="BtnOffsetReset_Click" Style="{StaticResource SqBtn}" Margin="6,0,0,0" ToolTip="0 mm ga qaytarish">
                                                        <Viewbox Width="16" Height="16"><Path Style="{StaticResource Ic}" Data="M4 12a8 8 0 1 0 3-6.2 M4 4v4h4"/></Viewbox>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- O'ng: jonli ko'rinish -->
                    <Border Grid.Column="1" Background="{DynamicResource Surface2}" Padding="20">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtLabelSizeCaption" Text="JONLI KO'RINISH" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Ink3}"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            <Border x:Name="StickerCard" Background="White" CornerRadius="8" Margin="0,14,0,14"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#0F1B21" Opacity="0.12"/>
                                </Border.Effect>
                                <!-- Printer chiqishi bilan bir xil render -->
                                <Image x:Name="ImgPreview" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <TextBlock Text="Sozlama o'zgarsa, ko'rinish darhol yangilanadi. Printerdan aynan shunday chiqadi."
                                       FontSize="12" Foreground="{DynamicResource Ink3}" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Pastki panel -->
                <Border Grid.Row="2" Padding="22,14" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="Sinov (1 dona)" Click="BtnTestPrint_Click" Style="{StaticResource BtnSecondary}"/>
                        <Button x:Name="BtnPrint" DockPanel.Dock="Right" Content="1 ta chop etish" Click="BtnPrint_Click" IsDefault="True"
                                Style="{StaticResource BtnPrimary}" Padding="22,0" Margin="10,0,0,0"/>
                        <Button DockPanel.Dock="Right" Click="BtnCancel_Click" IsCancel="True" Style="{StaticResource BtnSecondary}" Padding="18,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Bekor" VerticalAlignment="Center"/>
                                <TextBlock Text="Esc" Style="{StaticResource Kbd}"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="TxtStatus" Text="" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ok}" VerticalAlignment="Center"
                                   Margin="14,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
