<Window x:Class="PosElectro.Desktop.Views.BarcodePrintDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shtrix-kod etiketka chop etish" Height="670" Width="780"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0F172A">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content (Preview + Settings) -->
            <RowDefinition Height="*"/>
            <!-- Status message -->
            <RowDefinition Height="Auto"/>
            <!-- Action buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Sarlavha -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#134E4A" CornerRadius="8" Padding="6,6" Margin="0,0,10,0">
                    <TextBlock Text="🏷️" FontSize="18" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="Shtrix-kod Etiketka Chop Etish" Foreground="#F8FAFC" FontSize="17" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtPrinterStatus" Text="🔍 Printer holati tekshirilmoqda..." Foreground="#38BDF8" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 2. Asosiy Maydon: Chapda Jonli Preview, O'ngda Sozlamalar -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <!-- Chap: Jonli Stiker Ko'rinishi (Preview) -->
                <ColumnDefinition Width="290"/>
                <!-- O'ng: Nusxalar va Elementlar sozlamasi -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CHAP: JONLI PREVIEW BLOKI (100% WYSIWYG) -->
            <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,14,0">
                <Grid VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="JONLI KO'RINISH (PREVIEW)" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="0,0,0,12" HorizontalAlignment="Center"/>

                    <!-- Oq Fonli Termostiker modeli (Printer renderi bilan 100% bir xil) -->
                    <Border Grid.Row="1" x:Name="StickerCard" Background="White" CornerRadius="4" 
                            BorderBrush="#CBD5E1" BorderThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.5"/>
                        </Border.Effect>
                        <!-- Yagona DrawingVisual Render natijasi -->
                        <Image x:Name="ImgPreview" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <TextBlock Grid.Row="2" x:Name="TxtLabelSizeCaption" Text="40 x 30 mm (Standart)" Foreground="#64748B" FontSize="11" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Grid.Row="3" Text="💡 Ekranda qanday ko'rinsa, printerdan aynan shunday chiqadi" Foreground="#38BDF8" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="10,0"/>
                </Grid>
            </Border>

            <!-- O'NG: SOZLAMALAR VA BOSHQARUV -->
            <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,10,0">
                        <!-- Printerni tanlash -->
                        <TextBlock Text="🖨️ Printer (Xprinter XP-365B):" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbPrinters" Height="32" FontSize="12" Margin="0,0,0,8" 
                                  SelectionChanged="CmbPrinters_SelectionChanged"/>

                        <!-- Stiker o'lchamini tanlash -->
                        <TextBlock Text="📐 Stiker qog'oz o'lchami:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbLabelSize" Height="32" FontSize="12" Margin="0,0,0,10" 
                                  SelectionChanged="CmbLabelSize_SelectionChanged"/>

                        <!-- 1. MAHSULOT NOMI SOZLAMALARI -->
                        <Border Background="#162235" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="📝 Mahsulot nomi sozlamasi:" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>

                                <!-- Joylashuvi (Tekislash: Chapdan / O'rtadan) -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Joylashuvi:" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="BtnAlignLeft" Content="⬅️ Chapdan" Click="BtnAlignLeft_Click"
                                                Style="{StaticResource ModernButton}" Height="28" Padding="8,2" FontSize="11" Margin="0,0,4,0" ToolTip="Nomni chapdan boshlash (boshi kesilmaydi)"/>
                                        <Button x:Name="BtnAlignCenter" Content="↔️ O'rtadan" Click="BtnAlignCenter_Click"
                                                Style="{StaticResource ModernButton}" Height="28" Padding="8,2" FontSize="11" ToolTip="Nomni markazga tekislash"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Gorizontal siljitish (Chap/O'ng) -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="↔️ Nomni surish:" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="◀" Click="BtnNameOffsetLeft_Click"
                                                Style="{StaticResource ModernButton}" Width="30" Height="28" FontSize="11" Padding="0" Margin="0,0,4,0" ToolTip="0.5 mm chapga surish"/>
                                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8,4" MinWidth="58">
                                            <TextBlock x:Name="TxtNameOffset" Text="0.0 mm" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Button Content="▶" Click="BtnNameOffsetRight_Click"
                                                Style="{StaticResource ModernButton}" Width="30" Height="28" FontSize="11" Padding="0" Margin="4,0,0,0" ToolTip="0.5 mm o'ngga surish"/>
                                        <Button Content="↺" Click="BtnNameOffsetReset_Click"
                                                Background="#334155" Foreground="#94A3B8" Style="{StaticResource ModernButton}" Width="26" Height="28" FontSize="11" Padding="0" Margin="4,0,0,0" ToolTip="0 mm ga qaytarish"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Qatorlar soni (1 qator / 2 qator) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Qator turi:" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="BtnLines1" Content="1 qator (ixcham)" Click="BtnLines1_Click"
                                                Style="{StaticResource ModernButton}" Height="28" Padding="8,2" FontSize="11" Margin="0,0,4,0" ToolTip="Bitta qatorda chiqarish"/>
                                        <Button x:Name="BtnLines2" Content="2 qator (to'liq)" Click="BtnLines2_Click"
                                                Style="{StaticResource ModernButton}" Height="28" Padding="8,2" FontSize="11" ToolTip="Ikki qatorda o'rab chiqarish"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2. UMUMIY PRINTER KALIBROVKASI -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⚙️ Printer kalibrovkasi:" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" ToolTip="Barcha elementlarni stiker bo'ylab umumiy siljitish"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="◀" Click="BtnOffsetLeft_Click"
                                        Style="{StaticResource ModernButton}" Width="30" Height="28" FontSize="11" Padding="0" Margin="0,0,4,0" ToolTip="0.5 mm chapga surish"/>
                                <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8,4" MinWidth="58">
                                    <TextBlock x:Name="TxtOffset" Text="0.0 mm" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Border>
                                <Button Content="▶" Click="BtnOffsetRight_Click"
                                        Style="{StaticResource ModernButton}" Width="30" Height="28" FontSize="11" Padding="0" Margin="4,0,0,0" ToolTip="0.5 mm o'ngga surish"/>
                                <Button Content="↺" Click="BtnOffsetReset_Click"
                                        Background="#334155" Foreground="#94A3B8" Style="{StaticResource ModernButton}" Width="26" Height="28" FontSize="11" Padding="0" Margin="4,0,0,0" ToolTip="0 mm ga qaytarish"/>
                            </StackPanel>
                        </Grid>

                        <!-- 3. NUSXALAR SONI -->
                        <TextBlock Text="Chop etiladigan nusxalar soni:" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="42"/>
                            </Grid.ColumnDefinitions>

                            <!-- Minus -->
                            <Button Grid.Column="0" Content="-" Click="BtnMinus_Click"
                                    Style="{StaticResource ModernButton}" Height="36" Padding="0"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    FontSize="20" FontWeight="Bold"/>

                            <!-- Input -->
                            <TextBox x:Name="TxtCopies" Grid.Column="1" Text="1" 
                                     Style="{StaticResource ModernTextBox}" Height="36"
                                     FontSize="16" FontWeight="Bold" TextAlignment="Center" Margin="6,0"
                                     Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     Foreground="#FFFFFF" Background="#0F172A" CaretBrush="#2DD4BF"
                                     TextChanged="TxtCopies_TextChanged"/>

                            <!-- Plus -->
                            <Button Grid.Column="2" Content="+" Click="BtnPlus_Click"
                                    Style="{StaticResource ModernButton}" Height="36" Padding="0"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    FontSize="20" FontWeight="Bold"/>
                        </Grid>

                        <!-- Tezkor tugmalar -->
                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="1 dona" Click="BtnQuickQty_Click" Tag="1"
                                    Background="#334155" Foreground="#F8FAFC" Style="{StaticResource ModernButton}" 
                                    Padding="8,3" Margin="0,0,4,4" FontSize="11"/>
                            <Button Content="5 dona" Click="BtnQuickQty_Click" Tag="5"
                                    Background="#334155" Foreground="#F8FAFC" Style="{StaticResource ModernButton}" 
                                    Padding="8,3" Margin="0,0,4,4" FontSize="11"/>
                            <Button Content="10 dona" Click="BtnQuickQty_Click" Tag="10"
                                    Background="#334155" Foreground="#F8FAFC" Style="{StaticResource ModernButton}" 
                                    Padding="8,3" Margin="0,0,4,4" FontSize="11"/>
                            <Button x:Name="BtnStockQty" Content="📦 Qoldiqcha (0)" Click="BtnStockQty_Click"
                                    Background="#0F3642" BorderBrush="#0B6477" BorderThickness="1" Foreground="#2DD4BF" 
                                    Style="{StaticResource ModernButton}" Padding="8,3" Margin="0,0,4,4" FontSize="11"/>
                        </WrapPanel>

                        <Separator Background="#334155" Margin="0,0,0,8"/>

                        <!-- 4. Moslashuvchan Elementlar (Toggles) -->
                        <TextBlock Text="Stikerda nimalar ko'rinsin?" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>

                        <!-- Checkbox: Mahsulot nomi -->
                        <CheckBox x:Name="ChkShowName" Content="Mahsulot nomi" IsChecked="True" 
                                  Foreground="#E2E8F0" FontSize="12" Margin="0,0,0,6"
                                  Checked="OnElementVisibilityChanged" Unchecked="OnElementVisibilityChanged"/>

                        <!-- Checkbox: Shtrix-kod va raqami -->
                        <CheckBox x:Name="ChkShowBarcode" Content="Shtrix-kod chiziqlari va raqami" IsChecked="True" 
                                  Foreground="#E2E8F0" FontSize="12" Margin="0,0,0,6"
                                  Checked="OnElementVisibilityChanged" Unchecked="OnElementVisibilityChanged"/>

                        <!-- Checkbox: Sotish narxi -->
                        <CheckBox x:Name="ChkShowPrice" Content="Sotish narxi (so'mda)" IsChecked="True" 
                                  Foreground="#E2E8F0" FontSize="12" Margin="0,0,0,6"
                                  Checked="OnElementVisibilityChanged" Unchecked="OnElementVisibilityChanged"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 3. Status xabari -->
        <TextBlock x:Name="TxtStatus" Grid.Row="2" Text="" Foreground="#10B981" FontSize="12" 
                   Margin="0,0,0,10" HorizontalAlignment="Center" FontWeight="SemiBold" Visibility="Collapsed"/>

        <!-- 4. Tugmalar qatori -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <!-- Bekor qilish -->
                <ColumnDefinition Width="Auto"/>
                <!-- Oraliq -->
                <ColumnDefinition Width="*"/>
                <!-- 1 dona sinov -->
                <ColumnDefinition Width="Auto"/>
                <!-- Chop etish -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Bekor qilish -->
            <Button Grid.Column="0" Content="Bekor qilish" Click="BtnCancel_Click"
                    Background="#334155" Foreground="White" Style="{StaticResource ModernButton}" 
                    Padding="18,10" Height="42"/>

            <!-- 1 dona sinov (Test Print) -->
            <Button Grid.Column="2" Content="🖨️ 1 dona sinov" Click="BtnTestPrint_Click"
                    Background="#0F3642" BorderBrush="#0B6477" BorderThickness="1.5" Foreground="#2DD4BF" 
                    Style="{StaticResource ModernButton}" Padding="16,10" Height="42" Margin="0,0,10,0"/>

            <!-- Asosiy Chop Etish -->
            <Button x:Name="BtnPrint" Grid.Column="3" Content="🖨️ Chop etish (1 ta)" Click="BtnPrint_Click"
                    Style="{StaticResource SuccessButton}" Padding="22,10" Height="42" FontSize="14" FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>
