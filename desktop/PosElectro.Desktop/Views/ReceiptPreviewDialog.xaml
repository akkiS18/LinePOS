<Window x:Class="PosElectro.Desktop.Views.ReceiptPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chekni Oldindan Ko'rish (Preview)" Height="750" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#0B132B">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Yuqori qism: Sarlavha va Format tanlash (Segmented Pill Toggle) -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="🖨️ Chekni Oldindan Ko'rish" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="TxtSubtitle" Text="Qog'ozda qanday chiqishini tekshiring" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Format almashtirish: 58mm vs A4 -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="20" Padding="4" BorderBrush="#334155" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="Rb58mm" Content="🧾 Xprinter 58mm" 
                                 IsChecked="True" Checked="FormatRadio_Checked"
                                 GroupName="PrintFormat" Cursor="Hand"
                                 Style="{StaticResource SegmentRadioButton}"/>
                    <RadioButton x:Name="RbA4" Content="📄 A4 Format" 
                                 Checked="FormatRadio_Checked"
                                 GroupName="PrintFormat" Cursor="Hand"
                                 Style="{StaticResource SegmentRadioButton}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- O'rta qism: Qog'oz maydoni (Dark backdrop + Realistik oq qog'oz) -->
        <Border Grid.Row="1" Background="#020617" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel HorizontalAlignment="Center">
                    <!-- 1. XPRINTER 58MM LENTA CHEKI KO'RINISHI -->
                    <Border x:Name="Border58mm" Background="#FFFFFF" Width="310" CornerRadius="4" Padding="14,18" Margin="0,10,0,20">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.5"/>
                        </Border.Effect>
                        <TextBlock x:Name="Txt58mmContent" 
                                   FontFamily="Consolas, Courier New" 
                                   FontSize="12" 
                                   Foreground="#0F172A" 
                                   LineHeight="17"
                                   TextWrapping="NoWrap"/>
                    </Border>

                    <!-- 2. A4 FORMAT KO'RINISHI -->
                    <Border x:Name="BorderA4" Background="#FFFFFF" Width="550" CornerRadius="4" Padding="26" Margin="0,10,0,20" Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- A4 Sarlavhasi -->
                            <TextBlock Text="LINE POS — TOVAR CHEKI / HISOB-FAKTURA" 
                                       Foreground="#0B6477" FontSize="16" FontWeight="Bold" 
                                       HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock Text="Elektr jihozlari va uskunalari do'koni" 
                                       Foreground="#64748B" FontSize="11" 
                                       HorizontalAlignment="Center" Margin="0,0,0,16"/>

                            <!-- A4 Metadata -->
                            <Grid Margin="0,0,0,14">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock x:Name="TxtA4ChekNum" Text="Hujjat: Chek #1" FontWeight="Bold" FontSize="12" Foreground="#0F172A"/>
                                    <TextBlock x:Name="TxtA4Date" Text="Sana: 24.09.2026 13:00" FontSize="11" Foreground="#475569"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right">
                                    <TextBlock x:Name="TxtA4Payment" Text="To'lov: Naqd" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                    <TextBlock Text="Holati: To'langan" FontSize="11" Foreground="#16A34A" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>

                            <!-- A4 Jadvali -->
                            <DataGrid x:Name="GridA4Items" AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="True" Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFC"
                                      Foreground="#0F172A" BorderBrush="#E2E8F0" BorderThickness="1" GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="#E2E8F0" VerticalGridLinesBrush="#E2E8F0"
                                      HeadersVisibility="Column" Margin="0,0,0,16">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="6,4"/>
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="№" Binding="{Binding IndexDisplay}" Width="35"/>
                                    <DataGridTextColumn Header="Mahsulot Nomi" Binding="{Binding ProductName}" Width="2*"/>
                                    <DataGridTextColumn Header="Miqdor" Binding="{Binding QuantityDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="Narxi" Binding="{Binding PriceDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="Jami (so'm)" Binding="{Binding TotalDisplay}" Width="*" FontWeight="Bold"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- A4 Jami summa -->
                            <StackPanel HorizontalAlignment="Right" Margin="0,0,0,24">
                                <TextBlock Text="JAMI TO'LOV:" FontWeight="Bold" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="TxtA4Total" Text="0 SO'M" FontWeight="ExtraBold" FontSize="18" Foreground="#10B981" HorizontalAlignment="Right"/>
                            </StackPanel>

                            <!-- Imzolar -->
                            <TextBlock Text="Tovarlar to'liq, butun va soz holatda topshirildi hamda qabul qilindi." 
                                       FontSize="10" Foreground="#64748B" Margin="0,0,0,18"/>
                            <Grid>
                                <TextBlock Text="Berdi (Sotuvchi): ___________________" FontSize="10" Foreground="#475569" HorizontalAlignment="Left"/>
                                <TextBlock Text="Qabul qildi: ___________________" FontSize="10" Foreground="#475569" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Pastki qism: Tugmalar -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtPreviewStatus" VerticalAlignment="Center" 
                           Foreground="#34D399" FontSize="12" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <ComboBox x:Name="CmbReceiptPrinters" Width="180" Height="32" 
                          VerticalContentAlignment="Center" SelectionChanged="CmbReceiptPrinters_SelectionChanged"/>
            </StackPanel>

            <Button Grid.Column="1" Content="Yopish (Esc)" Click="BtnClose_Click"
                    Style="{StaticResource ModernButton}" Width="120" Height="40" Margin="0,0,10,0"/>

            <Button Grid.Column="2" x:Name="BtnPrint" Content="🖨️ Chop etish" Click="BtnPrint_Click"
                    Style="{StaticResource SuccessButton}" Width="150" Height="40" FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>
