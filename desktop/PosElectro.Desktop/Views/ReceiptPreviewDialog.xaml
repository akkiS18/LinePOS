<Window x:Class="PosElectro.Desktop.Views.ReceiptPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chekni oldindan ko'rish" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <!-- Maket 4.6: chekni oldindan ko'rish (58 mm / A4). Markazda 1000×700 karta. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/Theme.Light.xaml"/>
                <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/SmartControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Qog'oz ranglari: chek qog'ozi har qanday temada oq, yozuvi qora (ataylab tokensiz) -->
            <SolidColorBrush x:Key="Paper" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="PaperInk" Color="#0F1B21"/>
            <SolidColorBrush x:Key="PaperMuted" Color="#4F5F68"/>
            <SolidColorBrush x:Key="PaperLine" Color="#C9D2D8"/>
            <SolidColorBrush x:Key="PaperHead" Color="#F2F4F6"/>

            <!-- 58 mm / A4 almashtirgich -->
            <Style x:Key="SegRadio" TargetType="RadioButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="16,0" Height="36">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PaperCaption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
            <Style x:Key="A4Cell" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource PaperInk}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="6,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootLayer" Background="{DynamicResource Scrim}" TextElement.Foreground="{DynamicResource Ink}">
        <Border Style="{StaticResource ModalCard}" Width="1000" Height="700" Margin="24" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sarlavha -->
                <Border Padding="20,14" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Click="BtnClose_Click" Style="{StaticResource CloseBtn}" Width="42" Height="42"
                                Background="{DynamicResource Surface2}" Margin="10,0,0,0" ToolTip="Yopish (Esc)">
                            <Viewbox Width="18" Height="18">
                                <Path Style="{StaticResource Ic}" Data="M6 6l12 12 M18 6L6 18"/>
                            </Viewbox>
                        </Button>
                        <Button DockPanel.Dock="Right" x:Name="BtnPrint" Content="Chop etish" Click="BtnPrint_Click"
                                Style="{StaticResource BtnPrimary}" Height="42" Padding="18,0" Margin="10,0,0,0" ToolTip="Chop etish (Enter)"/>
                        <Border DockPanel.Dock="Right" Background="{DynamicResource Surface2}" CornerRadius="10" Padding="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Rb58mm" Content="58 mm" IsChecked="True" Checked="FormatRadio_Checked"
                                             GroupName="PrintFormat" Style="{StaticResource SegRadio}"/>
                                <RadioButton x:Name="RbA4" Content="A4" Checked="FormatRadio_Checked"
                                             GroupName="PrintFormat" Style="{StaticResource SegRadio}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="TxtTitle" Text="Chek · oldindan ko'rish" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtSubtitle" Text="Qog'ozda qanday chiqishini tekshiring" Foreground="{DynamicResource Ink3}" FontSize="12"
                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Qog'ozlar: ikkalasi yonma-yon, tanlangani ajratib ko'rsatiladi -->
                <Border Grid.Row="1" Background="{DynamicResource Bg}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24">
                            <!-- 1. 58 mm lenta cheki -->
                            <StackPanel x:Name="Panel58mm" Margin="0,0,40,0" VerticalAlignment="Top" Cursor="Hand" MouseLeftButtonDown="Paper58_Click" Background="Transparent">
                                <TextBlock x:Name="Cap58mm" Text="58 mm" Style="{StaticResource PaperCaption}"/>
                                <Border x:Name="Border58mm" BorderThickness="2" Padding="4" CornerRadius="2">
                                    <Border Background="{StaticResource Paper}" Width="290" Padding="14,16">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#0F1B21" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.15"/>
                                        </Border.Effect>
                                        <TextBlock x:Name="Txt58mmContent" FontFamily="Consolas, Courier New" FontSize="12"
                                                   Foreground="{StaticResource PaperInk}" LineHeight="17" TextWrapping="NoWrap"/>
                                    </Border>
                                </Border>
                            </StackPanel>

                            <!-- 2. A4 hisob-faktura -->
                            <StackPanel x:Name="PanelA4" VerticalAlignment="Top" Cursor="Hand" MouseLeftButtonDown="PaperA4_Click" Background="Transparent">
                                <TextBlock x:Name="CapA4" Text="A4" Style="{StaticResource PaperCaption}"/>
                                <Border x:Name="BorderA4" BorderThickness="2" Padding="4" CornerRadius="2">
                                    <Border Background="{StaticResource Paper}" Width="520" MinHeight="520" Padding="26">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#0F1B21" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.15"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="LINE POS — TOVAR CHEKI / HISOB-FAKTURA" Foreground="{StaticResource PaperInk}" FontSize="15" FontWeight="Bold"
                                                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,2"/>
                                            <TextBlock Text="Elektr jihozlari va uskunalari do'koni" Foreground="{StaticResource PaperMuted}" FontSize="11"
                                                       HorizontalAlignment="Center" Margin="0,0,0,16"/>

                                            <DockPanel Margin="0,0,0,14">
                                                <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0">
                                                    <TextBlock x:Name="TxtA4Payment" Text="To'lov: Naqd" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource PaperInk}"
                                                               HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" MaxWidth="200"/>
                                                    <TextBlock Text="Holati: To'langan" FontSize="11" Foreground="{StaticResource PaperMuted}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock x:Name="TxtA4ChekNum" Text="Hujjat: Chek" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PaperInk}" TextWrapping="Wrap"/>
                                                    <TextBlock x:Name="TxtA4Date" Text="Sana:" FontSize="11" Foreground="{StaticResource PaperMuted}"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Jadval -->
                                            <Border BorderBrush="{StaticResource PaperLine}" BorderThickness="1" Margin="0,0,0,16">
                                                <StackPanel>
                                                    <Border Background="{StaticResource PaperHead}" Height="26">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="32"/>
                                                                <ColumnDefinition Width="2*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="№" Style="{StaticResource A4Cell}" FontWeight="Bold"/>
                                                            <TextBlock Grid.Column="1" Text="Mahsulot nomi" Style="{StaticResource A4Cell}" FontWeight="Bold"/>
                                                            <TextBlock Grid.Column="2" Text="Miqdor" Style="{StaticResource A4Cell}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                            <TextBlock Grid.Column="3" Text="Narxi" Style="{StaticResource A4Cell}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                            <TextBlock Grid.Column="4" Text="Jami (so'm)" Style="{StaticResource A4Cell}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                    </Border>
                                                    <ItemsControl x:Name="GridA4Items">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{StaticResource PaperLine}" BorderThickness="0,1,0,0" MinHeight="24">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="32"/>
                                                                            <ColumnDefinition Width="2*"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding IndexDisplay}" Style="{StaticResource A4Cell}"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding ProductName}" Style="{StaticResource A4Cell}" TextWrapping="Wrap" TextTrimming="None" Margin="6,4"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding QuantityDisplay}" Style="{StaticResource A4Cell}" HorizontalAlignment="Right"/>
                                                                        <TextBlock Grid.Column="3" Text="{Binding PriceDisplay}" Style="{StaticResource A4Cell}" HorizontalAlignment="Right"/>
                                                                        <TextBlock Grid.Column="4" Text="{Binding TotalDisplay}" Style="{StaticResource A4Cell}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel HorizontalAlignment="Right" Margin="0,0,0,24">
                                                <TextBlock Text="JAMI TO'LOV:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PaperMuted}" HorizontalAlignment="Right"/>
                                                <TextBlock x:Name="TxtA4Total" Text="0 so'm" FontWeight="ExtraBold" FontSize="17" Foreground="{StaticResource PaperInk}" HorizontalAlignment="Right"/>
                                            </StackPanel>

                                            <TextBlock Text="Tovarlar to'liq, butun va soz holatda topshirildi hamda qabul qilindi."
                                                       FontSize="10" Foreground="{StaticResource PaperMuted}" Margin="0,0,0,18" TextWrapping="Wrap"/>
                                            <Grid>
                                                <TextBlock Text="Berdi (sotuvchi): ___________________" FontSize="10" Foreground="{StaticResource PaperMuted}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="Qabul qildi: ___________________" FontSize="10" Foreground="{StaticResource PaperMuted}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Pastki qism: chek printeri va holat -->
                <Border Grid.Row="2" Padding="20,10" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <StackPanel x:Name="PrinterPanel" DockPanel.Dock="Left" Orientation="Horizontal">
                            <TextBlock Text="Chek printeri" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CmbReceiptPrinters" Style="{StaticResource FieldCombo}" Height="40" MinWidth="220" MaxWidth="320"
                                      SelectionChanged="CmbReceiptPrinters_SelectionChanged"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtPreviewStatus" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource Ok}"
                                   FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" MinHeight="40" Padding="0,11,0,0"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
