<UserControl x:Class="PosElectro.Desktop.Views.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             PreviewKeyDown="SyncView_PreviewKeyDown"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="{DynamicResource Bg}">
        <!-- Asosiy Tarkib -->
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <!-- Chap tomon: QR Kod va Wi-Fi holati -->
                <ColumnDefinition Width="380"/>
                <!-- O'ng tomon: Kassa va Mobil Aloqa Markazi -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CHAP: QR KOD VA SOZLAMALAR -->
            <Border Grid.Column="0" Background="{DynamicResource Surface}" CornerRadius="16" BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,20,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
                <StackPanel>
                    <!-- Sarlavha: Wi-Fi Orqali Ulanish (Vektor ikonka bilan) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,18">
                        <Path Data="M12 3C7.03 3 2.7 5.4 0 9l12 13 12-13c-2.7-3.6-7.03-6-12-6zm0 3.5c3.6 0 6.9 1.4 9.3 3.7L12 19.4 2.7 11.2C5.1 8.9 8.4 7.5 12 7.5z"
                              Fill="{DynamicResource Accent}" Stretch="Uniform" Width="20" Height="17" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Wi-Fi Orqali Ulanish" Foreground="{DynamicResource Ink}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- QR Kod kartasi -->
                    <Border Background="White" CornerRadius="12" Padding="14" HorizontalAlignment="Center" Width="240" Height="240" Margin="0,0,0,16">
                        <Image Source="{Binding QrCodeImage}" Stretch="Uniform"/>
                    </Border>

                    <!-- IP Manzil va Port -->
                    <Border Background="{DynamicResource Bg}" CornerRadius="10" Padding="12" Margin="0,0,0,16" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Lokal Server: " Foreground="{DynamicResource Ink2}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ServerIp}" Foreground="{DynamicResource Ok}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text=":" Foreground="{DynamicResource Ink2}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ServerPort}" Foreground="{DynamicResource Ok}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Telefonni bir marta QR orqali ulang. Keyingi sinxron avtomatik ishlaydi."
                               TextWrapping="Wrap" Foreground="{DynamicResource Ink2}" FontSize="12" Margin="0,0,0,10"/>
                    <Button Content="Yangi telefon uchun QR" Command="{Binding GenerateQrCommand}"
                            Style="{StaticResource ModernButton}" Margin="0,0,0,8"/>
                    <Expander Header="Qo'shimcha ulanish sozlamalari" Foreground="{DynamicResource Ink2}" Margin="0,6,0,0">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="QR ishlamasa: ulanish kodi" Foreground="{DynamicResource Ink2}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding PairingCode}" Foreground="{DynamicResource Ok}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="5 daqiqa, bir qurilma uchun" Foreground="{DynamicResource Ink2}" HorizontalAlignment="Center" Margin="0,4,0,8"/>
                            <Button Content="Telefonlar ruxsatini bekor qilish" Command="{Binding RevokeDevicesCommand}"
                                    Style="{StaticResource ModernButton}" Margin="0,0,0,8"/>
                            <Button Content="Windows Firewall ruxsatini ochish" Command="{Binding OpenFirewallCommand}"
                                    Style="{StaticResource ModernButton}" Background="{DynamicResource WarnSolid}"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- O'NG: REALTIME ULANGAN QURILMALAR VA TERMINAL JURNALI -->
            <Border Grid.Column="1" Background="{DynamicResource Surface}" CornerRadius="16" Padding="20" BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- 0: Ulangan Qurilmalar Bo'limi (Auto) -->
                    <RowDefinition Height="Auto"/>
                    <!-- 1: Divider -->
                    <RowDefinition Height="Auto"/>
                    <!-- 2: Realtime Terminal Sarlavhasi -->
                    <RowDefinition Height="Auto"/>
                    <!-- 3: Realtime Terminal Body (*) -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 0: ULANGAN QURILMALAR SECTION (REAL-TIME) -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sarlavha (Vektor ikonka bilan) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M2 16h3v5H2v-5zm5-4h3v9H7V12zm5-4h3v13h-3V8zm5-5h3v18h-3V3z"
                                  Fill="{DynamicResource OkSolid}" Stretch="Uniform" Width="18" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ulangan Qurilmalar" Foreground="{DynamicResource Ink}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Realtime Qurilmalar Soni Nishoni -->
                        <Border Grid.Column="1" Background="{DynamicResource OkSoft}" BorderBrush="{DynamicResource Ok}" BorderThickness="1.5" CornerRadius="16" Padding="12,5" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource OkSolid}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ConnectedClientsCountText}" Foreground="{DynamicResource Ok}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Ulangan qurilmalar ro'yxati (har bir telefon alohida kartada) -->
                    <ItemsControl ItemsSource="{Binding ConnectedClients}" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Ok}" BorderThickness="1.5" CornerRadius="12" Padding="14,10" Margin="0,0,12,8" MinWidth="260">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="Auto"/>
                                             <ColumnDefinition Width="*"/>
                                             <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource OkSoft}" BorderBrush="{DynamicResource Ok}" BorderThickness="1" CornerRadius="10" Width="36" Height="42" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Path Data="M7 2h10a2 2 0 012 2v16a2 2 0 01-2 2H7a2 2 0 01-2-2V4a2 2 0 012-2zm0 3v13h10V5H7zm5 14a1 1 0 100 2 1 1 0 000-2z" 
                                                  Fill="{DynamicResource OkSolid}" Stretch="Uniform" Width="18" Height="22" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DeviceName}" Foreground="{DynamicResource Ink}" FontSize="14" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding IpAddress}" Foreground="{DynamicResource AccentInk}" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0">
                                            <Border Background="{DynamicResource OkSoft}" CornerRadius="8" Padding="8,3" Margin="0,0,0,2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource OkSolid}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="JONLI" Foreground="{DynamicResource Ok}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding ConnectedAtText}" Foreground="{DynamicResource Ink3}" FontSize="10" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Agar 0 ta bo'lsa ko'rsatiladigan qulay placeholder (Vektor ikonka bilan) -->
                    <Border Background="{DynamicResource Bg}" CornerRadius="12" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="16,12"
                            Visibility="{Binding HasNoConnectedClients, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Data="M7 2h10a2 2 0 012 2v16a2 2 0 01-2 2H7a2 2 0 01-2-2V4a2 2 0 012-2zm0 3v13h10V5H7zm5 14a1 1 0 100 2 1 1 0 000-2z" 
                                      Fill="{DynamicResource Accent}" Stretch="Uniform" Width="14" Height="17" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Hozirda ulangan mobil qurilma yo'q. Mobil ilovadan chapdagi QR kodni skanerlang." Foreground="{DynamicResource Ink2}" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 1: DIVIDER -->
                <Separator Grid.Row="1" Background="{DynamicResource Line}" Margin="0,0,0,14"/>

                <!-- 2: REALTIME TERMINAL SARLAVHASI -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M7 2v11h3v9l7-12h-4l4-8z" Fill="{DynamicResource WarnSolid}" Stretch="Uniform" Width="13" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Real-time Terminal &amp; O'tkazishlar" Foreground="{DynamicResource Ink}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Tozalash tugmasi (Faqat vektor ikonka) -->
                        <Button Command="{Binding ClearLogsCommand}" ToolTip="Terminalni tozalash"
                                Style="{StaticResource ModernButton}" Background="{DynamicResource Line}"
                                Width="36" Height="36" Padding="0" Margin="0,0,8,0" Cursor="Hand">
                            <Path Data="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2m3 0v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6h14zM10 11v6M14 11v6" 
                                  Stroke="{DynamicResource Ink2}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" 
                                  Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <!-- Yangilash tugmasi (Faqat vektor ikonka va animatsiya) -->
                        <Button Command="{Binding RefreshStatsCommand}" ToolTip="Yangilash"
                                Style="{StaticResource ModernButton}"
                                Width="36" Height="36" Padding="0" Cursor="Hand">
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="Button.Click">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SyncTerminalRefreshIcon"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:0.6"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                            <Path Stretch="Uniform" x:Name="SyncTerminalRefreshIcon"
                                  Data="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                                  Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="15" Height="15" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 3: REALTIME TERMINAL TANA QISMI -->
                <Border Grid.Row="3" Background="{DynamicResource Bg}" CornerRadius="12" BorderBrush="{DynamicResource Line}" BorderThickness="1.5" Padding="8">
                    <ListBox ItemsSource="{Binding Activities}" 
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter HorizontalAlignment="Stretch" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="10,7" Margin="0,2" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Rangli Ikonka Badge (Yashil, Sariq, Qizil, Ko'k) -->
                                        <Border Grid.Column="0" 
                                                Background="{Binding BadgeBgHex}" 
                                                BorderBrush="{Binding BorderColorHex}" 
                                                BorderThickness="1" 
                                                CornerRadius="6" 
                                                Width="24" Height="24" 
                                                Margin="0,0,10,0" 
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Icon}" 
                                                       Foreground="{Binding ColorHex}" 
                                                       FontSize="13" 
                                                       FontWeight="Bold"
                                                       FontFamily="Segoe UI, Segoe UI Emoji" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Xabar: Uzun bo'lsa pastki qatorga chiroyli tushishi uchun Wrap -->
                                        <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{DynamicResource Ink}" FontFamily="Consolas, Segoe UI" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>

                                        <!-- Vaqt -->
                                        <TextBlock Grid.Column="2" Text="{Binding TimeText}" Foreground="{DynamicResource Ink3}" FontFamily="Consolas, Segoe UI" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Border>
    </Grid>

    <!-- YO'RIQNOMA MODALI (OK MODAL) -->
    <Grid Visibility="{Binding IsHelpModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
          Background="{DynamicResource Scrim}" Panel.ZIndex="1000">
        <Border Background="{DynamicResource Surface}" CornerRadius="16" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.7" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
                <!-- Modal Sarlavhasi -->
                <Grid Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AccentHover}" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                            <TextBlock Text="💡" FontFamily="Segoe UI Emoji" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Qanday ulaniladi?" Foreground="{DynamicResource Ink}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Command="{Binding CloseHelpModalCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,2">
                        <TextBlock Text="✕" Foreground="{DynamicResource Ink2}" FontSize="16" FontWeight="Bold"/>
                    </Button>
                </Grid>

                <Separator Background="{DynamicResource Line}" Margin="0,0,0,16"/>

                <!-- Yo'riqnoma Qadamlari -->
                <Border Background="{DynamicResource Bg}" CornerRadius="12" Padding="16" Margin="0,0,0,20" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                    <StackPanel>
                        <!-- 1-qadam -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource AccentHover}" CornerRadius="12" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock Text="1" Foreground="{DynamicResource AccentInk}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Telefon va kompyuter bitta Wi-Fi da bo'lsin (yoki telefon Hotspot yoqsin)." 
                                       Foreground="{DynamicResource Ink}" FontSize="13" LineHeight="18" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 2-qadam -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource AccentHover}" CornerRadius="12" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock Text="2" Foreground="{DynamicResource AccentInk}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Mobil ilovada QR kodni skanerlang." 
                                       Foreground="{DynamicResource Ink}" FontSize="13" LineHeight="18" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 3-qadam -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource OkSoft}" CornerRadius="12" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock Text="3" Foreground="{DynamicResource Ok}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="O'tkazishni tanlang — ma'lumotlar bir zumda yangilanadi!" 
                                       Foreground="{DynamicResource Ok}" FontWeight="SemiBold" FontSize="13" LineHeight="18" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- OK Tugmasi -->
                <Button Content="Tushundim (OK / Esc)" Command="{Binding CloseHelpModalCommand}"
                        Style="{StaticResource ModernButton}" HorizontalAlignment="Stretch" Height="42" FontSize="14" FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</Grid>
</UserControl>
