<UserControl x:Class="PosElectro.Desktop.Views.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             PreviewKeyDown="SyncView_PreviewKeyDown"
             d:DesignHeight="712" d:DesignWidth="1366">
    <!-- Maket 5.1 (Wi-Fi Sinxron), 5.2 (yo'riqnoma), 5.3 (server to'xtatilgan). Yorug' tema; ranglar faqat tokenlardan. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/Theme.Light.xaml"/>
                <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/SmartControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
            </Style>
            <!-- Qadam raqami: och fonda aksent rang -->
            <Style x:Key="StepNum" TargetType="Border">
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="CornerRadius" Value="11"/>
                <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
            </Style>
            <Style x:Key="StepNumText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="StepText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="LineHeight" Value="19"/>
            </Style>
            <!-- 36px kichik tugma -->
            <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Bg}" TextElement.Foreground="{DynamicResource Ink}">
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ CHAP: TELEFONNI ULASH ============ -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <!-- 5.1: server ishlayapti -->
                    <DockPanel Margin="20" Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Border DockPanel.Dock="Right" Height="28" Padding="10,0" CornerRadius="14" Background="{DynamicResource OkSoft}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Ok}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Server ishlayapti" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Ok}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Telefonni ulash" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="Serverni to'xtatish" Command="{Binding StopServerCommand}"
                                Style="{StaticResource BtnDangerOutline}" Height="44" Margin="0,12,0,0"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border HorizontalAlignment="Center" Padding="12" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="White">
                                    <Image Source="{Binding QrCodeImage}" Width="200" Height="200" Stretch="Uniform"/>
                                </Border>
                                <!-- Manzil -->
                                <Border Height="48" Padding="14,0,6,0" CornerRadius="10" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,14,0,0">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Nusxalash" Click="CopyAddress_Click" Style="{StaticResource SmallBtn}" BorderBrush="{DynamicResource LineStrong}"
                                                ToolTip="Manzilni nusxalash"/>
                                        <TextBlock DockPanel.Dock="Left" Text="Manzil" FontSize="12" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtAddress" FontFamily="Consolas" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding ServerIp, Mode=OneWay}"/><Run Text=":"/><Run Text="{Binding ServerPort, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                                <!-- Qadamlar -->
                                <DockPanel Margin="0,14,0,0">
                                    <Border Style="{StaticResource StepNum}"><TextBlock Text="1" Style="{StaticResource StepNumText}"/></Border>
                                    <TextBlock Text="Telefon va kompyuter bitta Wi-Fi tarmog'ida bo'lsin" Style="{StaticResource StepText}"/>
                                </DockPanel>
                                <DockPanel Margin="0,10,0,0">
                                    <Border Style="{StaticResource StepNum}"><TextBlock Text="2" Style="{StaticResource StepNumText}"/></Border>
                                    <TextBlock Text="Telefondagi SMART kassa ilovasida Sinxron bo'limini oching" Style="{StaticResource StepText}"/>
                                </DockPanel>
                                <DockPanel Margin="0,10,0,0">
                                    <Border Style="{StaticResource StepNum}"><TextBlock Text="3" Style="{StaticResource StepNumText}"/></Border>
                                    <TextBlock Text="QR kodni skanerlang — keyingi sinxron avtomatik ishlaydi" Style="{StaticResource StepText}"/>
                                </DockPanel>

                                <Button Content="Yangi telefon uchun QR" Command="{Binding GenerateQrCommand}" Style="{StaticResource BtnSecondary}" Height="44" Margin="0,14,0,0"/>

                                <!-- Qo'shimcha sozlamalar -->
                                <Expander Margin="0,10,0,0" Foreground="{DynamicResource Ink2}">
                                    <Expander.Header>
                                        <TextBlock Text="Qo'shimcha ulanish sozlamalari" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}"/>
                                    </Expander.Header>
                                    <StackPanel Margin="0,10,0,0">
                                        <Border Padding="14,10" CornerRadius="10" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="QR ishlamasa: ulanish kodi" FontSize="12" Foreground="{DynamicResource Ink2}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding PairingCode}" FontFamily="Consolas" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" Margin="0,2"/>
                                                <TextBlock Text="5 daqiqa amal qiladi, bitta qurilma uchun" FontSize="12" Foreground="{DynamicResource Ink3}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Button Content="Windows Firewall ruxsatini ochish" Command="{Binding OpenFirewallCommand}" Style="{StaticResource BtnSecondary}" Height="44" Margin="0,8,0,0"/>
                                        <Button Content="Telefonlar ruxsatini bekor qilish" Command="{Binding RevokeDevicesCommand}" Style="{StaticResource BtnDangerOutline}" Height="44" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- 5.3: server to'xtatilgan -->
                    <StackPanel Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <Grid Width="220" Height="220">
                            <Rectangle RadiusX="16" RadiusY="16" Fill="{DynamicResource Surface2}" Stroke="{DynamicResource LineStrong}" StrokeThickness="2" StrokeDashArray="4 3"/>
                            <Viewbox Width="72" Height="72">
                                <Grid Width="24" Height="24">
                                    <Path Stroke="{DynamicResource Ink3}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M2 8.5a15 15 0 0 1 20 0 M5 12a10 10 0 0 1 14 0 M8.5 15.5a5 5 0 0 1 7 0 M12 18.5a0.5 0.5 0 1 0 0.01 0"/>
                                    <Path Stroke="{DynamicResource Bad}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3 3l18 18"/>
                                </Grid>
                            </Viewbox>
                        </Grid>
                        <Border Padding="12,6" CornerRadius="16" Background="{DynamicResource BadSoft}" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Bad}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Server to'xtatilgan" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Bad}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Telefonlar kassaga ulana olmaydi. Sotuvlar shu kompyuterda saqlanishda davom etadi."
                                   Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="21" MaxWidth="320" Margin="0,16,0,0"/>
                        <Button Command="{Binding StartServerCommand}" Style="{StaticResource BtnPrimary}" Height="50" Padding="26,0" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M7 4l13 8l-13 8z" Fill="{DynamicResource OnAccent}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Serverni ishga tushirish" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ O'NG ============ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Ulangan qurilmalar -->
                <Border Style="{StaticResource Card}" Padding="20,16">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Qanday ulanadi?" Command="{Binding OpenHelpModalCommand}" Style="{StaticResource SmallBtn}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Ulangan qurilmalar" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border Padding="8,2" CornerRadius="10" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource OkSoft}"/>
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Ok}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasNoConnectedClients}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink2}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="12" FontWeight="Bold">
                                        <Run Text="{Binding ConnectedClients.Count, Mode=OneWay}"/> <Run Text="onlayn"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding ConnectedClients}" Margin="-6,6,-6,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14,12" Margin="6,6,6,0" CornerRadius="12" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="11" Background="{DynamicResource IllusBg}" Margin="0,0,12,0">
                                                <Viewbox Width="20" Height="20">
                                                    <Path Style="{StaticResource Ic}" Stroke="{DynamicResource AccentInk}" Data="M8 2h8a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z M11 18h2"/>
                                                </Viewbox>
                                            </Border>
                                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Ok}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Onlayn" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Ok}"/>
                                                </StackPanel>
                                                <TextBlock FontSize="12" Foreground="{DynamicResource Ink3}" HorizontalAlignment="Right" Margin="0,2,0,0" ToolTip="Ulangan vaqti">
                                                    <Run Text="{Binding ConnectedAtText, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceName}"/>
                                                <TextBlock Text="{Binding IpAddress}" FontSize="12" Foreground="{DynamicResource Ink3}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bo'sh holat -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,10,0,8"
                                    Visibility="{Binding HasNoConnectedClients, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource IllusBg}" HorizontalAlignment="Center">
                                <Viewbox Width="34" Height="34">
                                    <Path Style="{StaticResource Ic}" Stroke="{DynamicResource AccentInk}" Data="M9 2h6a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z M11 18h2"/>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="Hali hech qanday telefon ulanmagan" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock Text="Serverni yoqing, keyin telefondagi SMART kassa ilovasidan QR kodni skanerlang."
                                       Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="21" MaxWidth="400" Margin="0,6,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Jurnal -->
                <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="20,12,12,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Tozalash" Command="{Binding ClearLogsCommand}" Style="{StaticResource SmallBtn}" Foreground="{DynamicResource Ink2}"
                                            ToolTip="Jurnalni tozalash"/>
                                    <Button Command="{Binding RefreshStatsCommand}" Style="{StaticResource SmallBtn}" Width="36" Padding="0" Margin="6,0,0,0"
                                            Foreground="{DynamicResource Ink2}" ToolTip="Yangilash">
                                        <Viewbox Width="15" Height="15">
                                            <Path Style="{StaticResource Ic}" Data="M20 11a8 8 0 0 0-14.5-4.5L4 8 M4 4v4h4 M4 13a8 8 0 0 0 14.5 4.5L20 16 M20 20v-4h-4"/>
                                        </Viewbox>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="Jurnal" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Grid>
                            <ListBox ItemsSource="{Binding Activities}" Background="Transparent" BorderThickness="0" Padding="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter HorizontalAlignment="Stretch"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinHeight="44" Padding="20,8" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding TimeText}" Width="64" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Ink3}" VerticalAlignment="Center"/>
                                                <!-- Yozuv turi -->
                                                <Border DockPanel.Dock="Left" MinWidth="72" Padding="8,2" CornerRadius="6" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentInk}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="success">
                                                                    <Setter Property="Background" Value="{DynamicResource OkSoft}"/>
                                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Ok}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="warning">
                                                                    <Setter Property="Background" Value="{DynamicResource WarnSoft}"/>
                                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Warn}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="error">
                                                                    <Setter Property="Background" Value="{DynamicResource BadSoft}"/>
                                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Bad}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11" FontWeight="Bold" HorizontalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="MA'LUMOT"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Type}" Value="success">
                                                                        <Setter Property="Text" Value="SINXRON"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Type}" Value="warning">
                                                                        <Setter Property="Text" Value="OGOH"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Type}" Value="error">
                                                                        <Setter Property="Text" Value="XATO"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding Message}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Sinxron yozuvlari bu yerda chiqadi" Foreground="{DynamicResource Ink3}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Activities.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ 5.2 ULANISH YO'RIQNOMASI ============ -->
        <Grid Visibility="{Binding IsHelpModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="{DynamicResource Scrim}" Panel.ZIndex="1000">
            <Border Style="{StaticResource ModalCard}" Width="640" Margin="24">
                <StackPanel>
                    <Border Padding="24,18" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding CloseHelpModalCommand}" Style="{StaticResource CloseBtn}" Background="{DynamicResource Surface2}" ToolTip="Yopish (Esc)">
                                <Viewbox Width="18" Height="18">
                                    <Path Style="{StaticResource Ic}" Data="M6 6l12 12 M18 6L6 18"/>
                                </Viewbox>
                            </Button>
                            <TextBlock Text="Telefonni kassaga ulash" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>
                    <StackPanel Margin="24,8,24,4">
                        <Border Padding="0,14" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Border Style="{StaticResource StepNum}" Width="32" Height="32" CornerRadius="16" Margin="0,0,14,0"><TextBlock Text="1" Style="{StaticResource StepNumText}" FontSize="14" FontWeight="ExtraBold"/></Border>
                                <StackPanel>
                                    <TextBlock Text="Bir xil Wi-Fi" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock Text="Kompyuter va telefon bitta Wi-Fi tarmog'ida bo'lsin (yoki telefon hotspot yoqsin)." Style="{StaticResource StepText}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Padding="0,14" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Border Style="{StaticResource StepNum}" Width="32" Height="32" CornerRadius="16" Margin="0,0,14,0"><TextBlock Text="2" Style="{StaticResource StepNumText}" FontSize="14" FontWeight="ExtraBold"/></Border>
                                <StackPanel>
                                    <TextBlock Text="Telefonda SMART kassa → Sinxron" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock Text="Android ilovada Sinxron bo'limini oching va QR skanerlashni tanlang." Style="{StaticResource StepText}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Padding="0,14" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Border Style="{StaticResource StepNum}" Width="32" Height="32" CornerRadius="16" Margin="0,0,14,0"><TextBlock Text="3" Style="{StaticResource StepNumText}" FontSize="14" FontWeight="ExtraBold"/></Border>
                                <StackPanel>
                                    <TextBlock Text="QR kodni skanerlang" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource StepText}" Margin="0,3,0,0">
                                        <Run Text="Ekrandagi QR kodni skanerlang. Ishlamasa, «Qo'shimcha ulanish sozlamalari»dagi ulanish kodidan foydalaning. Manzil:"/>
                                        <Run Text="{Binding ServerIp, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=":" FontWeight="SemiBold"/><Run Text="{Binding ServerPort, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Padding="0,14" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Border Style="{StaticResource StepNum}" Width="32" Height="32" CornerRadius="16" Margin="0,0,14,0"><TextBlock Text="4" Style="{StaticResource StepNumText}" FontSize="14" FontWeight="ExtraBold"/></Border>
                                <StackPanel>
                                    <TextBlock Text="Birinchi sinxron" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock Text="Ma'lumotlar telefonga o'tadi. Keyingi safar sinxron avtomatik ishlaydi." Style="{StaticResource StepText}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                    <Border Margin="24,14" Padding="14,12" CornerRadius="10" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1">
                        <TextBlock FontSize="13" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" LineHeight="20">
                            <Run Text="Ulanmasa:" FontWeight="Bold"/>
                            <Run Text="«Qo'shimcha ulanish sozlamalari»dan Windows Firewall ruxsatini oching. Mehmon (guest) Wi-Fi'da qurilmalar bir-birini ko'rmaydi."/>
                        </TextBlock>
                    </Border>
                    <Button Content="Tushunarli" Command="{Binding CloseHelpModalCommand}" Style="{StaticResource BtnPrimary}" Height="46" Padding="22,0"
                            HorizontalAlignment="Right" Margin="0,0,24,20"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
