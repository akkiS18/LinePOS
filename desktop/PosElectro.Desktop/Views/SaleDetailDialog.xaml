<Window x:Class="PosElectro.Desktop.Views.SaleDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:PosElectro.Desktop.Services"
        xmlns:models="clr-namespace:PosElectro.Desktop.Models"
        Title="Chek tafsiloti" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <!-- Maket 4.2: chek tafsiloti. Oyna egasi ustini qoplaydi (Scrim), markazda 640px karta. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/SmartControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ColHead" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </Style>
            <Style x:Key="Num" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </Style>
            <Style x:Key="WarnBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
                <Setter Property="Background" Value="{DynamicResource WarnSoft}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource WarnLine}"/>
                <Setter Property="Foreground" Value="{DynamicResource Warn}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="14,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource Scrim}" TextElement.Foreground="{DynamicResource Ink}">
        <Border Style="{StaticResource ModalCard}" Width="640" Margin="24">
            <StackPanel>
                <!-- Sarlavha -->
                <DockPanel Margin="24,18,16,12">
                    <Button DockPanel.Dock="Right" Click="BtnClose_Click" Style="{StaticResource CloseBtn}" VerticalAlignment="Top" ToolTip="Yopish (Esc)">
                        <Viewbox Width="18" Height="18">
                            <Path Style="{StaticResource Ic}" Data="M18 6L6 18 M6 6l12 12"/>
                        </Viewbox>
                    </Button>
                    <StackPanel>
                        <TextBlock x:Name="TxtTitle" Text="Chek" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock x:Name="TxtDate" Text="" FontSize="13" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Border CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink2}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PaymentType}" Value="{x:Static models:PaymentType.CASH}">
                                                <Setter Property="Background" Value="{DynamicResource OkSoft}"/>
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Ok}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PaymentType}" Value="{x:Static models:PaymentType.CARD}">
                                                <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentInk}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PaymentType}" Value="{x:Static models:PaymentType.DEBT}">
                                                <Setter Property="Background" Value="{DynamicResource WarnSoft}"/>
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Warn}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PaymentType}" Value="{x:Static models:PaymentType.RETURN}">
                                                <Setter Property="Background" Value="{DynamicResource BadSoft}"/>
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Bad}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PaymentType}" Value="{x:Static models:PaymentType.BRAK}">
                                                <Setter Property="Background" Value="{DynamicResource BadSoft}"/>
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Bad}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="12" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding PaymentTypeDisplay}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PaymentType}" Value="{x:Static models:PaymentType.SPLIT}">
                                                    <Setter Property="Text" Value="Aralash"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PaymentType}" Value="{x:Static models:PaymentType.BRAK}">
                                                    <Setter Property="Text" Value="Brak"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>

                <!-- Tovarlar -->
                <Border Margin="24,0" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                    <StackPanel>
                        <Border Background="{DynamicResource Surface2}" Height="34" Padding="14,0" CornerRadius="9,9,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TOVAR" Style="{StaticResource ColHead}" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="SONI" Style="{StaticResource ColHead}"/>
                                <TextBlock Grid.Column="2" Text="NARX" Style="{StaticResource ColHead}"/>
                                <!-- Tan narx: faqat admin ko'radi -->
                                <TextBlock Grid.Column="3" Text="TAN NARX" Style="{StaticResource ColHead}" Width="100" TextAlignment="Right"
                                           Visibility="{Binding CanSeeSecrets, Source={x:Static services:AdminGate.Current}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Grid.Column="4" Text="SUMMA" Style="{StaticResource ColHead}"/>
                            </Grid>
                        </Border>
                        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="GridItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="40" Padding="14,0" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="110"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ProductName}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ProductName}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource Num}">
                                                    <Run Text="{Binding Quantity, Mode=OneWay}"/> <Run Text="{Binding UnitAtSale, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Text="{Binding PriceAtSale, StringFormat={}{0:N0}}" Style="{StaticResource Num}" Foreground="{DynamicResource Ink2}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding CostDisplay}" Style="{StaticResource Num}" Foreground="{DynamicResource Ink2}" Width="100" TextAlignment="Right"
                                                           Visibility="{Binding CanSeeSecrets, Source={x:Static services:AdminGate.Current}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <TextBlock Grid.Column="4" Text="{Binding TotalPrice, StringFormat={}{0:N0}}" Style="{StaticResource Num}" FontWeight="SemiBold"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Yakun -->
                <StackPanel Margin="24,14,24,14">
                    <DockPanel x:Name="RowSplit" Visibility="Collapsed" Margin="0,0,0,4">
                        <TextBlock x:Name="TxtSplit" DockPanel.Dock="Right" FontSize="14" Foreground="{DynamicResource Ink2}"/>
                        <TextBlock Text="Naqd / karta" FontSize="14" Foreground="{DynamicResource Ink2}"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock x:Name="TxtTotalAmount" DockPanel.Dock="Right" Text="0 so'm" FontSize="18" FontWeight="ExtraBold"/>
                        <TextBlock Text="Jami" FontSize="18" FontWeight="ExtraBold"/>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock x:Name="TxtTotalProfit" DockPanel.Dock="Right" Text="" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}"/>
                        <TextBlock x:Name="TxtProfitLabel" Text="Sof foyda" FontSize="14" Foreground="{DynamicResource Ink2}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <!-- Qaytarishlar tarixi / chop etish holati -->
                    <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" Text="" Foreground="{DynamicResource Ink2}"
                                   FontSize="12" FontWeight="SemiBold" Visibility="Collapsed"/>
                    </ScrollViewer>
                </StackPanel>

                <!-- Tugmalar -->
                <Border Padding="24,14,24,20" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <Button x:Name="BtnReturn" DockPanel.Dock="Left" Click="BtnReturn_Click" Style="{StaticResource WarnBtn}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                    <Path Style="{StaticResource Ic}" Data="M9 14L4 9l5-5 M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/>
                                </Viewbox>
                                <TextBlock x:Name="TxtReturn" Text="Qaytarish" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Click="BtnPreview_Click" Style="{StaticResource BtnSecondary}" Width="48" Padding="0" Margin="0,0,10,0"
                                    ToolTip="Chek qog'ozda qanday chiqishini oldindan ko'rish">
                                <Viewbox Width="18" Height="18">
                                    <Path Style="{StaticResource Ic}" Data="M2 12s4-7 10-7s10 7 10 7s-4 7-10 7s-10-7-10-7z M12 9a3 3 0 1 0 0.01 0"/>
                                </Viewbox>
                            </Button>
                            <Button Content="A4 hisob-faktura" Click="BtnPrintA4_Click" Style="{StaticResource BtnSecondary}" Padding="14,0" Margin="0,0,10,0"
                                    ToolTip="A4 printerda hisob-faktura chiqarish"/>
                            <Button x:Name="BtnPrintReceipt" Click="BtnPrintReceipt_Click" Style="{StaticResource BtnPrimary}" ToolTip="Kassa chekini qayta chiqarish (Enter)">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                        <Path Style="{StaticResource Ic}" Data="M6 9V2h12v7 M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2 M6 14h12v8H6z"/>
                                    </Viewbox>
                                    <TextBlock Text="Chekni qayta chiqarish" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
