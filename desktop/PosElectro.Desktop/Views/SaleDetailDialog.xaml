<Window x:Class="PosElectro.Desktop.Views.SaleDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chek Tafsilotlari" Height="560" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0F172A">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Sarlavha -->
        <TextBlock x:Name="TxtTitle" Grid.Row="0" Text="Chek #0 Tafsilotlari" 
                   Foreground="#2563EB" FontSize="18" FontWeight="Bold"/>

        <TextBlock x:Name="TxtDate" Grid.Row="1" Text="10.09.2026 20:46" 
                   Foreground="#94A3B8" FontSize="12" Margin="0,4,0,12"/>

        <!-- Mahsulotlar ro'yxati -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" Padding="6" Margin="0,0,0,14">
            <DataGrid x:Name="GridItems" AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True"
                      Background="Transparent" RowBackground="#1E293B" AlternatingRowBackground="#0F172A"
                      Foreground="#F8FAFC" BorderThickness="0" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#334155" HeadersVisibility="Column">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0F172A"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,8"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mahsulot" Binding="{Binding ProductName}" Width="2*" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Miqdor" Binding="{Binding Quantity}" Width="*"/>
                    <DataGridTextColumn Header="Narxi" Binding="{Binding PriceAtSale, StringFormat='{}{0:N0} so\'m'}" Width="*"/>
                    <DataGridTextColumn Header="Tan narx" Binding="{Binding CostDisplay}" Width="*"/>
                    <DataGridTextColumn Header="Jami" Binding="{Binding TotalPrice, StringFormat='{}{0:N0} so\'m'}" Width="*" FontWeight="Bold"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Jami va Foyda xulosasi -->
        <Border Grid.Row="3" Background="#1E293B" CornerRadius="10" Padding="14" Margin="0,0,0,14" BorderBrush="#334155" BorderThickness="1">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="JAMI SUMMA:" Foreground="#94A3B8" FontWeight="Bold" FontSize="14"/>
                    <TextBlock x:Name="TxtTotalAmount" Text="0 so'm" HorizontalAlignment="Right" Foreground="#F8FAFC" FontWeight="ExtraBold" FontSize="16"/>
                </Grid>
                <Grid>
                    <TextBlock Text="SOF FOYDA:" Foreground="#10B981" FontWeight="Bold" FontSize="14"/>
                    <TextBlock x:Name="TxtTotalProfit" Text="+0 so'm" HorizontalAlignment="Right" Foreground="#10B981" FontWeight="Bold" FontSize="16"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Printer formati tanlash va Ko'rish (Preview) -->
        <Border Grid.Row="4" Background="#1E293B" CornerRadius="10" Padding="12,10" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Chop etish:" Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <ComboBox Grid.Column="1" x:Name="CmbPrinterFormat" SelectedIndex="0" Height="36" VerticalContentAlignment="Center" Margin="0,0,10,0">
                    <ComboBoxItem Content="🧾 Xprinter 58mm (Kassa cheki)"/>
                    <ComboBoxItem Content="📄 A4 Printer (Hisob-faktura)"/>
                </ComboBox>

                <Button Grid.Column="2" Content="👁️ Ko'rish" Click="BtnPreview_Click"
                        Style="{StaticResource ModernButton}" Height="36" Padding="12,0" 
                        ToolTip="Chek yoki A4 hujjat qanday chiqishini oldindan ko'rish"/>
            </Grid>
        </Border>

        <!-- Xabar / Status -->
        <TextBlock x:Name="TxtStatus" Grid.Row="5" Text="" Foreground="#10B981" 
                   FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8" Visibility="Collapsed"/>

        <!-- Tugmalar -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Yopish" Click="BtnClose_Click"
                    Style="{StaticResource ModernButton}" Height="40" Margin="0,0,6,0"/>

            <Button x:Name="BtnReturn" Grid.Column="1" Content="Qaytarish" Click="BtnReturn_Click" Height="40" Margin="6,0,6,0"/>
            <Button x:Name="BtnPrintReceipt" Grid.Column="2" Content="🖨️ Chop etish" Click="BtnPrintReceipt_Click"
                    Style="{StaticResource SuccessButton}" Height="40" Margin="6,0,0,0" FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>
