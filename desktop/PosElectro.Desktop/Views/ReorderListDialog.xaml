<Window x:Class="PosElectro.Desktop.Views.ReorderListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buyurtma Ro'yxati (Zakaz)" Height="620" Width="780"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#0F172A">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content / Items -->
            <RowDefinition Height="*"/>
            <!-- Footer actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="🛒 Buyurtma Uchun Tanlangan Tovarlar" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="TxtSummary" Text="Ro'yxatni tekshiring, adashib qo'shilganlarini o'chiring yoki chek/Excelga chiqaring" 
                           Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" Click="BtnClearAll_Click"
                    Background="#334155" Foreground="#F87171" BorderBrush="#EF4444" BorderThickness="1"
                    Padding="12,6" Cursor="Hand" FontWeight="SemiBold" FontSize="12">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🗑️ Barchasini tozalash" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- BODY: TOVARLAR JADVALI -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="4">
            <DataGrid x:Name="DgReorderItems"
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      CanUserResizeColumns="True"
                      IsReadOnly="True"
                      Background="Transparent" 
                      RowBackground="#1E293B" 
                      AlternatingRowBackground="#0F172A" 
                      Foreground="#F8FAFC" 
                      BorderThickness="0" 
                      GridLinesVisibility="Horizontal" 
                      HorizontalGridLinesBrush="#334155" 
                      HeadersVisibility="Column"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0F172A"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#334155"/>
                        <Setter Property="Padding" Value="10,8"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Foreground" Value="#F8FAFC"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <!-- Mahsulot nomi -->
                    <DataGridTextColumn Header="Mahsulot nomi" Binding="{Binding Name}" Width="2*" MinWidth="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Shtrix-kod -->
                    <DataGridTextColumn Header="Shtrix-kod" Binding="{Binding Barcode}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Qoldiq -->
                    <DataGridTemplateColumn Header="Hozirgi qoldiq" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StockDisplay}" Foreground="#EF4444" FontWeight="Bold" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Birlik -->
                    <DataGridTextColumn Header="Birlik" Binding="{Binding UnitDisplay}" Width="65">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Tan narxi -->
                    <DataGridTextColumn Header="Tan narxi" Binding="{Binding CostPriceDisplay}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#38BDF8"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Olib tashlash (❌) -->
                    <DataGridTemplateColumn Header="Amal" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="BtnRemoveItem_Click"
                                        Tag="{Binding}"
                                        ToolTip="Buyurtma ro'yxatidan olib tashlash"
                                        Background="#451A1A" BorderBrush="#EF4444" BorderThickness="1"
                                        Foreground="#F87171" FontWeight="Bold" FontSize="11"
                                        Padding="6,4" Cursor="Hand" HorizontalAlignment="Center">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="❌ O'chirish" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- FOOTER: AMALLAR -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Tanlanganlar soni -->
            <TextBlock x:Name="TxtTotalCount" Text="Jami: 0 ta tovar" Foreground="#38BDF8" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>

            <!-- Eksport va Chek tugmalari -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <!-- Chek printeriga chiqarish -->
                <Button Click="BtnPrintReceipt_Click"
                        Background="#0F766E" Foreground="White" BorderBrush="#14B8A6" BorderThickness="1"
                        Padding="16,9" Cursor="Hand" FontWeight="Bold" FontSize="13" Margin="0,0,10,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖨️ Chek chiqarish" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Excelga saqlash -->
                <Button Click="BtnExportExcel_Click"
                        Background="#0B6477" Foreground="White" BorderBrush="#2DD4BF" BorderThickness="1"
                        Padding="16,9" Cursor="Hand" FontWeight="Bold" FontSize="13" Margin="0,0,12,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊 Excelga saqlash" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Yopish -->
                <Button Click="BtnClose_Click"
                        Background="#334155" Foreground="White" BorderThickness="0"
                        Padding="16,9" Cursor="Hand" FontWeight="SemiBold" FontSize="13">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="Yopish"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
