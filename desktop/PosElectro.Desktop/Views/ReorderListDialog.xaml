<Window x:Class="PosElectro.Desktop.Views.ReorderListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:PosElectro.Desktop.Services"
        Title="Buyurtma ro'yxati" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <!-- Maket 2.10: buyurtma ro'yxati. Oyna egasi ustini qoplaydi (Scrim), markazda 900×620 karta. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/SmartControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ColHead" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <!-- Qatordagi kichik tugma (rasm, olib tashlash) -->
            <Style x:Key="RowBtn" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="RemoveBtn" TargetType="Button" BasedOn="{StaticResource RowBtn}">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BadSoft}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootLayer" Background="{DynamicResource Scrim}" TextElement.Foreground="{DynamicResource Ink}">
        <Border Style="{StaticResource ModalCard}" Width="900" Height="620" Margin="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sarlavha -->
                <Border Padding="22,16" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Click="BtnClearAll_Click" Style="{StaticResource BtnDangerOutline}" Height="40" VerticalAlignment="Center" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                    <Path Style="{StaticResource Ic}" Data="M4 7h16 M9 7V4h6v3 M6 7l1 13h10l1-13 M10 11v6 M14 11v6"/>
                                </Viewbox>
                                <TextBlock Text="Ro'yxatni tozalash" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Buyurtma ro'yxati" FontSize="18" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtSummary" Text="Buyurtma uchun tanlangan tovarlar" FontSize="13" Foreground="{DynamicResource Ink3}"
                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Ustun sarlavhalari -->
                <Border Grid.Row="1" Background="{DynamicResource Surface2}" Padding="22,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="1.8*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="TOVAR" Style="{StaticResource ColHead}"/>
                        <TextBlock Grid.Column="2" Text="SHTRIX-KOD" Style="{StaticResource ColHead}"/>
                        <TextBlock Grid.Column="3" Text="QOLDIQ" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="TAN NARX" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- Tovarlar -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="DgReorderItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MinHeight="52" Padding="22,6" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="1.8*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="48"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Rasm: bosilsa tanlanadi, o'ng tugma — menyu -->
                                        <Button Click="BtnChangeImage_Click" Tag="{Binding}" Style="{StaticResource RowBtn}" Width="38" Height="38"
                                                HorizontalAlignment="Left" ToolTip="Rasm biriktirish (o'ng tugma — o'chirish)">
                                            <Border Width="38" Height="38" CornerRadius="8" Background="{DynamicResource Surface2}">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Rasm tanlash..." Click="MenuSelectImage_Click" Tag="{Binding}"/>
                                                        <MenuItem Header="Rasmni o'chirish" Click="MenuRemoveImage_Click" Tag="{Binding}" IsEnabled="{Binding HasImage}"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <Image Source="{Binding ImagePath}" Stretch="UniformToFill"
                                                           Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Image.Clip>
                                                            <RectangleGeometry Rect="0,0,38,38" RadiusX="8" RadiusY="8"/>
                                                        </Image.Clip>
                                                    </Image>
                                                    <Viewbox Width="18" Height="18"
                                                             Visibility="{Binding HasImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                        <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink3}"
                                                              Data="M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z M4 16l5-5l4 4l3-3l4 4 M9.5 8.5a1 1 0 1 0 0.01 0"/>
                                                    </Viewbox>
                                                </Grid>
                                            </Border>
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,12,0" ToolTip="{Binding Name}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Barcode}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Ink2}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <!-- Qoldiq: tugagan — qizil, kam — sariq -->
                                        <Border Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="10" Padding="8,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource WarnSoft}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Warn}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource BadSoft}"/>
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Bad}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="13" FontWeight="Bold">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:0.##} {1}">
                                                        <Binding Path="StockQuantity"/>
                                                        <Binding Path="UnitDisplay"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>
                                        <!-- Tan narx: faqat admin ko'radi -->
                                        <Grid Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CostPriceDisplay}" FontSize="13" Foreground="{DynamicResource Ink2}"
                                                       Visibility="{Binding CanSeeSecrets, Source={x:Static services:AdminGate.Current}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <TextBlock Text="••••" FontSize="13" Foreground="{DynamicResource Ink3}"
                                                       Visibility="{Binding CanSeeSecrets, Source={x:Static services:AdminGate.Current}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                        </Grid>
                                        <!-- Ro'yxatdan olib tashlash -->
                                        <Button Grid.Column="5" Click="BtnRemoveItem_Click" Tag="{Binding}" Style="{StaticResource RemoveBtn}"
                                                HorizontalAlignment="Right" ToolTip="Buyurtma ro'yxatidan olib tashlash">
                                            <Viewbox Width="16" Height="16">
                                                <Path Style="{StaticResource Ic}" Data="M6 6l12 12 M18 6L6 18"/>
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="TxtEmpty" Grid.Row="2" Text="Ro'yxatda tovar qolmadi" FontSize="14" Foreground="{DynamicResource Ink3}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                <!-- Pastki qism -->
                <Border Grid.Row="3" Padding="22,14" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Click="BtnClose_Click" IsCancel="True" Style="{StaticResource BtnSecondary}" Height="46" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Yopish" VerticalAlignment="Center"/>
                                    <TextBlock Text="Esc" Style="{StaticResource Kbd}"/>
                                </StackPanel>
                            </Button>
                            <Button Click="BtnPrintReceipt_Click" Content="Chek printerga" Style="{StaticResource BtnSecondary}" Height="46" Margin="10,0,0,0"/>
                            <Button Click="BtnExportExcel_Click" Content="Excel'ga eksport" Style="{StaticResource BtnPrimary}" Height="46" Padding="18,0" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTotalCount" Text="0 ta tovar" FontSize="14" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
