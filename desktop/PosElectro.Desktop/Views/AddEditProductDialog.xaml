<Window x:Class="PosElectro.Desktop.Views.AddEditProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mahsulot ma'lumotlari" Height="580" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0F172A">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Sarlavha -->
        <TextBlock x:Name="TxtTitle" Grid.Row="0" Text="Yangi Mahsulot Qo'shish" 
                   Foreground="#F8FAFC" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

        <!-- Maydonlar ro'yxati -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <!-- Nomi -->
                <TextBlock Text="Mahsulot nomi *" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtName" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                <!-- Shtrix-kod va Generatsiya / Chop etish tugmalari -->
                <TextBlock Text="Shtrix-kod" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtBarcode" Grid.Column="0" Style="{StaticResource ModernTextBox}" Margin="0,0,6,0" TextChanged="TxtBarcode_TextChanged"/>
                    <Button x:Name="BtnGenerateBarcode" Grid.Column="1" Content="✨ Yaratish" Click="BtnGenerateBarcode_Click"
                            ToolTip="Shtrix-kodi yo'q tovar uchun yangi 13 xonali EAN-13 kod yaratish"
                            Background="#0F3642" BorderBrush="#0B6477" BorderThickness="1" Foreground="#2DD4BF" 
                            Style="{StaticResource ModernButton}" Height="38" Padding="10,0" Margin="0,0,6,0"/>
                    <Button x:Name="BtnPrintBarcode" Grid.Column="2" Content="🖨️ Chiqarish" Click="BtnPrintBarcode_Click"
                            ToolTip="Xprinter 365B orqali ushbu mahsulotga etiketka (stiker) chiqarish"
                            Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Foreground="#F8FAFC" 
                            Style="{StaticResource ModernButton}" Height="38" Padding="10,0"/>
                </Grid>

                <!-- Kategoriya -->
                <TextBlock Text="Kategoriya" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtCategory" Text="Barchasi" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                <!-- Narxlar (Tan narx va Sotish narxi) -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <Grid Margin="0,0,0,6">
                            <TextBlock x:Name="LblCostTitle" Text="Tan narxi (so'm) *" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                            <Border Background="#0F172A" CornerRadius="6" Padding="2" BorderBrush="#334155" BorderThickness="1" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RbCostUzs" Content="🇺🇿 SO'M" IsChecked="True" Style="{StaticResource CurrencySegmentRadio}" Checked="RbCostCurrency_Changed"/>
                                    <RadioButton x:Name="RbCostUsd" Content="💵 USD ($)" Style="{StaticResource CurrencySegmentRadio}" Checked="RbCostCurrency_Changed"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBox x:Name="TxtCostPrice" Text="0" Style="{StaticResource ModernTextBox}" TextChanged="TxtCostPrice_TextChanged"/>
                        <TextBlock x:Name="TxtCostConversion" Text="≈ 0 so'm" Foreground="#38BDF8" FontSize="11" Margin="0,4,0,0" Visibility="Collapsed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Sotish narxi (so'm) *" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtSellingPrice" Text="0" Style="{StaticResource ModernTextBox}" Margin="0,0,0,8"/>
                        <TextBlock Text="2-sotish narxi (so'm) [Ixtiyoriy]" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtSellingPrice2" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                </Grid>

                <!-- Qoldiq miqdori va Birlik -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Qoldiq miqdori *" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtStockQuantity" Text="0" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="O'lchov birligi" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbUnitType" Height="38" FontSize="14">
                            <ComboBoxItem Content="dona (sht)" IsSelected="True"/>
                            <ComboBoxItem Content="metr (m)"/>
                            <ComboBoxItem Content="kilogram (kg)"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Kam qolgan tovar chegarasi -->
                <TextBlock Text="Kam qolganlik ogohlantirish chegarasi" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtMinStockAlert" Text="3" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Xatolik / Ogohlantirish xabari -->
        <TextBlock x:Name="TxtError" Grid.Row="2" Foreground="#EF4444" FontSize="13" FontWeight="SemiBold" 
                   Margin="0,8,0,8" TextWrapping="Wrap" Visibility="Collapsed"/>

        <!-- Tugmalar -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Bekor qilish" Click="BtnCancel_Click"
                    Background="#334155" Foreground="White" Style="{StaticResource ModernButton}" Margin="0,0,6,0"/>

            <Button Grid.Column="1" Content="Saqlash" Click="BtnSave_Click"
                    Style="{StaticResource SuccessButton}" Margin="6,0,0,0"/>
        </Grid>
    </Grid>
</Window>
