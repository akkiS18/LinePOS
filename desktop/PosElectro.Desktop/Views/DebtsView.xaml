<UserControl x:Class="PosElectro.Desktop.Views.DebtsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:PosElectro.Desktop.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="#0F172A">

    <UserControl.Resources>
        <!-- Filter Chip Button Stili -->
        <Style x:Key="FilterChipButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sub-tab Button Stili -->
        <Style x:Key="SubTabButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Payment Type Selector Button Stili -->
        <Style x:Key="PaymentTypeSelectorButton" TargetType="Button">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded Action Button Stili -->
        <Style x:Key="RoundedActionButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <vm:MinorToUzConverter x:Key="MinorToUzConverter"/>
        <vm:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter"/>
        <vm:LessThanZeroConverter x:Key="LessThanZeroConverter"/>
        <vm:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <vm:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0: KPI Summary Kartalari -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Qidiruv va Filtrlar paneli -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Asosiy Maydon (Chapda mijozlar, o'ngda tafsilotlar) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 0: KPI SUMMARY KARTALARI -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Jami qarz -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Padding="16,14" Margin="0,0,8,0" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="JAMI FAOL QARZ" Foreground="#94A3B8" FontSize="11" FontWeight="Bold"/>
                        <Path Stretch="Uniform"
                              Data="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                              Stroke="#F87171" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding TotalActiveDebtText}" Foreground="#F87171" FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Qarzdorlar soni -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="12" Padding="16,14" Margin="4,0,4,0" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="QARZDORLAR SONI" Foreground="#94A3B8" FontSize="11" FontWeight="Bold"/>
                        <Path Stretch="Uniform"
                              Data="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                              Stroke="#38BDF8" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding DebtorsCountText}" Foreground="#38BDF8" FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Muddati o'tgan qarz -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="12" Padding="16,14" Margin="4,0,4,0" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="MUDDATI O'TGAN QARZ" Foreground="#94A3B8" FontSize="11" FontWeight="Bold"/>
                        <Path Stretch="Uniform"
                              Data="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                              Stroke="#FBBF24" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding OverdueDebtText}" Foreground="#FBBF24" FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Ortiqcha to'lov / Kredit -->
            <Border Grid.Column="3" Background="#1E293B" CornerRadius="12" Padding="16,14" Margin="8,0,0,0" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="ORTIQCHA TO'LOV (KREDIT)" Foreground="#94A3B8" FontSize="11" FontWeight="Bold"/>
                        <Path Stretch="Uniform"
                              Data="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                              Stroke="#34D399" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding TotalCreditText}" Foreground="#34D399" FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 1: QIDIRUV VA FILTRLAR PANELI -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="12" Padding="14,10" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Qidiruv input -->
                    <ColumnDefinition Width="320"/>
                    <!-- Filtr dropdown -->
                    <ColumnDefinition Width="*"/>
                    <!-- Yangi mijoz qo'shish va Refresh -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Qidiruv Maydoni (Vektor ikonka va X tozalash tugmasi bilan) -->
                <Grid Grid.Column="0">
                    <TextBox x:Name="CustomerSearchBox"
                             Style="{StaticResource ModernTextBox}"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13" Height="40" Padding="36,0,36,0" VerticalContentAlignment="Center"/>

                    <!-- Qidiruv Vektor Belgisi -->
                    <Path Stretch="Uniform" Data="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                          Stroke="#64748B" StrokeThickness="2" StrokeStartLineCap="Round"
                          Width="15" Height="15"
                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                          IsHitTestVisible="False"/>

                    <!-- Placeholder / Suv belgisi -->
                    <TextBlock Text="Mijoz ismi yoki telefon raqami..."
                               Foreground="#64748B" FontSize="13" VerticalAlignment="Center" Margin="38,0,0,0"
                               IsHitTestVisible="False"
                               Visibility="{Binding HasSearchQuery, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                    <!-- Tozalash tugmasi (Matn yozilganda ko'rinadi) -->
                    <Button Command="{Binding ClearSearchCommand}"
                            Visibility="{Binding HasSearchQuery, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                            Cursor="Hand" Width="26" Height="26" ToolTip="Qidiruvni tozalash">
                        <Path Stretch="Uniform" Data="M6 18L18 6M6 6l12 12"
                              Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round"
                              Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- Filtr Dropdown (ComboBox) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Filtr:" Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding FilterOptions}"
                              SelectedItem="{Binding SelectedFilterOption}"
                              DisplayMemberPath="DisplayName"
                              Width="210" Height="40"
                              VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Yangi mijoz va Yangilash tugmalari -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Yangilash tugmasi (Faqat vektor ikonka va animatsiya) -->
                    <Button Command="{Binding RefreshCommand}"
                            ToolTip="Ro'yxatni yangilash"
                            Style="{StaticResource ModernButton}"
                            Background="#334155"
                            Width="40" Height="40" Padding="0" Margin="0,0,10,0">
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="Button.Click">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DebtsRefreshIcon"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:0.6"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                        <Path Stretch="Uniform" x:Name="DebtsRefreshIcon"
                              Data="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                              Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Path.RenderTransform>
                        </Path>
                    </Button>

                    <!-- Yangi mijoz tugmasi -->
                    <Button Command="{Binding OpenCreateCustomerModalCommand}"
                            Style="{StaticResource RoundedActionButton}" Background="#16A34A" Foreground="White"
                            Height="40" Padding="14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Stretch="Uniform" Data="M12 4v16m8-8H4"
                                  Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round"
                                  Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Yangi mijoz" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2: ASOSIY ISH MAYDONI: CHAPDA MIJOZLAR, O'NGDA TAFSILOTLAR -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Chap ustun: Mijozlar ro'yxati -->
                <ColumnDefinition Width="400"/>
                <!-- Vertikal ajratgich -->
                <ColumnDefinition Width="16"/>
                <!-- O'ng ustun: Mijoz profili va tafsilotlari -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- MIJOZLAR RO'YXATI -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="14" Padding="12" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding Customers.Count, StringFormat='Mijozlar ({0} ta)'}"
                               Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold" Margin="4,0,0,8"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemBorder" Background="#0F172A" CornerRadius="10" Padding="12,10"
                                                    BorderBrush="#334155" BorderThickness="1" Cursor="Hand">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#1E293B"/>
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="#0B6477"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#042F2E"/>
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="#10B981"/>
                                                    <Setter TargetName="itemBorder" Property="BorderThickness" Value="1.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Nomi va Status Badge -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" Margin="0,0,6,0"/>
                                        <Border CornerRadius="4" Padding="4,1" Margin="0,0,0,0" Background="#26334155">
                                            <TextBlock Text="{Binding StatusBadge}" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Telefon -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding PhoneDisplay}" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>

                                    <!-- Balans -->
                                    <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Text="{Binding BalanceDisplay}"
                                               FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#F8FAFC"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BalanceMinor, Converter={StaticResource GreaterThanZeroConverter}}" Value="True">
                                                        <Setter Property="Foreground" Value="#F87171"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BalanceMinor, Converter={StaticResource LessThanZeroConverter}}" Value="True">
                                                        <Setter Property="Foreground" Value="#34D399"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- O'NG USTUN: MIJOZ PROFILI VA TAFSILOTLARI -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="14" Padding="20" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <!-- Tanlanmagan holat placeholder -->
                    <Grid Visibility="{Binding IsCustomerSelected, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path Stretch="Uniform" Data="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                                  Stroke="#64748B" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Mijoz tanlanmagan" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Qarz yoki to'lov tarixini ko'rish uchun chapdagi ro'yxatdan mijozni tanlang"
                                       Foreground="#64748B" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Tanlangan mijoz tafsilotlari -->
                    <Grid Visibility="{Binding IsCustomerSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <!-- Mijoz Header Card (Ismi, Telefon, Balans, Tugmalar) -->
                            <RowDefinition Height="Auto"/>
                            <!-- Sub-tabs: Cheklar / Tarix -->
                            <RowDefinition Height="Auto"/>
                            <!-- Sub-tab tarkibi -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header Card -->
                        <Border Grid.Row="0" Background="#0F172A" CornerRadius="12" Padding="18,14" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Chap qism: Mijoz ma'lumotlari -->
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedCustomer.Name}" Foreground="#F8FAFC" FontSize="20" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <Border CornerRadius="6" Padding="8,2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
                                            <TextBlock Text="{Binding SelectedCustomer.StatusBadge}" Foreground="#38BDF8" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Path Stretch="Uniform" Data="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                              Stroke="#64748B" StrokeThickness="1.6" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding SelectedCustomer.PhoneDisplay}" Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                        <Path Stretch="Uniform" Data="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                                              Stroke="#64748B" StrokeThickness="1.6" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding SelectedCustomer.Note}" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Balans va faol qarz -->
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Joriy holat: " Foreground="#64748B" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedCustomer.BalanceDisplay}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#F8FAFC"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedCustomer.BalanceMinor, Converter={StaticResource GreaterThanZeroConverter}}" Value="True">
                                                            <Setter Property="Foreground" Value="#F87171"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedCustomer.BalanceMinor, Converter={StaticResource LessThanZeroConverter}}" Value="True">
                                                            <Setter Property="Foreground" Value="#34D399"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Text="Jami savdo: " Foreground="#64748B" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedCustomer.OriginalDebtMinor, StringFormat='{}{0:N0} so\'m', Converter={StaticResource MinorToUzConverter}}"
                                                   Foreground="#CBD5E1" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                        <TextBlock Text="To'langan: " Foreground="#64748B" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedCustomer.TotalPaidMinor, StringFormat='{}{0:N0} so\'m', Converter={StaticResource MinorToUzConverter}}"
                                                   Foreground="#34D399" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- O'ng qism: Amallar tugmalari -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding OpenPaymentModalCommand}"
                                            Visibility="{Binding HasActiveDebt, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Style="{StaticResource RoundedActionButton}" Background="#10B981" Foreground="White" FontWeight="Bold"
                                            Padding="14,10" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Stretch="Uniform" Data="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"
                                                  Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="To'lov olish" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding OpenRefundCreditModalCommand}"
                                            Visibility="{Binding HasCredit, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Style="{StaticResource RoundedActionButton}" Background="#D97706" Foreground="White" FontWeight="Bold"
                                            Padding="14,10" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Stretch="Uniform" Data="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"
                                                  Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Pulni qaytarish" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding TransferCreditCommand}"
                                            Visibility="{Binding CanTransferCredit, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Style="{StaticResource RoundedActionButton}" Background="#2563EB" Foreground="White" FontWeight="Bold"
                                            Padding="14,10" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Stretch="Uniform" Data="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"
                                                  Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Qarzga o'tkazish" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding PrintStatementCommand}"
                                            ToolTip="Mijoz hisob ko'chirmasini (sverka) chop etish yoki xotiraga nusxalash"
                                            Style="{StaticResource RoundedActionButton}" Background="#475569" Foreground="White" FontWeight="Bold"
                                            Padding="12,10" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Stretch="Uniform" Data="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"
                                                  Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Ko'chirma" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding OpenEditCustomerModalCommand}"
                                            Style="{StaticResource RoundedActionButton}" Background="#334155" Foreground="#F8FAFC"
                                            Padding="12,10" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Stretch="Uniform" Data="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
                                                  Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Tahrirlash" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding ToggleArchiveCustomerCommand}"
                                            Style="{StaticResource RoundedActionButton}" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1"
                                            Padding="12,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Stretch="Uniform" Data="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                                                  Stroke="#94A3B8" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding BlockButtonText}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Sub-tabs: Cheklar / Tarix -->
                        <Border Grid.Row="1" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding SelectDetailTabCommand}" CommandParameter="0" Margin="0,0,8,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SubTabButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAccountsTabSelected}" Value="True">
                                                    <Setter Property="Background" Value="#0B6477"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Stretch="Uniform" Data="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Nasiyalar (Cheklar)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding SelectDetailTabCommand}" CommandParameter="1">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SubTabButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHistoryTabSelected}" Value="True">
                                                    <Setter Property="Background" Value="#0B6477"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Stretch="Uniform" Data="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="To'lovlar va Tarix" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- TAB 0: NASIYALAR / CHEKLAR JADVALI -->
                        <DataGrid Grid.Row="2" ItemsSource="{Binding SelectedCustomerAccounts}" AutoGenerateColumns="False"
                                  Visibility="{Binding IsAccountsTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
                                  RowBackground="#0F172A" AlternatingRowBackground="#162032"
                                  Foreground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E293B"
                                  HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True"
                                  FontSize="13" RowHeight="38">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#334155"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Chek raqami" Binding="{Binding ReceiptNumber}" Width="150"/>
                                <DataGridTextColumn Header="Sana" Binding="{Binding CreatedAtDisplay}" Width="140"/>
                                <DataGridTextColumn Header="Boshlang'ich qarz" Binding="{Binding OriginalDebtUz, StringFormat='{}{0:N0} so\'m'}" Width="140"/>
                                <DataGridTextColumn Header="Qoldiq" Binding="{Binding BalanceDisplay}" Width="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#F87171"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BalanceMinor}" Value="0">
                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Muddati" Binding="{Binding DueDateDisplay}" Width="120"/>
                                <DataGridTextColumn Header="Holati" Binding="{Binding StatusText}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- TAB 1: TO'LOVLAR VA TARIX JADVALI -->
                        <DataGrid Grid.Row="2" ItemsSource="{Binding SelectedCustomerEvents}" AutoGenerateColumns="False"
                                  Visibility="{Binding IsHistoryTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
                                  RowBackground="#0F172A" AlternatingRowBackground="#162032"
                                  Foreground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E293B"
                                  HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True"
                                  FontSize="13" RowHeight="38">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#334155"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Vaqt" Binding="{Binding OccurredAtDisplay}" Width="140"/>
                                <DataGridTextColumn Header="Amal turi" Binding="{Binding KindDisplay}" Width="160"/>
                                <DataGridTextColumn Header="Summa" Binding="{Binding AmountDisplay}" Width="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#34D399"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Naqd" Binding="{Binding CashMinor, StringFormat='{}{0:N0} so\'m', Converter={StaticResource MinorToUzConverter}}" Width="120"/>
                                <DataGridTextColumn Header="Karta" Binding="{Binding CardMinor, StringFormat='{}{0:N0} so\'m', Converter={StaticResource MinorToUzConverter}}" Width="120"/>
                                <DataGridTextColumn Header="Tafsilot" Binding="{Binding Lines.Count, StringFormat='{}{0} ta chekka taqsimlangan'}" Width="*"/>
                                <DataGridTemplateColumn Header="Amallar" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Bekor qilish"
                                                    Command="{Binding DataContext.ReversePaymentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanReverse, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Background="#7F1D1D" Foreground="#FCA5A5" BorderBrush="#EF4444" BorderThickness="1"
                                                    FontSize="11" FontWeight="SemiBold" Padding="8,3" Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= MODAL: YANGI MIJOZ / TAHRIRLASH ================= -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#CC000000" Panel.ZIndex="200"
                Visibility="{Binding IsCustomerModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#1E293B" CornerRadius="16" BorderBrush="#0B6477" BorderThickness="1.5"
                    Width="440" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="{Binding CustomerModalTitle}" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold"/>
                        <Button Command="{Binding CloseCustomerModalCommand}" HorizontalAlignment="Right"
                                Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" Padding="4">
                            <Path Stretch="Uniform" Data="M6 18L18 6M6 6l12 12"
                                  Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round"
                                  Width="13" Height="13"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="Mijoz ismi va familiyasi *" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ModalCustomerName, UpdateSourceTrigger=PropertyChanged}"
                             Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="10,8" FontSize="13" Margin="0,0,0,12"/>

                    <TextBlock Text="Telefon raqami" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ModalCustomerPhone, UpdateSourceTrigger=PropertyChanged}"
                             Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="10,8" FontSize="13" Margin="0,0,0,12"/>

                    <TextBlock Text="Izoh (manzil yoki qo'shimcha ma'lumot)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ModalCustomerNote, UpdateSourceTrigger=PropertyChanged}"
                             Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="10,8" FontSize="13" Height="60" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <TextBlock Text="{Binding ModalCustomerErrorMessage}" Foreground="#EF4444" FontSize="12" Margin="0,0,0,12"
                               Visibility="{Binding ModalCustomerErrorMessage, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Bekor qilish" Command="{Binding CloseCustomerModalCommand}"
                                Style="{StaticResource RoundedActionButton}" Background="#334155" Foreground="#F8FAFC" Padding="12,10" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Content="Saqlash" Command="{Binding SaveCustomerModalCommand}"
                                Style="{StaticResource RoundedActionButton}" Background="#16A34A" Foreground="White" FontWeight="Bold" Padding="12,10" Margin="6,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- ================= MODAL: QARZ TO'LOVI QABUL QILISH ================= -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#CC000000" Panel.ZIndex="210"
                Visibility="{Binding IsPaymentModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#1E293B" CornerRadius="16" BorderBrush="#10B981" BorderThickness="1.5"
                    Width="520" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Stretch="Uniform" Data="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"
                                  Stroke="#10B981" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Qarz to'lovini qabul qilish" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Command="{Binding ClosePaymentModalCommand}" HorizontalAlignment="Right"
                                Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" Padding="4">
                            <Path Stretch="Uniform" Data="M6 18L18 6M6 6l12 12"
                                  Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round"
                                  Width="13" Height="13"/>
                        </Button>
                    </Grid>

                    <!-- Mijoz va Mavjud Qarz qutisi -->
                    <Border Background="#0F172A" CornerRadius="10" Padding="14,10" Margin="0,0,0,14" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding SelectedCustomer.Name}" Foreground="#F8FAFC" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedCustomer.PhoneDisplay}" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="Mavjud qarz:" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding SelectedCustomer.BalanceDisplay}" Foreground="#F87171" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- To'lov turi tanlash (Naqd, Karta, Aralash) -->
                    <TextBlock Text="To'lov turi:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Naqd" Command="{Binding SelectPaymentTypeCommand}" CommandParameter="0" Margin="0,0,4,0" Padding="0,8" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PaymentTypeSelectorButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaymentCash}" Value="True">
                                            <Setter Property="Background" Value="#064E3B"/>
                                            <Setter Property="BorderBrush" Value="#10B981"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Grid.Column="1" Content="Karta" Command="{Binding SelectPaymentTypeCommand}" CommandParameter="1" Margin="4,0,4,0" Padding="0,8" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PaymentTypeSelectorButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaymentCard}" Value="True">
                                            <Setter Property="Background" Value="#0C4A6E"/>
                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Grid.Column="2" Content="Aralash" Command="{Binding SelectPaymentTypeCommand}" CommandParameter="2" Margin="4,0,0,0" Padding="0,8" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PaymentTypeSelectorButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaymentSplit}" Value="True">
                                            <Setter Property="Background" Value="#581C87"/>
                                            <Setter Property="BorderBrush" Value="#A855F7"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- To'lov summasi kiritish -->
                    <Grid Margin="0,0,0,12" Visibility="{Binding IsPaymentSplit, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="To'lov summasi (so'm) *" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding PaymentAmountInput, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="12,10" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>

                    <!-- Aralash bo'lsa Naqd va Karta alohida -->
                    <Grid Margin="0,0,0,12" Visibility="{Binding IsPaymentSplit, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Naqd qismi (so'm) *" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding PaymentCashInput, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="10,8" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Karta qismi (so'm) *" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding PaymentCardInput, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="10,8" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>

                    <!-- Jonli Taqsimot Preview qutisi -->
                    <Border Background="#0F172A" CornerRadius="10" Padding="12" Margin="0,0,0,14" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Jonli taqsimot ko'rinishi:" Foreground="#64748B" FontSize="11" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding AllocationPreviewLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ReceiptNumber}" Foreground="#94A3B8" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PaidMinor, StringFormat='-{0:N0} so\'m', Converter={StaticResource MinorToUzConverter}}"
                                                       Foreground="#34D399" FontSize="12" FontWeight="Bold"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding PreviewRemainingDebtText}" Foreground="#FBBF24" FontSize="12" FontWeight="Bold" Margin="0,6,0,0"
                                       Visibility="{Binding PreviewRemainingDebtText, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding PaymentErrorMessage}" Foreground="#EF4444" FontSize="12" Margin="0,0,0,12"
                               Visibility="{Binding PaymentErrorMessage, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Bekor qilish" Command="{Binding ClosePaymentModalCommand}"
                                Style="{StaticResource RoundedActionButton}" Background="#334155" Foreground="#F8FAFC" Padding="12,10" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Content="Tasdiqlash va qabul qilish" Command="{Binding ConfirmPaymentCommand}"
                                Style="{StaticResource RoundedActionButton}" Background="#10B981" Foreground="White" FontWeight="Bold" Padding="12,10" Margin="6,0,0,0"
                                IsEnabled="{Binding IsSubmittingPayment, Converter={StaticResource InverseBooleanConverter}}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- ================= MODAL: PULNI QAYTARISH (KREDIT / HAQDORLIK) ================= -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#CC000000" Panel.ZIndex="200"
                Visibility="{Binding IsRefundCreditModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#1E293B" CornerRadius="16" BorderBrush="#D97706" BorderThickness="1.5"
                    Width="440" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Stretch="Uniform" Data="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"
                                  Stroke="#D97706" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ortiqcha pulni mijozga qaytarish" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Command="{Binding CloseRefundCreditModalCommand}" HorizontalAlignment="Right"
                                Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" Padding="4">
                            <Path Stretch="Uniform" Data="M6 18L18 6M6 6l12 12"
                                  Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round"
                                  Width="13" Height="13"/>
                        </Button>
                    </Grid>

                    <Border Background="#0F172A" CornerRadius="10" Padding="14,10" Margin="0,0,0,14" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedCustomer.Name}" Foreground="#F8FAFC" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="{Binding RefundCreditMaxAmountText}" Foreground="#34D399" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Naqd qaytariladigan summa (so'm):" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding RefundCreditCashInput, UpdateSourceTrigger=PropertyChanged}"
                             Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="10,8" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>

                    <TextBlock Text="Karta orqali qaytariladigan summa (so'm):" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding RefundCreditCardInput, UpdateSourceTrigger=PropertyChanged}"
                             Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="10,8" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>

                    <TextBlock Text="{Binding RefundCreditErrorMessage}" Foreground="#EF4444" FontSize="12" Margin="0,0,0,12"
                               Visibility="{Binding RefundCreditErrorMessage, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Bekor qilish" Command="{Binding CloseRefundCreditModalCommand}"
                                Style="{StaticResource RoundedActionButton}" Background="#334155" Foreground="#F8FAFC" Padding="12,10" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Content="Tasdiqlash" Command="{Binding ConfirmRefundCreditCommand}"
                                Style="{StaticResource RoundedActionButton}" Background="#D97706" Foreground="White" FontWeight="Bold" Padding="12,10" Margin="6,0,0,0"
                                IsEnabled="{Binding IsSubmittingRefundCredit, Converter={StaticResource InverseBooleanConverter}}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
