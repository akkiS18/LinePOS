<UserControl x:Class="PosElectro.Desktop.Views.DebtsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:PosElectro.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="712" d:DesignWidth="1366"
             PreviewKeyDown="DebtsView_PreviewKeyDown">
    <!-- Maket 3.x: Qarzlar (yorug' tema). Ranglar faqat tokenlardan — keyin dark rejim uchun. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/SmartControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <vm:MinorToUzConverter x:Key="MinorToUzConverter"/>
            <vm:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter"/>
            <vm:LessThanZeroConverter x:Key="LessThanZeroConverter"/>
            <vm:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
            <vm:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
            </Style>
            <Style x:Key="KpiLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="KpiValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="ExtraBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="ColHead" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
            </Style>
            <Style x:Key="Cell" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
            </Style>
            <Style x:Key="StatLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="StatValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="ModalError" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,12,0,0"/>
            </Style>
            <!-- Ko'p qatorli maydon -->
            <Style x:Key="FieldArea" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
                <Setter Property="Height" Value="72"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="AcceptsReturn" Value="True"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            </Style>

            <!-- Filtr belgisi (pill): Tag=True — tanlangan -->
            <Style x:Key="FilterPill" TargetType="Button">
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Margin" Value="0,0,6,6"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    CornerRadius="16" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Accent}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- 44×44 ikonka tugmasi (chegarali) -->
            <Style x:Key="IconBtn" TargetType="ButtonBase">
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ButtonBase">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tab (tagida chiziq): Tag=True — tanlangan -->
            <Style x:Key="LineTab" TargetType="Button">
                <Setter Property="Height" Value="46"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- "Boshqa amallar" menyusi qatori -->
            <Style x:Key="MenuRow" TargetType="Button">
                <Setter Property="Height" Value="40"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Bg}" TextElement.Foreground="{DynamicResource Ink}">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============ KPI ============ -->
            <UniformGrid Rows="1" Margin="-6,0,-6,12">
                <Border Style="{StaticResource Card}" Height="84" Padding="16,0" Margin="6,0">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Bad}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Jami qarz" Style="{StaticResource KpiLabel}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalActiveDebtText}" Style="{StaticResource KpiValue}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Height="84" Padding="16,0" Margin="6,0">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Qarzdorlar" Style="{StaticResource KpiLabel}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DebtorsCountText}" Style="{StaticResource KpiValue}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Height="84" Padding="16,0" Margin="6,0">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Bad}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Muddati o'tgan" Style="{StaticResource KpiLabel}"/>
                        </StackPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding OverdueDebtorsCountText}" FontSize="13" Foreground="{DynamicResource Ink3}"
                                       VerticalAlignment="Bottom" Margin="8,0,0,3"/>
                            <TextBlock Text="{Binding OverdueDebtText}" Style="{StaticResource KpiValue}" Foreground="{DynamicResource Bad}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Height="84" Padding="16,0" Margin="6,0">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Ok}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ortiqcha to'lov (haqdorlik)" Style="{StaticResource KpiLabel}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalCreditText}" Style="{StaticResource KpiValue}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Tor oynada mijozlar ro'yxati biroz torayadi, o'ng tomondagi jadval sig'adi -->
                    <ColumnDefinition Width="0.45*" MinWidth="280" MaxWidth="380"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============ 3.1 MIJOZLAR RO'YXATI ============ -->
                <Border Style="{StaticResource Card}" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Padding="12,12,12,6" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding OpenCreateCustomerModalCommand}" Style="{StaticResource BtnPrimary}"
                                            Height="44" Padding="12,0" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="16" Height="16" Margin="0,0,6,0">
                                                <Path Style="{StaticResource Ic}" StrokeThickness="2.4" Data="M12 5v14 M5 12h14"/>
                                            </Viewbox>
                                            <TextBlock Text="Mijoz" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Style="{StaticResource IconBtn}" Margin="8,0,0,0" ToolTip="Ro'yxatni yangilash">
                                        <Viewbox Width="17" Height="17">
                                            <Path Style="{StaticResource Ic}" Data="M20 11a8 8 0 0 0-14.5-4.5L4 8 M4 4v4h4 M4 13a8 8 0 0 0 14.5 4.5L20 16 M20 20v-4h-4"/>
                                        </Viewbox>
                                    </Button>
                                    <!-- Qidiruv -->
                                    <Border Height="44" CornerRadius="10" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                        <Grid>
                                            <Viewbox Width="17" Height="17" HorizontalAlignment="Left" Margin="12,0,0,0">
                                                <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink3}" Data="M11 4a7 7 0 1 0 0.01 0 M20 20l-3.5-3.5"/>
                                            </Viewbox>
                                            <TextBlock Text="Ism yoki telefon" Foreground="{DynamicResource Ink3}" FontSize="14" VerticalAlignment="Center" Margin="37,0,34,0"
                                                       IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasSearchQuery, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                            <TextBox x:Name="CustomerSearchBox" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent" BorderThickness="0" FontSize="14" Foreground="{DynamicResource Ink}"
                                                     CaretBrush="{DynamicResource AccentInk}" VerticalContentAlignment="Center" Padding="35,0,34,0"/>
                                            <Button Command="{Binding ClearSearchCommand}" Style="{StaticResource MenuRow}" Width="28" Height="28" Padding="0"
                                                    HorizontalAlignment="Right" Margin="0,0,6,0" ToolTip="Qidiruvni tozalash" HorizontalContentAlignment="Center"
                                                    Visibility="{Binding HasSearchQuery, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Viewbox Width="13" Height="13" Margin="7,0,0,0">
                                                    <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink2}" Data="M6 6l12 12 M18 6L6 18"/>
                                                </Viewbox>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DockPanel>
                                <!-- Filtrlar -->
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Hammasi" Command="{Binding SetFilterCommand}" CommandParameter="All" Tag="{Binding IsFilterAll}" Style="{StaticResource FilterPill}"/>
                                    <Button Content="Qarzdor" Command="{Binding SetFilterCommand}" CommandParameter="ActiveDebt" Tag="{Binding IsFilterActiveDebt}" Style="{StaticResource FilterPill}"/>
                                    <Button Content="Muddati o'tgan" Command="{Binding SetFilterCommand}" CommandParameter="Overdue" Tag="{Binding IsFilterOverdue}" Style="{StaticResource FilterPill}"/>
                                    <Button Content="Yopilgan" Command="{Binding SetFilterCommand}" CommandParameter="Settled" Tag="{Binding IsFilterSettled}" Style="{StaticResource FilterPill}"/>
                                    <Button Content="Haqdor" Command="{Binding SetFilterCommand}" CommandParameter="Credit" Tag="{Binding IsFilterCredit}" Style="{StaticResource FilterPill}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                                 Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="row" Background="Transparent" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1" Cursor="Hand">
                                                    <Grid>
                                                        <Border x:Name="bar" Width="3" HorizontalAlignment="Left" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
                                                        <ContentPresenter/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="row" Property="Background" Value="{DynamicResource Surface2}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="row" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                        <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="62" Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Bosh harflar -->
                                        <Border Width="38" Height="38" CornerRadius="19" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource IllusBg}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentInk}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource BadSoft}"/>
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Bad}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <DockPanel LastChildFill="False">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"
                                                           MaxWidth="150" ToolTip="{Binding Name}"/>
                                                <Border CornerRadius="5" Padding="6,1" Margin="6,0,0,0" Background="{DynamicResource BadSoft}" VerticalAlignment="Center"
                                                        Visibility="{Binding HasOverdue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="Muddati o'tgan" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Bad}"/>
                                                </Border>
                                                <Border CornerRadius="5" Padding="6,1" Margin="6,0,0,0" Background="{DynamicResource Surface2}" VerticalAlignment="Center"
                                                        Visibility="{Binding Archived, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="Bloklangan" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Ink2}"/>
                                                </Border>
                                            </DockPanel>
                                            <TextBlock Text="{Binding PhoneDisplay}" FontSize="12" Foreground="{DynamicResource Ink3}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding BalanceUz, StringFormat={}{0:N0}}" FontSize="14" FontWeight="Bold"
                                                   VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BalanceMinor, Converter={StaticResource LessThanZeroConverter}}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Ok}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="1" Text="Mijoz topilmadi" FontSize="14" Foreground="{DynamicResource Ink3}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Customers.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- ============ TAFSILOT: tanlanmagan holat ============ -->
                <Border Grid.Column="2" Style="{StaticResource Card}"
                        Visibility="{Binding IsCustomerSelected, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                        <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource Surface2}" HorizontalAlignment="Center">
                            <Viewbox Width="28" Height="28">
                                <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink3}" Data="M12 4a4 4 0 1 0 0.01 0 M5 21a7 7 0 0 1 14 0"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Mijoz tanlanmagan" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock Text="Qarz va to'lovlar tarixini ko'rish uchun chapdagi ro'yxatdan mijozni tanlang"
                                   FontSize="14" Foreground="{DynamicResource Ink3}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ============ TAFSILOT: tanlangan mijoz ============ -->
                <Grid Grid.Column="2" Visibility="{Binding IsCustomerSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sarlavha kartasi -->
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel>
                                <!-- Amallar (o'ngda) -->
                                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0">
                                    <Button Command="{Binding PrintStatementCommand}" Style="{StaticResource IconBtn}" Margin="0,0,8,0" ToolTip="Ko'chirma chop etish">
                                        <Viewbox Width="18" Height="18">
                                            <Path Style="{StaticResource Ic}" Data="M6 9V3h12v6 M5 9h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2z M7 14h10v7H7z"/>
                                        </Viewbox>
                                    </Button>
                                    <Button Command="{Binding OpenEditCustomerModalCommand}" Style="{StaticResource IconBtn}" Margin="0,0,8,0" ToolTip="Tahrirlash">
                                        <Viewbox Width="18" Height="18">
                                            <Path Style="{StaticResource Ic}" Data="M12 20h9 M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1l1-4z"/>
                                        </Viewbox>
                                    </Button>
                                    <!-- Boshqa amallar -->
                                    <Grid Margin="0,0,8,0">
                                        <ToggleButton x:Name="MoreToggle" Style="{StaticResource IconBtn}" ToolTip="Boshqa amallar">
                                            <Viewbox Width="18" Height="18">
                                                <Path Width="24" Height="24" Stretch="None" Fill="{DynamicResource Ink2}"
                                                      Data="M5 10.2a1.8 1.8 0 1 0 0.01 0z M12 10.2a1.8 1.8 0 1 0 0.01 0z M19 10.2a1.8 1.8 0 1 0 0.01 0z"/>
                                            </Viewbox>
                                        </ToggleButton>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=MoreToggle, Mode=TwoWay}" StaysOpen="False"
                                               PlacementTarget="{Binding ElementName=MoreToggle}" Placement="Bottom" HorizontalOffset="-176"
                                               AllowsTransparency="True" PopupAnimation="Fade">
                                            <Border Width="228" Margin="0,4,8,12" Padding="4" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                                                    BorderThickness="1" CornerRadius="10">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.14" Color="#0F1B21"/>
                                                </Border.Effect>
                                                <StackPanel>
                                                    <Button Content="Mijoz haqida" Command="{Binding OpenCustomerInfoModalCommand}" Click="MoreMenuItem_Click" Style="{StaticResource MenuRow}"/>
                                                    <Button Content="{Binding BlockButtonText}" Command="{Binding ToggleArchiveCustomerCommand}" Click="MoreMenuItem_Click"
                                                            Style="{StaticResource MenuRow}" Foreground="{DynamicResource Bad}"/>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <Button Command="{Binding TransferCreditCommand}" Style="{StaticResource BtnSecondary}" Height="44" Margin="0,0,8,0" Content="Qarzga o'tkazish"
                                            Visibility="{Binding CanTransferCredit, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Button Command="{Binding OpenRefundCreditModalCommand}" Style="{StaticResource BtnSecondary}" Height="44" Content="Pulni qaytarish"
                                            Visibility="{Binding HasCredit, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Button Command="{Binding OpenPaymentModalCommand}" Style="{StaticResource BtnPrimary}" Height="44" Padding="18,0"
                                            Visibility="{Binding HasActiveDebt, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                                <Path Style="{StaticResource Ic}" Data="M4 6h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z M12 9.5a2.5 2.5 0 1 0 0.01 0"/>
                                            </Viewbox>
                                            <TextBlock Text="To'lov olish" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                                <!-- Bosh harflar -->
                                <Border Width="48" Height="48" CornerRadius="24" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource IllusBg}"/>
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentInk}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCustomer.HasOverdue}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BadSoft}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Bad}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SelectedCustomer.Initials}" FontSize="16" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding SelectedCustomer.Name, Mode=OneWay}" FontSize="18" FontWeight="Bold"/>
                                        <Run Text="·" FontSize="13" Foreground="{DynamicResource Ink3}"/>
                                        <Run Text="{Binding SelectedCustomer.StatusBadge, Mode=OneWay}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Ink3}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding SelectedCustomer.PhoneDisplay}" FontSize="13" Foreground="{DynamicResource Ink2}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Ko'rsatkichlar -->
                            <UniformGrid Rows="1" Margin="-5,14,-5,0">
                                <Border CornerRadius="10" Padding="14,10" Margin="5,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasActiveDebt}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BadSoft}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Bad}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasCredit}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource OkSoft}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Ok}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="Joriy holat" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <!-- Summa hech qachon "..." bo'lib kesilmaydi: joy yetmasa biroz kichrayadi -->
                                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding SelectedCustomer.BalanceDisplay}" FontSize="20" FontWeight="ExtraBold"
                                                       ToolTip="{Binding SelectedCustomer.BalanceDisplay}"/>
                                        </Viewbox>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="10" Padding="14,10" Margin="5,0" Background="{DynamicResource Surface2}">
                                    <StackPanel>
                                        <TextBlock Text="Jami savdo" Style="{StaticResource StatLabel}"/>
                                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
    <TextBlock Text="{Binding SelectedCustomer.OriginalDebtMinor, Converter={StaticResource MinorToUzConverter}, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}"/>
                                        </Viewbox>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="10" Padding="14,10" Margin="5,0" Background="{DynamicResource Surface2}">
                                    <StackPanel>
                                        <TextBlock Text="To'langan" Style="{StaticResource StatLabel}"/>
                                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
    <TextBlock Text="{Binding SelectedCustomer.TotalPaidMinor, Converter={StaticResource MinorToUzConverter}, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}"/>
                                        </Viewbox>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="10" Padding="14,10" Margin="5,0" Background="{DynamicResource Surface2}">
                                    <StackPanel>
                                        <TextBlock Text="Eng yaqin muddat" Style="{StaticResource StatLabel}" ToolTip="Eng yaqin to'lov muddati"/>
                                        <TextBlock Text="{Binding SelectedCustomer.EarliestDueDate, TargetNullValue=—, FallbackValue=—}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedCustomer.HasOverdue}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Tablar va jadvallar -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Padding="12,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding SelectDetailTabCommand}" CommandParameter="0" Tag="{Binding IsAccountsTabSelected}" Style="{StaticResource LineTab}">
                                        <TextBlock>
                                            <Run Text="Nasiya cheklari"/>
                                            <Run Text="{Binding SelectedCustomerAccounts.Count, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Button>
                                    <Button Command="{Binding SelectDetailTabCommand}" CommandParameter="1" Tag="{Binding IsHistoryTabSelected}" Style="{StaticResource LineTab}">
                                        <TextBlock>
                                            <Run Text="To'lovlar tarixi"/>
                                            <Run Text="{Binding SelectedCustomerEvents.Count, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- ===== 3.1 Nasiya cheklari ===== -->
                            <Grid Grid.Row="1" Visibility="{Binding IsAccountsTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource Surface2}" Padding="16,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" MinWidth="90"/>
                                            <ColumnDefinition Width="118"/>
                                            <ColumnDefinition Width="*" MinWidth="72"/>
                                            <ColumnDefinition Width="*" MinWidth="72"/>
                                            <ColumnDefinition Width="*" MinWidth="72"/>
                                            <ColumnDefinition Width="88"/>
                                            <ColumnDefinition Width="112"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="CHEK №" Style="{StaticResource ColHead}"/>
                                        <TextBlock Grid.Column="1" Text="SANA" Style="{StaticResource ColHead}"/>
                                        <TextBlock Grid.Column="2" Text="SUMMA" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Text="QOPLANGAN" Style="{StaticResource ColHead}" HorizontalAlignment="Right" ToolTip="To&apos;lov va qaytarishlar hisobidan yopilgan qism"/>
                                        <TextBlock Grid.Column="4" Text="QOLDIQ" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="5" Text="MUDDATI" Style="{StaticResource ColHead}"/>
                                        <TextBlock Grid.Column="6" Text="HOLATI" Style="{StaticResource ColHead}" Margin="0"/>
                                    </Grid>
                                </Border>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding SelectedCustomerAccounts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border MinHeight="46" Padding="16,0" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.2*" MinWidth="90"/>
                                                            <ColumnDefinition Width="118"/>
                                                            <ColumnDefinition Width="*" MinWidth="72"/>
                                                            <ColumnDefinition Width="*" MinWidth="72"/>
                                                            <ColumnDefinition Width="*" MinWidth="72"/>
                                                            <ColumnDefinition Width="88"/>
                                                            <ColumnDefinition Width="112"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding ReceiptNumber}" Style="{StaticResource Cell}" FontWeight="SemiBold" Foreground="{DynamicResource AccentInk}"
                                                                   ToolTip="{Binding ReceiptNumber}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding CreatedAtDisplay}" Style="{StaticResource Cell}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding OriginalDebtUz, StringFormat={}{0:N0}}" Style="{StaticResource Cell}"
                                                                   Foreground="{DynamicResource Ink}" HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding PaidUz, StringFormat={}{0:N0}}" Style="{StaticResource Cell}" HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding BalanceUz, StringFormat={}{0:N0}}" Style="{StaticResource Cell}"
                                                                   Foreground="{DynamicResource Ink}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding DueDateDisplay}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Border Grid.Column="6" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentInk}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource BadSoft}"/>
                                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Bad}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding BalanceMinor, Converter={StaticResource GreaterThanZeroConverter}}" Value="False">
                                                                            <Setter Property="Background" Value="{DynamicResource OkSoft}"/>
                                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Ok}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Grid.Row="1" Text="Nasiya cheklari yo'q" FontSize="14" Foreground="{DynamicResource Ink3}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCustomerAccounts.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- ===== 3.3 To'lovlar tarixi ===== -->
                            <Grid Grid.Row="1" Visibility="{Binding IsHistoryTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource Surface2}" Padding="16,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="1.3*" MinWidth="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1.3*"/>
                                            <ColumnDefinition Width="1.3*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="SANA, VAQT" Style="{StaticResource ColHead}"/>
                                        <TextBlock Grid.Column="1" Text="TURI" Style="{StaticResource ColHead}"/>
                                        <TextBlock Grid.Column="2" Text="SUMMA" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Text="USUL" Style="{StaticResource ColHead}"/>
                                        <TextBlock Grid.Column="4" Text="TAFSILOT" Style="{StaticResource ColHead}"/>
                                    </Grid>
                                </Border>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding SelectedCustomerEvents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border MinHeight="46" Padding="16,0" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="1.3*" MinWidth="150"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="1.3*"/>
                                                            <ColumnDefinition Width="1.3*"/>
                                                            <ColumnDefinition Width="44"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding OccurredAtDisplay}" Style="{StaticResource Cell}"/>
                                                        <Border Grid.Column="1" CornerRadius="6" Padding="8,3" Margin="0,0,12,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource WarnSoft}"/>
                                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Warn}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="payment">
                                                                            <Setter Property="Background" Value="{DynamicResource OkSoft}"/>
                                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Ok}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="sale_open">
                                                                            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentInk}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="payment_reversal">
                                                                            <Setter Property="Background" Value="{DynamicResource BadSoft}"/>
                                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Bad}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="return_reversal">
                                                                            <Setter Property="Background" Value="{DynamicResource BadSoft}"/>
                                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Bad}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsReversed}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink3}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding KindDisplay}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding KindDisplay}"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="2" Text="{Binding AmountDisplay}" HorizontalAlignment="Right">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="payment">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Ok}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsReversed}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
                                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="3" Text="{Binding MethodDisplay}" Style="{StaticResource Cell}" ToolTip="{Binding MethodDisplay}"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding DetailsDisplay}" Style="{StaticResource Cell}" ToolTip="{Binding DetailsDisplay}"/>
                                                        <Button Grid.Column="5" Width="36" Height="36" HorizontalAlignment="Right" ToolTip="To'lovni bekor qilish"
                                                                Command="{Binding DataContext.ReversePaymentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" Style="{StaticResource MenuRow}" Padding="0" Foreground="{DynamicResource Bad}"
                                                                Visibility="{Binding CanReverse, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Viewbox Width="16" Height="16" Margin="10,0,0,0">
                                                                <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Bad}" Data="M9 14L4 9l5-5 M4 9h10a6 6 0 0 1 0 12h-3"/>
                                                            </Viewbox>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Grid.Row="1" Text="Hali amal yo'q" FontSize="14" Foreground="{DynamicResource Ink3}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCustomerEvents.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================= 3.4 YANGI MIJOZ / TAHRIRLASH ================= -->
        <Border Background="{DynamicResource Scrim}" Panel.ZIndex="100"
                Visibility="{Binding IsCustomerModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{StaticResource ModalCard}" Width="440" Padding="24,22">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="Nasiya uchun" FontSize="12" Foreground="{DynamicResource Ink3}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBlock FontSize="18" FontWeight="Bold" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Yangi mijoz"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditingCustomer}" Value="True">
                                            <Setter Property="Text" Value="Mijozni tahrirlash"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                    <TextBlock Margin="0,14,0,6" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}">
                        <Run Text="Ism familiya"/> <Run Text="*" Foreground="{DynamicResource Bad}"/>
                    </TextBlock>
                    <TextBox Text="{Binding ModalCustomerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" IsVisibleChanged="FocusWhenShown"/>
                    <TextBlock Text="Telefon" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding ModalCustomerPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                    <TextBlock Margin="0,14,0,6" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap">
                        <Run Text="Izoh"/> <Run Text="— manzil, kim tavsiya qilgan (ixtiyoriy)" FontWeight="Normal" Foreground="{DynamicResource Ink3}"/>
                    </TextBlock>
                    <TextBox Text="{Binding ModalCustomerNote, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldArea}"/>
                    <TextBlock Text="{Binding ModalCustomerErrorMessage}" Style="{StaticResource ModalError}"
                               Visibility="{Binding ModalCustomerErrorMessage, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                    <DockPanel Margin="0,18,0,0">
                        <Button DockPanel.Dock="Left" Command="{Binding CloseCustomerModalCommand}" Style="{StaticResource BtnSecondary}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Bekor qilish" VerticalAlignment="Center"/>
                                <TextBlock Text="Esc" Style="{StaticResource Kbd}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveCustomerModalCommand}" Style="{StaticResource BtnPrimary}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Saqlash" VerticalAlignment="Center"/>
                                <TextBlock Text="Enter" Style="{StaticResource Kbd}"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ================= 3.2 QARZ TO'LOVINI QABUL QILISH ================= -->
        <Border Background="{DynamicResource Scrim}" Panel.ZIndex="100"
                Visibility="{Binding IsPaymentModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{StaticResource ModalCard}" Width="520">
                <StackPanel>
                    <DockPanel Margin="24,18,16,8">
                        <Button DockPanel.Dock="Right" Command="{Binding ClosePaymentModalCommand}" Style="{StaticResource CloseBtn}" ToolTip="Yopish" VerticalAlignment="Top">
                            <Viewbox Width="18" Height="18">
                                <Path Style="{StaticResource Ic}" Data="M6 6l12 12 M18 6L6 18"/>
                            </Viewbox>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="To'lov qabul qilish" FontSize="20" FontWeight="Bold"/>
                            <TextBlock FontSize="13" Foreground="{DynamicResource Ink2}" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding SelectedCustomer.Name, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding SelectedCustomer.PhoneDisplay, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Margin="24,8,24,0">
                        <!-- Joriy qarz -->
                        <Border CornerRadius="10" Padding="14,12" Background="{DynamicResource BadSoft}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedCustomer.BalanceDisplay}" FontSize="22" FontWeight="ExtraBold" Foreground="{DynamicResource Bad}"/>
                                <TextBlock Text="Joriy qarz" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Bad}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <!-- To'lov turi -->
                        <Border Margin="0,16,0,0" Padding="4" CornerRadius="10" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <UniformGrid Rows="1">
                                <Button Content="Naqd" Command="{Binding SelectPaymentTypeCommand}" CommandParameter="0" Tag="{Binding IsPaymentCash}" Style="{StaticResource SegTab}"/>
                                <Button Content="Karta" Command="{Binding SelectPaymentTypeCommand}" CommandParameter="1" Tag="{Binding IsPaymentCard}" Style="{StaticResource SegTab}"/>
                                <Button Content="Aralash" Command="{Binding SelectPaymentTypeCommand}" CommandParameter="2" Tag="{Binding IsPaymentSplit}" Style="{StaticResource SegTab}"/>
                            </UniformGrid>
                        </Border>
                        <!-- Summa -->
                        <StackPanel Margin="0,16,0,0" Visibility="{Binding IsPaymentSplit, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <TextBlock Text="To'lov summasi" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding PaymentAmountInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBoxBig}" Tag="so'm"
                                     IsVisibleChanged="FocusWhenShown"/>
                        </StackPanel>
                        <Grid Margin="0,16,0,0" Visibility="{Binding IsPaymentSplit, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Naqd qismi" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding PaymentCashInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBoxBig}" Tag="so'm"
                                         IsVisibleChanged="FocusWhenShown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Karta qismi" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding PaymentCardInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBoxBig}" Tag="so'm"/>
                            </StackPanel>
                        </Grid>
                        <!-- Taqsimot -->
                        <Border Margin="0,16,0,0" CornerRadius="10" Padding="14,12" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Taqsimot (eng eski chekdan boshlab)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap"/>
                                <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                    <ItemsControl ItemsSource="{Binding AllocationPreviewLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock DockPanel.Dock="Right" FontSize="13" FontWeight="SemiBold" Margin="12,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding NewBalanceMinor, Converter={StaticResource GreaterThanZeroConverter}}" Value="False">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Ok}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <Run Text="{Binding PaidMinor, Converter={StaticResource MinorToUzConverter}, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                                        <Run Text="— qoldiq"/>
                                                        <Run Text="{Binding NewBalanceMinor, Converter={StaticResource MinorToUzConverter}, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding ReceiptNumber}" FontSize="13" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Border BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,1,0,0" Padding="0,6,0,0"
                                        Visibility="{Binding PreviewRemainingDebtText, Converter={StaticResource EmptyStringToVisibilityConverter}}">
                                    <TextBlock Text="{Binding PreviewRemainingDebtText}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding PaymentErrorMessage}" Style="{StaticResource ModalError}"
                                   Visibility="{Binding PaymentErrorMessage, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                    </StackPanel>
                    <DockPanel Margin="24,18,24,20">
                        <Button DockPanel.Dock="Left" Command="{Binding ClosePaymentModalCommand}" Style="{StaticResource BtnSecondary}" Height="52" Padding="18,0" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Bekor qilish" VerticalAlignment="Center"/>
                                <TextBlock Text="Esc" Style="{StaticResource Kbd}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ConfirmPaymentCommand}" Style="{StaticResource BtnPrimary}" Height="52" FontSize="16"
                                IsEnabled="{Binding IsSubmittingPayment, Converter={StaticResource InverseBooleanConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="To'lovni qabul qilish" VerticalAlignment="Center"/>
                                <TextBlock Text="Enter" Style="{StaticResource Kbd}"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ================= 3.5 ORTIQCHA PULNI QAYTARISH ================= -->
        <Border Background="{DynamicResource Scrim}" Panel.ZIndex="100"
                Visibility="{Binding IsRefundCreditModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{StaticResource ModalCard}" Width="480">
                <StackPanel>
                    <DockPanel Margin="24,18,16,8">
                        <Button DockPanel.Dock="Right" Command="{Binding CloseRefundCreditModalCommand}" Style="{StaticResource CloseBtn}" ToolTip="Yopish" VerticalAlignment="Top">
                            <Viewbox Width="18" Height="18">
                                <Path Style="{StaticResource Ic}" Data="M6 6l12 12 M18 6L6 18"/>
                            </Viewbox>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="Ortiqcha pulni qaytarish" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedCustomer.Name}" FontSize="13" Foreground="{DynamicResource Ink2}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Margin="24,8,24,0">
                        <Border CornerRadius="10" Padding="14,12" Background="{DynamicResource OkSoft}">
                            <TextBlock Text="{Binding RefundCreditMaxAmountText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ok}" TextWrapping="Wrap"/>
                        </Border>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Naqd qaytariladi" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding RefundCreditCashInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBoxBig}" Tag="so'm"
                                         IsVisibleChanged="FocusWhenShown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Kartaga qaytariladi" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding RefundCreditCardInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBoxBig}" Tag="so'm"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding RefundCreditErrorMessage}" Style="{StaticResource ModalError}"
                                   Visibility="{Binding RefundCreditErrorMessage, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                    </StackPanel>
                    <DockPanel Margin="24,18,24,20">
                        <Button DockPanel.Dock="Left" Command="{Binding CloseRefundCreditModalCommand}" Style="{StaticResource BtnSecondary}" Height="52" Padding="18,0" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Bekor qilish" VerticalAlignment="Center"/>
                                <TextBlock Text="Esc" Style="{StaticResource Kbd}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ConfirmRefundCreditCommand}" Style="{StaticResource BtnPrimary}" Height="52" FontSize="16"
                                IsEnabled="{Binding IsSubmittingRefundCredit, Converter={StaticResource InverseBooleanConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Pulni qaytarish" VerticalAlignment="Center"/>
                                <TextBlock Text="Enter" Style="{StaticResource Kbd}"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ================= 3.6 MIJOZ HAQIDA MA'LUMOT ================= -->
        <Border Background="{DynamicResource Scrim}" Panel.ZIndex="100"
                Visibility="{Binding IsCustomerInfoModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{StaticResource ModalCard}" Width="440" Padding="24,22">
                <StackPanel>
                    <DockPanel>
                        <Border Width="48" Height="48" CornerRadius="24" Margin="0,0,14,0" Background="{DynamicResource IllusBg}">
                            <TextBlock Text="{Binding SelectedCustomer.Initials}" FontSize="16" FontWeight="ExtraBold" Foreground="{DynamicResource AccentInk}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedCustomer.Name}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedCustomer.StatusBadge}" FontSize="13" Foreground="{DynamicResource Ink3}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Margin="0,16,0,0" CornerRadius="10" Padding="14,12" Background="{DynamicResource Surface2}">
                        <StackPanel>
                            <TextBlock Text="Telefon" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding SelectedCustomer.PhoneDisplay}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,10,0,0" CornerRadius="10" Padding="14,12" Background="{DynamicResource Surface2}">
                        <StackPanel>
                            <TextBlock Text="Izoh" Style="{StaticResource StatLabel}"/>
                            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                                <TextBlock Text="{Binding SelectedCustomerNoteOrEmpty}" FontSize="14" TextWrapping="Wrap" LineHeight="20"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding CloseCustomerInfoModalCommand}" Style="{StaticResource BtnSecondary}" Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Yopish" VerticalAlignment="Center"/>
                            <TextBlock Text="Esc" Style="{StaticResource Kbd}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Border>

        <!-- ================= 3.7 MIJOZNI BLOKLASH (TASDIQ) ================= -->
        <Border Background="{DynamicResource Scrim}" Panel.ZIndex="200"
                Visibility="{Binding IsBlockConfirmOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{StaticResource ModalCard}" Width="460" Padding="24">
                <StackPanel>
                    <DockPanel>
                        <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource WarnSoft}" VerticalAlignment="Top" Margin="0,0,14,0">
                            <Viewbox Width="22" Height="22">
                                <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Warn}" Data="M6 11h12a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1z M8 11V8a4 4 0 0 1 8 0v3"/>
                            </Viewbox>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding BlockConfirmTitle}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedCustomer.Name}" FontSize="14" Foreground="{DynamicResource Ink2}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Background="{DynamicResource Surface2}" CornerRadius="10" Padding="12,10" Margin="0,14,0,0">
                        <TextBlock Text="Bloklangan mijozning mavjud qarzlari saqlanib qoladi va ularga to'lov qabul qilish mumkin, biroq yangi nasiya ochib bo'lmaydi."
                                   FontSize="13" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" LineHeight="19"/>
                    </Border>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding CancelToggleArchiveCommand}" Style="{StaticResource BtnSecondary}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Bekor" VerticalAlignment="Center"/>
                                <TextBlock Text="Esc" Style="{StaticResource Kbd}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding ConfirmToggleArchiveCommand}" Style="{StaticResource BtnDanger}" Content="{Binding BlockConfirmButtonText}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
