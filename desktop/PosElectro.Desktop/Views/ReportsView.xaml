<UserControl x:Class="PosElectro.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="clr-namespace:PosElectro.Desktop.Services"
             xmlns:models="clr-namespace:PosElectro.Desktop.Models"
             mc:Ignorable="d"
             d:DesignHeight="712" d:DesignWidth="1366">
    <!-- Maket 4.1 (Hisobotlar) va 4.4 (sana oralig'i). Yorug' tema; ranglar faqat tokenlardan. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/SmartControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
            </Style>
            <Style x:Key="KpiLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="KpiValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontWeight" Value="ExtraBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="Margin" Value="0,2,0,2"/>
            </Style>
            <Style x:Key="KpiSub" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="ColHead" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
            </Style>
            <Style x:Key="Cell" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
            </Style>
            <Style x:Key="AxisLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </Style>

            <!-- Filtr ro'yxati (44px) -->
            <Style x:Key="FilterCombo" TargetType="ComboBox" BasedOn="{StaticResource FieldCombo}">
                <Setter Property="MinWidth" Value="150"/>
                <Setter Property="MaxWidth" Value="210"/>
                <Setter Property="Margin" Value="8,8,0,0"/>
                <Setter Property="FontWeight" Value="Medium"/>
            </Style>

            <!-- 44px chegarali tugma (kurs, Excel, yangilash, sana) -->
            <Style x:Key="ToolBtn" TargetType="Button">
                <Setter Property="Height" Value="44"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Qatordagi / kalendardagi yengil tugma -->
            <Style x:Key="GhostBtn" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="WeekDay" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,2"/>
            </Style>

            <!-- Kalendar kuni: ranglar holatga qarab tokenlardan -->
            <DataTemplate x:Key="DayTpl">
                <Border CornerRadius="{Binding ItemCornerRadius}" Height="34" Margin="0,1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInRange}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelectedEdge}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                </DataTrigger>
                                <!-- Qo'shni oy kunlari bo'yalmaydi (o'z oyida ko'rinadi) -->
                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                    <Setter Property="Background" Value="Transparent"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Button Command="{Binding DataContext.DatePicker.SelectDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" Cursor="Hand" Padding="0"
                            BorderThickness="{Binding ItemBorderThickness}" BorderBrush="{DynamicResource Accent}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="dayB" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{Binding ItemCornerRadius}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                            <Condition Binding="{Binding IsSelectedEdge}" Value="False"/>
                                            <Condition Binding="{Binding IsInRange}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="dayB" Property="Background" Value="{DynamicResource Surface2}"/>
                                    </MultiDataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="{Binding DayNumber}" FontWeight="{Binding ItemFontWeight}" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsInRange}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelectedEdge}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Bg}" TextElement.Foreground="{DynamicResource Ink}">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============ FILTRLAR ============ -->
            <DockPanel Margin="0,0,0,12">
                <!-- O'ng: kurs, Excel, yangilash -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Top">
                    <Button Command="{Binding RefreshUsdRateCommand}" Style="{StaticResource ToolBtn}" FontSize="13" FontWeight="Normal"
                            Foreground="{DynamicResource Ink2}" ToolTip="Markaziy bank kursini yangilash">
                        <TextBlock Text="{Binding UsdRateText}"/>
                    </Button>
                    <Button Command="{Binding ExecuteExportCommand}" Style="{StaticResource ToolBtn}" Padding="14,0" Margin="8,0,0,0"
                            BorderBrush="{DynamicResource LineStrong}" ToolTip="Ekrandagi hisobotni Excel faylga yuklab olish">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="17" Height="17" Margin="0,0,8,0">
                                <Path Style="{StaticResource Ic}" Data="M12 4v11 M7 10l5 5l5-5 M5 20h14"/>
                            </Viewbox>
                            <TextBlock Text="Excel" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource ToolBtn}" Width="44" Padding="0" Margin="8,0,0,0"
                            Foreground="{DynamicResource Ink2}" ToolTip="Ma'lumotlarni qayta yuklash">
                        <Viewbox Width="17" Height="17">
                            <Path Style="{StaticResource Ic}" Data="M20 11a8 8 0 0 0-14.5-4.5L4 8 M4 4v4h4 M4 13a8 8 0 0 0 14.5 4.5L20 16 M20 20v-4h-4"/>
                        </Viewbox>
                    </Button>
                </StackPanel>

                <!-- Tor oynada filtrlar ikkinchi qatorga o'tadi (kesilib qolmaydi) -->
                <WrapPanel Orientation="Horizontal" Margin="0,-8,0,0">
                    <!-- Sana oralig'i -->
                    <Button x:Name="BtnDateRangeDropdown" Command="{Binding ToggleDatePickerCommand}" Style="{StaticResource ToolBtn}" Padding="14,0" Margin="0,8,0,0"
                            BorderBrush="{DynamicResource Accent}" BorderThickness="1.5">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="17" Height="17" Margin="0,0,10,0">
                                <Path Style="{StaticResource Ic}" Stroke="{DynamicResource AccentInk}" Data="M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z M4 10h16 M8 3v4 M16 3v4"/>
                            </Viewbox>
                            <TextBlock Text="{Binding SelectedDateDisplay}" VerticalAlignment="Center"/>
                            <Viewbox Width="13" Height="13" Margin="10,0,0,0">
                                <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink3}" Data="M6 9l6 6l6-6"/>
                            </Viewbox>
                        </StackPanel>
                    </Button>

                    <!-- ============ 4.4 SANA ORALIG'INI TANLASH ============ -->
                    <Popup IsOpen="{Binding IsDateRangePickerOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=BtnDateRangeDropdown}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="4">
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16"
                                Margin="0,0,16,20" TextElement.Foreground="{DynamicResource Ink}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.18" Color="#0F1B21"/>
                            </Border.Effect>
                            <StackPanel Width="720">
                                <Grid Margin="18,18,18,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Tez tanlov -->
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="TEZ TANLOV" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Ink3}" Margin="10,0,0,8"/>
                                        <Button Content="Bugun" Command="{Binding QuickApplyPresetCommand}" CommandParameter="today" Style="{StaticResource GhostBtn}"
                                                Height="36" Padding="10,0" HorizontalContentAlignment="Left" Foreground="{DynamicResource Ink}" FontSize="13"/>
                                        <Button Content="Kecha" Command="{Binding QuickApplyPresetCommand}" CommandParameter="yesterday" Style="{StaticResource GhostBtn}"
                                                Height="36" Padding="10,0" HorizontalContentAlignment="Left" Foreground="{DynamicResource Ink}" FontSize="13"/>
                                        <Button Content="Oxirgi 7 kun" Command="{Binding QuickApplyPresetCommand}" CommandParameter="last7" Style="{StaticResource GhostBtn}"
                                                Height="36" Padding="10,0" HorizontalContentAlignment="Left" Foreground="{DynamicResource Ink}" FontSize="13"/>
                                        <Button Content="Shu oy" Command="{Binding QuickApplyPresetCommand}" CommandParameter="this_month" Style="{StaticResource GhostBtn}"
                                                Height="36" Padding="10,0" HorizontalContentAlignment="Left" Foreground="{DynamicResource Ink}" FontSize="13"/>
                                        <Button Content="O'tgan oy" Command="{Binding QuickApplyPresetCommand}" CommandParameter="last_month" Style="{StaticResource GhostBtn}"
                                                Height="36" Padding="10,0" HorizontalContentAlignment="Left" Foreground="{DynamicResource Ink}" FontSize="13"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource Line}"/>
                                    <!-- Ikki oy yonma-yon -->
                                    <Grid Grid.Column="2" Margin="16,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Button Command="{Binding DatePicker.PreviousMonthCommand}" Style="{StaticResource GhostBtn}" Width="32" Height="32"
                                                        HorizontalAlignment="Left" ToolTip="Oldingi oy">
                                                    <Viewbox Width="14" Height="14">
                                                        <Path Style="{StaticResource Ic}" Data="M15 6l-6 6l6 6"/>
                                                    </Viewbox>
                                                </Button>
                                                <TextBlock Text="{Binding DatePicker.LeftMonthTitle}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <UniformGrid Columns="7">
                                                <TextBlock Text="Du" Style="{StaticResource WeekDay}"/>
                                                <TextBlock Text="Se" Style="{StaticResource WeekDay}"/>
                                                <TextBlock Text="Ch" Style="{StaticResource WeekDay}"/>
                                                <TextBlock Text="Pa" Style="{StaticResource WeekDay}"/>
                                                <TextBlock Text="Ju" Style="{StaticResource WeekDay}"/>
                                                <TextBlock Text="Sh" Style="{StaticResource WeekDay}"/>
                                                <TextBlock Text="Ya" Style="{StaticResource WeekDay}"/>
                                            </UniformGrid>
                                            <ItemsControl ItemsSource="{Binding DatePicker.LeftDays}" ItemTemplate="{StaticResource DayTpl}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="7"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="{Binding DatePicker.RightMonthTitle}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Button Command="{Binding DatePicker.NextMonthCommand}" Style="{StaticResource GhostBtn}" Width="32" Height="32"
                                                        HorizontalAlignment="Right" ToolTip="Keyingi oy">
                                                    <Viewbox Width="14" Height="14">
                                                        <Path Style="{StaticResource Ic}" Data="M9 6l6 6l-6 6"/>
                                                    </Viewbox>
                                                </Button>
                                            </Grid>
                                            <UniformGrid Columns="7">
                                                <TextBlock Text="Du" Style="{StaticResource WeekDay}"/>
                                                <TextBlock Text="Se" Style="{StaticResource WeekDay}"/>
                                                <TextBlock Text="Ch" Style="{StaticResource WeekDay}"/>
                                                <TextBlock Text="Pa" Style="{StaticResource WeekDay}"/>
                                                <TextBlock Text="Ju" Style="{StaticResource WeekDay}"/>
                                                <TextBlock Text="Sh" Style="{StaticResource WeekDay}"/>
                                                <TextBlock Text="Ya" Style="{StaticResource WeekDay}"/>
                                            </UniformGrid>
                                            <ItemsControl ItemsSource="{Binding DatePicker.RightDays}" ItemTemplate="{StaticResource DayTpl}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="7"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                                <!-- Pastki qism -->
                                <Border Margin="0,14,0,0" Padding="18,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="Tozalash" Command="{Binding DatePicker.ResetCommand}" Style="{StaticResource BtnSecondary}" Height="40" Margin="0,0,10,0"/>
                                            <Button Content="Qo'llash" Command="{Binding ApplyDateRangePickerCommand}" Style="{StaticResource BtnPrimary}" Height="40" Padding="22,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DatePicker.SelectedRangeText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentInk}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}" DisplayMemberPath="Name"
                              Style="{StaticResource FilterCombo}" ToolTip="Ombor bo'yicha filtr"/>
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                              Style="{StaticResource FilterCombo}" ToolTip="Kategoriya bo'yicha filtr"/>
                    <ComboBox ItemsSource="{Binding RecordKinds}" SelectedItem="{Binding SelectedRecordKind}"
                              Style="{StaticResource FilterCombo}" MinWidth="130" ToolTip="Amal turi bo'yicha filtr"/>
                </WrapPanel>
            </DockPanel>

            <!-- ============ STATISTIKA SARLAVHASI (yig'ish / ochish) ============ -->
            <!-- Ko'rsatkichlar va grafikni yig'ib qo'yish mumkin: cheklar jadvali ko'proq joy oladi. Holat eslab qolinadi. -->
            <DockPanel Grid.Row="1" Height="28" Margin="0,0,0,8" LastChildFill="True">
                <Button DockPanel.Dock="Left" Style="{StaticResource GhostBtn}" Height="28" Padding="6,0,10,0" Focusable="False"
                        Command="{Binding ToggleStatsCommand}">
                    <Button.ToolTip>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Statistikani yig'ib qo'yish — cheklar ko'proq joy oladi"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatsCollapsed}" Value="True">
                                            <Setter Property="Text" Value="Statistikani ochish"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button.ToolTip>
                    <StackPanel Orientation="Horizontal">
                        <Viewbox x:Name="StatsChevron" Width="16" Height="16" RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform>
                                <RotateTransform x:Name="StatsChevronRotate" Angle="0"/>
                            </Viewbox.RenderTransform>
                            <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink2}" StrokeThickness="2.4" Data="M6 9l6 6l6-6"/>
                        </Viewbox>
                        <TextBlock Text="Statistika" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- Yig'ilgan holatda asosiy raqamlar bir qatorda qoladi -->
                <TextBlock x:Name="StatsSummary" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="13" Foreground="{DynamicResource Ink2}"
                           TextTrimming="CharacterEllipsis" Opacity="0" IsHitTestVisible="False">
                    <Run Text="Jami tushum"/> <Run Text="{Binding TotalRevenueText, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                    <Run Text="  ·  "/> <Run Text="{Binding TotalSalesCountText, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                    <Run Text="  ·  "/> <Run Text="Sotilgan"/> <Run Text="{Binding TotalItemsCountText, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                </TextBlock>
            </DockPanel>

            <!-- Yig'iladigan qism: balandligi animatsiya bilan o'zgaradi, ichidagilar pastga yopishgan — yig'ilganda yuqoriga chiqib ketadi -->
            <Border x:Name="StatsHost" Grid.Row="2" ClipToBounds="True">
            <StackPanel x:Name="StatsContent" VerticalAlignment="Bottom">
            <!-- ============ KPI ============ -->
            <UniformGrid Rows="1" Margin="-6,0,-6,12">
                <Border Style="{StaticResource Card}" Height="96" Padding="16,0" Margin="6,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Jami tushum" Style="{StaticResource KpiLabel}"/>
                        <TextBlock Text="{Binding TotalRevenueText}" Style="{StaticResource KpiValue}"/>
                        <TextBlock Style="{StaticResource KpiSub}">
                            <Run Text="Naqd"/> <Run Text="{Binding TotalCashRevenueText, Mode=OneWay}"/> <Run Text="·"/> <Run Text="Karta"/> <Run Text="{Binding TotalCardRevenueText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Height="96" Padding="16,0" Margin="6,0">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Sof foyda" Style="{StaticResource KpiLabel}"/>
                            <Viewbox Width="13" Height="13" Margin="6,0,0,0"
                                     Visibility="{Binding IsLocked, Source={x:Static services:AdminGate.Current}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink3}" Data="M6 11h12a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1z M8 11V8a4 4 0 0 1 8 0v3"/>
                            </Viewbox>
                        </StackPanel>
                        <!-- Qulflangan: raqam yashirin -->
                        <DockPanel Margin="0,2,0,2"
                                   Visibility="{Binding IsLocked, Source={x:Static services:AdminGate.Current}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button DockPanel.Dock="Right" Command="{Binding UnlockCommand, Source={x:Static services:AdminGate.Current}}" Content="PIN bilan ochish"
                                    Style="{StaticResource ToolBtn}" Height="32" Padding="10,0" FontSize="12" FontWeight="Bold"
                                    Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" Foreground="{DynamicResource AccentInk}" VerticalAlignment="Center"/>
                            <TextBlock Text="•••• ••••" FontSize="24" FontWeight="ExtraBold" Foreground="{DynamicResource Ink3}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <!-- Ochiq: foyda -->
                        <DockPanel Margin="0,2,0,2" LastChildFill="False"
                                   Visibility="{Binding CanSeeSecrets, Source={x:Static services:AdminGate.Current}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding TotalProfitText}" FontSize="24" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Ok}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProfitNegative}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding TotalProfitUsdText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}" VerticalAlignment="Bottom" Margin="8,0,0,4"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource KpiSub}" Foreground="{DynamicResource Ink3}">
                            <Run Text="Karta solig'i hisobga olingan:"/> <Run Text="{Binding TotalTaxAmountText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Height="96" Padding="16,0" Margin="6,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Savdolar soni" Style="{StaticResource KpiLabel}"/>
                        <TextBlock Text="{Binding TotalSalesCountText}" Style="{StaticResource KpiValue}"/>
                        <TextBlock Text="{Binding SalesSubText}" Style="{StaticResource KpiSub}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Height="96" Padding="16,0" Margin="6,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Sotilgan tovarlar" Style="{StaticResource KpiLabel}"/>
                        <TextBlock Text="{Binding TotalItemsCountText}" Style="{StaticResource KpiValue}"/>
                        <TextBlock Text="{Binding ItemsSubText}" Style="{StaticResource KpiSub}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ============ GRAFIK VA ENG KO'P SOTILGANLAR ============ -->
            <Grid Height="204" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="16,14,16,10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ChartUnitText}" FontSize="12" Foreground="{DynamicResource Ink3}" VerticalAlignment="Bottom"/>
                            <TextBlock Text="Soatlar bo'yicha tushum" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="18"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="20"/>
                            </Grid.RowDefinitions>
                            <!-- O'q yozuvlari -->
                            <Grid VerticalAlignment="Bottom" Height="{Binding ChartPlotHeight}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding ChartAxisLabels[0]}" Style="{StaticResource AxisLabel}" VerticalAlignment="Top" Margin="0,-7,0,0"/>
                                <TextBlock Grid.Row="1" Text="{Binding ChartAxisLabels[1]}" Style="{StaticResource AxisLabel}" VerticalAlignment="Top" Margin="0,-7,0,0"/>
                                <TextBlock Grid.Row="2" Text="{Binding ChartAxisLabels[2]}" Style="{StaticResource AxisLabel}" VerticalAlignment="Top" Margin="0,-7,0,0"/>
                                <TextBlock Grid.Row="2" Text="0" Style="{StaticResource AxisLabel}" VerticalAlignment="Bottom" Margin="0,0,0,-7"/>
                            </Grid>
                            <!-- To'r chiziqlari -->
                            <Grid Grid.Column="2" VerticalAlignment="Bottom" Height="{Binding ChartPlotHeight}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,1,0,0"/>
                                <Border Grid.Row="1" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,1,0,0"/>
                                <Border Grid.Row="2" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,1,0,0"/>
                            </Grid>
                            <!-- Ustunlar -->
                            <Border Grid.Column="2" BorderBrush="{DynamicResource LineStrong}" BorderThickness="0,0,0,1">
                                <ItemsControl ItemsSource="{Binding HourBars}" VerticalAlignment="Bottom">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Bottom" Margin="4,0" ToolTip="{Binding Tip}">
                                                <TextBlock Text="{Binding PeakLabel}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center"
                                                           Margin="0,0,0,3" Visibility="{Binding IsPeak, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <Border Height="{Binding Height}" CornerRadius="4,4,0,0" Background="{DynamicResource Accent}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Opacity" Value="0.55"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPeak}" Value="True">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <!-- Soatlar -->
                            <ItemsControl Grid.Row="1" Grid.Column="2" ItemsSource="{Binding HourBars}" VerticalAlignment="Bottom">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Hour}" FontSize="11" Foreground="{DynamicResource Ink3}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Right" Text="tushum bo'yicha" FontSize="12" Foreground="{DynamicResource Ink3}" VerticalAlignment="Bottom"/>
                            <TextBlock Text="Eng ko'p sotilganlar" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <Grid>
                            <ItemsControl ItemsSource="{Binding TopProducts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,6,0,0">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SumText}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                            </DockPanel>
                                            <Grid Height="4" Margin="0,3,0,0">
                                                <Border CornerRadius="2" Background="{DynamicResource LineSoft}"/>
                                                <Border CornerRadius="2" Background="{DynamicResource Accent}" RenderTransformOrigin="0,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding Ratio}"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Bu davrda sotuv yo'q" FontSize="13" Foreground="{DynamicResource Ink3}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasTopProducts, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            </StackPanel>
            </Border>

            <!-- ============ CHEKLAR JADVALI ============ -->
            <Border Grid.Row="3" Style="{StaticResource Card}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="16,8,12,8">
                        <!-- Qidiruv -->
                        <Border DockPanel.Dock="Right" Width="380" Height="38" CornerRadius="9" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                Margin="12,0,0,0">
                            <Grid>
                                <Viewbox Width="16" Height="16" HorizontalAlignment="Left" Margin="12,0,0,0">
                                    <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink3}" Data="M11 4a7 7 0 1 0 0.01 0 M20 20l-3.5-3.5"/>
                                </Viewbox>
                                <TextBlock Text="Chek №, tovar nomi yoki shtrix-kod" Foreground="{DynamicResource Ink3}" FontSize="13" VerticalAlignment="Center" Margin="36,0,34,0"
                                           IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding HasSearchReceiptNumber, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                <TextBox Text="{Binding SearchReceiptNumber, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                                         FontSize="13" Foreground="{DynamicResource Ink}" CaretBrush="{DynamicResource AccentInk}" VerticalContentAlignment="Center"
                                         Padding="34,0,34,0" ToolTip="Chek raqami, tovar nomi yoki shtrix-kod bo'yicha butun tarixdan qidiradi"/>
                                <Button Command="{Binding ClearReceiptSearchCommand}" Style="{StaticResource GhostBtn}" Width="26" Height="26" HorizontalAlignment="Right"
                                        Margin="0,0,6,0" ToolTip="Qidiruvni tozalash"
                                        Visibility="{Binding HasSearchReceiptNumber, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Viewbox Width="12" Height="12">
                                        <Path Style="{StaticResource Ic}" Data="M6 6l12 12 M18 6L6 18"/>
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </Border>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SearchInfoText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Warn}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" MaxWidth="420"
                                   ToolTip="{Binding SearchInfoText}"
                                   Visibility="{Binding HasSearchInfo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="14">
                            <Run Text="Cheklar" FontWeight="Bold"/>
                            <Run Text="· eng oxirgisi birinchi" Foreground="{DynamicResource Ink3}" FontWeight="Medium"/>
                        </TextBlock>
                    </DockPanel>

                    <Border Grid.Row="1" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*" MinWidth="120"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CHEK №" Style="{StaticResource ColHead}"/>
                            <TextBlock Grid.Column="1" Text="VAQT" Style="{StaticResource ColHead}"/>
                            <TextBlock Grid.Column="2" Text="TO'LOV TURI" Style="{StaticResource ColHead}"/>
                            <TextBlock Grid.Column="3" Text="TOVARLAR" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="JAMI SUMMA" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="5" Text="FOYDA" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <ListBox x:Name="GridSales" Grid.Row="2" ItemsSource="{Binding Sales}" Background="Transparent" BorderThickness="0" Padding="0"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             MouseDoubleClick="GridSales_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="row" Background="Transparent" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,1,0,0">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="row" Property="Background" Value="{DynamicResource Surface2}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="row" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="44" Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.6*" MinWidth="120"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ReceiptNumber}" Style="{StaticResource Cell}" FontWeight="SemiBold" Foreground="{DynamicResource AccentInk}"
                                               ToolTip="{Binding ReceiptNumber}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CreatedDateTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Style="{StaticResource Cell}"/>
                                    <!-- To'lov turi belgisi -->
                                    <Border Grid.Column="2" CornerRadius="6" Padding="8,3" Margin="0,0,12,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            ToolTip="{Binding PaymentTypeDisplay}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink2}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PaymentType}" Value="{x:Static models:PaymentType.CASH}">
                                                        <Setter Property="Background" Value="{DynamicResource OkSoft}"/>
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Ok}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PaymentType}" Value="{x:Static models:PaymentType.CARD}">
                                                        <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentInk}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PaymentType}" Value="{x:Static models:PaymentType.DEBT}">
                                                        <Setter Property="Background" Value="{DynamicResource WarnSoft}"/>
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Warn}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PaymentType}" Value="{x:Static models:PaymentType.RETURN}">
                                                        <Setter Property="Background" Value="{DynamicResource BadSoft}"/>
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Bad}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PaymentType}" Value="{x:Static models:PaymentType.BRAK}">
                                                        <Setter Property="Background" Value="{DynamicResource BadSoft}"/>
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Bad}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding PaymentTypeDisplay}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PaymentType}" Value="{x:Static models:PaymentType.SPLIT}">
                                                            <Setter Property="Text" Value="Aralash"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PaymentType}" Value="{x:Static models:PaymentType.RETURN_REVERSAL}">
                                                            <Setter Property="Text" Value="Qaytarish bekor"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PaymentType}" Value="{x:Static models:PaymentType.BRAK}">
                                                            <Setter Property="Text" Value="Brak"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding Items.Count, StringFormat={}{0} xil}" Style="{StaticResource Cell}" HorizontalAlignment="Right"
                                               ToolTip="{Binding ItemsSummary}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding TotalAmount, StringFormat={}{0:N0}}" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PaymentType}" Value="{x:Static models:PaymentType.RETURN}">
                                                        <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Foyda: faqat admin ko'radi -->
                                    <Grid Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="••••" FontSize="14" Foreground="{DynamicResource Ink3}"
                                                   Visibility="{Binding CanSeeSecrets, Source={x:Static services:AdminGate.Current}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding ProfitDisplay}" FontSize="14" FontWeight="SemiBold"
                                                   Visibility="{Binding CanSeeSecrets, Source={x:Static services:AdminGate.Current}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Ok}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProfitNegative}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button Grid.Column="6" Click="BtnViewDetail_Click" Style="{StaticResource GhostBtn}" Width="36" Height="36" HorizontalAlignment="Right"
                                            ToolTip="Chek tafsiloti">
                                        <Viewbox Width="16" Height="16">
                                            <Path Style="{StaticResource Ic}" Data="M9 6l6 6l-6 6"/>
                                        </Viewbox>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="Bu davrda chek yo'q" FontSize="14" Foreground="{DynamicResource Ink3}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Sales.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
