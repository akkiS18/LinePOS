<UserControl x:Class="PosElectro.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    <UserControl.Resources>
        <!-- Kalendar Tezkor Tanlov Tugmasi Stili -->
        <Style x:Key="CalendarPresetButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pBorder" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kalendar Hafta Kuni Sarlavhasi Stili -->
        <Style x:Key="CalendarWeekDayHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#0F172A" Margin="20">
        <Grid.RowDefinitions>
            <!-- 1. Filtrlar va Yuqori Asboblar Paneli -->
            <RowDefinition Height="Auto"/>
            <!-- 2. 4 ta KPI Kartasi -->
            <RowDefinition Height="Auto"/>
            <!-- 2.5. Qarz va Cashflow Paneli -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Savdolar Jadvali -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. FILTRLAR VA ASBOBLAR PANELI (NAVBAR) -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <!-- Chap: To'liq birlashgan filtrlar (Sana, Ombor, Kategoriya, Operatsiya turi) -->
                <ColumnDefinition Width="Auto"/>
                <!-- O'rta: Bo'shliq -->
                <ColumnDefinition Width="*"/>
                <!-- O'ng: Dollar kursi, 1-bosishda Excel eksport, Yangilash -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Chap: Filtrlar bloki -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 1. Aqlli Sana Oralig'i Dropdown Trigger Tugmasi va Popupi -->
                <Button x:Name="BtnDateRangeDropdown" Command="{Binding ToggleDatePickerCommand}" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="Foreground" Value="#F8FAFC"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Padding" Value="14,8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#0284C7"/>
                                                <Setter TargetName="border" Property="Background" Value="#24334A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDateRangePickerOpen}" Value="True">
                                    <Setter Property="BorderBrush" Value="#0284C7"/>
                                    <Setter Property="Background" Value="#1E3A5F"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Kalendar vektor ikonka (Stretch="Uniform") -->
                        <Path Stretch="Uniform"
                              Data="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                              Stroke="#38BDF8" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedDateDisplay}" FontWeight="Bold" Foreground="#F8FAFC" FontSize="13" VerticalAlignment="Center"/>
                        <!-- Chevron pastga -->
                        <Path Stretch="Uniform"
                              Data="M19 9l-7 7-7-7" Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="9" Height="9" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Aqlli kalendar Popupi (Zedge dizayni) -->
                <Popup IsOpen="{Binding IsDateRangePickerOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=BtnDateRangeDropdown}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       VerticalOffset="8">
                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1.5" CornerRadius="16" Padding="18">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.75" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel Width="700">
                            <!-- Asosiy qism: Chapda presetlar, o'ngda 2 ta oy -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Chap: Tezkor presetlar -->
                                    <ColumnDefinition Width="135"/>
                                    <ColumnDefinition Width="1"/>
                                    <!-- O'ng: 2 ta oy yonma-yon -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Chap panel: Preset tugmalar -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Tezkor tanlov" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="4,0,0,10"/>
                                    <Button Content="Bugun" Command="{Binding QuickApplyPresetCommand}" CommandParameter="today"
                                            Style="{StaticResource CalendarPresetButton}"/>
                                    <Button Content="Kecha" Command="{Binding QuickApplyPresetCommand}" CommandParameter="yesterday"
                                            Style="{StaticResource CalendarPresetButton}"/>
                                    <Button Content="Oxirgi 7 kun" Command="{Binding QuickApplyPresetCommand}" CommandParameter="last7"
                                            Style="{StaticResource CalendarPresetButton}"/>
                                    <Button Content="Shu oy" Command="{Binding QuickApplyPresetCommand}" CommandParameter="this_month"
                                            Style="{StaticResource CalendarPresetButton}"/>
                                    <Button Content="O'tgan oy" Command="{Binding QuickApplyPresetCommand}" CommandParameter="last_month"
                                            Style="{StaticResource CalendarPresetButton}"/>
                                </StackPanel>

                                <!-- Vertikal ajratgich -->
                                <Rectangle Grid.Column="1" Fill="#1E293B" Margin="0,4"/>

                                <!-- O'ng panel: 2 ta oy yonma-yon -->
                                <Grid Grid.Column="2" Margin="16,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 1-OY (CHAP) -->
                                    <StackPanel Grid.Column="0">
                                        <!-- Oy sarlavhasi va oldingi tugmasi -->
                                        <Grid Margin="0,0,0,8">
                                            <Button Command="{Binding DatePicker.PreviousMonthCommand}"
                                                    HorizontalAlignment="Left"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" Padding="6,4">
                                                <Path Stretch="Uniform" Data="M15 19l-7-7 7-7" Stroke="#94A3B8" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9"/>
                                            </Button>
                                            <TextBlock Text="{Binding DatePicker.LeftMonthTitle}"
                                                       Foreground="#F1F5F9" FontSize="13" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Hafta kunlari -->
                                        <UniformGrid Columns="7" Margin="0,0,0,6">
                                            <TextBlock Text="Du" Style="{StaticResource CalendarWeekDayHeader}"/>
                                            <TextBlock Text="Se" Style="{StaticResource CalendarWeekDayHeader}"/>
                                            <TextBlock Text="Ch" Style="{StaticResource CalendarWeekDayHeader}"/>
                                            <TextBlock Text="Pa" Style="{StaticResource CalendarWeekDayHeader}"/>
                                            <TextBlock Text="Ju" Style="{StaticResource CalendarWeekDayHeader}"/>
                                            <TextBlock Text="Sha" Style="{StaticResource CalendarWeekDayHeader}"/>
                                            <TextBlock Text="Ya" Style="{StaticResource CalendarWeekDayHeader}"/>
                                        </UniformGrid>

                                        <!-- Kunlar ro'yxati -->
                                        <ItemsControl ItemsSource="{Binding DatePicker.LeftDays}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="7"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding ItemBackground}"
                                                            CornerRadius="{Binding ItemCornerRadius}"
                                                            Height="32" Margin="0,1">
                                                        <Button Command="{Binding DataContext.DatePicker.SelectDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent"
                                                                BorderThickness="{Binding ItemBorderThickness}"
                                                                BorderBrush="{Binding ItemBorderBrush}"
                                                                Cursor="Hand" Padding="0">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="dayB" Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="{Binding ItemCornerRadius}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                                                <Condition Binding="{Binding IsSelectedEdge}" Value="False"/>
                                                                                <Condition Binding="{Binding IsInRange}" Value="False"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter TargetName="dayB" Property="Background" Value="#334155"/>
                                                                        </MultiDataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <TextBlock Text="{Binding DayNumber}"
                                                                       Foreground="{Binding ItemForeground}"
                                                                       FontWeight="{Binding ItemFontWeight}"
                                                                       FontSize="12"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- 2-OY (O'NG) -->
                                    <StackPanel Grid.Column="2">
                                        <!-- Oy sarlavhasi va keyingi tugmasi -->
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="{Binding DatePicker.RightMonthTitle}"
                                                       Foreground="#F1F5F9" FontSize="13" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Button Command="{Binding DatePicker.NextMonthCommand}"
                                                    HorizontalAlignment="Right"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" Padding="6,4">
                                                <Path Stretch="Uniform" Data="M9 5l7 7-7 7" Stroke="#94A3B8" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9"/>
                                            </Button>
                                        </Grid>

                                        <!-- Hafta kunlari -->
                                        <UniformGrid Columns="7" Margin="0,0,0,6">
                                            <TextBlock Text="Du" Style="{StaticResource CalendarWeekDayHeader}"/>
                                            <TextBlock Text="Se" Style="{StaticResource CalendarWeekDayHeader}"/>
                                            <TextBlock Text="Ch" Style="{StaticResource CalendarWeekDayHeader}"/>
                                            <TextBlock Text="Pa" Style="{StaticResource CalendarWeekDayHeader}"/>
                                            <TextBlock Text="Ju" Style="{StaticResource CalendarWeekDayHeader}"/>
                                            <TextBlock Text="Sha" Style="{StaticResource CalendarWeekDayHeader}"/>
                                            <TextBlock Text="Ya" Style="{StaticResource CalendarWeekDayHeader}"/>
                                        </UniformGrid>

                                        <!-- Kunlar ro'yxati -->
                                        <ItemsControl ItemsSource="{Binding DatePicker.RightDays}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="7"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding ItemBackground}"
                                                            CornerRadius="{Binding ItemCornerRadius}"
                                                            Height="32" Margin="0,1">
                                                        <Button Command="{Binding DataContext.DatePicker.SelectDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent"
                                                                BorderThickness="{Binding ItemBorderThickness}"
                                                                BorderBrush="{Binding ItemBorderBrush}"
                                                                Cursor="Hand" Padding="0">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="dayB" Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="{Binding ItemCornerRadius}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                                                <Condition Binding="{Binding IsSelectedEdge}" Value="False"/>
                                                                                <Condition Binding="{Binding IsInRange}" Value="False"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter TargetName="dayB" Property="Background" Value="#334155"/>
                                                                        </MultiDataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <TextBlock Text="{Binding DayNumber}"
                                                                       Foreground="{Binding ItemForeground}"
                                                                       FontWeight="{Binding ItemFontWeight}"
                                                                       FontSize="12"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- Ajratgich chiziq -->
                            <Separator Background="#1E293B" Margin="0,14,0,12"/>

                            <!-- Pastki panel: Tanlangan sana matni, Tozalash va Qo'llash tugmalari -->
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Stretch="Uniform"
                                          Data="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                                          Stroke="#38BDF8" StrokeThickness="1.8" Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DatePicker.SelectedRangeText}"
                                               Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Tozalash" Command="{Binding DatePicker.ResetCommand}"
                                            Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1"
                                            Padding="14,7" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button Content="Qo'llash" Command="{Binding ApplyDateRangePickerCommand}"
                                            Background="#0284C7" Foreground="White" BorderThickness="0"
                                            Padding="18,7" FontSize="12" FontWeight="Bold" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- 2. Ombor filtri -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Path Stretch="Uniform"
                          Data="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                          Stroke="#38BDF8" StrokeThickness="1.6" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"
                          ToolTip="Ombor bo'yicha filtr"/>
                    <ComboBox ItemsSource="{Binding Warehouses}"
                              SelectedItem="{Binding SelectedWarehouse}"
                              DisplayMemberPath="Name"
                              MinWidth="145" MaxWidth="190" Height="38"
                              ToolTip="Ombor bo'yicha filtr"/>
                </StackPanel>

                <!-- 3. Kategoriya filtri -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Path Stretch="Uniform"
                          Data="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"
                          Stroke="#38BDF8" StrokeThickness="1.6" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"
                          ToolTip="Kategoriya bo'yicha filtr"/>
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              MinWidth="135" MaxWidth="180" Height="38"
                              ToolTip="Kategoriya bo'yicha filtr"/>
                </StackPanel>

                <!-- 4. Operatsiya turi filtri -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Path Stretch="Uniform"
                          Data="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
                          Stroke="#38BDF8" StrokeThickness="1.6" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"
                          ToolTip="Operatsiya turi bo'yicha filtr"/>
                    <ComboBox ItemsSource="{Binding RecordKinds}"
                              SelectedItem="{Binding SelectedRecordKind}"
                              MinWidth="115" MaxWidth="150" Height="38"
                              ToolTip="Operatsiya turi bo'yicha filtr"/>
                </StackPanel>
            </StackPanel>

            <!-- O'ng: Dollar Kursi, 1-Bosishda Excel Eksport va Yangilash -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Dollar kursi indikatori va yangilash tugmasi -->
                <Button Command="{Binding RefreshUsdRateCommand}" 
                        ToolTip="O'zbekiston Markaziy banki (CBU) jonli kursini yangilash"
                        Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1"
                        Cursor="Hand" Margin="0,0,10,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="12,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Stretch="Uniform"
                                          Data="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"
                                          Stroke="#38BDF8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding UsdRateText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Excel yuklab olish tugmasi (Hech qanday modalsiz aktiv filtrlar bo'yicha to'g'ridan-to'g'ri eksport qiladi) -->
                <Button Command="{Binding ExecuteExportCommand}"
                        ToolTip="Ekranda filtrlangan hisobotni to'g'ridan-to'g'ri Excel (.xls) faylga yuklab olish"
                        Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="13"
                        Style="{StaticResource ModernButton}" Padding="16,8" Margin="0,0,10,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Stretch="Uniform"
                                          Data="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z M14 2v6h6 M8 13h2m-2 4h4m-4-8h1 M16 13l-3 3m0 0l-3-3m3 3v-6"
                                          Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Excel (.xls)" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Yangilash tugmasi (Ombor oynasidagi kabi 40x40 animatsiyali vektor tugma) -->
                <Button Command="{Binding RefreshCommand}" 
                        ToolTip="Baza ma'lumotlarini qayta yuklash va hisoblash"
                        Style="{StaticResource ModernButton}"
                        Background="#334155"
                        Width="40" Height="40" Padding="0">
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Button.Click">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ReportsRefreshIcon"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:0.6"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                    <Path Stretch="Uniform" x:Name="ReportsRefreshIcon"
                          Data="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                          Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="15" Height="15" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Path.RenderTransform>
                    </Path>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. 4 TA ASOSIY STATISTIKA KARTASI (Vektor ikonkalari bilan) -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. JAMI TUSHUM -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="14" Padding="18,14" Margin="0,0,8,0" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="JAMI TUSHUM" Foreground="#94A3B8" FontSize="12" FontWeight="Bold"/>
                        <Path Stretch="Uniform"
                              Data="M3 10h18M7 15h1m4 0h1m-7 4h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                              Stroke="#2DD4BF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding TotalRevenueText}" Foreground="#2DD4BF" FontSize="22" FontWeight="Black" Margin="0,4,0,2"/>
                    <TextBlock Foreground="#94A3B8" FontSize="11">
                        <Run Text="Naqd: "/><Run Text="{Binding TotalCashRevenueText, Mode=OneWay}" Foreground="#F8FAFC" FontWeight="SemiBold"/>
                        <Run Text=" • "/><Run Text="Karta: "/><Run Text="{Binding TotalCardRevenueText, Mode=OneWay}" Foreground="#38BDF8" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 2. SOF FOYDA (So'mda va Dollarda) -->
            <Border Grid.Column="1" CornerRadius="14" Padding="18,14" Margin="4,0,4,0" BorderBrush="#334155" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1E293B"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProfitNegative}" Value="True">
                                <Setter Property="Background" Value="#1C0A0A"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid>
                        <TextBlock Text="SOF FOYDA" Foreground="#94A3B8" FontSize="12" FontWeight="Bold"/>
                        <Path Stretch="Uniform"
                              Data="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"
                              Stroke="#10B981" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                        <TextBlock Text="{Binding TotalProfitText}" FontSize="22" FontWeight="Black">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#10B981"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProfitNegative}" Value="True">
                                            <Setter Property="Foreground" Value="#EF4444"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding TotalProfitUsdText}" Foreground="#34D399" FontSize="14" FontWeight="Bold" VerticalAlignment="Bottom" Margin="8,0,0,3"/>
                    </StackPanel>
                    <TextBlock Foreground="#94A3B8" FontSize="11">
                        <Run Text="Karta solig'i: "/><Run Text="{Binding TotalTaxAmountText, Mode=OneWay}" Foreground="#F43F5E" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 3. SAVDOLAR SONI (Toza va ixcham, ComboBox yuqori panelga chiqarildi) -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="14" Padding="18,14" Margin="4,0,4,0" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="SAVDOLAR SONI" Foreground="#94A3B8" FontSize="12" FontWeight="Bold"/>
                        <Path Stretch="Uniform"
                              Data="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                              Stroke="#94A3B8" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding TotalSalesCountText}" Foreground="#F8FAFC" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- 4. SOTILGAN TOVARLAR -->
            <Border Grid.Column="3" Background="#1E293B" CornerRadius="14" Padding="18,14" Margin="8,0,0,0" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="SOTILGAN TOVARLAR" Foreground="#94A3B8" FontSize="12" FontWeight="Bold"/>
                        <Path Stretch="Uniform"
                              Data="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                              Stroke="#94A3B8" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding TotalItemsCountText}" Foreground="#F8FAFC" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2.5 QARZ VA KASSA PUL OQIMI (CASHFLOW) -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="14" Padding="18,12" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 1. Berilgan yangi qarz -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="BERILGAN NASIYA" Foreground="#94A3B8" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding NewDebtIssuedText}" Foreground="#F59E0B" FontSize="18" FontWeight="Bold" Margin="0,4,0,2"/>
                    <TextBlock Text="Savdodan hosil bo'lgan qarz" Foreground="#64748B" FontSize="11"/>
                </StackPanel>

                <!-- 2. Undirilgan qarz (Yig'im) -->
                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                    <TextBlock Text="UNDIRILGAN QARZ (YIG'IM)" Foreground="#94A3B8" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding DebtCollectedTotalText}" Foreground="#10B981" FontSize="18" FontWeight="Bold" Margin="0,4,0,2"/>
                    <TextBlock Foreground="#94A3B8" FontSize="11">
                        <Run Text="Naqd: "/><Run Text="{Binding DebtCollectedCashText, Mode=OneWay}" Foreground="#F8FAFC" FontWeight="SemiBold"/>
                        <Run Text=" • "/><Run Text="Karta: "/><Run Text="{Binding DebtCollectedCardText, Mode=OneWay}" Foreground="#38BDF8" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>

                <!-- 3. Kassa pul oqimi (Cashflow) -->
                <StackPanel Grid.Column="2" Margin="4,0,4,0">
                    <TextBlock Text="KASSA PUL OQIMI (CASHFLOW)" Foreground="#94A3B8" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalCashflowText}" Foreground="#38BDF8" FontSize="18" FontWeight="Bold" Margin="0,4,0,2"/>
                    <TextBlock Foreground="#64748B" FontSize="11">
                        <Run Text="Naqd + Karta (Savdo + Qarz)"/>
                    </TextBlock>
                </StackPanel>

                <!-- 4. Davr oxiriga faol qarz va haqdorlik -->
                <StackPanel Grid.Column="3" Margin="8,0,0,0">
                    <TextBlock Text="FAOL QARZDORLIK / HAQDORLIK" Foreground="#94A3B8" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ClosingDebtText}" Foreground="#EF4444" FontSize="18" FontWeight="Bold" Margin="0,4,0,2"/>
                    <TextBlock Foreground="#94A3B8" FontSize="11">
                        <Run Text="Mijoz haqi (kredit): "/><Run Text="{Binding ClosingCreditText, Mode=OneWay}" Foreground="#A78BFA" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. SAVDOLAR TARIXI JADVALI (Yuqorida Chek № qidiruv paneli bilan) -->
        <Border Grid.Row="3" Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Jadval ustidagi panel: Sarlavha va Chek № bo'yicha qidiruv -->
                <Grid Grid.Row="0" Margin="4,2,4,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Chap: Sarlavha -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Stretch="Uniform"
                              Data="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
                              Stroke="#38BDF8" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Cheklar Tarixi" Foreground="#F8FAFC" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- O'ng: Chek № bo'yicha qidiruv -->
                    <Border Grid.Column="2" Background="#0F172A" CornerRadius="18" BorderBrush="#334155" BorderThickness="1" 
                            Height="36" Width="280" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Qidiruv vektor ikonka (lupa) -->
                            <Path Grid.Column="0" Stretch="Uniform"
                                  Data="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                                  Stroke="#94A3B8" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="13" Height="13" VerticalAlignment="Center" Margin="10,0,6,0"/>

                            <TextBox Grid.Column="1" Text="{Binding SearchReceiptNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" Foreground="#F8FAFC" BorderThickness="0"
                                     VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                     CaretBrush="White" VerticalContentAlignment="Center" Padding="2,0,0,0"/>

                            <!-- Placeholder -->
                            <TextBlock Grid.Column="1" Text="Chek № bo'yicha qidirish..." Foreground="#64748B" FontSize="12"
                                       VerticalAlignment="Center" Margin="6,0,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchReceiptNumber}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Tozalash tugmasi -->
                            <Button Grid.Column="2" Command="{Binding ClearReceiptSearchCommand}"
                                    Visibility="{Binding HasSearchReceiptNumber, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                                    Cursor="Hand" Margin="0,0,6,0" Padding="4,2" VerticalAlignment="Center">
                                <Path Stretch="Uniform" Data="M6 18L18 6M6 6l12 12" Stroke="#94A3B8" StrokeThickness="2" Width="9" Height="9"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Jadval -->
                <DataGrid Grid.Row="1" x:Name="GridSales"
                          ItemsSource="{Binding Sales}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Background="Transparent" 
                          RowBackground="#1E293B" 
                          AlternatingRowBackground="#0F172A"
                          Foreground="#F8FAFC" 
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal" 
                          HorizontalGridLinesBrush="#334155"
                          HeadersVisibility="Column"
                          EnableRowVirtualization="True"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          MouseDoubleClick="GridSales_MouseDoubleClick">
                    <DataGrid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#0F172A"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="#334155" 
                                                BorderThickness="0,0,0,1" 
                                                Padding="12,12">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderThickness="0" 
                                                Padding="12,8" 
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" 
                                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#0B6477"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Padding" Value="0,2"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Vaqt" Binding="{Binding CreatedDateTime, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="140"/>
                        <DataGridTextColumn Header="Chek №" Binding="{Binding ReceiptNumber}" Width="280"/>
                        <DataGridTextColumn Header="To'lov turi" Binding="{Binding PaymentTypeDisplay}" Width="90"/>
                        <DataGridTextColumn Header="Tovarlar soni" Binding="{Binding Items.Count, StringFormat='{}{0} xil'}" Width="110"/>
                        <DataGridTextColumn Header="Jami summa" Binding="{Binding TotalAmount, StringFormat='{}{0:N0} so\'m'}" Width="*" FontWeight="Bold"/>

                        <!-- Foyda: minus bo'lsa qizil, musbat bo'lsa yashil -->
                        <DataGridTemplateColumn Header="Foyda" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ProfitDisplay}" FontWeight="Bold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#10B981"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsProfitNegative}" Value="True">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <!-- Tafsilotlarni ko'rish tugmasi -->
                        <DataGridTemplateColumn Header="Tafsilot" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Click="BtnViewDetail_Click"
                                            Background="#334155" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                            Padding="10,5" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Stretch="Uniform"
                                                  Data="M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                                                  Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Ko'rish" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
