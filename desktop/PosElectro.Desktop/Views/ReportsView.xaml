<UserControl x:Class="PosElectro.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    <UserControl.Resources>
        <!-- Filter Tugmasi Stili -->
        <Style x:Key="FilterChipButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#0F172A" Margin="20">
        <Grid.RowDefinitions>
            <!-- 1. Filtrlar va Yuqori Asboblar Paneli -->
            <RowDefinition Height="Auto"/>
            <!-- 2. 4 ta KPI Kartasi -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Savdolar Jadvali -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. FILTRLAR VA ASBOBLAR PANELI (NAVBAR) -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Chap: Vaqt filtrlari (Chip tugmalar) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Bugun -->
                <Button Content="📅 Bugun" Command="{Binding FilterTodayCommand}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FilterChipButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTodaySelected}" Value="True">
                                    <Setter Property="Background" Value="#0B6477"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#0B6477"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Kecha -->
                <Button Content="🕒 Kecha" Command="{Binding FilterYesterdayCommand}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FilterChipButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsYesterdaySelected}" Value="True">
                                    <Setter Property="Background" Value="#0B6477"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#0B6477"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Shu oy -->
                <Button Content="📆 Shu oy" Command="{Binding FilterThisMonthCommand}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FilterChipButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsThisMonthSelected}" Value="True">
                                    <Setter Property="Background" Value="#0B6477"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#0B6477"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Sana tanlash -->
                <Button Content="🗓️ Sana tanlash" Command="{Binding FilterCustomCommand}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FilterChipButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCustomSelected}" Value="True">
                                    <Setter Property="Background" Value="#0B6477"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#0B6477"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Custom Sana Tanlash Kiritish Maydoni -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsCustomDateVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="8,0,0,0">
                    <DatePicker SelectedDate="{Binding CustomStartDate, Mode=TwoWay}" Width="120" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="—" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding CustomEndDate, Mode=TwoWay}" Width="120" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- O'rta: Chek raqami bo'yicha qidiruv -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="20" BorderBrush="#334155" BorderThickness="1" 
                    Height="38" Margin="16,0,16,0" VerticalAlignment="Center" MaxWidth="280" HorizontalAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Foreground="#94A3B8" 
                               VerticalAlignment="Center" Margin="12,0,4,0"/>

                    <TextBox Grid.Column="1" Text="{Binding SearchReceiptNumber, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" Foreground="#F8FAFC" BorderThickness="0"
                             VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                             CaretBrush="White" VerticalContentAlignment="Center" Padding="4,0,0,0"/>

                    <!-- Placeholder -->
                    <TextBlock Grid.Column="1" Text="Chek № bo'yicha qidirish..." Foreground="#64748B" FontSize="13"
                               VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchReceiptNumber}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Tozalash tugmasi -->
                    <Button Grid.Column="2" Command="{Binding ClearReceiptSearchCommand}"
                            Visibility="{Binding HasSearchReceiptNumber, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                            Cursor="Hand" Margin="0,0,6,0" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="✕" FontSize="11" FontWeight="Bold"/>
                    </Button>
                </Grid>
            </Border>

            <!-- O'ng: Dollar Kursi, Excel Eksport Modali va Yangilash -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Dollar kursi indikatori va yangilash tugmasi -->
                <Button Command="{Binding RefreshUsdRateCommand}" 
                        ToolTip="O'zbekiston Markaziy banki (CBU) jonli kursini yangilash"
                        Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1"
                        Cursor="Hand" Margin="0,0,10,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20" Padding="12,7">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="💵" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding UsdRateText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Excel yuklab olish tugmasi (Modal ochadi) -->
                <Button Command="{Binding OpenExportModalCommand}"
                        ToolTip="Hisobotni ombor va kategoriya bo'yicha filtrlab Excel faylga yuklab olish"
                        Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="13"
                        Style="{StaticResource ModernButton}" Padding="16,8" Margin="0,0,10,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📥" FontSize="13" Margin="0,0,6,0"/>
                                    <TextBlock Text="Excel (.xls)" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Yangilash tugmasi (Dinamik aylanuvchi animatsiya bilan) -->
                <Button Command="{Binding RefreshCommand}" 
                        ToolTip="Baza ma'lumotlarini qayta yuklash va hisoblash"
                        Background="#334155" Foreground="White" Style="{StaticResource ModernButton}" Padding="16,8">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Button.Click">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ReportsRefreshIcon"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:0.6"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ReportsRefreshIcon" Text="🔄" RenderTransformOrigin="0.5,0.5" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="Yangilash" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. 4 TA ASOSIY STATISTIKA KARTASI (Mobil bilan 100% bir xil) -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. JAMI TUSHUM -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="14" Padding="18,14" Margin="0,0,8,0" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="JAMI TUSHUM" Foreground="#94A3B8" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="💳" HorizontalAlignment="Right" FontSize="14"/>
                    </Grid>
                    <TextBlock Text="{Binding TotalRevenueText}" Foreground="#2DD4BF" FontSize="22" FontWeight="Black" Margin="0,4,0,2"/>
                    <TextBlock Foreground="#94A3B8" FontSize="11">
                        <Run Text="Naqd: "/><Run Text="{Binding TotalCashRevenueText, Mode=OneWay}" Foreground="#F8FAFC" FontWeight="SemiBold"/>
                        <Run Text=" • "/><Run Text="Karta: "/><Run Text="{Binding TotalCardRevenueText, Mode=OneWay}" Foreground="#38BDF8" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 2. SOF FOYDA (So'mda va Dollarda) -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="14" Padding="18,14" Margin="4,0,4,0" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="SOF FOYDA" Foreground="#94A3B8" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="📈" HorizontalAlignment="Right" FontSize="14"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                        <TextBlock Text="{Binding TotalProfitText}" Foreground="#10B981" FontSize="22" FontWeight="Black"/>
                        <TextBlock Text="{Binding TotalProfitUsdText}" Foreground="#34D399" FontSize="14" FontWeight="Bold" VerticalAlignment="Bottom" Margin="8,0,0,3"/>
                    </StackPanel>
                    <TextBlock Foreground="#94A3B8" FontSize="11">
                        <Run Text="Karta solig'i: "/><Run Text="{Binding TotalTaxAmountText, Mode=OneWay}" Foreground="#F43F5E" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 3. SAVDOLAR SONI -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="14" Padding="18,16" Margin="4,0,4,0" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="SAVDOLAR SONI" Foreground="#94A3B8" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="🧾" HorizontalAlignment="Right" FontSize="14"/>
                    </Grid>
                    <TextBlock Text="{Binding TotalSalesCountText}" Foreground="#F8FAFC" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- 4. SOTILGAN TOVARLAR -->
            <Border Grid.Column="3" Background="#1E293B" CornerRadius="14" Padding="18,16" Margin="8,0,0,0" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="SOTILGAN TOVARLAR" Foreground="#94A3B8" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="📦" HorizontalAlignment="Right" FontSize="14"/>
                    </Grid>
                    <TextBlock Text="{Binding TotalItemsCountText}" Foreground="#F8FAFC" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. SAVDOLAR TARIXI JADVALI (To'lov turi yo'q, Tafsilot bilan) -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="8">
            <DataGrid x:Name="GridSales"
                      ItemsSource="{Binding Sales}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      Background="Transparent" 
                      RowBackground="#1E293B" 
                      AlternatingRowBackground="#0F172A"
                      Foreground="#F8FAFC" 
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal" 
                      HorizontalGridLinesBrush="#334155"
                      HeadersVisibility="Column"
                      EnableRowVirtualization="True"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      MouseDoubleClick="GridSales_MouseDoubleClick">
                <DataGrid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0F172A"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridColumnHeader">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="#334155" 
                                            BorderThickness="0,0,0,1" 
                                            Padding="12,12">
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderThickness="0" 
                                            Padding="12,8" 
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" 
                                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#0B6477"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Padding" Value="0,2"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Vaqt" Binding="{Binding CreatedDateTime, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="140"/>
                    <DataGridTextColumn Header="Chek №" Binding="{Binding Id, StringFormat='{}#{0}'}" Width="80"/>
                    <DataGridTextColumn Header="To'lov turi" Binding="{Binding PaymentTypeDisplay}" Width="90"/>
                    <DataGridTextColumn Header="Tovarlar soni" Binding="{Binding Items.Count, StringFormat='{}{0} xil'}" Width="110"/>
                    <DataGridTextColumn Header="Jami summa" Binding="{Binding TotalAmount, StringFormat='{}{0:N0} so\'m'}" Width="*" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Foyda" Binding="{Binding Profit, StringFormat='{}+{0:N0} so\'m'}" Width="*" Foreground="#10B981" FontWeight="Bold"/>
                    
                    <!-- Tafsilotlarni ko'rish tugmasi -->
                    <DataGridTemplateColumn Header="Tafsilot" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🔍 Ko'rish" Click="BtnViewDetail_Click"
                                        Background="#334155" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                        Padding="8,4" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 4. EXCEL EXPORT PARAMETRLARI MODALI -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Margin="-20"
              Background="#B0000000"
              Visibility="{Binding IsExportModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="1000">
            <Border Background="#1E293B" CornerRadius="16" Width="520"
                    Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#334155" BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Modal Sarlavhasi -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#065F46" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0" BorderBrush="#10B981" BorderThickness="1.5">
                                <TextBlock Text="📥" FontFamily="Segoe UI Emoji" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Excel hisobotini yuklab olish" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Eksport parametrlarini sozlang" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Command="{Binding CloseExportModalCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                ToolTip="Yopish"
                                Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
                                Width="32" Height="32" Cursor="Hand" Padding="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="16"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="✕" Foreground="#94A3B8" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Separator Background="#334155" Margin="0,0,0,18"/>

                    <!-- Vaqt oralig'i filtri -->
                    <TextBlock Text="Vaqt oralig'i:" Foreground="#CBD5E1" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="📅 Bugun" Command="{Binding SetExportFilterCommand}" CommandParameter="today" Margin="0,0,8,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterChipButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExportToday}" Value="True">
                                            <Setter Property="Background" Value="#10B981"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#059669"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="⏳ Kecha" Command="{Binding SetExportFilterCommand}" CommandParameter="yesterday" Margin="0,0,8,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterChipButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExportYesterday}" Value="True">
                                            <Setter Property="Background" Value="#10B981"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#059669"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="🗓️ Shu oy" Command="{Binding SetExportFilterCommand}" CommandParameter="this_month" Margin="0,0,8,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterChipButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExportThisMonth}" Value="True">
                                            <Setter Property="Background" Value="#10B981"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#059669"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="📅 Sana tanlash" Command="{Binding SetExportFilterCommand}" CommandParameter="custom" Margin="0,0,8,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterChipButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExportCustom}" Value="True">
                                            <Setter Property="Background" Value="#10B981"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#059669"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </WrapPanel>

                    <!-- Agar 'Sana tanlash' tanlangan bo'lsa -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsExportCustomDateVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,16">
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="Boshlanish sanasi:" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,6"/>
                            <DatePicker SelectedDate="{Binding ExportCustomStartDate}" Width="160" Height="40"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Tugash sanasi:" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,6"/>
                            <DatePicker SelectedDate="{Binding ExportCustomEndDate}" Width="160" Height="40"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Ombor va Kategoriya filtri -->
                    <Grid Margin="0,4,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ombor -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="🏢 Ombor:" Foreground="#CBD5E1" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding Warehouses}"
                                      SelectedItem="{Binding ExportSelectedWarehouse}"
                                      DisplayMemberPath="Name"
                                      Height="40"/>
                        </StackPanel>

                        <!-- Kategoriya -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="🏷️ Kategoriya:" Foreground="#CBD5E1" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding ExportSelectedCategory}"
                                      Height="40"/>
                        </StackPanel>
                    </Grid>

                    <Separator Background="#334155" Margin="0,0,0,18"/>

                    <!-- Modal tugmalari -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Bekor qilish"
                                Command="{Binding CloseExportModalCommand}"
                                Background="#334155" Foreground="#CBD5E1"
                                Height="44" FontSize="14" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
