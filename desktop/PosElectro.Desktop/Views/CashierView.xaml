<UserControl x:Class="PosElectro.Desktop.Views.CashierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:PosElectro.Desktop.Models"
             xmlns:controls="clr-namespace:PosElectro.Desktop.Controls"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             mc:Ignorable="d"
             d:DesignHeight="712" d:DesignWidth="1366">
    <!--
        Maket: "SMART kassa — Kassa maketi", 1.1 Kassa (Main.dc.html).
        Qayta qurilgan ekran yorug' temada (maketning LIGHT palitrasi). Hali qayta qurilmagan
        ekranlar vaqtincha qorong'i temada qoladi (App.xaml). Holat: docs/MAKET_KOCHIRISH_UZ.md
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/Theme.Light.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 24×24 chiziqli ikonka (maketdagi SVG'lar bilan bir xil koordinatalar). Viewbox ichida o'lchanadi. -->
            <Style x:Key="Ic" TargetType="Path">
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Stretch" Value="None"/>
                <Setter Property="StrokeThickness" Value="2"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
            </Style>

            <!-- Klaviatura belgisi (to'lov oynasida ishlatiladi) -->
            <Style x:Key="KbdChip" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource OnAccentChip}"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Asosiy to'lov tugmasi: 56px, Accent, radius 12 -->
            <Style x:Key="PayPrimary" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                <Setter Property="Height" Value="56"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Ikkinchi darajali to'lov tugmasi: 48px, Surface, LineStrong chegara, radius 10 -->
            <Style x:Key="PaySecondary" TargetType="Button" BasedOn="{StaticResource PayPrimary}">
                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="Height" Value="48"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2}"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Savat sarlavhasidagi 40×40 asbob tugmasi -->
            <Style x:Key="CartTool" TargetType="Button">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Savat qatoridagi −/+ tugmasi (40×40, Surface2) -->
            <Style x:Key="StepBtn" TargetType="Button">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Line}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Shaffof ikonka tugmasi (qatorni o'chirish, kutishdagi savatni o'chirish) -->
            <Style x:Key="GhostIconBtn" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource BadSoft}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Plitka / ro'yxat almashtirgichi tugmasi (44×42) -->
            <Style x:Key="ViewToggleBtn" TargetType="Button">
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Qoldiq belgisi: oddiy / kam / tugagan -->
            <Style x:Key="StockPill" TargetType="Border">
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink2}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource WarnSoft}"/>
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Warn}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BadSoft}"/>
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Bad}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Ro'yxat elementi: konteynersiz (fokus/tanlash ramkasiz) -->
            <Style x:Key="BareItem" TargetType="ListBoxItem">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource Bg}" TextElement.Foreground="{DynamicResource Ink}">
        <!-- ===== 1.1 ASOSIY KASSA EKRANI: chapda tovarlar, o'ngda savat ===== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="69*"/>
                <!-- Savat: clamp(380px, 31%, 500px) -->
                <ColumnDefinition Width="31*" MinWidth="380" MaxWidth="500"/>
            </Grid.ColumnDefinitions>

            <!-- ================= CHAP: TOVARLAR ================= -->
            <Grid Grid.Column="0" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Qidiruv + ko'rinish almashtirgichi -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 3px fokus halqasi -->
                    <Border x:Name="SearchRing" Grid.Column="0" Margin="-3" CornerRadius="13" BorderThickness="3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchField}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentRing}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border x:Name="SearchField" Grid.Column="0" Height="48" CornerRadius="10" Background="{DynamicResource Surface}"
                            BorderThickness="1.5" Padding="14,0" Cursor="IBeam">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                <Path Style="{StaticResource Ic}" Stroke="{DynamicResource AccentInk}"
                                      Data="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2M8 7v10M12 7v10M17 7v10"/>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Text="Shtrix-kodni skanerlang yoki tovar nomini yozing…" FontSize="15"
                                       Foreground="{DynamicResource Ink3}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Margin="10,0,8,0"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="SearchTextBox_KeyDown"
                                     Background="Transparent" BorderThickness="0" FontSize="15"
                                     Foreground="{DynamicResource Ink}" CaretBrush="{DynamicResource AccentInk}"
                                     VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="0"/>
                            <TextBlock Grid.Column="2" Text="Enter — savatga" FontSize="12" Foreground="{DynamicResource Ink3}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Plitka / Ro'yxat -->
                    <Border Grid.Column="1" Margin="8,0,0,0" Height="48" Padding="2" CornerRadius="10"
                            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button ToolTip="Plitkalar" Command="{Binding SetTileModeCommand}" Focusable="False">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ViewToggleBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTileMode}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Viewbox Width="18" Height="18">
                                    <Path Style="{StaticResource Ic}" Data="M4 3h5a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z M15 3h5a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1h-5a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z M4 14h5a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-5a1 1 0 0 1 1-1z M15 14h5a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1h-5a1 1 0 0 1-1-1v-5a1 1 0 0 1 1-1z"/>
                                </Viewbox>
                            </Button>
                            <Button ToolTip="Ro'yxat" Command="{Binding SetListModeCommand}" Focusable="False" Margin="2,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ViewToggleBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsListMode}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Viewbox Width="18" Height="18">
                                    <Path Style="{StaticResource Ic}" Data="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Kategoriya chiplari (34px, soni bilan) -->
                <ItemsControl Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding CategoryChips}" Focusable="False" Height="34" ClipToBounds="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Name}" Focusable="False" Margin="0,0,6,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Height="34" Padding="14,0" CornerRadius="17" BorderThickness="1"
                                                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="lbl" Text="{Binding Label}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Ink}"/>
                                                <TextBlock x:Name="cnt" Text="{Binding Count}" FontSize="13" FontWeight="Medium" Margin="5,0,0,0" Opacity="0.7" Foreground="{DynamicResource Ink}"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="lbl" Property="Foreground" Value="{DynamicResource OnAccent}"/>
                                                <Setter TargetName="lbl" Property="FontWeight" Value="SemiBold"/>
                                                <Setter TargetName="cnt" Property="Foreground" Value="{DynamicResource OnAccent}"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <!-- PLITKA REJIMI: minmax(176px, 1fr), qator 212px, oraliq 10px -->
                    <ListBox x:Name="ProductListBox"
                             ItemsSource="{Binding DisplayProducts}"
                             Visibility="{Binding IsTileMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             Focusable="False" KeyboardNavigation.TabNavigation="None"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.ScrollChanged="ProductList_ScrollChanged"
                             ItemContainerStyle="{StaticResource BareItem}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:AdaptiveGridPanel MinItemWidth="176" ItemHeight="212" Spacing="10"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="productCard" CornerRadius="12" BorderThickness="1" Padding="8,8,8,10" Height="212" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick"
                                                      Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Surface}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                    <Setter Property="Opacity" Value="0.55"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="96"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Rasm joyi (96px) -->
                                        <Border Grid.Row="0" CornerRadius="8" Background="{DynamicResource IllusBg}" ClipToBounds="True">
                                            <Grid>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Visibility="{Binding HasImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                    <Viewbox Width="24" Height="24">
                                                        <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink3}" StrokeThickness="1.8"
                                                              Data="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M7 9a2 2 0 1 0 4 0a2 2 0 1 0-4 0 M21 15l-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/>
                                                    </Viewbox>
                                                    <TextBlock Text="Rasm yo'q" Foreground="{DynamicResource Ink3}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                                </StackPanel>

                                                <Button Command="{Binding DataContext.OpenImagePreviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        ToolTip="Rasmni kattalashtirib ko'rish" Focusable="False" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border CornerRadius="8">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding ImagePath}" Stretch="UniformToFill"/>
                                                                </Border.Background>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <Border Background="{DynamicResource BadSolid}" CornerRadius="6" Padding="8,2" Margin="6"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                                                        Visibility="{Binding IsOutOfStock, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="Tugagan" Foreground="{DynamicResource OnAccent}" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Nomi (2 qator) va kategoriya · ombor -->
                                        <StackPanel Grid.Row="1" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" LineHeight="18"
                                                       LineStackingStrategy="BlockLineHeight" MaxHeight="36"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink}"/>
                                            <TextBlock Text="{Binding CategoryWarehouseMeta}" FontSize="12" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource Ink3}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Narx va qoldiq -->
                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding PriceText}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource StockPill}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StockPillText}" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- RO'YXAT REJIMI (maket 1.3) -->
                    <Border Visibility="{Binding IsListMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="ProductRowsHeader" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,0,6,0">
                                <Grid TextElement.FontSize="12" TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource Ink3}" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="152"/>
                                        <ColumnDefinition Width="132"/>
                                        <ColumnDefinition Width="122"/>
                                        <ColumnDefinition Width="132"/>
                                        <ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="TOVAR"/>
                                    <TextBlock Grid.Column="2" Text="KATEGORIYA" Margin="12,0,0,0"/>
                                    <TextBlock Grid.Column="3" Text="OMBOR" Margin="12,0,0,0"/>
                                    <TextBlock Grid.Column="4" Text="QOLDIQ" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Text="NARX" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <ListBox Grid.Row="1" x:Name="ProductRowsListBox"
                                     ItemsSource="{Binding DisplayProducts}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     Focusable="False" KeyboardNavigation.TabNavigation="None"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.ScrollChanged="ProductList_ScrollChanged"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     ItemContainerStyle="{StaticResource BareItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinHeight="48" Padding="12,0,6,0" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1" Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick"
                                                              Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                            <Setter Property="Opacity" Value="0.55"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="152"/>
                                                    <ColumnDefinition Width="132"/>
                                                    <ColumnDefinition Width="122"/>
                                                    <ColumnDefinition Width="132"/>
                                                    <ColumnDefinition Width="64"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36" CornerRadius="6" Background="{DynamicResource IllusBg}" HorizontalAlignment="Left">
                                                    <Grid>
                                                        <Viewbox Width="18" Height="18"
                                                                 Visibility="{Binding HasImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                            <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink3}" StrokeThickness="1.8"
                                                                  Data="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M7 9a2 2 0 1 0 4 0a2 2 0 1 0-4 0 M21 15l-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/>
                                                        </Viewbox>
                                                        <Border CornerRadius="6" Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding ImagePath}" Stretch="UniformToFill"/>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Category}" FontSize="13" Margin="12,0,0,0"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink2}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding WarehouseName}" FontSize="13" Margin="12,0,0,0"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink2}"/>
                                                <Border Grid.Column="4" Style="{StaticResource StockPill}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StockPillText}" FontSize="12" FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Grid.Column="5" Text="{Binding PriceText}" FontWeight="Bold" FontSize="14"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Ink}"/>
                                                <Button Grid.Column="6" Width="44" Height="36" HorizontalAlignment="Right" Focusable="False" Cursor="Hand"
                                                        ToolTip="Savatga qo'shish" Foreground="{DynamicResource AccentInk}"
                                                        Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Viewbox Width="16" Height="16">
                                                        <Path Style="{StaticResource Ic}" StrokeThickness="2.4" Data="M12 5v14M5 12h14"/>
                                                    </Viewbox>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Qidiruv bo'yicha tovar topilmadi -->
                    <Border Background="{DynamicResource Surface}" CornerRadius="12" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsEmptySearchResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Viewbox Width="28" Height="28" Margin="0,0,0,10">
                                <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink3}" Data="M21 21l-4.35-4.35M19 10a9 9 0 1 1-18 0a9 9 0 0 1 18 0z" Margin="0"/>
                            </Viewbox>
                            <TextBlock Text="Bunday tovar topilmadi" Foreground="{DynamicResource Ink}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Nomi yoki shtrix-kodini tekshirib qayta kiritib ko'ring" Foreground="{DynamicResource Ink2}" FontSize="13" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ================= O'NG: SAVAT ================= -->
            <Border Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sarlavha: "Savat" + soni, asboblar -->
                    <Border Grid.Row="0" Padding="16,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Savat" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                                <Border MinWidth="24" Height="22" Padding="7,0" CornerRadius="11" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCartItems}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource LineStrong}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding TotalItemsCount}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource OnAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource CartTool}" Command="{Binding OpenBrakModalCommand}" IsEnabled="{Binding HasCartItems}"
                                        Margin="0" Foreground="{DynamicResource Warn}" ToolTip="Brak sifatida chiqarish (0 so'm)">
                                    <Viewbox Width="18" Height="18">
                                        <Path Style="{StaticResource Ic}" Data="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z M12 9v4M12 17h.01"/>
                                    </Viewbox>
                                </Button>
                                <Button Command="{Binding ToggleAllCartPricesCommand}" IsEnabled="{Binding HasCartItems}"
                                        ToolTip="1-narx / 2-narx (barcha tovarlar)">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource CartTool}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAllPrice2Active}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Viewbox Width="18" Height="18">
                                        <Path Style="{StaticResource Ic}" Data="M7 4L3 8l4 4M3 8h14M17 20l4-4-4-4M21 16H7"/>
                                    </Viewbox>
                                </Button>
                                <Button Style="{StaticResource CartTool}" Command="{Binding HoldCurrentCartCommand}" IsEnabled="{Binding HasCartItems}"
                                        ToolTip="Kutishga qo'yish">
                                    <Viewbox Width="16" Height="16">
                                        <Path Style="{StaticResource Ic}" StrokeThickness="0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M7 4h2a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z M15 4h2a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"/>
                                    </Viewbox>
                                </Button>
                                <Button Style="{StaticResource CartTool}" Command="{Binding ClearCartCommand}" IsEnabled="{Binding HasCartItems}"
                                        Background="{DynamicResource BadSoft}" BorderBrush="{DynamicResource BadLine}" Foreground="{DynamicResource Bad}"
                                        ToolTip="Savatni tozalash">
                                    <Viewbox Width="18" Height="18">
                                        <Path Style="{StaticResource Ic}" Data="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6M10 11v6M14 11v6"/>
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Kutishdagi savatlar (32px chiplar) -->
                    <ScrollViewer Grid.Row="1" x:Name="HeldCartsScrollViewer" Margin="16,10,16,0"
                                  Visibility="{Binding HasHeldCarts, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  CanContentScroll="False" Focusable="False"
                                  PreviewMouseWheel="HeldCartsScrollViewer_PreviewMouseWheel">
                        <ItemsControl ItemsSource="{Binding HeldCarts}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="32" Padding="10,0,4,0" Margin="0,0,6,0" CornerRadius="8" Cursor="Hand"
                                            Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1"
                                            ToolTip="Savatni qaytarish">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick"
                                                          Command="{Binding DataContext.ResumeHeldCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                                <Path Style="{StaticResource Ic}" StrokeThickness="0" Fill="{DynamicResource Warn}"
                                                      Data="M7 4h2a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z M15 4h2a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"/>
                                            </Viewbox>
                                            <TextBlock Text="{Binding DisplayText}" Foreground="{DynamicResource Warn}" FontSize="12" FontWeight="SemiBold"
                                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            <Button Width="24" Height="24" Margin="4,0,0,0" Focusable="False" ToolTip="Kutishdagi savatni o'chirish"
                                                    Style="{StaticResource GhostIconBtn}" Foreground="{DynamicResource Warn}"
                                                    Command="{Binding DataContext.DeleteHeldCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Viewbox Width="12" Height="12">
                                                    <Path Style="{StaticResource Ic}" StrokeThickness="2.5" Data="M18 6L6 18M6 6l12 12"/>
                                                </Viewbox>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Savat qatorlari -->
                    <ListBox Grid.Row="2" Margin="16,8"
                             ItemsSource="{Binding CartItems}"
                             Visibility="{Binding HasCartItems, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Background="Transparent" BorderThickness="0" Padding="0" Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             ItemContainerStyle="{StaticResource BareItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,10" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1" Background="Transparent"
                                        ToolTip="Narx yoki miqdorni o'zgartirish uchun 2 marta bosing">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick"
                                                      Command="{Binding DataContext.OpenEditModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <!-- 1-qator: [⇄ 2] nomi ............ [o'chirish] -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Margin="0,0,8,0" Focusable="False" Cursor="Hand" VerticalAlignment="Center"
                                                    Visibility="{Binding HasSellingPrice2, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    ToolTip="1-narx / 2-narx (usta narxi)"
                                                    Command="{Binding DataContext.ToggleCartPriceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Height="22" Padding="6,0" CornerRadius="6" Background="{DynamicResource Surface2}"
                                                                BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                                            <TextBlock x:Name="tx" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource Ink3}">
                                                                <Run Text="⇄"/><Run Text="{Binding PriceNumberDisplay, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsPrice2Active}" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentSoft}"/>
                                                                <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource AccentInk}"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <TextBlock Grid.Column="1" Text="{Binding Product.Name}" FontWeight="SemiBold" FontSize="14"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink}"/>
                                            <Button Grid.Column="2" Width="32" Height="32" Margin="8,0,0,0" Focusable="False"
                                                    Style="{StaticResource GhostIconBtn}" ToolTip="Qatorni o'chirish"
                                                    Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Viewbox Width="16" Height="16">
                                                    <Path Style="{StaticResource Ic}" Data="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                                </Viewbox>
                                            </Button>
                                        </Grid>

                                        <!-- 2-qator: narx / ombor · [− qty +] · qator jami -->
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="92"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding PriceLineText}" FontSize="13">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDiscounted}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding OriginalPrice, StringFormat='{}{0:N0}'}" FontSize="12" Margin="5,0,0,0"
                                                               Foreground="{DynamicResource Ink3}" TextDecorations="Strikethrough" VerticalAlignment="Bottom"
                                                               Visibility="{Binding ShowOriginalPrice, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding WarehouseName}" FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource Ink3}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HasWarehouse, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>

                                            <Border Grid.Column="1" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" VerticalAlignment="Center"
                                                    Background="{DynamicResource Surface2}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource StepBtn}" Focusable="False" ToolTip="Kamaytirish"
                                                            Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Viewbox Width="16" Height="16">
                                                            <Path Style="{StaticResource Ic}" StrokeThickness="2.4" Data="M5 12h14"/>
                                                        </Viewbox>
                                                    </Button>
                                                    <Border Background="{DynamicResource Surface}" MinWidth="44" Padding="4,0">
                                                        <TextBlock Text="{Binding Quantity}" TextAlignment="Center" VerticalAlignment="Center"
                                                                   FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Ink}"/>
                                                    </Border>
                                                    <Button Style="{StaticResource StepBtn}" Focusable="False" ToolTip="Ko'paytirish"
                                                            Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Viewbox Width="16" Height="16">
                                                            <Path Style="{StaticResource Ic}" StrokeThickness="2.4" Data="M12 5v14M5 12h14"/>
                                                        </Viewbox>
                                                    </Button>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Grid.Column="2" Text="{Binding TotalPrice, StringFormat='{}{0:N0}'}" TextAlignment="Right"
                                                       FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Foreground="{DynamicResource Ink}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Bo'sh savat -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                Visibility="{Binding HasCartItems, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <Viewbox Width="28" Height="28">
                                <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink3}" StrokeThickness="1.8"
                                      Data="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2M8 7v10M12 7v10M17 7v10"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Savat bo'sh" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Text="Tovarni skanerlang yoki chapdagi ro'yxatdan tanlang" FontSize="13" Foreground="{DynamicResource Ink2}"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260" Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- To'lov paneli -->
                    <Border Grid.Row="3" Padding="16,12,16,16" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource Surface}">
                        <StackPanel>
                            <Grid TextElement.FontSize="13" TextElement.Foreground="{DynamicResource Ink2}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding CartItemsLine}"/>
                                <TextBlock Text="{Binding SubtotalAmount, StringFormat='{}{0:N0}'}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="1" Text="Chegirma" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Text="{Binding DiscountText}" Margin="0,4,0,0" HorizontalAlignment="Right"
                                           FontWeight="SemiBold" Foreground="{DynamicResource AccentInk}"/>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <TextBlock Text="Jami" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Ink2}" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{DynamicResource Ink}">
                                    <Run Text="{Binding TotalAmount, Mode=OneWay, StringFormat='{}{0:N0}'}" FontSize="30" FontWeight="ExtraBold"/>
                                    <Run Text="so'm" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}"/>
                                </TextBlock>
                            </Grid>

                            <Button Style="{StaticResource PayPrimary}" Margin="0,10,0,0" Command="{Binding OpenCashSaleCommand}" IsEnabled="{Binding HasCartItems}"
                                    ToolTip="Naqd pul orqali sotish (Space / F8)">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="22" Height="22">
                                            <Path Style="{StaticResource Ic}" Data="M4 6h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z M9.5 12a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0-5 0 M6 12h.01M18 12h.01"/>
                                        </Viewbox>
                                        <TextBlock Text="Naqd to'lash" FontSize="17" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Style="{StaticResource KbdChip}" HorizontalAlignment="Right">
                                        <TextBlock Text="Space · F8" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource PaySecondary}" Command="{Binding OpenCardSaleCommand}" IsEnabled="{Binding HasCartItems}"
                                        ToolTip="Plastik karta orqali sotish (F9)">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Viewbox Width="18" Height="18">
                                                <Path Style="{StaticResource Ic}" Data="M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z M2 10h20"/>
                                            </Viewbox>
                                            <TextBlock Text="Karta" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,2" CornerRadius="5" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                            <TextBlock Text="F9" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Ink2}"/>
                                        </Border>
                                    </Grid>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource PaySecondary}" Command="{Binding OpenSplitSaleCommand}" IsEnabled="{Binding HasCartItems}"
                                        ToolTip="Aralash to'lov: naqd + karta (F10)">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Viewbox Width="18" Height="18">
                                                <Path Style="{StaticResource Ic}" Data="M8 3L4 7l4 4M4 7h16M16 21l4-4-4-4M20 17H4"/>
                                            </Viewbox>
                                            <TextBlock Text="Aralash" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,2" CornerRadius="5" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                            <TextBlock Text="F10" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Ink2}"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- NARX VA MIQDORNI TAHRIRLASH MODAL OYNASI -->
        <Border Background="{DynamicResource Scrim}" Panel.ZIndex="100"
                Visibility="{Binding IsEditModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                    CornerRadius="16" Padding="24" Width="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Modal Sarlavhasi -->
                    <TextBlock Text="✏️ Mahsulot Narxi va Miqdorini Tahrirlash" Foreground="{DynamicResource Ink}" FontSize="17" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="Mana shu sotuv uchun narxni o'zgartiring (Chegirma). Ombordagi asl narx o'zgarmaydi." Foreground="{DynamicResource Ink2}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <!-- Tovar Nomi va Ombori -->
                    <Border Background="{DynamicResource Bg}" CornerRadius="8" Padding="12" Margin="0,0,0,14" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding EditProductName}" Foreground="{DynamicResource Ink}" FontSize="15" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding EditOriginalPrice, StringFormat='{}Asl sotish narxi: {0:N0} so\'m'}" Foreground="{DynamicResource Ink2}" FontSize="12"/>
                                <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding EditWarehouseName, StringFormat='{}🏢 {0}'}" Foreground="{DynamicResource AccentInk}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Narx kiritish maydoni -->
                    <TextBlock Text="Ushbu sotuv uchun narx (so'm):" Foreground="{DynamicResource Ink}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding EditPriceText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="EditModal_KeyDown"
                             FontSize="16" FontWeight="Bold" Padding="10,8" Margin="0,0,0,14"/>

                    <!-- Miqdor kiritish maydoni -->
                    <TextBlock Text="{Binding EditUnitDisplay, StringFormat='{}Miqdori ({0}):'}" Foreground="{DynamicResource Ink}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding EditQuantityText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="EditModal_KeyDown"
                             FontSize="16" FontWeight="Bold" Padding="10,8" Margin="0,0,0,14"/>

                    <!-- Xatolik matni -->
                    <TextBlock Text="{Binding EditErrorMessage}" Foreground="{DynamicResource Bad}" FontSize="12" FontWeight="SemiBold" 
                               Margin="0,0,0,12" Visibility="{Binding EditErrorMessage, Converter={x:Null}}"/>

                    <!-- Tugmalar -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Bekor qilish (Esc)" 
                                Command="{Binding CancelEditModalCommand}"
                                Background="{DynamicResource Line}" Style="{StaticResource ModernButton}" 
                                Margin="0,0,6,0" Padding="0,12"/>

                        <Button Grid.Column="1" Content="Saqlash (Enter)" 
                                Command="{Binding SaveEditModalCommand}"
                                Style="{StaticResource SuccessButton}" 
                                Margin="6,0,0,0" Padding="0,12"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- TO'LOV TURINI TANLASH VA JONLI PREVIEW MODAL OYNASI -->
        <Border Background="{DynamicResource Scrim}" Panel.ZIndex="110"
                x:Name="PaymentModalBorder"
                Visibility="{Binding IsPaymentModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                IsVisibleChanged="PaymentModal_IsVisibleChanged"
                KeyDown="PaymentModal_KeyDown">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                    CornerRadius="16" Padding="24" Width="920" Height="570"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.8"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Chap ustun: To'lov parametrlari va tugmalar (430px) -->
                        <ColumnDefinition Width="430"/>
                        <!-- Vertikal ajratgich -->
                        <ColumnDefinition Width="25"/>
                        <!-- O'ng ustun: Jonli Chek / Hujjat Preview (qolgan kenglik) -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CHAP USTUN -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header -->
                            <RowDefinition Height="*"/>    <!-- Scrollable content -->
                            <RowDefinition Height="Auto"/> <!-- Tugmalar (har doim pastda ko'rinadi) -->
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource OkSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Width="36" Height="36" CornerRadius="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Path Data="M20 4H4C2.89 4 2 4.89 2 6V18C2 19.1 2.89 20 4 20H20C21.1 20 22 19.1 22 18V6C22 4.89 21.1 4 20 4ZM20 8H4V6H20V8ZM20 18H4V12H20V18Z" 
                                          Fill="{DynamicResource Accent}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="To'lovni tasdiqlash" Foreground="{DynamicResource Ink}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Content="✕" 
                                    Command="{Binding ClosePaymentModalCommand}"
                                    Background="Transparent" Foreground="{DynamicResource Ink2}" BorderThickness="0"
                                    FontSize="16" Cursor="Hand" Padding="6"/>
                        </Grid>

                        <!-- O'rtadagi scroll qilinadigan to'lov parametrlari -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12" Padding="0,0,8,0">
                            <StackPanel>
                                <!-- Jami to'lov va tanlangan to'lov turi -->
                                <Border Background="{DynamicResource Bg}" CornerRadius="12" Padding="14,12" Margin="0,0,0,12" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Jami to'lov miqdori:" Foreground="{DynamicResource Ink2}" FontSize="13"/>
                                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,4,0,0" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding SelectedPaymentTypeTitle}" Foreground="{DynamicResource AccentInk}" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N0} so\'m'}" 
                                                   Foreground="{DynamicResource Ok}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Karta tanlanganda Soliq xabarnomasi -->
                                <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
                                        Visibility="{Binding IsCardSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="ℹ️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Foreground="{DynamicResource AccentInk}" FontSize="13" VerticalAlignment="Center">
                                            <Run Text="Karta solig'i ("/><Run Text="{Binding CurrentCardTaxRate, Mode=OneWay}"/><Run Text="%): "/><Run Text="{Binding PreviewCardTax, StringFormat='-{0:N0} so\'m', Mode=OneWay}" FontWeight="Bold"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Aralash to'lov maydonlari -->
                                <StackPanel Visibility="{Binding IsSplitSelected, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10">
                                    <TextBlock Text="Naqd to'lanadigan qismi (so'm):" Foreground="{DynamicResource Ink}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource ModernTextBox}"
                                             Text="{Binding CashAmountInput, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="14" FontWeight="Bold" Padding="10,6" Margin="0,0,0,8"/>

                                    <TextBlock Text="Kartadan to'lanadigan qismi (so'm):" Foreground="{DynamicResource Ink}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource ModernTextBox}"
                                             Text="{Binding CardAmountInput, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="14" FontWeight="Bold" Padding="10,6" Margin="0,0,0,8"/>

                                    <!-- Aralash soliq hisobi -->
                                    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                        <TextBlock Foreground="{DynamicResource AccentInk}" FontSize="12">
                                            <Run Text="Kartadan soliq ("/><Run Text="{Binding CurrentCardTaxRate, Mode=OneWay}"/><Run Text="%): "/><Run Text="{Binding PreviewCardTax, StringFormat='-{0:N0} so\'m', Mode=OneWay}" FontWeight="Bold"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>

                                <!-- Nasiyaga yozish (Qarz) Checkbox -->
                                <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentInk}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                                    <CheckBox IsChecked="{Binding IsDebtSale, Mode=TwoWay}" Cursor="Hand">
                                        <CheckBox.Content>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📒 Nasiyaga yozish (Qarz)" Foreground="{DynamicResource AccentInk}" FontSize="13" FontWeight="Bold"/>
                                                <TextBlock Text="— to'lovni mijoz qarziga o'tkazish" Foreground="{DynamicResource AccentInk}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </CheckBox.Content>
                                    </CheckBox>
                                </Border>

                                <!-- Nasiya to'lov maydonlari (Faqat checkbox belgilanganda ko'rinadi) -->
                                <StackPanel Visibility="{Binding IsDebtSale, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,12">
                                    <!-- Mijoz tanlash va Yangi qo'shish -->
                                    <TextBlock Text="Mijozni tanlang:" Foreground="{DynamicResource Ink}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding ActiveCustomers}"
                                                  SelectedItem="{Binding SelectedDebtCustomer, Mode=TwoWay}"
                                                  DisplayMemberPath="FullName"
                                                  Height="36" VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="2" Content="+ Yangi" Command="{Binding OpenQuickCustomerModalCommand}"
                                                Style="{StaticResource ModernButton}" Background="{DynamicResource Accent}" Height="36" Padding="12,0" Cursor="Hand"/>
                                    </Grid>

                                    <!-- Mijoz joriy qarzdorligi -->
                                    <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentInk}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8"
                                            Visibility="{Binding HasSelectedDebtCustomer, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding CustomerDebtBalanceText}" Foreground="{DynamicResource Ink}" FontSize="12" FontWeight="Bold"/>
                                    </Border>

                                    <!-- Oldindan to'lov (Avans) -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Naqd avans (so'm):" Foreground="{DynamicResource Ink2}" FontSize="11" Margin="0,0,0,2"/>
                                            <TextBox Style="{StaticResource ModernTextBox}"
                                                     Text="{Binding DebtCashAdvanceInput, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="13" FontWeight="Bold" Padding="8,4"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Karta avans (so'm):" Foreground="{DynamicResource Ink2}" FontSize="11" Margin="0,0,0,2"/>
                                            <TextBox Style="{StaticResource ModernTextBox}"
                                                     Text="{Binding DebtCardAdvanceInput, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="13" FontWeight="Bold" Padding="8,4"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Qolgan nasiya summasi va to'lov muddati -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Nasiyaga qolgan:" Foreground="{DynamicResource Ink2}" FontSize="11" Margin="0,0,0,2"/>
                                            <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                                <TextBlock Text="{Binding DebtRemainingAmountText}" Foreground="{DynamicResource Bad}" FontSize="13" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="To'lash muddati:" Foreground="{DynamicResource Ink2}" FontSize="11" Margin="0,0,0,2"/>
                                            <DatePicker SelectedDate="{Binding DebtDueDate, Mode=TwoWay}" Height="34" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- Chek chop etish tanlovi (Dropdown) -->
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Chek yoki hisob-faktura chop etish:" Foreground="{DynamicResource Ink2}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ComboBox SelectedIndex="{Binding SelectedReceiptPrintOption}" Height="38" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="🚫 Chek chiqarilmasin"/>
                                        <ComboBoxItem Content="🧾 Termo printer (Kassa cheki)"/>
                                        <ComboBoxItem Content="📄 A4 Printer (Hisob-faktura)"/>
                                    </ComboBox>

                                    <!-- Termo chek printerini tanlash (agar mavjud bo'lsa) -->
                                    <StackPanel Visibility="{Binding Is58mmPreview, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🖨️ Printer:" Foreground="{DynamicResource Ink2}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailablePrinters}" 
                                                      SelectedItem="{Binding SelectedReceiptPrinter, Mode=TwoWay}"
                                                      Height="34" VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Tugmalar (Bekor qilish / Tasdiqlash) -->
                        <Grid Grid.Row="2" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Bekor qilish (Esc)" 
                                    x:Name="PaymentCancelBtn"
                                    IsCancel="True"
                                    Command="{Binding ClosePaymentModalCommand}"
                                    Background="{DynamicResource Line}" Style="{StaticResource ModernButton}" 
                                    Margin="0,0,6,0" Padding="0,12"/>

                            <Button Grid.Column="1" Content="Tasdiqlash (Enter)" 
                                    x:Name="PaymentConfirmBtn"
                                    IsDefault="True"
                                    Command="{Binding ConfirmSaleCommand}"
                                    Style="{StaticResource SuccessButton}" 
                                    Margin="6,0,0,0" Padding="0,12"/>
                        </Grid>
                    </Grid>

                    <!-- O'NG USTUN: JONLI PREVIEW -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header: Preview Sarlavhasi va Printer statusi -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="JONLI KO'RINISH (PREVIEW)" Foreground="{DynamicResource Ink2}" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                            <!-- Printer holati badge (Faqat printer tanlanganda ko'rinadi) -->
                            <Border HorizontalAlignment="Right" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="8,4"
                                    Visibility="{Binding HasPrinterStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding PrinterStatusText}" Foreground="{Binding PrinterStatusColor}" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <!-- Asosiy Preview hududi (Fonda to'q ko'k ramka) -->
                        <Border Grid.Row="1" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="12" VerticalAlignment="Stretch">
                            <Grid>
                                <!-- 1. CHEKSIZ REJIM PREVIEW (IsNoReceiptPreview) -->
                                <StackPanel Visibility="{Binding IsNoReceiptPreview, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1.5"
                                            Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,16">
                                        <TextBlock Text="🚫" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Chek chop etilmaydi" Foreground="{DynamicResource Ink}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Savdo faqat tizim xotirasida saqlanadi. Qog'oz chek yoki faktura chiqarilmaydi." 
                                               Foreground="{DynamicResource Ink2}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"/>
                                </StackPanel>

                                <!-- 2. XPRINTER 58MM TERMO-CHEK PREVIEW (Is58mmPreview) -->
                                <ScrollViewer Visibility="{Binding Is58mmPreview, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              HorizontalAlignment="Center">
                                    <Border Background="#FFFFFF" CornerRadius="6" Width="220" HorizontalAlignment="Center"
                                            Padding="12,14" Margin="0,4,0,16"
                                            BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.5"/>
                                        </Border.Effect>
                                        <TextBlock Text="{Binding Receipt58mmPreviewText}" 
                                                   FontFamily="Consolas, Courier New" FontSize="11" Foreground="{DynamicResource OnAccent}" LineHeight="15" 
                                                   TextWrapping="NoWrap" HorizontalAlignment="Center"/>
                                    </Border>
                                </ScrollViewer>

                                <!-- 3. A4 PRINTER (HISOB-FAKTURA) PREVIEW (IsA4Preview) -->
                                <Border Visibility="{Binding IsA4Preview, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Background="#FFFFFF" CornerRadius="6" HorizontalAlignment="Stretch" Padding="16,14"
                                        BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.5"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <!-- A4 Mini Header -->
                                            <Border BorderBrush="{DynamicResource Bg}" BorderThickness="0,0,0,1.5" Padding="0,0,0,8" Margin="0,0,0,10">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="HISOB-FAKTURA (A4)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource OnAccent}"/>
                                                        <TextBlock Text="LinePOS Savdo Tizimi" FontSize="10" Foreground="{DynamicResource Ink3}"/>
                                                    </StackPanel>
                                                    <StackPanel HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding A4DateDisplay}" FontSize="10" Foreground="{DynamicResource Ink3}" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding A4PaymentDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- A4 Jadval Sarlavhasi -->
                                            <Grid Background="{DynamicResource Ink}" Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="#" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Ink3}" Padding="2"/>
                                                <TextBlock Grid.Column="1" Text="Mahsulot" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Ink3}" Padding="2"/>
                                                <TextBlock Grid.Column="2" Text="Miqdor" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Ink3}" HorizontalAlignment="Right" Padding="2"/>
                                                <TextBlock Grid.Column="3" Text="Narx" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Ink3}" HorizontalAlignment="Right" Padding="2"/>
                                                <TextBlock Grid.Column="4" Text="Jami" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Ink3}" HorizontalAlignment="Right" Padding="2"/>
                                            </Grid>

                                            <!-- A4 Jadval Qatorlari -->
                                            <ItemsControl ItemsSource="{Binding A4PreviewRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource LineStrong}" BorderThickness="0,0,0,1" Padding="0,3">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="22"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="50"/>
                                                                    <ColumnDefinition Width="65"/>
                                                                    <ColumnDefinition Width="70"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding IndexDisplay}" FontSize="10" Foreground="{DynamicResource Ink3}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontSize="10" Foreground="{DynamicResource OnAccent}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding QuantityDisplay}" FontSize="10" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Right"/>
                                                                <TextBlock Grid.Column="3" Text="{Binding PriceDisplay}" FontSize="10" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Right"/>
                                                                <TextBlock Grid.Column="4" Text="{Binding TotalDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- A4 Jami va Imzo -->
                                            <Grid Margin="0,12,0,0">
                                                <StackPanel HorizontalAlignment="Left">
                                                    <TextBlock Text="Tovarni qabul qildi:" FontSize="9" Foreground="{DynamicResource Ink3}"/>
                                                    <TextBlock Text="____________________" FontSize="9" Foreground="{DynamicResource Ink2}" Margin="0,6,0,0"/>
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Right">
                                                    <TextBlock Text="Jami to'lov:" FontSize="10" Foreground="{DynamicResource Ink3}" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N0} so\'m'}" 
                                                               FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Ok}" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Pastki eslatma -->
                        <TextBlock Grid.Row="2" Text="💡 Printer tanlovi o'zgartirilganda ushbu oyna darhol yangilanadi" 
                                   Foreground="{DynamicResource Ink3}" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- TOPILMAGAN MAHSULOT (YANGI QO'SHISH) MODAL OYNASI -->
        <Border Background="{DynamicResource Scrim}" Panel.ZIndex="120"
                Visibility="{Binding IsUnrecognizedBarcodeModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                Focusable="True"
                IsVisibleChanged="UnrecognizedBarcodeModal_IsVisibleChanged"
                KeyDown="UnrecognizedBarcodeModal_KeyDown">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                    CornerRadius="16" Padding="28" Width="460"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.8"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <!-- Icon -->
                    <Border Background="{DynamicResource OkSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                            Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="❓" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Sarlavha -->
                    <TextBlock Text="Mahsulot topilmadi" Foreground="{DynamicResource Ink}" FontSize="18" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>

                    <!-- Shtrix-kod ko'rinishi -->
                    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" 
                            Padding="14,8" Margin="0,0,0,14" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Shtrix-kod: " Foreground="{DynamicResource Ink2}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding UnrecognizedBarcode}" Foreground="{DynamicResource AccentInk}" FontFamily="Consolas" 
                                       FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Matn -->
                    <TextBlock Text="Ushbu shtrix-kodli mahsulot omborda mavjud emas. Yangi mahsulot sifatida bazaga qo'shamizmi?" 
                               Foreground="{DynamicResource Ink2}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" 
                               MaxWidth="380" Margin="0,0,0,24" LineHeight="20"/>

                    <!-- Tugmalar -->
                    <Grid Width="380">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Yo'q (Esc)" 
                                Command="{Binding CloseUnrecognizedBarcodeCommand}"
                                Background="{DynamicResource Line}" Style="{StaticResource ModernButton}" 
                                Margin="0,0,6,0" Padding="0,12" Cursor="Hand"/>

                        <Button x:Name="AddUnrecognizedBarcodeBtn" Grid.Column="1" Content="Ha, tovar qo'shish" 
                                Command="{Binding ConfirmAddUnrecognizedBarcodeCommand}"
                                Style="{StaticResource SuccessButton}" 
                                Margin="6,0,0,0" Padding="0,12" Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- ============================================================= -->
        <!-- BRAK TOVARLARNI CHIQARISH (SPISANIE) TASDIQLASH MODALI -->
        <!-- ============================================================= -->
        <!-- BRAK TOVARLARNI HISOBDAN CHIQARISH MODALI (0 SO'M)             -->
        <!-- ============================================================= -->
        <Border Background="{DynamicResource Scrim}" Panel.ZIndex="105"
                Visibility="{Binding IsBrakModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                IsVisibleChanged="BrakModal_IsVisibleChanged">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="16" Padding="24" Width="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.8"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Modal Sarlavhasi -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="{DynamicResource BadSoft}" BorderBrush="{DynamicResource BadLine}" BorderThickness="1" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                            <Path Data="M12 2L1 21h22L12 2zm0 3.5L20.2 19H3.8L12 5.5zM11 10v4h2v-4h-2zm0 6v2h2v-2h-2z" 
                                  Fill="{DynamicResource Bad}" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Brak Tovarlarni Chiqarish (0 so'm)" Foreground="{DynamicResource Ink}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Xulosa kartochkasi -->
                    <Border Background="{DynamicResource Bg}" CornerRadius="10" Padding="16,14" Margin="0,0,0,20" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Chiqarilayotgan tovarlar:" Foreground="{DynamicResource Ink2}" FontSize="13"/>
                                <TextBlock Text="{Binding BrakItemsCount, StringFormat='{}{0} xil tovar'}" Foreground="{DynamicResource Ink}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Sotish narxi:" Foreground="{DynamicResource Ink2}" FontSize="13"/>
                                <TextBlock Text="0 so'm (Bepul)" Foreground="{DynamicResource Ok}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Line}" Margin="0,4,0,8"/>
                            <Grid>
                                <TextBlock Text="Yetkazilgan sof zarar (tannarx):" Foreground="{DynamicResource Ink2}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding BrakTotalCostDisplay, StringFormat='{}-{0}'}" Foreground="{DynamicResource Bad}" FontSize="16" FontWeight="Black" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Tugmalar: Ha yoki Yo'q (Esc / Enter) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Yo'q, bekor qilish (Esc) -->
                        <Button Grid.Column="0"
                                x:Name="BrakCancelBtn"
                                Command="{Binding CloseBrakModalCommand}"
                                IsCancel="True"
                                Background="{DynamicResource Line}" Foreground="{DynamicResource Ink}"
                                Height="44" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="✕ Yo'q" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                                            <Border Background="{DynamicResource Surface}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Esc" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Ink2}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource LineStrong}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="btnBorder" Property="Opacity" Value="0.7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Ha, chiqarilsin (Enter) -->
                        <Button Grid.Column="2"
                                x:Name="BrakConfirmBtn"
                                Command="{Binding ConfirmBrakWriteOffCommand}"
                                Background="{DynamicResource BadSolid}" Foreground="White"
                                Height="44" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Bad}" BorderThickness="1" CornerRadius="10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="Ha, chiqarish" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BadSolid}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="btnBorder" Property="Opacity" Value="0.75"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- ============================================================= -->
        <!-- SAVATNI KUTISHGA QO'YISH (HOLD) NOM BERISH MODALI -->
        <!-- ============================================================= -->
        <Border Background="{DynamicResource Scrim}" Panel.ZIndex="110"
                Visibility="{Binding IsHoldModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                Focusable="True"
                IsVisibleChanged="HoldModal_IsVisibleChanged"
                KeyDown="HoldModal_KeyDown">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="16" Padding="28" Width="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.8"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <!-- Icon -->
                    <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                            Width="52" Height="52" CornerRadius="26" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Path Data="M6 4h3v14H6zm9 0h3v14h-3z" Fill="{DynamicResource Accent}" Stretch="Uniform" Width="16" Height="16"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Sarlavha -->
                    <TextBlock Text="Savatni kutishga qo'yish" Foreground="{DynamicResource Ink}" FontSize="18" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>

                    <TextBlock Text="Kutishga olinayotgan savat uchun mijoz yoki buyurtma nomini kiriting:" 
                               Foreground="{DynamicResource Ink2}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" 
                               MaxWidth="360" Margin="0,0,0,14"/>

                    <!-- Savat ma'lumoti chipi -->
                    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" 
                            Padding="14,8" Margin="0,0,0,16" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding HoldCartSummaryText}" Foreground="{DynamicResource AccentInk}" FontSize="13" FontWeight="SemiBold"/>
                    </Border>

                    <!-- Kiritish maydoni (TextBox) -->
                    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" 
                            Padding="12,4" Width="360" Margin="0,0,0,20">
                        <TextBox x:Name="TxtHoldCartName" 
                                 Text="{Binding HoldCartName, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" Foreground="{DynamicResource Ink}" BorderThickness="0"
                                 FontSize="15" FontWeight="SemiBold" CaretBrush="White"
                                 VerticalContentAlignment="Center" Height="36"/>
                    </Border>

                    <!-- Tugmalar -->
                    <Grid Width="360">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Bekor qilish (Esc)" 
                                Command="{Binding CloseHoldModalCommand}"
                                Background="{DynamicResource Line}" Style="{StaticResource ModernButton}" 
                                Padding="0,12" Cursor="Hand"/>

                        <Button x:Name="BtnConfirmHoldCart" Grid.Column="2" Content="Saqlash (Enter)" 
                                Command="{Binding ConfirmHoldCartCommand}"
                                Style="{StaticResource ModernButton}" 
                                Padding="0,12" Cursor="Hand" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- ========================================================= -->
        <!-- TEZKOR MIJOZ QO'SHISH MODAL OYNASI (QUICK CUSTOMER MODAL) -->
        <!-- ========================================================= -->
        <Border Background="{DynamicResource Scrim}" Panel.ZIndex="150"
                Visibility="{Binding IsQuickCustomerModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource AccentInk}" BorderThickness="1.5"
                    CornerRadius="14" Padding="24" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.8"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="👤 Yangi mijoz qo'shish" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="0,0,0,16"/>

                    <!-- Xato xabari -->
                    <Border Background="{DynamicResource BadSoft}" BorderBrush="{DynamicResource Bad}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,12"
                            Visibility="{Binding HasQuickCustomerError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding QuickCustomerErrorMessage}" Foreground="{DynamicResource Bad}" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Mijoz F.I.SH / Ismi *" Foreground="{DynamicResource Ink2}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding QuickCustomerName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Padding="10,8" Margin="0,0,0,12"/>

                    <TextBlock Text="Telefon raqami" Foreground="{DynamicResource Ink2}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding QuickCustomerPhone, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Padding="10,8" Margin="0,0,0,12"/>

                    <TextBlock Text="Izoh / Manzil" Foreground="{DynamicResource Ink2}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding QuickCustomerNote, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Padding="10,8" Margin="0,0,0,20"/>

                    <!-- Tugmalar -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Bekor qilish (Esc)" Command="{Binding CloseQuickCustomerModalCommand}"
                                Background="{DynamicResource Line}" Style="{StaticResource ModernButton}" Padding="0,10" Cursor="Hand"/>
                        <Button Grid.Column="2" Content="Saqlash (Enter)" Command="{Binding SaveQuickCustomerModalCommand}"
                                Background="{DynamicResource Accent}" Style="{StaticResource ModernButton}" Padding="0,10" Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- ========================================================= -->
        <!-- TOAST BILDIRISHNOMA (Next.js / Sonner uslubidagi zamonaviy xabar) -->
        <!-- ========================================================= -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                Panel.ZIndex="200"
                IsHitTestVisible="True"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="{DynamicResource Surface}" BorderThickness="1.5"
                    CornerRadius="12" Padding="16,12" MinWidth="360" MaxWidth="560">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource OkLine}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastKind}" Value="warn"><Setter Property="BorderBrush" Value="{DynamicResource WarnLine}"/></DataTrigger>
                                <DataTrigger Binding="{Binding ToastKind}" Value="bad"><Setter Property="BorderBrush" Value="{DynamicResource BadLine}"/></DataTrigger>
                                <DataTrigger Binding="{Binding ToastKind}" Value="info"><Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/></DataTrigger>
                            </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.7"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Holat belgisi -->
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource OkSoft}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastKind}" Value="warn"><Setter Property="Background" Value="{DynamicResource WarnSoft}"/></DataTrigger>
                                <DataTrigger Binding="{Binding ToastKind}" Value="bad"><Setter Property="Background" Value="{DynamicResource BadSoft}"/></DataTrigger>
                                <DataTrigger Binding="{Binding ToastKind}" Value="info"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/></DataTrigger>
                            </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="✓"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Ok}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ToastKind}" Value="warn"><Setter Property="Text" Value="!"/><Setter Property="Foreground" Value="{DynamicResource Warn}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding ToastKind}" Value="bad"><Setter Property="Text" Value="✕"/><Setter Property="Foreground" Value="{DynamicResource Bad}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding ToastKind}" Value="info"><Setter Property="Text" Value="i"/><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Matn -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ToastTitle}" Foreground="{DynamicResource Ink}" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ToastMessage}" Foreground="{DynamicResource Ink2}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Amal tugmasi (Qaytarish) -->
                    <Button Grid.Column="2" Style="{StaticResource PaySecondary}" Height="40" Padding="16,0" Margin="12,0,0,0"
                            MinWidth="110" VerticalAlignment="Center" HorizontalContentAlignment="Center"
                            Command="{Binding ToastActionCommand}"
                            Visibility="{Binding HasToastAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding ToastActionText}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentInk}"/>
                    </Button>

                    <!-- Yopish tugmasi ✕ -->
                    <Button Grid.Column="3" Content="✕" 
                            Command="{Binding DismissToastCommand}"
                            Background="Transparent" Foreground="{DynamicResource Ink3}" BorderThickness="0"
                            FontSize="12" Padding="6" Cursor="Hand" VerticalAlignment="Top" Margin="8,-4,-4,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
