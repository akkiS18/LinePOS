<UserControl x:Class="PosElectro.Desktop.Views.CashierView"
             xmlns:local="clr-namespace:PosElectro.Desktop.Views"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:PosElectro.Desktop.Models"
             xmlns:controls="clr-namespace:PosElectro.Desktop.Controls"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             mc:Ignorable="d"
             d:DesignHeight="712" d:DesignWidth="1366">
    <!--
        Maket: "SMART kassa — Kassa maketi", 1.1 Kassa (Main.dc.html).
        Qayta qurilgan ekran yorug' temada (maketning LIGHT palitrasi). Hali qayta qurilmagan
        ekranlar vaqtincha qorong'i temada qoladi (App.xaml). Holat: docs/MAKET_KOCHIRISH_UZ.md
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/Theme.Light.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 24×24 chiziqli ikonka (maketdagi SVG'lar bilan bir xil koordinatalar). Viewbox ichida o'lchanadi. -->
            <Style x:Key="Ic" TargetType="Path">
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Stretch" Value="None"/>
                <Setter Property="StrokeThickness" Value="2"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
            </Style>

            <!-- Klaviatura belgisi (to'lov oynasida ishlatiladi) -->
            <Style x:Key="KbdChip" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource OnAccentChip}"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Asosiy to'lov tugmasi: 56px, Accent, radius 12 -->
            <Style x:Key="PayPrimary" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                <Setter Property="Height" Value="56"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Ikkinchi darajali to'lov tugmasi: 48px, Surface, LineStrong chegara, radius 10 -->
            <Style x:Key="PaySecondary" TargetType="Button" BasedOn="{StaticResource PayPrimary}">
                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="Height" Value="48"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2}"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Savat sarlavhasidagi 40×40 asbob tugmasi -->
            <Style x:Key="CartTool" TargetType="Button">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Savat qatoridagi −/+ tugmasi (40×40, Surface2) -->
            <Style x:Key="StepBtn" TargetType="Button">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Line}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Shaffof ikonka tugmasi (qatorni o'chirish, kutishdagi savatni o'chirish) -->
            <Style x:Key="GhostIconBtn" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource BadSoft}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Plitka / ro'yxat almashtirgichi tugmasi (44×42) -->
            <Style x:Key="ViewToggleBtn" TargetType="Button">
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Qoldiq belgisi: oddiy / kam / tugagan -->
            <Style x:Key="StockPill" TargetType="Border">
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink2}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource WarnSoft}"/>
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Warn}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BadSoft}"/>
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Bad}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Ro'yxat elementi: konteynersiz (fokus/tanlash ramkasiz) -->
            <Style x:Key="BareItem" TargetType="ListBoxItem">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ======== Oynalar (maket 1.2–1.11) uchun umumiy uslublar ======== -->
            <local:EqualsConverter x:Key="EqualsConverter"/>

            <!-- Oyna kartasi: Surface, radius 16, maketdagi shadowLg -->
            <Style x:Key="ModalCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.18" Color="#0F1B21"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tugmalar: 48px, radius 10 -->
            <Style x:Key="BtnBase" TargetType="Button">
                <Setter Property="Height" Value="48"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
                <Setter Property="Background" Value="{DynamicResource Bad}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
            <Style x:Key="BtnDangerOutline" TargetType="Button" BasedOn="{StaticResource BtnBase}">
                <Setter Property="BorderBrush" Value="{DynamicResource BadLine}"/>
                <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                <Setter Property="Padding" Value="14,0"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BadSoft}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Yopish (✕) tugmasi 40×40 -->
            <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Tanlov tugmasi (chip): Tag=True bo'lsa tanlangan -->
            <Style x:Key="ChoiceChip" TargetType="Button" BasedOn="{StaticResource BtnBase}">
                <Setter Property="Height" Value="38"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                <Setter Property="Focusable" Value="False"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- To'lov turi segmenti (Naqd / Karta / Aralash) -->
            <Style x:Key="SegTab" TargetType="Button">
                <Setter Property="Height" Value="40"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                    <Setter TargetName="bd" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="2" ShadowDepth="1" Direction="270" Opacity="0.08" Color="#0F1B21"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Surface}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Kiritish maydoni: radius 10, fokusda Accent chegara -->
            <Style x:Key="FieldBox" TargetType="TextBox">
                <Setter Property="Height" Value="44"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource AccentInk}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1.5" CornerRadius="10">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                                    <!-- O'ngdagi birlik ("so'm") yoki maslahat: Tag -->
                                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                               FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="FieldBoxBig" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
                <Setter Property="Height" Value="52"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <!-- Maydon sarlavhasi -->
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <!-- Klaviatura belgisi (Esc / Enter) -->
            <Style x:Key="Kbd" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Opacity" Value="0.75"/>
            </Style>

            <!-- Ochiladigan ro'yxat: 44px, radius 10 -->
            <Style x:Key="FieldCombo" TargetType="ComboBox">
                <Setter Property="Height" Value="44"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="MaxDropDownHeight" Value="300"/>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="bd" Padding="10,8" CornerRadius="8" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="bd" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1.5" CornerRadius="10">
                                                <Viewbox Width="14" Height="14" HorizontalAlignment="Right" Margin="0,0,14,0">
                                                    <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink3}" Data="M6 9l6 6l6-6"/>
                                                </Viewbox>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter IsHitTestVisible="False" Margin="12,0,36,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                                <TextBlock x:Name="ph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Margin="14,0,36,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Ink3}" IsHitTestVisible="False" Visibility="Collapsed"/>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                    <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,8,12" Padding="4"
                                            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.14" Color="#0F1B21"/>
                                        </Border.Effect>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="SelectedItem" Value="{x:Null}">
                                    <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource Bg}" TextElement.Foreground="{DynamicResource Ink}">
        <!-- ===== 1.1 ASOSIY KASSA EKRANI: chapda tovarlar, o'ngda savat ===== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="69*"/>
                <!-- Savat: clamp(380px, 31%, 500px) -->
                <ColumnDefinition Width="31*" MinWidth="380" MaxWidth="500"/>
            </Grid.ColumnDefinitions>

            <!-- ================= CHAP: TOVARLAR ================= -->
            <Grid Grid.Column="0" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Qidiruv + ko'rinish almashtirgichi -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 3px fokus halqasi -->
                    <Border x:Name="SearchRing" Grid.Column="0" Margin="-3" CornerRadius="13" BorderThickness="3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchField}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentRing}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border x:Name="SearchField" Grid.Column="0" Height="48" CornerRadius="10" Background="{DynamicResource Surface}"
                            BorderThickness="1.5" Padding="14,0" Cursor="IBeam">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                <Path Style="{StaticResource Ic}" Stroke="{DynamicResource AccentInk}"
                                      Data="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2M8 7v10M12 7v10M17 7v10"/>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Text="Shtrix-kodni skanerlang yoki tovar nomini yozing…" FontSize="15"
                                       Foreground="{DynamicResource Ink3}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Margin="10,0,8,0"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="SearchTextBox_KeyDown"
                                     Background="Transparent" BorderThickness="0" FontSize="15"
                                     Foreground="{DynamicResource Ink}" CaretBrush="{DynamicResource AccentInk}"
                                     VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="0"/>
                            <TextBlock Grid.Column="2" Text="Enter — savatga" FontSize="12" Foreground="{DynamicResource Ink3}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Plitka / Ro'yxat -->
                    <Border Grid.Column="1" Margin="8,0,0,0" Height="48" Padding="2" CornerRadius="10"
                            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button ToolTip="Plitkalar" Command="{Binding SetTileModeCommand}" Focusable="False">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ViewToggleBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTileMode}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Viewbox Width="18" Height="18">
                                    <Path Style="{StaticResource Ic}" Data="M4 3h5a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z M15 3h5a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1h-5a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z M4 14h5a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-5a1 1 0 0 1 1-1z M15 14h5a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1h-5a1 1 0 0 1-1-1v-5a1 1 0 0 1 1-1z"/>
                                </Viewbox>
                            </Button>
                            <Button ToolTip="Ro'yxat" Command="{Binding SetListModeCommand}" Focusable="False" Margin="2,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ViewToggleBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsListMode}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Viewbox Width="18" Height="18">
                                    <Path Style="{StaticResource Ic}" Data="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Kategoriya chiplari (34px, soni bilan) -->
                <ItemsControl Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding CategoryChips}" Focusable="False" Height="34" ClipToBounds="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Name}" Focusable="False" Margin="0,0,6,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Height="34" Padding="14,0" CornerRadius="17" BorderThickness="1"
                                                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="lbl" Text="{Binding Label}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Ink}"/>
                                                <TextBlock x:Name="cnt" Text="{Binding Count}" FontSize="13" FontWeight="Medium" Margin="5,0,0,0" Opacity="0.7" Foreground="{DynamicResource Ink}"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="lbl" Property="Foreground" Value="{DynamicResource OnAccent}"/>
                                                <Setter TargetName="lbl" Property="FontWeight" Value="SemiBold"/>
                                                <Setter TargetName="cnt" Property="Foreground" Value="{DynamicResource OnAccent}"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <!-- PLITKA REJIMI: minmax(176px, 1fr), qator 212px, oraliq 10px -->
                    <ListBox x:Name="ProductListBox"
                             ItemsSource="{Binding DisplayProducts}"
                             Visibility="{Binding IsTileMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             Focusable="False" KeyboardNavigation.TabNavigation="None"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.ScrollChanged="ProductList_ScrollChanged"
                             ItemContainerStyle="{StaticResource BareItem}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:AdaptiveGridPanel MinItemWidth="176" ItemHeight="212" Spacing="10"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="productCard" CornerRadius="12" BorderThickness="1" Padding="8,8,8,10" Height="212" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick"
                                                      Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Surface}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                    <Setter Property="Opacity" Value="0.55"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="96"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Rasm joyi (96px) -->
                                        <Border Grid.Row="0" CornerRadius="8" Background="{DynamicResource IllusBg}" ClipToBounds="True">
                                            <Grid>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Visibility="{Binding HasImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                    <Viewbox Width="24" Height="24">
                                                        <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink3}" StrokeThickness="1.8"
                                                              Data="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M7 9a2 2 0 1 0 4 0a2 2 0 1 0-4 0 M21 15l-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/>
                                                    </Viewbox>
                                                    <TextBlock Text="Rasm yo'q" Foreground="{DynamicResource Ink3}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                                </StackPanel>

                                                <Button Command="{Binding DataContext.OpenImagePreviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        ToolTip="Rasmni kattalashtirib ko'rish" Focusable="False" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border CornerRadius="8">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding ImagePath}" Stretch="UniformToFill"/>
                                                                </Border.Background>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <Border Background="{DynamicResource BadSolid}" CornerRadius="6" Padding="8,2" Margin="6"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                                                        Visibility="{Binding IsOutOfStock, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="Tugagan" Foreground="{DynamicResource OnAccent}" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Nomi (2 qator) va kategoriya · ombor -->
                                        <StackPanel Grid.Row="1" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" LineHeight="18"
                                                       LineStackingStrategy="BlockLineHeight" MaxHeight="36"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink}"/>
                                            <TextBlock Text="{Binding CategoryWarehouseMeta}" FontSize="12" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource Ink3}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Narx va qoldiq -->
                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding PriceText}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource StockPill}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StockPillText}" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- RO'YXAT REJIMI (maket 1.3) -->
                    <Border Visibility="{Binding IsListMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="ProductRowsHeader" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,0,6,0">
                                <Grid TextElement.FontSize="12" TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource Ink3}" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="152"/>
                                        <ColumnDefinition Width="132"/>
                                        <ColumnDefinition Width="122"/>
                                        <ColumnDefinition Width="132"/>
                                        <ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="TOVAR"/>
                                    <TextBlock Grid.Column="2" Text="KATEGORIYA" Margin="12,0,0,0"/>
                                    <TextBlock Grid.Column="3" Text="OMBOR" Margin="12,0,0,0"/>
                                    <TextBlock Grid.Column="4" Text="QOLDIQ" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Text="NARX" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <ListBox Grid.Row="1" x:Name="ProductRowsListBox"
                                     ItemsSource="{Binding DisplayProducts}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     Focusable="False" KeyboardNavigation.TabNavigation="None"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.ScrollChanged="ProductList_ScrollChanged"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     ItemContainerStyle="{StaticResource BareItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinHeight="48" Padding="12,0,6,0" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1" Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick"
                                                              Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                            <Setter Property="Opacity" Value="0.55"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="152"/>
                                                    <ColumnDefinition Width="132"/>
                                                    <ColumnDefinition Width="122"/>
                                                    <ColumnDefinition Width="132"/>
                                                    <ColumnDefinition Width="64"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36" CornerRadius="6" Background="{DynamicResource IllusBg}" HorizontalAlignment="Left">
                                                    <Grid>
                                                        <Viewbox Width="18" Height="18"
                                                                 Visibility="{Binding HasImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                            <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink3}" StrokeThickness="1.8"
                                                                  Data="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M7 9a2 2 0 1 0 4 0a2 2 0 1 0-4 0 M21 15l-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/>
                                                        </Viewbox>
                                                        <Border CornerRadius="6" Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding ImagePath}" Stretch="UniformToFill"/>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Category}" FontSize="13" Margin="12,0,0,0"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink2}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding WarehouseName}" FontSize="13" Margin="12,0,0,0"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink2}"/>
                                                <Border Grid.Column="4" Style="{StaticResource StockPill}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StockPillText}" FontSize="12" FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Grid.Column="5" Text="{Binding PriceText}" FontWeight="Bold" FontSize="14"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Ink}"/>
                                                <Button Grid.Column="6" Width="44" Height="36" HorizontalAlignment="Right" Focusable="False" Cursor="Hand"
                                                        ToolTip="Savatga qo'shish" Foreground="{DynamicResource AccentInk}"
                                                        Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Viewbox Width="16" Height="16">
                                                        <Path Style="{StaticResource Ic}" StrokeThickness="2.4" Data="M12 5v14M5 12h14"/>
                                                    </Viewbox>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Qidiruv bo'yicha tovar topilmadi -->
                    <Border Background="{DynamicResource Surface}" CornerRadius="12" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsEmptySearchResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Viewbox Width="28" Height="28" Margin="0,0,0,10">
                                <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink3}" Data="M21 21l-4.35-4.35M19 10a9 9 0 1 1-18 0a9 9 0 0 1 18 0z" Margin="0"/>
                            </Viewbox>
                            <TextBlock Text="Bunday tovar topilmadi" Foreground="{DynamicResource Ink}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Nomi yoki shtrix-kodini tekshirib qayta kiritib ko'ring" Foreground="{DynamicResource Ink2}" FontSize="13" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ================= O'NG: SAVAT ================= -->
            <Border Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sarlavha: "Savat" + soni, asboblar -->
                    <Border Grid.Row="0" Padding="16,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Savat" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                                <Border MinWidth="24" Height="22" Padding="7,0" CornerRadius="11" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCartItems}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource LineStrong}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding TotalItemsCount}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource OnAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource CartTool}" Command="{Binding OpenBrakModalCommand}" IsEnabled="{Binding HasCartItems}"
                                        Margin="0" Foreground="{DynamicResource Warn}" ToolTip="Brak sifatida chiqarish (0 so'm)">
                                    <Viewbox Width="18" Height="18">
                                        <Path Style="{StaticResource Ic}" Data="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z M12 9v4M12 17h.01"/>
                                    </Viewbox>
                                </Button>
                                <Button Command="{Binding ToggleAllCartPricesCommand}" IsEnabled="{Binding HasCartItems}"
                                        ToolTip="1-narx / 2-narx (barcha tovarlar)">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource CartTool}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAllPrice2Active}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Viewbox Width="18" Height="18">
                                        <Path Style="{StaticResource Ic}" Data="M7 4L3 8l4 4M3 8h14M17 20l4-4-4-4M21 16H7"/>
                                    </Viewbox>
                                </Button>
                                <Button Style="{StaticResource CartTool}" Command="{Binding HoldCurrentCartCommand}" IsEnabled="{Binding HasCartItems}"
                                        ToolTip="Kutishga qo'yish">
                                    <Viewbox Width="16" Height="16">
                                        <Path Style="{StaticResource Ic}" StrokeThickness="0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M7 4h2a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z M15 4h2a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"/>
                                    </Viewbox>
                                </Button>
                                <Button Style="{StaticResource CartTool}" Command="{Binding ClearCartCommand}" IsEnabled="{Binding HasCartItems}"
                                        Background="{DynamicResource BadSoft}" BorderBrush="{DynamicResource BadLine}" Foreground="{DynamicResource Bad}"
                                        ToolTip="Savatni tozalash">
                                    <Viewbox Width="18" Height="18">
                                        <Path Style="{StaticResource Ic}" Data="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6M10 11v6M14 11v6"/>
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Kutishdagi savatlar (32px chiplar) -->
                    <ScrollViewer Grid.Row="1" x:Name="HeldCartsScrollViewer" Margin="16,10,16,0"
                                  Visibility="{Binding HasHeldCarts, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  CanContentScroll="False" Focusable="False"
                                  PreviewMouseWheel="HeldCartsScrollViewer_PreviewMouseWheel">
                        <ItemsControl ItemsSource="{Binding HeldCarts}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="32" Padding="10,0,4,0" Margin="0,0,6,0" CornerRadius="8" Cursor="Hand"
                                            Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1"
                                            ToolTip="Savatni qaytarish">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick"
                                                          Command="{Binding DataContext.ResumeHeldCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                                <Path Style="{StaticResource Ic}" StrokeThickness="0" Fill="{DynamicResource Warn}"
                                                      Data="M7 4h2a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z M15 4h2a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"/>
                                            </Viewbox>
                                            <TextBlock Text="{Binding DisplayText}" Foreground="{DynamicResource Warn}" FontSize="12" FontWeight="SemiBold"
                                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            <Button Width="24" Height="24" Margin="4,0,0,0" Focusable="False" ToolTip="Kutishdagi savatni o'chirish"
                                                    Style="{StaticResource GhostIconBtn}" Foreground="{DynamicResource Warn}"
                                                    Command="{Binding DataContext.DeleteHeldCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Viewbox Width="12" Height="12">
                                                    <Path Style="{StaticResource Ic}" StrokeThickness="2.5" Data="M18 6L6 18M6 6l12 12"/>
                                                </Viewbox>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Savat qatorlari -->
                    <ListBox Grid.Row="2" Margin="16,8"
                             ItemsSource="{Binding CartItems}"
                             Visibility="{Binding HasCartItems, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Background="Transparent" BorderThickness="0" Padding="0" Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             ItemContainerStyle="{StaticResource BareItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,10" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1" Background="Transparent"
                                        ToolTip="Narx yoki miqdorni o'zgartirish uchun 2 marta bosing">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick"
                                                      Command="{Binding DataContext.OpenEditModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <!-- 1-qator: [⇄ 2] nomi ............ [o'chirish] -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Margin="0,0,8,0" Focusable="False" Cursor="Hand" VerticalAlignment="Center"
                                                    Visibility="{Binding HasSellingPrice2, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    ToolTip="1-narx / 2-narx (usta narxi)"
                                                    Command="{Binding DataContext.ToggleCartPriceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Height="22" Padding="6,0" CornerRadius="6" Background="{DynamicResource Surface2}"
                                                                BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                                            <TextBlock x:Name="tx" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource Ink3}">
                                                                <Run Text="⇄"/><Run Text="{Binding PriceNumberDisplay, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsPrice2Active}" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentSoft}"/>
                                                                <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource AccentInk}"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <TextBlock Grid.Column="1" Text="{Binding Product.Name}" FontWeight="SemiBold" FontSize="14"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink}"/>
                                            <Button Grid.Column="2" Width="32" Height="32" Margin="8,0,0,0" Focusable="False"
                                                    Style="{StaticResource GhostIconBtn}" ToolTip="Qatorni o'chirish"
                                                    Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Viewbox Width="16" Height="16">
                                                    <Path Style="{StaticResource Ic}" Data="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                                </Viewbox>
                                            </Button>
                                        </Grid>

                                        <!-- 2-qator: narx / ombor · [− qty +] · qator jami -->
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="92"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding PriceLineText}" FontSize="13">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDiscounted}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding OriginalPrice, StringFormat='{}{0:N0}'}" FontSize="12" Margin="5,0,0,0"
                                                               Foreground="{DynamicResource Ink3}" TextDecorations="Strikethrough" VerticalAlignment="Bottom"
                                                               Visibility="{Binding ShowOriginalPrice, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding WarehouseName}" FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource Ink3}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HasWarehouse, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>

                                            <Border Grid.Column="1" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" VerticalAlignment="Center"
                                                    Background="{DynamicResource Surface2}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource StepBtn}" Focusable="False" ToolTip="Kamaytirish"
                                                            Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Viewbox Width="16" Height="16">
                                                            <Path Style="{StaticResource Ic}" StrokeThickness="2.4" Data="M5 12h14"/>
                                                        </Viewbox>
                                                    </Button>
                                                    <Border Background="{DynamicResource Surface}" MinWidth="44" Padding="4,0">
                                                        <TextBlock Text="{Binding Quantity}" TextAlignment="Center" VerticalAlignment="Center"
                                                                   FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Ink}"/>
                                                    </Border>
                                                    <Button Style="{StaticResource StepBtn}" Focusable="False" ToolTip="Ko'paytirish"
                                                            Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Viewbox Width="16" Height="16">
                                                            <Path Style="{StaticResource Ic}" StrokeThickness="2.4" Data="M12 5v14M5 12h14"/>
                                                        </Viewbox>
                                                    </Button>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Grid.Column="2" Text="{Binding TotalPrice, StringFormat='{}{0:N0}'}" TextAlignment="Right"
                                                       FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Foreground="{DynamicResource Ink}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Bo'sh savat -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                Visibility="{Binding HasCartItems, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <Viewbox Width="28" Height="28">
                                <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink3}" StrokeThickness="1.8"
                                      Data="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2M8 7v10M12 7v10M17 7v10"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Savat bo'sh" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Text="Tovarni skanerlang yoki chapdagi ro'yxatdan tanlang" FontSize="13" Foreground="{DynamicResource Ink2}"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260" Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- Savat ro'yxati bilan to'lov paneli orasidagi soya: qatorlar panel ostiga kirib ketayotgani bilinadi -->
                    <Border Grid.Row="2" Height="14" VerticalAlignment="Bottom" IsHitTestVisible="False"
                            Visibility="{Binding HasCartItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#000F1B21" Offset="0"/>
                                <GradientStop Color="#240F1B21" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- To'lov paneli -->
                    <Border Grid.Row="3" Padding="16,12,16,16" BorderBrush="{DynamicResource LineStrong}" BorderThickness="0,2,0,0" Background="{DynamicResource Surface2}">
                        <StackPanel>
                            <Grid TextElement.FontSize="13" TextElement.Foreground="{DynamicResource Ink2}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding CartItemsLine}"/>
                                <TextBlock Text="{Binding SubtotalAmount, StringFormat='{}{0:N0}'}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="1" Text="Chegirma" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Text="{Binding DiscountText}" Margin="0,4,0,0" HorizontalAlignment="Right"
                                           FontWeight="SemiBold" Foreground="{DynamicResource AccentInk}"/>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <TextBlock Text="Jami" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Ink2}" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{DynamicResource Ink}">
                                    <Run Text="{Binding TotalAmount, Mode=OneWay, StringFormat='{}{0:N0}'}" FontSize="30" FontWeight="ExtraBold"/>
                                    <Run Text="so'm" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}"/>
                                </TextBlock>
                            </Grid>

                            <Button Style="{StaticResource PayPrimary}" Margin="0,10,0,0" Command="{Binding OpenCashSaleCommand}" IsEnabled="{Binding HasCartItems}"
                                    ToolTip="Naqd pul orqali sotish (Space / F8)">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="22" Height="22">
                                            <Path Style="{StaticResource Ic}" Data="M4 6h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z M9.5 12a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0-5 0 M6 12h.01M18 12h.01"/>
                                        </Viewbox>
                                        <TextBlock Text="Naqd to'lash" FontSize="17" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Style="{StaticResource KbdChip}" HorizontalAlignment="Right">
                                        <TextBlock Text="Space · F8" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource PaySecondary}" Command="{Binding OpenCardSaleCommand}" IsEnabled="{Binding HasCartItems}"
                                        ToolTip="Plastik karta orqali sotish (F9)">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Viewbox Width="18" Height="18">
                                                <Path Style="{StaticResource Ic}" Data="M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z M2 10h20"/>
                                            </Viewbox>
                                            <TextBlock Text="Karta" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,2" CornerRadius="5" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                            <TextBlock Text="F9" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Ink2}"/>
                                        </Border>
                                    </Grid>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource PaySecondary}" Command="{Binding OpenSplitSaleCommand}" IsEnabled="{Binding HasCartItems}"
                                        ToolTip="Aralash to'lov: naqd + karta (F10)">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Viewbox Width="18" Height="18">
                                                <Path Style="{StaticResource Ic}" Data="M8 3L4 7l4 4M4 7h16M16 21l4-4-4-4M20 17H4"/>
                                            </Viewbox>
                                            <TextBlock Text="Aralash" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,2" CornerRadius="5" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                            <TextBlock Text="F10" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Ink2}"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================================================================== -->
        <!-- 1.8 SAVAT QATORI: NARX, MIQDOR, CHEGIRMA (520px)                       -->
        <!-- ===================================================================== -->
        <Border Background="{DynamicResource Scrim}" Panel.ZIndex="100"
                Visibility="{Binding IsEditModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{StaticResource ModalCard}" Width="520">
                <StackPanel>
                    <!-- Sarlavha: tovar rasmi joyi, nomi, ma'lumot, yopish -->
                    <Border Padding="22,18" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="52" Height="52" CornerRadius="10" Background="{DynamicResource IllusBg}">
                                <Viewbox Width="28" Height="28">
                                    <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink2}" StrokeThickness="1.6"
                                          Data="M21 8L12 3L3 8v8l9 5l9-5z M3 8l9 5l9-5 M12 13v8"/>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding EditProductName}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding EditMetaText}" FontSize="12" Foreground="{DynamicResource Ink3}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource CloseBtn}" Background="{DynamicResource Surface2}" Command="{Binding CancelEditModalCommand}" ToolTip="Yopish (Esc)">
                                <Viewbox Width="18" Height="18"><Path Style="{StaticResource Ic}" Data="M6 6l12 12M18 6L6 18"/></Viewbox>
                            </Button>
                        </Grid>
                    </Border>

                    <StackPanel Margin="22,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Miqdor: [−] qiymat [+] -->
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding EditUnitDisplay, StringFormat='{}Miqdor ({0})'}"/>
                                <Border Height="48" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Surface2}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="48"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource StepBtn}" Width="46" Height="46" Focusable="False"
                                                Command="{Binding EditStepQuantityCommand}" CommandParameter="-1" ToolTip="Kamaytirish">
                                            <Viewbox Width="16" Height="16"><Path Style="{StaticResource Ic}" StrokeThickness="2.4" Data="M5 12h14"/></Viewbox>
                                        </Button>
                                        <TextBox Grid.Column="1" Text="{Binding EditQuantityText, UpdateSourceTrigger=PropertyChanged}" KeyDown="EditModal_KeyDown"
                                                 Background="{DynamicResource Surface}" BorderThickness="0" FontSize="18" FontWeight="Bold"
                                                 Foreground="{DynamicResource Ink}" CaretBrush="{DynamicResource AccentInk}"
                                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="2" Style="{StaticResource StepBtn}" Width="46" Height="46" Focusable="False"
                                                Command="{Binding EditStepQuantityCommand}" CommandParameter="1" ToolTip="Ko'paytirish">
                                            <Viewbox Width="16" Height="16"><Path Style="{StaticResource Ic}" StrokeThickness="2.4" Data="M12 5v14M5 12h14"/></Viewbox>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <!-- Sotuv narxi -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding EditUnitDisplay, StringFormat='{}Sotuv narxi (1 {0})'}"/>
                                <TextBox x:Name="EditPriceBox" Style="{StaticResource FieldBox}" Height="48" FontSize="18" FontWeight="Bold" Tag="so'm"
                                         Text="{Binding EditPriceText, UpdateSourceTrigger=PropertyChanged}" KeyDown="EditModal_KeyDown"/>
                            </StackPanel>
                        </Grid>

                        <!-- Chegirma tugmalari (narx maydonini to'ldiradi) -->
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Chegirma" Margin="0,16,0,6"/>
                        <WrapPanel>
                            <Button Style="{StaticResource ChoiceChip}" Height="40" Margin="0,0,8,6" Content="Yo'q"
                                    Command="{Binding EditApplyDiscountCommand}" CommandParameter="none"
                                    Tag="{Binding EditActiveDiscount, Converter={StaticResource EqualsConverter}, ConverterParameter=none}"/>
                            <Button Style="{StaticResource ChoiceChip}" Height="40" Margin="0,0,8,6" Content="−3%"
                                    Command="{Binding EditApplyDiscountCommand}" CommandParameter="p3"
                                    Tag="{Binding EditActiveDiscount, Converter={StaticResource EqualsConverter}, ConverterParameter=p3}"/>
                            <Button Style="{StaticResource ChoiceChip}" Height="40" Margin="0,0,8,6" Content="−5 000"
                                    Command="{Binding EditApplyDiscountCommand}" CommandParameter="m5000"
                                    Tag="{Binding EditActiveDiscount, Converter={StaticResource EqualsConverter}, ConverterParameter=m5000}"/>
                            <Button Style="{StaticResource ChoiceChip}" Height="40" Margin="0,0,8,6" Content="−10%"
                                    Command="{Binding EditApplyDiscountCommand}" CommandParameter="p10"
                                    Tag="{Binding EditActiveDiscount, Converter={StaticResource EqualsConverter}, ConverterParameter=p10}"/>
                            <Button Style="{StaticResource ChoiceChip}" Height="40" Margin="0,0,0,6" Content="Boshqa…" Foreground="{DynamicResource Ink2}"
                                    Click="EditOtherDiscount_Click" ToolTip="Narxni o'zingiz yozing"/>
                        </WrapPanel>

                        <!-- Izoh -->
                        <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="10" Background="{DynamicResource Surface2}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                    <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink3}" Data="M3 12a9 9 0 1 0 18 0a9 9 0 1 0-18 0 M12 11v5M12 8v.5"/>
                                </Viewbox>
                                <TextBlock Text="{Binding EditDiscountInfoText}" FontSize="13" Foreground="{DynamicResource Ink2}" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="430"/>
                            </StackPanel>
                        </Border>

                        <!-- Xato -->
                        <TextBlock Text="{Binding EditErrorMessage}" Foreground="{DynamicResource Bad}" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EditErrorMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Qator jami -->
                        <Border Margin="0,16,0,0" Padding="0,8,0,0" BorderThickness="0,1,0,0">
                            <Border.BorderBrush>
                                <VisualBrush TileMode="Tile" Viewport="0,0,6,1" ViewportUnits="Absolute">
                                    <VisualBrush.Visual>
                                        <Rectangle Width="3" Height="1" Fill="{DynamicResource Line}"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Border.BorderBrush>
                            <Grid>
                                <TextBlock Text="{Binding EditLineFormulaText}" Foreground="{DynamicResource Ink2}" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource Ink}">
                                    <Run Text="{Binding EditLineTotal, Mode=OneWay, StringFormat='{}{0:N0}'}" FontSize="24" FontWeight="ExtraBold"/>
                                    <Run Text="so'm" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource Ink3}"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Tugmalar -->
                    <Grid Margin="22,0,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource BtnDangerOutline}" Command="{Binding EditRemoveItemCommand}" ToolTip="Tovarni savatdan olib tashlash">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16"><Path Style="{StaticResource Ic}" Data="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/></Viewbox>
                                <TextBlock Text="Savatdan olish" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource BtnSecondary}" Command="{Binding CancelEditModalCommand}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Bekor" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource Kbd}" Text="Esc" Foreground="{DynamicResource Ink3}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource BtnPrimary}" Padding="22,0" Command="{Binding SaveEditModalCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Saqlash" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource Kbd}" Text="Enter"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===================================================================== -->
        <!-- 1.2 / 1.4 / 1.5 / 1.6 TO'LOV OYNASI (920×712: chapda to'lov, o'ngda chek 340px) -->
        <!-- ===================================================================== -->
        <Border Background="{DynamicResource Scrim}" Panel.ZIndex="110"
                x:Name="PaymentModalBorder"
                Visibility="{Binding IsPaymentModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                IsVisibleChanged="PaymentModal_IsVisibleChanged"
                KeyDown="PaymentModal_KeyDown">
            <Border Style="{StaticResource ModalCard}" MaxWidth="920" MaxHeight="712" Margin="24"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== CHAP: TO'LOV ===== -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="24,18,24,12">
                            <TextBlock Text="To'lov" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource CloseBtn}" HorizontalAlignment="Right" Command="{Binding ClosePaymentModalCommand}" ToolTip="Yopish (Esc)">
                                <Viewbox Width="18" Height="18"><Path Style="{StaticResource Ic}" Data="M18 6L6 18M6 6l12 12"/></Viewbox>
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel Margin="24,0,24,16">
                                <!-- To'lov turi -->
                                <Border Padding="4" CornerRadius="10" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                    <UniformGrid Columns="3">
                                        <Button Style="{StaticResource SegTab}" Margin="0,0,2,0" Command="{Binding SelectPaymentTypeCommand}" CommandParameter="0"
                                                Tag="{Binding SelectedPaymentType, Converter={StaticResource EqualsConverter}, ConverterParameter=0}">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Naqd"/><TextBlock Style="{StaticResource Kbd}" Text="F8" Opacity="0.6"/></StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SegTab}" Margin="2,0" Command="{Binding SelectPaymentTypeCommand}" CommandParameter="1"
                                                Tag="{Binding SelectedPaymentType, Converter={StaticResource EqualsConverter}, ConverterParameter=1}">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Karta"/><TextBlock Style="{StaticResource Kbd}" Text="F9" Opacity="0.6"/></StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SegTab}" Margin="2,0,0,0" Command="{Binding SelectPaymentTypeCommand}" CommandParameter="2"
                                                Tag="{Binding SelectedPaymentType, Converter={StaticResource EqualsConverter}, ConverterParameter=2}">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Aralash"/><TextBlock Style="{StaticResource Kbd}" Text="F10" Opacity="0.6"/></StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </Border>

                                <!-- To'lanadigan summa -->
                                <Grid Margin="0,16,0,0">
                                    <TextBlock Text="To'lanadigan summa" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource Ink2}" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                    <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource Ink}">
                                        <Run Text="{Binding TotalAmount, Mode=OneWay, StringFormat='{}{0:N0}'}" FontSize="28" FontWeight="ExtraBold"/>
                                        <Run Text="so'm" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}"/>
                                    </TextBlock>
                                </Grid>

                                <!-- NAQD: mijoz berdi + qaytim -->
                                <StackPanel Margin="0,16,0,0" Visibility="{Binding IsCashSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Style="{StaticResource FieldLabel}">
                                        <Run Text="Mijoz berdi"/>
                                        <Run Text="— ixtiyoriy, bo'sh qolsa Enter darhol yakunlaydi" FontWeight="Normal" Foreground="{DynamicResource Ink3}"/>
                                    </TextBlock>
                                    <TextBox Style="{StaticResource FieldBoxBig}" FontSize="22" Tag="so'm"
                                             Text="{Binding CashGivenInput, UpdateSourceTrigger=PropertyChanged}"/>
                                    <ItemsControl ItemsSource="{Binding QuickCashOptions}" Margin="0,8,0,0" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ChoiceChip}" Margin="0,0,6,0" Content="{Binding Label}" Tag="{Binding IsSelected}"
                                                        Command="{Binding DataContext.SetCashGivenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Margin="0,16,0,0" Padding="16,14" CornerRadius="12" Background="{DynamicResource OkSoft}">
                                        <Grid>
                                            <TextBlock Text="Qaytim" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Ok}" VerticalAlignment="Center"/>
                                            <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource Ok}">
                                                <Run Text="{Binding ChangeAmount, Mode=OneWay, StringFormat='{}{0:N0}'}" FontSize="26" FontWeight="ExtraBold"/>
                                                <Run Text="so'm" FontSize="14" FontWeight="SemiBold"/>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- KARTA -->
                                <Border Margin="0,16,0,0" Padding="16,14" CornerRadius="12" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                        Visibility="{Binding IsCardSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoft}">
                                                <Viewbox Width="20" Height="20">
                                                    <Path Style="{StaticResource Ic}" Stroke="{DynamicResource AccentInk}" Data="M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z M2 10h20"/>
                                                </Viewbox>
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Terminal orqali o'tkazing" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Ink}"/>
                                                <TextBlock Text="Summa terminalda tasdiqlangach &quot;Savdoni yakunlash&quot; ni bosing" FontSize="13" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Margin="0,10,0,0" Padding="0,10,0,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                                            <Grid TextElement.FontSize="13">
                                                <TextBlock Foreground="{DynamicResource Ink2}">
                                                    <Run Text="Karta solig'i ("/><Run Text="{Binding CurrentCardTaxRate, Mode=OneWay}"/><Run Text="%) — hisobotda xarajat"/>
                                                </TextBlock>
                                                <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"
                                                           Text="{Binding PreviewCardTax, StringFormat='{}{0:N0} so\'m'}"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- ARALASH -->
                                <StackPanel Margin="0,16,0,0" Visibility="{Binding IsSplitSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Naqd qismi"/>
                                            <TextBox Style="{StaticResource FieldBoxBig}" Text="{Binding CashAmountInput, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}">
                                                <Run Text="Karta qismi"/><Run Text=" · avtomatik" FontWeight="Medium" Foreground="{DynamicResource AccentInk}"/>
                                            </TextBlock>
                                            <TextBox Style="{StaticResource FieldBoxBig}" Background="{DynamicResource Surface2}"
                                                     Text="{Binding CardAmountInput, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Margin="0,12,0,0" Padding="14,12" CornerRadius="10" Background="{DynamicResource Surface2}">
                                        <Grid TextElement.FontSize="13">
                                            <TextBlock Foreground="{DynamicResource Ink2}">
                                                <Run Text="Karta qismidan soliq ("/><Run Text="{Binding CurrentCardTaxRate, Mode=OneWay}"/><Run Text="%)"/>
                                            </TextBlock>
                                            <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"
                                                       Text="{Binding PreviewCardTax, StringFormat='{}{0:N0} so\'m'}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Nasiyaga yozish (almashtirgich) -->
                                <CheckBox Margin="0,14,0,0" IsChecked="{Binding IsDebtSale, Mode=TwoWay}" Cursor="Hand" Focusable="False">
                                    <CheckBox.Template>
                                        <ControlTemplate TargetType="CheckBox">
                                            <WrapPanel Background="Transparent">
                                                <Border x:Name="track" Width="36" Height="20" CornerRadius="10" Background="{DynamicResource LineStrong}" VerticalAlignment="Center">
                                                    <Ellipse x:Name="knob" Width="16" Height="16" Fill="{DynamicResource OnAccent}" HorizontalAlignment="Left" Margin="2,0"/>
                                                </Border>
                                                <TextBlock Text="Nasiyaga yozish" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Ink}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="mijoz, avans va muddat" FontSize="13" Foreground="{DynamicResource Ink3}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            </WrapPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                                                    <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </CheckBox.Template>
                                </CheckBox>

                                <!-- NASIYA -->
                                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsDebtSale, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Style="{StaticResource FieldCombo}" Height="48" Tag="Mijozni tanlang…"
                                                  ItemsSource="{Binding ActiveCustomers}"
                                                  SelectedItem="{Binding SelectedDebtCustomer, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource BadSoft}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Bad}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding PhoneDisplay}" FontSize="12" Foreground="{DynamicResource Ink3}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" FontSize="12" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center">
                                                            <Run Text="Qarzi"/>
                                                            <Run Text="{Binding BalanceUz, Mode=OneWay, StringFormat='{}{0:N0}'}" FontWeight="Bold" Foreground="{DynamicResource Bad}"/>
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="1" Style="{StaticResource BtnSecondary}" Margin="8,0,0,0" Padding="12,0" FontWeight="Bold"
                                                Foreground="{DynamicResource AccentInk}" Content="+ Yangi" Command="{Binding OpenQuickCustomerModalCommand}"/>
                                    </Grid>

                                    <!-- Muddati o'tgan qarz ogohlantirishi -->
                                    <Border Margin="0,10,0,0" Padding="12,8" CornerRadius="8" Background="{DynamicResource WarnSoft}"
                                            Visibility="{Binding SelectedDebtCustomer.HasOverdue, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="16" Height="16"><Path Style="{StaticResource Ic}" Stroke="{DynamicResource Warn}" Data="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z M12 9v4M12 17h.01"/></Viewbox>
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Warn}" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Run Text="Muddati o'tgan qarzi bor"/><Run Text="{Binding SelectedDebtCustomer.EarliestDueDate, Mode=OneWay, StringFormat=' (muddat: {0})'}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" FontSize="12" Margin="0,0,0,4" Text="Naqd avans"/>
                                            <TextBox Style="{StaticResource FieldBox}" FontWeight="Bold" Text="{Binding DebtCashAdvanceInput, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}" FontSize="12" Margin="0,0,0,4" Text="Karta avans"/>
                                            <TextBox Style="{StaticResource FieldBox}" FontWeight="Bold" Text="{Binding DebtCardAdvanceInput, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Style="{StaticResource FieldLabel}" FontSize="12" Margin="0,0,0,4" Text="To'lash muddati"/>
                                            <Border Height="44" CornerRadius="10" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1.5" Background="{DynamicResource Surface}" Padding="6,0">
                                                <DatePicker SelectedDate="{Binding DebtDueDate, Mode=TwoWay}" BorderThickness="0" Background="Transparent"
                                                            VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Border Margin="0,10,0,0" Padding="14,10" CornerRadius="10" Background="{DynamicResource BadSoft}">
                                        <Grid>
                                            <TextBlock Text="Nasiyaga qoladi" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Bad}" VerticalAlignment="Center"/>
                                            <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource Bad}">
                                                <Run Text="{Binding DebtRemainingAmount, Mode=OneWay, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="ExtraBold"/>
                                                <Run Text="so'm" FontSize="13" FontWeight="SemiBold"/>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Chek turi -->
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Chek" Margin="0,16,0,8"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource ChoiceChip}" Margin="0,0,6,6" Content="58 mm chek"
                                            Command="{Binding SelectReceiptOptionCommand}" CommandParameter="1" Tag="{Binding Is58mmPreview}"/>
                                    <Button Style="{StaticResource ChoiceChip}" Margin="0,0,6,6" Content="A4 hisob-faktura"
                                            Command="{Binding SelectReceiptOptionCommand}" CommandParameter="2" Tag="{Binding IsA4Preview}"/>
                                    <Button Style="{StaticResource ChoiceChip}" Margin="0,0,0,6" Content="Cheksiz"
                                            Command="{Binding SelectReceiptOptionCommand}" CommandParameter="0" Tag="{Binding IsNoReceiptPreview}"/>
                                </WrapPanel>
                                <!-- 58 mm printer tanlash -->
                                <ComboBox Style="{StaticResource FieldCombo}" Margin="0,8,0,0" Height="40" Tag="Chek printerini tanlang…"
                                          Visibility="{Binding Is58mmPreview, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          ItemsSource="{Binding AvailablePrinters}"
                                          SelectedItem="{Binding SelectedReceiptPrinter, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="13" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Tugmalar -->
                        <Border Grid.Row="2" Padding="24,16,24,20" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PaymentCancelBtn" IsCancel="True" Style="{StaticResource BtnSecondary}" Height="52" Padding="18,0"
                                        Command="{Binding ClosePaymentModalCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Bekor qilish" VerticalAlignment="Center"/>
                                        <Border Margin="10,0,0,0" Padding="6,2" CornerRadius="5" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                            <TextBlock Text="Esc" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Ink2}"/>
                                        </Border>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" x:Name="PaymentConfirmBtn" IsDefault="True" Style="{StaticResource BtnPrimary}" Height="52" FontSize="16"
                                        Command="{Binding ConfirmSaleCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="20" Height="20"><Path Style="{StaticResource Ic}" StrokeThickness="2.4" Data="M20 6L9 17l-5-5"/></Viewbox>
                                        <TextBlock Text="{Binding ConfirmSaleLabel}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource KbdChip}" Margin="10,0,0,0" Padding="6,2" CornerRadius="5">
                                            <TextBlock Text="Enter" FontFamily="Consolas" FontSize="11" FontWeight="Normal"/>
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ===== O'NG: CHEK KO'RINISHI (340px) ===== -->
                    <Border Grid.Column="1" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" CornerRadius="0,16,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="20,18,20,12">
                                <TextBlock Text="Chek ko'rinishi" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="200"
                                            Visibility="{Binding HasPrinterStatus, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            ToolTip="{Binding PrinterStatusLabel}">
                                    <Ellipse x:Name="PrinterDot" Width="7" Height="7" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource Bad}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPrinterStatusOk}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource Ok}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding PrinterStatusLabel}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPrinterStatusOk}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Ok}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="20,0,20,20">
                                <!-- Cheksiz -->
                                <StackPanel Visibility="{Binding IsNoReceiptPreview, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" HorizontalAlignment="Center">
                                        <Viewbox Width="28" Height="28">
                                            <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink3}" StrokeThickness="1.8"
                                                  Data="M6 3h12v18l-3-2l-3 2l-3-2l-3 2z M9 8h6M9 12h6 M3 3l18 18"/>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="Chek chop etilmaydi" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                    <TextBlock Text="Savdo faqat dastur xotirasida saqlanadi." FontSize="13" Foreground="{DynamicResource Ink2}"
                                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="240"/>
                                </StackPanel>

                                <!-- 58 mm chek -->
                                <ScrollViewer Visibility="{Binding Is58mmPreview, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <Border Background="{DynamicResource PaperBg}" Width="230" Padding="14,16" HorizontalAlignment="Center" VerticalAlignment="Top">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.12" Color="#000000"/>
                                        </Border.Effect>
                                        <TextBlock Text="{Binding Receipt58mmPreviewText}" FontFamily="Consolas" FontSize="11" LineHeight="16"
                                                   Foreground="{DynamicResource PaperInk}" TextWrapping="NoWrap" HorizontalAlignment="Center"/>
                                    </Border>
                                </ScrollViewer>

                                <!-- A4 hisob-faktura (kichraytirilgan) -->
                                <Border Visibility="{Binding IsA4Preview, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Background="{DynamicResource PaperBg}" Padding="14" VerticalAlignment="Top">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.12" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" TextElement.Foreground="{DynamicResource PaperInk}">
                                        <StackPanel>
                                            <Border BorderBrush="{DynamicResource PaperInk}" BorderThickness="0,0,0,1.5" Padding="0,0,0,8" Margin="0,0,0,10">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="HISOB-FAKTURA" FontSize="13" FontWeight="Bold"/>
                                                        <TextBlock Text="A4" FontSize="10" Foreground="{DynamicResource PaperRule}"/>
                                                    </StackPanel>
                                                    <StackPanel HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding A4DateDisplay}" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource PaperRule}"/>
                                                        <TextBlock Text="{Binding A4PaymentDisplay}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Grid Margin="0,0,0,4" TextElement.FontSize="10" TextElement.FontWeight="Bold">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="62"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="#"/>
                                                <TextBlock Grid.Column="1" Text="Mahsulot"/>
                                                <TextBlock Grid.Column="2" Text="Miqdor" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="Jami" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding A4PreviewRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource PaperRule}" BorderThickness="0,0,0,0.5" Padding="0,3">
                                                            <Grid TextElement.FontSize="10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="18"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="40"/>
                                                                    <ColumnDefinition Width="62"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding IndexDisplay}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding ProductName}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding QuantityDisplay}" HorizontalAlignment="Right"/>
                                                                <TextBlock Grid.Column="3" Text="{Binding TotalDisplay}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Grid Margin="0,10,0,0">
                                                <TextBlock Text="Jami to'lov:" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N0} so\'m'}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- ===================================================================== -->
        <!-- 1.9 SHTRIX-KOD TOPILMADI (480px)                                       -->
        <!-- ===================================================================== -->
        <Border Background="{DynamicResource Scrim}" Panel.ZIndex="120"
                Visibility="{Binding IsUnrecognizedBarcodeModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                Focusable="True"
                IsVisibleChanged="UnrecognizedBarcodeModal_IsVisibleChanged"
                KeyDown="UnrecognizedBarcodeModal_KeyDown">
            <Border Style="{StaticResource ModalCard}" Width="480" Padding="26,26,26,20">
                <StackPanel>
                    <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource WarnSoft}" HorizontalAlignment="Center">
                        <Viewbox Width="32" Height="32">
                            <Grid Width="24" Height="24">
                                <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Warn}" StrokeThickness="1.8" Data="M4 6v12M7 6v12M10 6v12M14 6v12M17 6v12M20 6v12"/>
                                <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Bad}" StrokeThickness="1.8" Data="M3 21L21 3"/>
                            </Grid>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="Bu shtrix-kod bazada yo'q" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <Border Margin="0,12,0,0" Padding="14,8" CornerRadius="8" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="1" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding UnrecognizedBarcode}" FontFamily="Consolas" FontSize="20" Foreground="{DynamicResource Ink}"/>
                    </Border>
                    <TextBlock Text="Skaner to'g'ri o'qiganini tekshiring. Tovar yangi bo'lsa, shu kod bilan darhol qo'shing."
                               FontSize="14" LineHeight="21" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="380" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <Button x:Name="AddUnrecognizedBarcodeBtn" Style="{StaticResource BtnPrimary}" Margin="0,20,0,0" Focusable="False"
                            Command="{Binding ConfirmAddUnrecognizedBarcodeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18"><Path Style="{StaticResource Ic}" StrokeThickness="2.2" Data="M12 5v14M5 12h14"/></Viewbox>
                            <TextBlock Text="Yangi tovar sifatida qo'shish" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Kbd}" Text="Enter"/>
                        </StackPanel>
                    </Button>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource BtnSecondary}" Height="44" Focusable="False" Content="Nomi bo'yicha qidirish"
                                Command="{Binding CloseUnrecognizedBarcodeCommand}" ToolTip="Oynani yopib, qidiruv maydoniga qaytish"/>
                        <Button Grid.Column="2" Style="{StaticResource BtnSecondary}" Height="44" Focusable="False" Command="{Binding CloseUnrecognizedBarcodeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Yopish" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource Kbd}" Text="Esc" Foreground="{DynamicResource Ink3}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===================================================================== -->
        <!-- 1.10 BRAK SIFATIDA HISOBDAN CHIQARISH (500px)                          -->
        <!-- ===================================================================== -->
        <Border Background="{DynamicResource Scrim}" Panel.ZIndex="105"
                Visibility="{Binding IsBrakModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                IsVisibleChanged="BrakModal_IsVisibleChanged">
            <Border Style="{StaticResource ModalCard}" Width="500">
                <StackPanel>
                    <Grid Margin="24,22,24,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource BadSoft}" VerticalAlignment="Top">
                            <Viewbox Width="22" Height="22">
                                <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Bad}" Data="M21 8l-9-5l-9 5v8l9 5l9-5z M9 10l6 6M15 10l-6 6"/>
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="Brak sifatida hisobdan chiqarish" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                            <TextBlock Text="Savatdagi tovarlar sotilmaydi (0 so'm), ombordan ayiriladi va zarar sifatida hisobotga yoziladi."
                                       FontSize="14" LineHeight="20" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Border Margin="24,0" CornerRadius="12" BorderBrush="{DynamicResource Line}" BorderThickness="1" ClipToBounds="True">
                        <StackPanel TextElement.FontSize="14">
                            <Border Padding="14,12" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <TextBlock Text="Tovarlar" Foreground="{DynamicResource Ink2}"/>
                                    <TextBlock Text="{Binding BrakItemsCount, StringFormat='{}{0} xil'}" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <Border Padding="14,12" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <TextBlock Text="Sotuv narxi" Foreground="{DynamicResource Ink2}"/>
                                    <TextBlock Text="0 so'm" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <Border Padding="14,12" Background="{DynamicResource BadSoft}" CornerRadius="0,0,11,11">
                                <Grid>
                                    <TextBlock Text="Zarar (tan narx bo'yicha)" FontWeight="SemiBold" Foreground="{DynamicResource Bad}"/>
                                    <TextBlock Text="{Binding BrakTotalCostDisplay, StringFormat='{}−{0}'}" FontWeight="Bold" Foreground="{DynamicResource Bad}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Grid Margin="24,18,24,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BrakCancelBtn" IsCancel="True" Style="{StaticResource BtnSecondary}" Command="{Binding CloseBrakModalCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Bekor qilish" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource Kbd}" Text="Esc" Foreground="{DynamicResource Ink3}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" x:Name="BrakConfirmBtn" Style="{StaticResource BtnDanger}" Content="Brak qilish"
                                Command="{Binding ConfirmBrakWriteOffCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===================================================================== -->
        <!-- 1.11 SAVATNI KUTISHGA QO'YISH (460px)                                  -->
        <!-- ===================================================================== -->
        <Border Background="{DynamicResource Scrim}" Panel.ZIndex="110"
                Visibility="{Binding IsHoldModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                Focusable="True"
                IsVisibleChanged="HoldModal_IsVisibleChanged"
                KeyDown="HoldModal_KeyDown">
            <Border Style="{StaticResource ModalCard}" Width="460" Padding="24,22,24,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoft}">
                            <Viewbox Width="20" Height="20">
                                <Path Style="{StaticResource Ic}" Stroke="{DynamicResource AccentInk}" Data="M7 5h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z M15 5h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z"/>
                            </Viewbox>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Savatni kutishga qo'yish" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                            <TextBlock Text="{Binding HoldCartSummaryText}" FontSize="13" Foreground="{DynamicResource Ink3}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,6">
                        <Run Text="Kim uchun?"/><Run Text=" — keyin topish oson bo'ladi" FontWeight="Normal" Foreground="{DynamicResource Ink3}"/>
                    </TextBlock>
                    <TextBox x:Name="TxtHoldCartName" Style="{StaticResource FieldBox}" Height="48" FontSize="16"
                             Text="{Binding HoldCartName, UpdateSourceTrigger=PropertyChanged}"/>

                    <WrapPanel Margin="0,14,0,0">
                        <TextBlock Text="Tez:" FontSize="12" Foreground="{DynamicResource Ink3}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                        <Button Style="{StaticResource ChoiceChip}" Height="32" Padding="10,0" Margin="0,0,6,6" Background="{DynamicResource Surface2}"
                                Content="Pul olib keladi" Command="{Binding SetHoldNameCommand}" CommandParameter="Pul olib keladi"/>
                        <Button Style="{StaticResource ChoiceChip}" Height="32" Padding="10,0" Margin="0,0,6,6" Background="{DynamicResource Surface2}"
                                Content="Tanlayapti" Command="{Binding SetHoldNameCommand}" CommandParameter="Tanlayapti"/>
                        <Button Style="{StaticResource ChoiceChip}" Height="32" Padding="10,0" Margin="0,0,0,6" Background="{DynamicResource Surface2}"
                                Content="Telefon qiladi" Command="{Binding SetHoldNameCommand}" CommandParameter="Telefon qiladi"/>
                    </WrapPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Viewbox Width="14" Height="14"><Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink3}" Data="M3 12a9 9 0 1 0 18 0a9 9 0 1 0-18 0 M12 7v5l3 2"/></Viewbox>
                        <TextBlock FontSize="12" Foreground="{DynamicResource Ink3}" Margin="6,0,0,0" VerticalAlignment="Center">
                            <Run Text="Kutishdagi savatlar savat ustida chip bo'lib turadi (hozir"/><Run Text="{Binding HeldCarts.Count, Mode=OneWay, StringFormat=' {0} ta)'}"/>
                        </TextBlock>
                    </StackPanel>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource BtnSecondary}" Command="{Binding CloseHoldModalCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Bekor" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource Kbd}" Text="Esc" Foreground="{DynamicResource Ink3}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnConfirmHoldCart" Grid.Column="2" Style="{StaticResource BtnPrimary}" Command="{Binding ConfirmHoldCartCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Kutishga qo'yish" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource Kbd}" Text="Enter"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===================================================================== -->
        <!-- 1.7 NASIYA · TEZKOR MIJOZ QO'SHISH (440px)                             -->
        <!-- ===================================================================== -->
        <Border Background="{DynamicResource Scrim}" Panel.ZIndex="150"
                Visibility="{Binding IsQuickCustomerModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{StaticResource ModalCard}" Width="440" Padding="24,22">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Yangi mijoz" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                        <TextBlock Text="Nasiya uchun" FontSize="12" Foreground="{DynamicResource Ink3}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Margin="0,14,0,0" Padding="12,8" CornerRadius="8" Background="{DynamicResource BadSoft}"
                            Visibility="{Binding HasQuickCustomerError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding QuickCustomerErrorMessage}" Foreground="{DynamicResource Bad}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,6">
                        <Run Text="Ism familiya"/><Run Text=" *" Foreground="{DynamicResource Bad}"/>
                    </TextBlock>
                    <TextBox Style="{StaticResource FieldBox}" Text="{Binding QuickCustomerName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,6" Text="Telefon"/>
                    <TextBox Style="{StaticResource FieldBox}" Text="{Binding QuickCustomerPhone, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,6">
                        <Run Text="Izoh"/><Run Text=" — manzil, kim tavsiya qilgan" FontWeight="Normal" Foreground="{DynamicResource Ink3}"/>
                    </TextBlock>
                    <TextBox Style="{StaticResource FieldBox}" Text="{Binding QuickCustomerNote, UpdateSourceTrigger=PropertyChanged}"/>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource BtnSecondary}" Content="Bekor qilish" Command="{Binding CloseQuickCustomerModalCommand}"/>
                        <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Content="Saqlash va tanlash" Command="{Binding SaveQuickCustomerModalCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===================================================================== -->
        <!-- BILDIRISHNOMA (maket: pastda markazda; amal bo'lsa to'q fon)           -->
        <!-- ===================================================================== -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Panel.ZIndex="200"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                MaxWidth="720" CornerRadius="12" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.18" Color="#0F1B21"/>
            </Border.Effect>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Surface}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource OkLine}"/>
                    <Setter Property="Padding" Value="16,12"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastKind}" Value="warn"><Setter Property="BorderBrush" Value="{DynamicResource WarnLine}"/></DataTrigger>
                        <DataTrigger Binding="{Binding ToastKind}" Value="bad"><Setter Property="BorderBrush" Value="{DynamicResource BadLine}"/></DataTrigger>
                        <DataTrigger Binding="{Binding ToastKind}" Value="info"><Setter Property="BorderBrush" Value="{DynamicResource Line}"/></DataTrigger>
                        <!-- Bekor qilish amali bor xabar: to'q fon -->
                        <DataTrigger Binding="{Binding HasToastAction}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ToastBg}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource ToastBg}"/>
                            <Setter Property="Padding" Value="16,8,8,8"/>
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource ToastFg}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <!-- Holat belgisi -->
                <Border Width="28" Height="28" CornerRadius="14" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource OkSoft}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastKind}" Value="warn"><Setter Property="Background" Value="{DynamicResource WarnSoft}"/></DataTrigger>
                                <DataTrigger Binding="{Binding ToastKind}" Value="bad"><Setter Property="Background" Value="{DynamicResource BadSoft}"/></DataTrigger>
                                <DataTrigger Binding="{Binding ToastKind}" Value="info"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/></DataTrigger>
                                <DataTrigger Binding="{Binding HasToastAction}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Viewbox Width="16" Height="16">
                        <Path StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24" Stretch="None">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="M20 6L9 17l-5-5"/>
                                    <Setter Property="Stroke" Value="{DynamicResource Ok}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ToastKind}" Value="warn"><Setter Property="Data" Value="M12 7v6M12 17h.01"/><Setter Property="Stroke" Value="{DynamicResource Warn}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding ToastKind}" Value="bad"><Setter Property="Data" Value="M18 6L6 18M6 6l12 12"/><Setter Property="Stroke" Value="{DynamicResource Bad}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding ToastKind}" Value="info"><Setter Property="Data" Value="M12 11v6M12 7h.01"/><Setter Property="Stroke" Value="{DynamicResource AccentInk}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Viewbox>
                </Border>
                <!-- Amalli xabar ikonkasi (savatdan o'chirildi) -->
                <Viewbox Width="18" Height="18" Margin="0,0,14,0" VerticalAlignment="Center"
                         Visibility="{Binding HasToastAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Path Style="{StaticResource Ic}" Stroke="{DynamicResource ToastFg}" Data="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                </Viewbox>
                <TextBlock Text="{Binding ToastTitle}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ToastMessage}" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.75"
                           TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                <!-- Amal tugmasi (Bekor qilish) -->
                <Button Margin="14,0,0,0" Height="36" Padding="14,0" Cursor="Hand"
                        Command="{Binding ToastActionCommand}"
                        Visibility="{Binding HasToastAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{DynamicResource ToastBtnBg}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="16" Height="16">
                                        <Path Style="{StaticResource Ic}" StrokeThickness="2.2" Stroke="{DynamicResource ToastBtnFg}" Data="M9 14L4 9l5-5 M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/>
                                    </Viewbox>
                                    <TextBlock Text="{Binding ToastActionText}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ToastBtnFg}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <!-- Yopish -->
                <Button Width="28" Height="28" Margin="8,0,0,0" Cursor="Hand" Command="{Binding DismissToastCommand}" ToolTip="Yopish" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <Viewbox Width="12" Height="12" Opacity="0.6">
                                    <Path StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24" Stretch="None"
                                          Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=StackPanel}}" Data="M18 6L6 18M6 6l12 12"/>
                                </Viewbox>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
