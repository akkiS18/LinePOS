<Window x:Class="PosElectro.Desktop.Views.QuickStockAddDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Qoldiqni oshirish (Kirim)" Height="430" Width="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0F172A" WindowStyle="SingleBorderWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Sarlavha -->
            <RowDefinition Height="Auto"/>
            <!-- Tovar ma'lumotlari -->
            <RowDefinition Height="Auto"/>
            <!-- Kiritish maydoni -->
            <RowDefinition Height="Auto"/>
            <!-- Hisob-kitob ko'rinishi -->
            <RowDefinition Height="*"/>
            <!-- Tugmalar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. SARLAVHA -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#134E4A" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                    <TextBlock Text="📦" FontSize="20" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Qoldiqni Oshirish (Kirim)" Foreground="#F8FAFC" FontSize="17" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtWarehouseName" Text="Ombor: Asosiy ombor" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 2. TOVAR KARTASI -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" Padding="14,10" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtProductName" Text="Mahsulot nomi" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtBarcode" Text="Shtrix-kod: 12345678" Foreground="#38BDF8" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Joriy Qoldiq -->
                <Border Grid.Column="1" Background="#0F172A" CornerRadius="8" Padding="12,6" VerticalAlignment="Center" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Joriy qoldiq" Foreground="#94A3B8" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtCurrentStock" Text="10 dona" Foreground="#4ADE80" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 3. KIRITISH MAYDONI -->
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="Yangi kelgan tovar sonini kiriting:" Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Grid>
                <TextBox x:Name="TxtQuantity" 
                         Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#0284C7" BorderThickness="1.5"
                         FontSize="18" FontWeight="Bold" Padding="12,8"
                         VerticalContentAlignment="Center"
                         TextChanged="TxtQuantity_TextChanged"
                         KeyDown="TxtQuantity_KeyDown">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                <TextBlock x:Name="TxtUnitSuffix" Text="dona" Foreground="#64748B" FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" IsHitTestVisible="False"/>
            </Grid>
            <TextBlock x:Name="TxtError" Text="" Foreground="#F87171" FontSize="12" Margin="0,4,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- 4. HISOBLASH PREVIEW BLOKI -->
        <Border Grid.Row="3" Background="#0F3642" BorderBrush="#0B6477" BorderThickness="1" CornerRadius="8" Padding="14,10" VerticalAlignment="Center" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Yangi jami qoldiq: " Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtCalculationPreview" Text="10 + 0 = 10 dona" Foreground="#2DD4BF" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 5. TUGMALAR -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Bekor qilish (Esc)" Click="BtnCancel_Click"
                    Background="#334155" Foreground="#94A3B8" BorderThickness="0"
                    Padding="0,10" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold" FontSize="13">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                </Button.Resources>
            </Button>

            <Button Grid.Column="1" Content="✓ Qo'shish (Enter)" Click="BtnConfirm_Click"
                    Background="#0B6477" Foreground="White" BorderBrush="#2DD4BF" BorderThickness="1"
                    Padding="0,10" Margin="8,0,0,0" Cursor="Hand" FontWeight="Bold" FontSize="13">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
