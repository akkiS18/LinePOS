<Window x:Class="PosElectro.Desktop.Views.QuickStockAddDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Qoldiqni oshirish (Kirim)" Height="430" Width="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource Bg}" WindowStyle="SingleBorderWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Sarlavha -->
            <RowDefinition Height="Auto"/>
            <!-- Tovar ma'lumotlari -->
            <RowDefinition Height="Auto"/>
            <!-- Kiritish maydoni -->
            <RowDefinition Height="Auto"/>
            <!-- Hisob-kitob ko'rinishi -->
            <RowDefinition Height="*"/>
            <!-- Tugmalar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. SARLAVHA -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource OkSoft}" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                    <TextBlock Text="📦" FontSize="20" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Qoldiqni Oshirish (Kirim)" Foreground="{DynamicResource Ink}" FontSize="17" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtWarehouseName" Text="Ombor: Asosiy ombor" Foreground="{DynamicResource Ink2}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 2. TOVAR KARTASI -->
        <Border Grid.Row="1" Background="{DynamicResource Surface}" CornerRadius="10" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="14,10" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtProductName" Text="Mahsulot nomi" Foreground="{DynamicResource Ink}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtBarcode" Text="Shtrix-kod: 12345678" Foreground="{DynamicResource AccentInk}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Joriy Qoldiq -->
                <Border Grid.Column="1" Background="{DynamicResource Bg}" CornerRadius="8" Padding="12,6" VerticalAlignment="Center" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Joriy qoldiq" Foreground="{DynamicResource Ink2}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtCurrentStock" Text="10 dona" Foreground="{DynamicResource Ok}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 3. KIRITISH MAYDONI -->
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="Yangi kelgan tovar sonini kiriting:" Foreground="{DynamicResource Ink}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Grid>
                <TextBox x:Name="TxtQuantity" 
                         Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                         FontSize="18" FontWeight="Bold" Padding="12,8"
                         VerticalContentAlignment="Center"
                         TextChanged="TxtQuantity_TextChanged"
                         KeyDown="TxtQuantity_KeyDown">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                <TextBlock x:Name="TxtUnitSuffix" Text="dona" Foreground="{DynamicResource Ink3}" FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" IsHitTestVisible="False"/>
            </Grid>
            <TextBlock x:Name="TxtError" Text="" Foreground="{DynamicResource Bad}" FontSize="12" Margin="0,4,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- 4. HISOBLASH PREVIEW BLOKI -->
        <Border Grid.Row="3" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Padding="14,10" VerticalAlignment="Center" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Yangi jami qoldiq: " Foreground="{DynamicResource Ink2}" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtCalculationPreview" Text="10 + 0 = 10 dona" Foreground="{DynamicResource AccentInk}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 5. TUGMALAR -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Bekor qilish (Esc)" Click="BtnCancel_Click"
                    IsCancel="True"
                    Background="{DynamicResource Line}" Foreground="{DynamicResource Ink2}" BorderThickness="0"
                    Padding="0,10" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold" FontSize="13">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                </Button.Resources>
            </Button>

            <Button Grid.Column="1" Content="✓ Qo'shish (Enter)" Click="BtnConfirm_Click"
                    IsDefault="True"
                    Background="{DynamicResource Accent}" Foreground="White" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                    Padding="0,10" Margin="8,0,0,0" Cursor="Hand" FontWeight="Bold" FontSize="13">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
