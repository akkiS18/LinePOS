<UserControl x:Class="PosElectro.Desktop.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:PosElectro.Desktop.Controls"
             xmlns:services="clr-namespace:PosElectro.Desktop.Services"
             xmlns:models="clr-namespace:PosElectro.Desktop.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1150"
             PreviewKeyDown="InventoryView_PreviewKeyDown">
    <Grid Background="{DynamicResource Bg}">

        <!-- ========================================================= -->
        <!-- 1. OMBOR ASOSIY OYNASI (maket 2.1 va 2.2, yorug' tema)    -->
        <!-- ========================================================= -->
        <Grid Visibility="{Binding IsMainViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="{DynamicResource Bg}" TextElement.Foreground="{DynamicResource Ink}">
            <Grid.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/Theme.Light.xaml"/>
                        <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/SmartControls.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                    <CollectionViewSource x:Key="WarehouseCardsSource" Source="{Binding Warehouses}"/>

                    <!-- Qidiruv maydoni: 44px, Surface, radius 10, chapda ikonka -->
                    <Style x:Key="SearchField" TargetType="TextBox">
                        <Setter Property="Height" Value="44"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                        <Setter Property="CaretBrush" Value="{DynamicResource AccentInk}"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TextBox">
                                    <Border x:Name="bd" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,0,40,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <Path Data="M4 11a7 7 0 1 0 14 0a7 7 0 1 0-14 0 M20 20l-3.5-3.5" Width="24" Height="24" Stretch="None"
                                                      Stroke="{DynamicResource Ink3}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Viewbox>
                                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Focusable="False" VerticalAlignment="Center"
                                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"/>
                                            <TextBlock x:Name="ph" Grid.Column="1" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                       Foreground="{DynamicResource Ink3}" VerticalAlignment="Center" Margin="2,0,0,0"
                                                       IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Asboblar paneli tugmasi: 44px, radius 10 -->
                    <Style x:Key="ToolBtn" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                        <Setter Property="Height" Value="44"/>
                        <Setter Property="Padding" Value="14,0"/>
                        <Setter Property="Margin" Value="10,0,0,0"/>
                    </Style>

                    <!-- Jadval qatoridagi 40×40 amal tugmasi -->
                    <Style x:Key="RowActBtn" TargetType="Button">
                        <Setter Property="Width" Value="40"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- "Boshqa amallar" menyusi qatori -->
                    <Style x:Key="MenuItemBtn" TargetType="Button">
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Kichik belgilash qutisi (18px, radius 5) -->
                    <Style x:Key="SmallCheck" TargetType="CheckBox">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="CheckBox">
                                    <Border x:Name="box" Width="18" Height="18" CornerRadius="5" Background="{DynamicResource Surface}"
                                            BorderBrush="{DynamicResource LineStrong}" BorderThickness="1.5">
                                        <Viewbox x:Name="tick" Width="12" Height="12" Visibility="Collapsed">
                                            <Path Data="M5 12l5 5l9-10" Width="24" Height="24" Stretch="None" Stroke="{DynamicResource OnAccent}"
                                                  StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Viewbox>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                                            <Setter TargetName="box" Property="BorderThickness" Value="0"/>
                                            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Matnli havola tugmasi -->
                    <Style x:Key="LinkBtn" TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Kartadagi kichik ikonka tugmasi (28px) -->
                    <Style x:Key="CardIconBtn" TargetType="Button" BasedOn="{StaticResource RowActBtn}">
                        <Setter Property="Width" Value="28"/>
                        <Setter Property="Height" Value="28"/>
                        <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
                    </Style>

                </ResourceDictionary>
            </Grid.Resources>

            <!-- ============ 2.1 OMBORLAR VA KATEGORIYALAR ============ -->
            <Grid Margin="16" Visibility="{Binding IsProductsListVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Asboblar paneli -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ombor" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchField}"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="OverviewSearch_TextChanged">
                            <TextBox.Tag>
                                <Binding Path="OverviewSearchPlaceholder"/>
                            </TextBox.Tag>
                        </TextBox>
                    </Grid>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource ToolBtn}" Width="44" Padding="0" Command="{Binding RefreshCommand}" ToolTip="Ro'yxatni yangilash">
                            <Viewbox Width="18" Height="18"><Path Style="{StaticResource Ic}" Data="M3 12a9 9 0 0 1 15-6.7L21 8 M21 3v5h-5 M21 12a9 9 0 0 1-15 6.7L3 16 M3 21v-5h5"/></Viewbox>
                        </Button>
                        <Button Style="{StaticResource ToolBtn}" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" Foreground="{DynamicResource Warn}"
                                Command="{Binding SelectCategoryCommand}" CommandParameter="{Binding LowStockCard}"
                                ToolTip="Kam qolgan va tugagan tovarlar — buyurtma ro'yxati uchun">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18"><Path Style="{StaticResource Ic}" Data="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z M12 9v4M12 17h.01"/></Viewbox>
                                <TextBlock Text="Kam qolganlar" Margin="8,0,8,0" VerticalAlignment="Center"/>
                                <Border CornerRadius="9" Padding="7,1" Background="{DynamicResource Warn}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LowStockCard.Count}" FontSize="12" Foreground="{DynamicResource OnAccent}"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolBtn}" Command="{Binding OpenTransferModalCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18"><Path Style="{StaticResource Ic}" Data="M7 4L3 8l4 4M3 8h14M17 20l4-4-4-4M21 16H7"/></Viewbox>
                                <TextBlock Text="Omborlararo ko'chirish" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BtnPrimary}" Height="44" Padding="16,0" Margin="10,0,0,0" Command="{Binding OpenAddProductCommand}"
                                Visibility="{Binding CanAddProduct, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18"><Path Style="{StaticResource Ic}" StrokeThickness="2.4" Data="M12 5v14M5 12h14"/></Viewbox>
                                <TextBlock Text="Yangi tovar" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <!-- Omborlar -->
                        <TextBlock Text="Omborlar" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}" Margin="0,0,0,8"/>
                        <ItemsControl Focusable="False" Margin="3,3,3,0">
                            <ItemsControl.Resources>
                            <!-- Ombor kartasi (2.1): 118px, tanlangani Accent 2px + halqa -->
                            <DataTemplate DataType="{x:Type models:Warehouse}">
                                <Button Height="118" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.SelectWarehouseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Tag>
                                        <MultiBinding Converter="{StaticResource SameValueMultiConverter}">
                                            <Binding Path="Guid"/>
                                            <Binding Path="DataContext.SelectedWarehouse.Guid" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </Button.Tag>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ring" CornerRadius="15" BorderThickness="3" BorderBrush="Transparent" Margin="-3">
                                                <Border x:Name="bd" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                        CornerRadius="12" Padding="16,14">
                                                    <ContentPresenter/>
                                                </Border>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                                    <Setter TargetName="bd" Property="Padding" Value="15,13"/>
                                                    <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource AccentRing}"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="9">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource IllusBg}"/>
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink2}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource OnAccent}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Viewbox Width="18" Height="18">
                                                    <Path Data="M3 21h18M5 21V8l7-5l7 5v13M9 21v-6h6v6" Width="24" Height="24" Stretch="None" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"/>
                                                </Viewbox>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Ink}"
                                                       Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <!-- Asosiy ombor belgisi yoki amallar -->
                                            <Border Grid.Column="2" Padding="8,2" CornerRadius="6" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center"
                                                    Visibility="{Binding IsPrimary, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="ASOSIY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentInk}"/>
                                            </Border>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding IsPrimary, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                <Button Style="{StaticResource CardIconBtn}" ToolTip="Asosiy ombor qilish" Focusable="False"
                                                        Command="{Binding DataContext.SetPrimaryWarehouseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Viewbox Width="15" Height="15"><Path Style="{StaticResource Ic}" Data="M12 3l2.8 5.7l6.2.9l-4.5 4.4l1.1 6.2L12 17.3l-5.6 2.9l1.1-6.2L3 9.6l6.2-.9z"/></Viewbox>
                                                </Button>
                                                <Button Style="{StaticResource CardIconBtn}" ToolTip="Omborni o'chirish" Focusable="False" Margin="2,0,0,0"
                                                        Visibility="{Binding CanDelete, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Command="{Binding DataContext.DeleteWarehouseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Viewbox Width="15" Height="15"><Path Style="{StaticResource Ic}" Data="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/></Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <!-- Statistika -->
                                        <WrapPanel Grid.Row="2" TextElement.FontSize="13" TextElement.Foreground="{DynamicResource Ink2}">
                                            <TextBlock Margin="0,0,16,0">
                                                <Run Text="{Binding TotalProductCount, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                                                <Run Text="tovar"/>
                                            </TextBlock>
                                            <TextBlock Margin="0,0,16,0">
                                                <Run Text="{Binding TotalStockQuantity, Mode=OneWay, StringFormat='{}{0:#,0.##}'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                                                <Run Text="birlik"/>
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Tan narxi" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TotalStockValue, StringFormat='{}{0:N0}'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="4,0,0,0"
                                                           Visibility="{Binding CanSeeSecrets, Source={x:Static services:AdminGate.Current}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0" ToolTip="Admin PIN bilan ko'rinadi"
                                                            Visibility="{Binding CanSeeSecrets, Source={x:Static services:AdminGate.Current}, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                    <TextBlock Text="••••" FontWeight="Bold" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                                                    <Viewbox Width="12" Height="12" Margin="4,0,0,0" VerticalAlignment="Center">
                                                        <Path Data="M6 11h12a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2z M8 11V7a4 4 0 0 1 8 0v4" Width="24" Height="24" Stretch="None"
                                                              Stroke="{DynamicResource Ink3}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    </Viewbox>
                                                </StackPanel>
                                            </StackPanel>
                                        </WrapPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>

                            <!-- "Yangi ombor" (oxirgi karta, uzuq chiziqli) -->
                            <DataTemplate DataType="{x:Type sys:String}">
                                <Button Height="118" Cursor="Hand" Command="{Binding DataContext.OpenAddWarehouseModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Background="Transparent">
                                                <Rectangle x:Name="dash" RadiusX="12" RadiusY="12" Stroke="{DynamicResource LineStrong}" StrokeThickness="1.5" StrokeDashArray="4 3"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Viewbox Width="18" Height="18">
                                                        <Path Data="M12 5v14M5 12h14" Width="24" Height="24" Stretch="None" Stroke="{DynamicResource Ink2}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    </Viewbox>
                                                    <TextBlock Text="Yangi ombor" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="dash" Property="Stroke" Value="{DynamicResource Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                            </ItemsControl.Resources>
                            <ItemsControl.ItemsSource>
                                <CompositeCollection>
                                    <CollectionContainer Collection="{Binding Source={StaticResource WarehouseCardsSource}}"/>
                                    <sys:String>+</sys:String>
                                </CompositeCollection>
                            </ItemsControl.ItemsSource>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:AdaptiveGridPanel MinItemWidth="260" ItemHeight="118" Spacing="12"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>

                        <!-- Kategoriyalar -->
                        <Grid Margin="0,16,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center">
                                    <Run Text="Kategoriyalar ·"/>
                                    <Run Text="{Binding CurrentWarehouseTitle, Mode=OneWay}" Foreground="{DynamicResource Ink}"/>
                                </TextBlock>
                                <Button Style="{StaticResource LinkBtn}" Margin="8,0,0,0" Content="Barcha omborlar" FontSize="13"
                                        Command="{Binding BackToWarehousesCommand}"
                                        Visibility="{Binding CanGoBackToWarehouses, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                            <Button Style="{StaticResource LinkBtn}" HorizontalAlignment="Right" Content="+ Yangi kategoriya"
                                    Command="{Binding OpenAddCategoryModalCommand}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding GridCategoryCards}" Focusable="False" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:AdaptiveGridPanel MinItemWidth="260" ItemHeight="104" Spacing="12"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Height="104" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                        CornerRadius="12" Padding="16,14">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Direction="270" Opacity="0.05" Color="#0F1B21"/>
                                                    </Border.Effect>
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource IllusBg}" HorizontalAlignment="Left">
                                                    <Viewbox Width="20" Height="20">
                                                        <Path Data="{Binding IconData}" Width="24" Height="24" Stretch="None" Stroke="{DynamicResource Ink2}" StrokeThickness="2"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                    </Viewbox>
                                                </Border>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                    <Button Style="{StaticResource CardIconBtn}" ToolTip="Kategoriya nomini o'zgartirish" Focusable="False" Margin="0,0,6,0"
                                                            Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Command="{Binding DataContext.OpenEditCategoryModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Name}">
                                                        <Viewbox Width="15" Height="15"><Path Style="{StaticResource Ic}" Data="M12 20h9 M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1l1-4z"/></Viewbox>
                                                    </Button>
                                                    <Border Padding="8,3" CornerRadius="6" VerticalAlignment="Center"
                                                            Visibility="{Binding HasBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource WarnSoft}"/>
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Warn}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOutBadge}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource BadSoft}"/>
                                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Bad}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding BadgeText}" FontSize="12" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat='{}{0} tovar'}" FontSize="13" Foreground="{DynamicResource Ink2}" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                                            </Grid>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============ 2.2 TOVARLAR JADVALI ============ -->
            <Grid Margin="16" Visibility="{Binding IsProductsListVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Yo'l (breadcrumb) va amallar -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource BtnSecondary}" Width="40" Height="40" Padding="0" BorderBrush="{DynamicResource Line}"
                            Command="{Binding BackToCategoriesCommand}" ToolTip="Ortga (kategoriyalarga)">
                        <Viewbox Width="18" Height="18"><Path Style="{StaticResource Ic}" StrokeThickness="2.2" Data="M15 18l-6-6l6-6"/></Viewbox>
                    </Button>
                    <WrapPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center" TextElement.FontSize="14">
                        <Button Style="{StaticResource LinkBtn}" Foreground="{DynamicResource Ink2}" FontWeight="Normal" Padding="4,0" Content="Omborlar"
                                Command="{Binding BackToWarehousesCommand}"/>
                        <TextBlock Text="›" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" Margin="2,0"/>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedWarehouse}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Style="{StaticResource LinkBtn}" Foreground="{DynamicResource Ink2}" FontWeight="Normal" Padding="4,0"
                                    Content="{Binding CurrentWarehouseTitle}" Command="{Binding BackToCategoriesCommand}"/>
                            <TextBlock Text="›" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" Margin="2,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CurrentCategoryTitle}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,8,0"/>
                        <Border CornerRadius="10" Padding="8,2" Background="{DynamicResource Line}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CategoryAllCount}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}"/>
                        </Border>
                    </WrapPanel>
                    <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Height="44" Padding="16,0" Command="{Binding OpenAddProductCommand}"
                            Visibility="{Binding CanAddProduct, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18"><Path Style="{StaticResource Ic}" StrokeThickness="2.4" Data="M12 5v14M5 12h14"/></Viewbox>
                            <TextBlock Text="Yangi tovar" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Qidiruv va filtrlar -->
                <Grid Grid.Row="1" Margin="0,12,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="ProductSearchBox" Style="{StaticResource SearchField}"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{Binding ProductSearchPlaceholder}"
                                 IsVisibleChanged="ProductSearchBox_IsVisibleChanged"/>
                        <Button Style="{StaticResource CardIconBtn}" HorizontalAlignment="Right" Margin="0,0,8,0" Focusable="False"
                                Command="{Binding ClearSearchCommand}" ToolTip="Qidiruvni tozalash"
                                Visibility="{Binding HasSearchQuery, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Viewbox Width="14" Height="14"><Path Style="{StaticResource Ic}" StrokeThickness="2.4" Data="M18 6L6 18M6 6l12 12"/></Viewbox>
                        </Button>
                    </Grid>
                    <Border Grid.Column="1" Margin="10,0,0,0" Padding="3" CornerRadius="10" Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SegTab}" Height="36" Padding="14,0" Command="{Binding SetStockFilterCommand}" CommandParameter="0"
                                    Tag="{Binding StockFilter, Converter={StaticResource EqualsConverter}, ConverterParameter=0}">
                                <TextBlock Margin="14,0"><Run Text="Hammasi"/> <Run Text="{Binding CategoryAllCount, Mode=OneWay}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource SegTab}" Height="36" Margin="4,0,0,0" Command="{Binding SetStockFilterCommand}" CommandParameter="1"
                                    Tag="{Binding StockFilter, Converter={StaticResource EqualsConverter}, ConverterParameter=1}">
                                <TextBlock Margin="14,0"><Run Text="Kam qolgan"/> <Run Text="{Binding CategoryLowCount, Mode=OneWay}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource SegTab}" Height="36" Margin="4,0,0,0" Command="{Binding SetStockFilterCommand}" CommandParameter="2"
                                    Tag="{Binding StockFilter, Converter={StaticResource EqualsConverter}, ConverterParameter=2}">
                                <TextBlock Margin="14,0"><Run Text="Tugagan"/> <Run Text="{Binding CategoryOutCount, Mode=OneWay}"/></TextBlock>
                            </Button>
                        </StackPanel>
                    </Border>

                </Grid>

                <!-- Jadval -->
                <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <!-- Ustun kengliklari (sarlavha va qatorlar uchun bir xil) -->
                            <Style x:Key="TableCols" TargetType="Grid">
                                <Setter Property="Margin" Value="12,0"/>
                            </Style>
                        </Grid.Resources>

                        <!-- Sarlavha -->
                        <Border x:Name="ProductTableHeader" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                                CornerRadius="12,12,0,0" Padding="12,0">
                            <Grid TextElement.FontSize="12" TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource Ink3}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*" MinWidth="150"/>
                                    <ColumnDefinition Width="162"/>
                                    <ColumnDefinition Width="122"/>
                                    <ColumnDefinition Width="162"/>
                                    <ColumnDefinition Width="132"/>
                                    <ColumnDefinition Width="182"/>
                                    <ColumnDefinition Width="132"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource SmallCheck}" VerticalAlignment="Center" ToolTip="Barchasini tanlash / bekor qilish"
                                          IsChecked="{Binding IsAllLowStockSelected, Mode=TwoWay}"
                                          Visibility="{Binding IsLowStockCategorySelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Grid.Column="2" Text="MAHSULOT" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="SHTRIX-KOD" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="TAN NARXI"/>
                                    <Viewbox Width="11" Height="11" Margin="4,0,0,0"
                                             Visibility="{Binding CanSeeSecrets, Source={x:Static services:AdminGate.Current}, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                        <Path Data="M6 11h12a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2z M8 11V7a4 4 0 0 1 8 0v4" Width="24" Height="24" Stretch="None"
                                              Stroke="{DynamicResource Ink3}" StrokeThickness="2.4" StrokeStartLineCap="Round"/>
                                    </Viewbox>
                                </StackPanel>
                                <TextBlock Grid.Column="5" Text="SOTISH NARXI" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="6" Text="QOLDIQ" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="7" Text="IZOH (ZAKAZ UCHUN)" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="8" Text="AMALLAR" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Qatorlar -->
                        <ListBox x:Name="ProductRowsList" Grid.Row="1" ItemsSource="{Binding Products}" ItemContainerStyle="{StaticResource BareItem}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.ScrollChanged="ProductRows_ScrollChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="row" Height="54" Padding="12,0" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1"
                                            Background="{DynamicResource Surface}" MouseLeftButtonDown="ProductRow_MouseLeftButtonDown"
                                            ToolTip="Tahrirlash uchun 2 marta bosing">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*" MinWidth="150"/>
                                                <ColumnDefinition Width="162"/>
                                                <ColumnDefinition Width="122"/>
                                                <ColumnDefinition Width="162"/>
                                                <ColumnDefinition Width="132"/>
                                                <ColumnDefinition Width="182"/>
                                                <ColumnDefinition Width="132"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Style="{StaticResource SmallCheck}" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                      Visibility="{Binding DataContext.IsLowStockCategorySelected, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                            <!-- Rasm: bor bo'lsa kattalashtirish, yo'q bo'lsa biriktirish -->
                                            <Button Grid.Column="1" Width="40" Height="40" HorizontalAlignment="Left" Cursor="Hand" Focusable="False"
                                                    Command="{Binding DataContext.OpenProductImagePreviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" ToolTip="Rasmni kattalashtirish"
                                                    Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="8" Background="{DynamicResource IllusBg}">
                                                            <Border.OpacityMask>
                                                                <VisualBrush>
                                                                    <VisualBrush.Visual>
                                                                        <Border Width="40" Height="40" CornerRadius="8" Background="Black"/>
                                                                    </VisualBrush.Visual>
                                                                </VisualBrush>
                                                            </Border.OpacityMask>
                                                            <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Grid.Column="1" Width="40" Height="40" HorizontalAlignment="Left" Cursor="Hand" Focusable="False"
                                                    Command="{Binding DataContext.AttachProductImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" ToolTip="Rasm biriktirish"
                                                    Visibility="{Binding HasImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" CornerRadius="8" Background="{DynamicResource IllusBg}" BorderBrush="Transparent" BorderThickness="1">
                                                            <Viewbox Width="18" Height="18">
                                                                <Path Data="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M8 10a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0-3 0 M21 15l-5-5L5 21"
                                                                      Width="24" Height="24" Stretch="None" Stroke="{DynamicResource Ink3}" StrokeThickness="1.8"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                            </Viewbox>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding UnitDisplay}" FontSize="12" Foreground="{DynamicResource Ink3}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding Barcode}" FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource Ink2}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                            <Grid Grid.Column="4" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CostPriceDisplay}" HorizontalAlignment="Right" Foreground="{DynamicResource Ink2}"
                                                           Visibility="{Binding CanSeeSecrets, Source={x:Static services:AdminGate.Current}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <TextBlock Text="••••" HorizontalAlignment="Right" Foreground="{DynamicResource Ink3}"
                                                           Visibility="{Binding CanSeeSecrets, Source={x:Static services:AdminGate.Current}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                            </Grid>
                                            <StackPanel Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding SellingPrice, StringFormat='{}{0:N0}'}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding SellingPrice2, StringFormat='{}{0:N0} · 2-narx'}" FontSize="12" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Right"
                                                           Visibility="{Binding HasSellingPrice2, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                            <!-- Qoldiq: bosilsa kirim oynasi -->
                                            <Button Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Cursor="Hand" Focusable="False"
                                                    Command="{Binding DataContext.OpenQuickStockAddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" ToolTip="Qoldiq qo'shish (kirim)">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="pill" Style="{StaticResource StockPill}" Padding="9,3" BorderThickness="1" BorderBrush="Transparent">
                                                            <TextBlock Text="{Binding StockPillText}" FontSize="13" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <TextBlock Grid.Column="7" FontSize="13" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,12,0" ToolTip="{Binding Note}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Note}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Note}" Value="{x:Null}"><Setter Property="Text" Value="—"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Note}" Value=""><Setter Property="Text" Value="—"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- Amallar -->
                                            <StackPanel Grid.Column="8" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Style="{StaticResource RowActBtn}" ToolTip="Tahrirlash" Focusable="False"
                                                        Command="{Binding DataContext.OpenEditProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Viewbox Width="18" Height="18"><Path Style="{StaticResource Ic}" Data="M12 20h9 M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1l1-4z"/></Viewbox>
                                                </Button>
                                                <Button Style="{StaticResource RowActBtn}" ToolTip="Stiker chop etish" Focusable="False" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.PrintProductBarcodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Viewbox Width="18" Height="18"><Path Style="{StaticResource Ic}" Data="M6 9V3h12v6 M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2 M6 14h12v7H6z"/></Viewbox>
                                                </Button>
                                                <Grid Margin="4,0,0,0">
                                                    <ToggleButton x:Name="MoreBtn" Width="40" Height="40" Cursor="Hand" Focusable="False" ToolTip="Boshqa amallar"
                                                                  Foreground="{DynamicResource Ink2}">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                        <Viewbox Width="18" Height="18"><Path Style="{StaticResource Ic}" StrokeThickness="3" Data="M5 12h.01M12 12h.01M19 12h.01"/></Viewbox>
                                                    </ToggleButton>
                                                    <Popup IsOpen="{Binding IsChecked, ElementName=MoreBtn, Mode=TwoWay}" PlacementTarget="{Binding ElementName=MoreBtn}"
                                                           Placement="Bottom" HorizontalOffset="-176" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                                        <Border Width="230" Margin="0,4,12,16" Padding="6" CornerRadius="12" Background="{DynamicResource Surface}"
                                                                BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.18" Color="#0F1B21"/>
                                                            </Border.Effect>
                                                            <StackPanel>
                                                                <Button Style="{StaticResource MenuItemBtn}" Click="RowMenuItem_Click"
                                                                        Command="{Binding DataContext.OpenQuickStockAddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Viewbox Width="16" Height="16"><Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink2}" Data="M12 5v14M5 12h14"/></Viewbox>
                                                                        <TextBlock Text="Qoldiq qo'shish (kirim)" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Style="{StaticResource MenuItemBtn}" Click="RowMenuItem_Click"
                                                                        Command="{Binding DataContext.AttachProductImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Viewbox Width="16" Height="16"><Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink2}" Data="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M8 10a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0-3 0 M21 15l-5-5L5 21"/></Viewbox>
                                                                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text" Value="Rasm biriktirish"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasImage}" Value="True"><Setter Property="Text" Value="Rasmni almashtirish"/></DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Style="{StaticResource MenuItemBtn}" Click="RowMenuItem_Click"
                                                                        Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                        Command="{Binding DataContext.RemoveProductImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Viewbox Width="16" Height="16"><Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink2}" Data="M18 6L6 18M6 6l12 12"/></Viewbox>
                                                                        <TextBlock Text="Rasmni o'chirish" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Border Height="1" Background="{DynamicResource Line}" Margin="4,4"/>
                                                                <Button Style="{StaticResource MenuItemBtn}" Click="RowMenuItem_Click" Foreground="{DynamicResource Bad}"
                                                                        Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Viewbox Width="16" Height="16"><Path Style="{StaticResource Ic}" Data="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/></Viewbox>
                                                                        <TextBlock Text="Tovarni o'chirish" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="row" Property="Background" Value="{DynamicResource Surface2}"/>
                                        </DataTrigger>
                                        <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="row" Property="Background" Value="{DynamicResource Surface2}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Bo'sh natija -->
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsEmptySearchResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource IllusBg}" HorizontalAlignment="Center">
                                <Viewbox Width="28" Height="28">
                                    <Path Data="M4 11a7 7 0 1 0 14 0a7 7 0 1 0-14 0 M20 20l-3.5-3.5" Width="24" Height="24" Stretch="None" Stroke="{DynamicResource Ink3}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="Hech narsa topilmadi" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                            <TextBlock Text="So'rov yoki filtrni o'zgartirib ko'ring" FontSize="13" Foreground="{DynamicResource Ink2}" HorizontalAlignment="Center"/>
                            <Button Style="{StaticResource BtnSecondary}" Height="40" Margin="0,14,0,0" HorizontalAlignment="Center" Content="Qidiruvni tozalash"
                                    Command="{Binding ClearSearchCommand}" Visibility="{Binding HasSearchQuery, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tanlanganlar paneli (kam qolganlardan buyurtma ro'yxati) -->
                <Border Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Padding="16,8,8,8" CornerRadius="12"
                        Background="{DynamicResource ToastBg}"
                        Visibility="{Binding HasSelectedLowStock, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.25" Color="#0F1B21"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource ToastFg}">
                        <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Run Text="{Binding SelectedLowStockCount, Mode=OneWay}"/><Run Text=" ta tovar tanlandi"/>
                        </TextBlock>
                        <Button Height="36" Padding="12,0" Cursor="Hand" Command="{Binding OpenReorderListDialogCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{DynamicResource OnAccentChip}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="Buyurtma ro'yxatiga" FontWeight="SemiBold" Foreground="{DynamicResource ToastFg}" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="36" Height="36" Margin="6,0,0,0" Cursor="Hand" ToolTip="Tanlovni bekor qilish" Command="{Binding ClearSelectedLowStockCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <Viewbox Width="16" Height="16">
                                            <Path Data="M18 6L6 18M6 6l12 12" Width="24" Height="24" Stretch="None" Stroke="{DynamicResource ToastFg}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Viewbox>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>


        <!-- ========================================================= -->
        <!-- 2. TOVAR QO'SHISH / TAHRIRLASH (maket 2.3, yorug' tema)   -->
        <!-- ========================================================= -->
        <Grid Visibility="{Binding IsAddEditFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="{DynamicResource Bg}" TextElement.Foreground="{DynamicResource Ink}">
            <Grid.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/Theme.Light.xaml"/>
                        <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/SmartControls.xaml"/>
                    </ResourceDictionary.MergedDictionaries>

                    <!-- Forma kartasi: Surface, radius 14, padding 20 -->
                    <Style x:Key="FormCard" TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Surface}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="CornerRadius" Value="14"/>
                        <Setter Property="Padding" Value="20"/>
                    </Style>
                    <Style x:Key="CardTitle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                        <Setter Property="Margin" Value="0,0,0,16"/>
                    </Style>
                    <Style x:Key="Hint" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="Margin" Value="0,6,0,0"/>
                    </Style>
                    <!-- Ko'p qatorli izoh maydoni -->
                    <Style x:Key="FieldArea" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
                        <Setter Property="Height" Value="Auto"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="AcceptsReturn" Value="True"/>
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                    </Style>
                    <!-- Segment (so'm / USD) — RadioButton -->
                    <Style x:Key="SegRadio" TargetType="RadioButton">
                        <Setter Property="Height" Value="30"/>
                        <Setter Property="MinWidth" Value="52"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="Medium"/>
                        <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface}"/>
                                            <Setter TargetName="bd" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="2" ShadowDepth="1" Direction="270" Opacity="0.08" Color="#0F1B21"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <!-- Segment (dona / metr / kg) — ListBox elementi -->
                    <Style x:Key="SegItem" TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="Medium"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="6,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface}"/>
                                            <Setter TargetName="bd" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="2" ShadowDepth="1" Direction="270" Opacity="0.08" Color="#0F1B21"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <!-- Kichik ikonkali tugma (rasm ustida) -->
                    <Style x:Key="ImgActBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
                        <Setter Property="Width" Value="30"/>
                        <Setter Property="Height" Value="30"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                    </Style>
                </ResourceDictionary>
            </Grid.Resources>
            <Grid.InputBindings>
                <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProductFormCommand}"/>
            </Grid.InputBindings>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Sarlavha: ortga, yo'l, nom; o'ngda ombor belgisi -->
            <Grid Grid.Row="0" Margin="24,20,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Command="{Binding CancelAddEditCommand}" Style="{StaticResource BtnSecondary}" Width="40" Height="40" Padding="0"
                        BorderBrush="{DynamicResource Line}" ToolTip="Ortga (Esc)">
                    <Viewbox Width="20" Height="20"><Path Style="{StaticResource Ic}" Data="M15 18l-6-6l6-6"/></Viewbox>
                </Button>
                <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                    <WrapPanel>
                        <TextBlock Text="Ombor" FontSize="12" Foreground="{DynamicResource Ink3}"/>
                        <TextBlock Text=" › " FontSize="12" Foreground="{DynamicResource Ink3}"/>
                        <TextBlock Text="{Binding FormCategory}" FontSize="12" Foreground="{DynamicResource Ink3}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding FormTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Ink}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Height="36" CornerRadius="10" Background="{DynamicResource AccentSoft}" Padding="12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                            <Path Style="{StaticResource Ic}" Stroke="{DynamicResource AccentInk}" Data="M3 21V8l9-5l9 5v13 M7 21v-8h10v8 M7 17h10"/>
                        </Viewbox>
                        <TextBlock Text="{Binding SelectedWarehouseNameDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentInk}"
                                   VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Ikki karta: 1.15fr / 1fr -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <Grid Margin="24,0,24,24" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1-karta: Asosiy ma'lumotlar -->
                    <Border Grid.Column="0" Style="{StaticResource FormCard}">
                        <StackPanel>
                            <TextBlock Text="Asosiy ma'lumotlar" Style="{StaticResource CardTitle}"/>

                            <TextBlock Text="Tovar nomi *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" TextChanged="ProductNameTextBox_TextChanged"
                                     Style="{StaticResource FieldBox}" FontSize="14"/>

                            <TextBlock Text="Shtrix-kod" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox Text="{Binding FormBarcode, UpdateSourceTrigger=PropertyChanged}"
                                             services:KeyboardLayoutHelper.IsScannerField="True"
                                             Style="{StaticResource FieldBox}" FontFamily="Consolas" FontSize="14" Padding="38,0,12,0"/>
                                    <Viewbox Width="18" Height="18" HorizontalAlignment="Left" Margin="13,0,0,0" IsHitTestVisible="False">
                                        <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink3}" Data="M4 5v14 M8 5v14 M11 5v14 M15 5v14 M18 5v14 M20 5v14"/>
                                    </Viewbox>
                                </Grid>
                                <Button Grid.Column="1" Command="{Binding GenerateBarcodeCommand}" Style="{StaticResource BtnSecondary}" Height="44" Margin="8,0,0,0"
                                        ToolTip="Shtrix-kodi yo'q tovar uchun ichki EAN-13 kod yaratish">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="16" Height="16" Margin="0,0,6,0"><Path Style="{StaticResource Ic}" Data="M13 3L4 14h7l-1 7l9-11h-7z"/></Viewbox>
                                        <TextBlock Text="Yaratish" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Command="{Binding PrintBarcodeCommand}" Style="{StaticResource BtnSecondary}" Height="44" Margin="8,0,0,0"
                                        ToolTip="Shu tovar uchun stiker chop etish">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="16" Height="16" Margin="0,0,6,0"><Path Style="{StaticResource Ic}" Data="M6 9V3h12v6 M6 18H4v-9h16v9h-2 M6 14h12v7H6z"/></Viewbox>
                                        <TextBlock Text="Stiker" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Text="Skanerlang yoki &quot;Yaratish&quot; bilan ichki kod oling" Style="{StaticResource Hint}"/>

                            <TextBlock Text="Kategoriya *" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding ExistingCategories}" SelectedItem="{Binding FormCategory}" Style="{StaticResource FieldCombo}"/>
                                <Button Grid.Column="1" Command="{Binding OpenEditCategoryModalCommand}" Style="{StaticResource BtnSecondary}"
                                        Width="44" Height="44" Padding="0" Margin="8,0,0,0" ToolTip="Tanlangan kategoriya nomini o'zgartirish">
                                    <Viewbox Width="18" Height="18"><Path Style="{StaticResource Ic}" Data="M4 20h4L18.5 9.5l-4-4L4 16z M13.5 6.5l4 4"/></Viewbox>
                                </Button>
                                <Button Grid.Column="2" Command="{Binding OpenAddCategoryModalCommand}" Style="{StaticResource BtnSecondary}"
                                        Width="44" Height="44" Padding="0" Margin="8,0,0,0" ToolTip="Yangi kategoriya qo'shish">
                                    <Viewbox Width="18" Height="18"><Path Style="{StaticResource Ic}" Data="M12 5v14 M5 12h14"/></Viewbox>
                                </Button>
                            </Grid>

                            <!-- Rasm (120px) + Izoh -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Rasm" Style="{StaticResource FieldLabel}"/>
                                    <Grid Width="120" Height="120">
                                        <!-- Rasm yo'q: punktir chegarali tugma -->
                                        <Button Command="{Binding PickFormImageCommand}" Cursor="Hand"
                                                Visibility="{Binding FormHasImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Background="Transparent">
                                                        <Rectangle x:Name="dash" RadiusX="12" RadiusY="12" Fill="{DynamicResource Surface2}"
                                                                   Stroke="{DynamicResource LineStrong}" StrokeThickness="1.5" StrokeDashArray="4 3"/>
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <Viewbox Width="24" Height="24" HorizontalAlignment="Center">
                                                                <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink3}"
                                                                      Data="M4 5h16v14H4z M4 16l5-5l5 5 M14 14l2-2l4 4 M15 8.5h.01"/>
                                                            </Viewbox>
                                                            <TextBlock Text="Rasm qo'shish" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}"
                                                                       Margin="6,6,6,0" TextAlignment="Center" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="dash" Property="Stroke" Value="{DynamicResource Accent}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Rasm bor: miniatyura + almashtirish / o'chirish -->
                                        <Grid Visibility="{Binding FormHasImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Border CornerRadius="12" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource IllusBg}" ClipToBounds="True">
                                                <Image Source="{Binding FormImagePath}" Stretch="UniformToFill">
                                                    <Image.Clip>
                                                        <RectangleGeometry Rect="0,0,118,118" RadiusX="11" RadiusY="11"/>
                                                    </Image.Clip>
                                                </Image>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6">
                                                <Button Command="{Binding PickFormImageCommand}" Style="{StaticResource ImgActBtn}" ToolTip="Rasmni almashtirish">
                                                    <Viewbox Width="14" Height="14"><Path Style="{StaticResource Ic}" Data="M4 20h4L18.5 9.5l-4-4L4 16z M13.5 6.5l4 4"/></Viewbox>
                                                </Button>
                                                <Button Command="{Binding RemoveFormImageCommand}" Style="{StaticResource ImgActBtn}" Foreground="{DynamicResource Bad}"
                                                        Margin="6,0,0,0" ToolTip="Rasmni o'chirish">
                                                    <Viewbox Width="14" Height="14"><Path Style="{StaticResource Ic}" Data="M4 7h16 M10 11v6 M14 11v6 M6 7l1 13h10l1-13 M9 7V4h6v3"/></Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                                <DockPanel Grid.Column="2">
                                    <TextBlock DockPanel.Dock="Top" Text="Izoh — zakaz uchun yetkazib beruvchi, telefon" Style="{StaticResource FieldLabel}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBox Text="{Binding FormNote, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldArea}" Height="120"/>
                                </DockPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2-karta: Narx va qoldiq -->
                    <Border Grid.Column="2" Style="{StaticResource FormCard}">
                        <StackPanel>
                            <TextBlock Text="Narx va qoldiq" Style="{StaticResource CardTitle}"/>

                            <!-- Tan narxi + so'm / USD -->
                            <DockPanel Margin="0,0,0,6" LastChildFill="True">
                                <Border DockPanel.Dock="Right" Background="{DynamicResource Surface2}" CornerRadius="8" Padding="3" Margin="8,0,0,0" VerticalAlignment="Bottom">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="so'm" GroupName="FormCurrencyGroup" IsChecked="{Binding FormIsUzs}" Style="{StaticResource SegRadio}"/>
                                        <RadioButton Content="USD" GroupName="FormCurrencyGroup" IsChecked="{Binding FormIsUsd}" Style="{StaticResource SegRadio}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding FormCostPriceLabel}" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <Grid>
                                <TextBox Text="{Binding FormCostPrice, UpdateSourceTrigger=PropertyChanged}" TextChanged="PriceTextBox_TextChanged"
                                         Style="{StaticResource FieldBox}"
                                         Visibility="{Binding IsFormCostMasked, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                <!-- Admin PIN yopiq: mavjud tovarning tan narxi yashirin, qiymati o'zgarmaydi -->
                                <Border Height="44" CornerRadius="10" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="1.5" Padding="12,0,6,0"
                                        Visibility="{Binding IsFormCostMasked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Command="{Binding UnlockCommand, Source={x:Static services:AdminGate.Current}}"
                                                Style="{StaticResource BtnSecondary}" Height="32" Padding="10,0" FontSize="13" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Style="{StaticResource Ic}" Data="M5 11h14v10H5z M8 11V7a4 4 0 0 1 8 0v4"/></Viewbox>
                                                <TextBlock Text="Ko'rish (PIN)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="••••••" FontSize="16" Foreground="{DynamicResource Ink3}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding FormUsdConversion}" Style="{StaticResource Hint}"
                                       Visibility="{Binding IsFormUsdConversionVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!-- Sotish narxi + 2-narx -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Sotish narxi *" Style="{StaticResource FieldLabel}" TextTrimming="CharacterEllipsis"/>
                                    <TextBox Text="{Binding FormSellingPrice, UpdateSourceTrigger=PropertyChanged}" TextChanged="PriceTextBox_TextChanged"
                                             Style="{StaticResource FieldBox}" FontWeight="SemiBold" Tag="so'm"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="2-narx (usta / optom)" Style="{StaticResource FieldLabel}" TextTrimming="CharacterEllipsis"/>
                                    <TextBox Text="{Binding FormSellingPrice2, UpdateSourceTrigger=PropertyChanged}" TextChanged="PriceTextBox_TextChanged"
                                             Style="{StaticResource FieldBox}" Tag="so'm"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding FormMarkupText}" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Ok}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FormMarkupText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFormMarkupNegative}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Qoldiq / O'lchov birligi / Kam qolganda -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Qoldiq *" Style="{StaticResource FieldLabel}" TextTrimming="CharacterEllipsis"/>
                                    <TextBox Text="{Binding FormStockQuantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" VerticalAlignment="Bottom"/>
                                </DockPanel>
                                <DockPanel Grid.Column="2">
                                    <TextBlock DockPanel.Dock="Top" Text="O'lchov birligi" Style="{StaticResource FieldLabel}" TextTrimming="CharacterEllipsis"/>
                                    <Border Height="44" Background="{DynamicResource Surface2}" CornerRadius="10" Padding="3" VerticalAlignment="Bottom">
                                        <ListBox SelectedIndex="{Binding FormUnitTypeIndex}" ItemContainerStyle="{StaticResource SegItem}"
                                                 Background="Transparent" BorderThickness="0" Padding="0" Focusable="False"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.Template>
                                                <ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate>
                                            </ListBox.Template>
                                            <ListBoxItem Content="dona"/>
                                            <ListBoxItem Content="metr"/>
                                            <ListBoxItem Content="kg"/>
                                        </ListBox>
                                    </Border>
                                </DockPanel>
                                <DockPanel Grid.Column="4">
                                    <TextBlock DockPanel.Dock="Top" Text="Kam qolganda ogohlantir" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                                    <TextBox Text="{Binding FormMinStockAlert, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" VerticalAlignment="Bottom"/>
                                </DockPanel>
                            </Grid>

                            <!-- Tan narxi haqida eslatma -->
                            <Border Background="{DynamicResource Surface2}" CornerRadius="10" Padding="12,10" Margin="0,18,0,0">
                                <DockPanel>
                                    <Viewbox Width="16" Height="16" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,1,10,0">
                                        <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink2}" Data="M5 11h14v10H5z M8 11V7a4 4 0 0 1 8 0v4"/>
                                    </Viewbox>
                                    <TextBlock Text="Tan narxi saqlangandan keyin jadvalda yashiriladi. Uni faqat Admin PIN bilan ko'rish yoki o'zgartirish mumkin."
                                               FontSize="12" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- Pastki panel: 72px, xato xabari, Bekor / Saqlash -->
            <Border Grid.Row="2" MinHeight="72" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding CancelAddEditCommand}" IsCancel="True" Style="{StaticResource BtnSecondary}" Height="46" Padding="18,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Bekor qilish" VerticalAlignment="Center"/>
                                <TextBlock Text="Esc" Style="{StaticResource Kbd}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveProductFormCommand}" IsDefault="True" Style="{StaticResource BtnPrimary}" Height="46" Padding="22,0" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18" Margin="0,0,8,0"><Path Style="{StaticResource Ic}" Data="M5 12l5 5L20 7"/></Viewbox>
                                <TextBlock Text="Saqlash" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource KbdChip}" Margin="10,0,0,0" Padding="6,2">
                                    <TextBlock Text="Ctrl+S" FontFamily="Consolas" FontSize="11" FontWeight="Normal"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding FormErrorMessage}" Foreground="{DynamicResource Bad}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Visibility="{Binding HasFormError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="* majburiy maydonlar" FontSize="12" Foreground="{DynamicResource Ink3}"
                                   Visibility="{Binding HasFormError, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- 2.11–2.13 MODALLAR (maket, yorug' tema): kategoriya,      -->
        <!-- yangi ombor, omborlararo ko'chirish                       -->
        <!-- ========================================================= -->
        <Grid Panel.ZIndex="2000" TextElement.Foreground="{DynamicResource Ink}">
            <Grid.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/Theme.Light.xaml"/>
                        <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/SmartControls.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                    <Style x:Key="ModalTitle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="18"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="TextWrapping" Value="Wrap"/>
                    </Style>
                    <Style x:Key="ModalError" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="Margin" Value="0,10,0,0"/>
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="NameBox" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
                        <Setter Property="Height" Value="48"/>
                        <Setter Property="FontSize" Value="16"/>
                    </Style>
                    <!-- Ombor tanlash qutisi: ichida kichik sarlavha (ustidan qo'yiladi), radius 12 -->
                    <Style x:Key="BoxCombo" TargetType="ComboBox" BasedOn="{StaticResource FieldCombo}">
                        <Setter Property="Height" Value="62"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Background" Value="{DynamicResource Surface}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBox">
                                    <Grid>
                                        <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                                                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                                                        <Viewbox Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,14">
                                                            <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink3}" Data="M6 9l6 6l6-6"/>
                                                        </Viewbox>
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <ContentPresenter IsHitTestVisible="False" Margin="14,30,36,0" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                                    MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,8,12" Padding="4"
                                                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10"
                                                    TextElement.FontWeight="Normal">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.14" Color="#0F1B21"/>
                                                </Border.Effect>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="BoxLabel" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
                        <Setter Property="Margin" Value="14,11,14,0"/>
                        <Setter Property="VerticalAlignment" Value="Top"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    </Style>
                </ResourceDictionary>
            </Grid.Resources>

            <!-- ============ 2.13 YANGI KATEGORIYA ============ -->
            <Border Background="{DynamicResource Scrim}"
                    Visibility="{Binding IsAddCategoryModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Style="{StaticResource ModalCard}" Width="480" Padding="24,22,24,20">
                    <StackPanel>
                        <TextBlock Text="Yangi kategoriya" Style="{StaticResource ModalTitle}"/>
                        <TextBlock Margin="0,16,0,6" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}">
                            <Run Text="Nomi"/> <Run Text="*" Foreground="{DynamicResource Bad}"/>
                        </TextBlock>
                        <TextBox Text="{Binding NewCategoryInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NameBox}"
                                 IsVisibleChanged="FocusWhenShown"/>
                        <TextBlock Text="{Binding NewCategoryErrorMessage}" Style="{StaticResource ModalError}"/>
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding CloseAddCategoryModalCommand}" Style="{StaticResource BtnSecondary}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Bekor" VerticalAlignment="Center"/>
                                    <TextBlock Text="Esc" Style="{StaticResource Kbd}"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding SaveNewCategoryCommand}" Style="{StaticResource BtnPrimary}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Qo'shish" VerticalAlignment="Center"/>
                                    <TextBlock Text="Enter" Style="{StaticResource Kbd}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ============ 2.13 KATEGORIYANI TAHRIRLASH ============ -->
            <Border Background="{DynamicResource Scrim}"
                    Visibility="{Binding IsEditCategoryModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Style="{StaticResource ModalCard}" Width="480" Padding="24,22,24,20">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding EditCategoryCountText}" FontSize="12" Foreground="{DynamicResource Ink3}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBlock Text="Kategoriyani tahrirlash" Style="{StaticResource ModalTitle}"/>
                        </DockPanel>
                        <TextBlock Margin="0,16,0,6" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}">
                            <Run Text="Nomi"/> <Run Text="*" Foreground="{DynamicResource Bad}"/>
                        </TextBlock>
                        <TextBox Text="{Binding EditCategoryInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NameBox}"
                                 IsVisibleChanged="FocusWhenShown"/>
                        <TextBlock Text="{Binding EditCategoryErrorMessage}" Style="{StaticResource ModalError}"/>
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding CloseEditCategoryModalCommand}" Style="{StaticResource BtnSecondary}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Bekor" VerticalAlignment="Center"/>
                                    <TextBlock Text="Esc" Style="{StaticResource Kbd}"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding SaveEditCategoryCommand}" Style="{StaticResource BtnPrimary}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Saqlash" VerticalAlignment="Center"/>
                                    <TextBlock Text="Enter" Style="{StaticResource Kbd}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ============ 2.12 YANGI OMBOR ============ -->
            <Border Background="{DynamicResource Scrim}"
                    Visibility="{Binding IsAddWarehouseModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Style="{StaticResource ModalCard}" Width="440" Padding="24,22,24,20">
                    <StackPanel>
                        <TextBlock Text="Yangi ombor" Style="{StaticResource ModalTitle}"/>
                        <TextBlock Margin="0,16,0,6" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}">
                            <Run Text="Nomi"/> <Run Text="*" Foreground="{DynamicResource Bad}"/>
                        </TextBlock>
                        <TextBox Text="{Binding NewWarehouseName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NameBox}"
                                 IsVisibleChanged="FocusWhenShown"/>
                        <!-- Asosiy ombor qilish -->
                        <CheckBox IsChecked="{Binding NewWarehouseIsPrimary}" Margin="0,16,0,0" Cursor="Hand" HorizontalContentAlignment="Stretch">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <Border x:Name="card" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                            CornerRadius="12" Padding="14,12">
                                        <DockPanel>
                                            <Border x:Name="box" DockPanel.Dock="Left" Width="20" Height="20" CornerRadius="5" Margin="0,1,12,0" VerticalAlignment="Top"
                                                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1.5">
                                                <Viewbox x:Name="tick" Width="14" Height="14" Visibility="Collapsed">
                                                    <Path Data="M5 12l5 5l9-10" Width="24" Height="24" Stretch="None" Stroke="{DynamicResource OnAccent}"
                                                          StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                </Viewbox>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="Asosiy ombor qilish" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextWrapping="Wrap"/>
                                                <TextBlock FontSize="13" Foreground="{DynamicResource Ink3}" Margin="0,2,0,0" TextWrapping="Wrap" LineHeight="19">
                                                    <Run Text="Kassa sotuvlari avval shu ombordan ayiriladi. Hozirgi asosiy:"/>
                                                    <Run Text="{Binding CurrentPrimaryWarehouseName, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource Ink2}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                                            <Setter TargetName="box" Property="BorderThickness" Value="0"/>
                                            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>
                        <TextBlock Text="{Binding NewWarehouseErrorMessage}" Style="{StaticResource ModalError}"/>
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding CloseAddWarehouseModalCommand}" Style="{StaticResource BtnSecondary}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Bekor" VerticalAlignment="Center"/>
                                    <TextBlock Text="Esc" Style="{StaticResource Kbd}"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding SaveNewWarehouseCommand}" Style="{StaticResource BtnPrimary}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Yaratish" VerticalAlignment="Center"/>
                                    <TextBlock Text="Enter" Style="{StaticResource Kbd}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ============ 2.11 OMBORLARARO KO'CHIRISH ============ -->
            <Border Background="{DynamicResource Scrim}"
                    Visibility="{Binding IsTransferModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Style="{StaticResource ModalCard}" Width="560">
                    <StackPanel>
                        <Border Padding="24,20,24,14" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                            <TextBlock Text="Omborlararo ko'chirish" Style="{StaticResource ModalTitle}"/>
                        </Border>
                        <StackPanel Margin="24,18,24,18">
                            <!-- Qayerdan ⇄ Qayerga -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding TransferFromWarehouse}"
                                              DisplayMemberPath="Name" Style="{StaticResource BoxCombo}"/>
                                    <TextBlock Text="Qayerdan" Style="{StaticResource BoxLabel}"/>
                                </Grid>
                                <Button Grid.Column="1" Command="{Binding SwapTransferWarehousesCommand}" ToolTip="Almashtirish"
                                        Width="40" Height="40" Margin="12,0" Cursor="Hand" Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" CornerRadius="20" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
                                                <Viewbox Width="18" Height="18">
                                                    <Path Style="{StaticResource Ic}" Stroke="{DynamicResource AccentInk}" Data="M4 9h14l-4-4 M20 15H6l4 4"/>
                                                </Viewbox>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Grid Grid.Column="2">
                                    <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding TransferToWarehouse}"
                                              DisplayMemberPath="Name" Style="{StaticResource BoxCombo}"
                                              Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"/>
                                    <TextBlock Text="Qayerga" Style="{StaticResource BoxLabel}" Foreground="{DynamicResource AccentInk}"/>
                                </Grid>
                            </Grid>

                            <!-- Tovar -->
                            <DockPanel Margin="0,16,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TransferAvailableText}" FontSize="12" Foreground="{DynamicResource Ink3}" VerticalAlignment="Center"/>
                                <TextBlock Text="Tovar" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}"/>
                            </DockPanel>
                            <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding TransferProduct}" DisplayMemberPath="Name"
                                      Style="{StaticResource FieldCombo}" Height="48" FontWeight="SemiBold" Tag="Tovarni tanlang"/>

                            <!-- Miqdor va natija -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Miqdor" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding TransferQuantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                                             Height="48" FontSize="18" FontWeight="Bold" Tag="{Binding TransferProduct.UnitDisplay}"
                                             IsVisibleChanged="FocusWhenShown"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                            Visibility="{Binding HasTransferPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock FontSize="13" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" LineHeight="21">
                                        <Run Text="{Binding TransferFromLine, Mode=OneWay}"/><Run Text="{Binding TransferFromAfter, Mode=OneWay}" FontWeight="Bold">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTransferOverStock}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>
                                    </TextBlock>
                                    <TextBlock FontSize="13" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" LineHeight="21">
                                        <Run Text="{Binding TransferToLine, Mode=OneWay}"/><Run Text="{Binding TransferToAfter, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource Ok}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding TransferErrorMessage}" Style="{StaticResource ModalError}"/>
                        </StackPanel>
                        <Grid Margin="24,0,24,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding CloseTransferModalCommand}" Style="{StaticResource BtnSecondary}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Bekor" VerticalAlignment="Center"/>
                                    <TextBlock Text="Esc" Style="{StaticResource Kbd}"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding ExecuteTransferCommand}" Style="{StaticResource BtnPrimary}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TransferButtonText}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Enter" Style="{StaticResource Kbd}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- 2.4 TOVARNI O'CHIRISH TASDIG'I (maket, yorug' tema)       -->
        <!-- ========================================================= -->
        <Grid Panel.ZIndex="200" Visibility="{Binding IsDeleteConfirmOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              TextElement.Foreground="{DynamicResource Ink}">
            <Grid.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/Theme.Light.xaml"/>
                        <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/SmartControls.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Grid.Resources>
            <Border Background="{DynamicResource Scrim}">
                <Border Style="{StaticResource ModalCard}" Width="460" Padding="24">
                    <StackPanel>
                        <DockPanel>
                            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource BadSoft}" VerticalAlignment="Top" Margin="0,0,14,0">
                                <Viewbox Width="22" Height="22">
                                    <Path Style="{StaticResource Ic}" Stroke="{DynamicResource Bad}" Data="M4 7h16 M9 7V4h6v3 M6 7l1 13h10l1-13 M10 11v6 M14 11v6"/>
                                </Viewbox>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Tovarni o'chirasizmi?" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding DeleteConfirmName}" FontSize="14" Foreground="{DynamicResource Ink2}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="20"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,14,0,0">
                            <TextBlock Text="{Binding DeleteConfirmNote}" FontSize="13" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" LineHeight="19"/>
                        </Border>
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding CancelDeleteProductCommand}" Style="{StaticResource BtnSecondary}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Bekor" VerticalAlignment="Center"/>
                                    <TextBlock Text="Esc" Style="{StaticResource Kbd}"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding ConfirmDeleteProductCommand}" Style="{StaticResource BtnDanger}" Content="Ha, o'chirish"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

    </Grid>
</UserControl>
