<UserControl x:Class="PosElectro.Desktop.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:PosElectro.Desktop.Controls"
             xmlns:services="clr-namespace:PosElectro.Desktop.Services"
             xmlns:models="clr-namespace:PosElectro.Desktop.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1150"
             PreviewKeyDown="InventoryView_PreviewKeyDown">
    <Grid Background="{DynamicResource Bg}">

        <!-- ========================================================= -->
        <!-- 1. OMBOR ASOSIY OYNASI (maket 2.1 va 2.2, yorug' tema)    -->
        <!-- ========================================================= -->
        <Grid Visibility="{Binding IsMainViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="{DynamicResource Bg}" TextElement.Foreground="{DynamicResource Ink}">
            <Grid.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/Theme.Light.xaml"/>
                        <ResourceDictionary Source="/PosElectro.Desktop;component/Themes/SmartControls.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                    <CollectionViewSource x:Key="WarehouseCardsSource" Source="{Binding Warehouses}"/>

                    <!-- Qidiruv maydoni: 44px, Surface, radius 10, chapda ikonka -->
                    <Style x:Key="SearchField" TargetType="TextBox">
                        <Setter Property="Height" Value="44"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                        <Setter Property="CaretBrush" Value="{DynamicResource AccentInk}"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TextBox">
                                    <Border x:Name="bd" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,0,40,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <Path Data="M4 11a7 7 0 1 0 14 0a7 7 0 1 0-14 0 M20 20l-3.5-3.5" Width="24" Height="24" Stretch="None"
                                                      Stroke="{DynamicResource Ink3}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Viewbox>
                                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Focusable="False" VerticalAlignment="Center"
                                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"/>
                                            <TextBlock x:Name="ph" Grid.Column="1" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                       Foreground="{DynamicResource Ink3}" VerticalAlignment="Center" Margin="2,0,0,0"
                                                       IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Asboblar paneli tugmasi: 44px, radius 10 -->
                    <Style x:Key="ToolBtn" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                        <Setter Property="Height" Value="44"/>
                        <Setter Property="Padding" Value="14,0"/>
                        <Setter Property="Margin" Value="10,0,0,0"/>
                    </Style>

                    <!-- Jadval qatoridagi 40×40 amal tugmasi -->
                    <Style x:Key="RowActBtn" TargetType="Button">
                        <Setter Property="Width" Value="40"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- "Boshqa amallar" menyusi qatori -->
                    <Style x:Key="MenuItemBtn" TargetType="Button">
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Kichik belgilash qutisi (18px, radius 5) -->
                    <Style x:Key="SmallCheck" TargetType="CheckBox">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="CheckBox">
                                    <Border x:Name="box" Width="18" Height="18" CornerRadius="5" Background="{DynamicResource Surface}"
                                            BorderBrush="{DynamicResource LineStrong}" BorderThickness="1.5">
                                        <Viewbox x:Name="tick" Width="12" Height="12" Visibility="Collapsed">
                                            <Path Data="M5 12l5 5l9-10" Width="24" Height="24" Stretch="None" Stroke="{DynamicResource OnAccent}"
                                                  StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Viewbox>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                                            <Setter TargetName="box" Property="BorderThickness" Value="0"/>
                                            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Matnli havola tugmasi -->
                    <Style x:Key="LinkBtn" TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Kartadagi kichik ikonka tugmasi (28px) -->
                    <Style x:Key="CardIconBtn" TargetType="Button" BasedOn="{StaticResource RowActBtn}">
                        <Setter Property="Width" Value="28"/>
                        <Setter Property="Height" Value="28"/>
                        <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
                    </Style>

                </ResourceDictionary>
            </Grid.Resources>

            <!-- ============ 2.1 OMBORLAR VA KATEGORIYALAR ============ -->
            <Grid Margin="16" Visibility="{Binding IsProductsListVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Asboblar paneli -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ombor" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchField}"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="OverviewSearch_TextChanged">
                            <TextBox.Tag>
                                <Binding Path="OverviewSearchPlaceholder"/>
                            </TextBox.Tag>
                        </TextBox>
                    </Grid>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource ToolBtn}" Width="44" Padding="0" Command="{Binding RefreshCommand}" ToolTip="Ro'yxatni yangilash">
                            <Viewbox Width="18" Height="18"><Path Style="{StaticResource Ic}" Data="M3 12a9 9 0 0 1 15-6.7L21 8 M21 3v5h-5 M21 12a9 9 0 0 1-15 6.7L3 16 M3 21v-5h5"/></Viewbox>
                        </Button>
                        <Button Style="{StaticResource ToolBtn}" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" Foreground="{DynamicResource Warn}"
                                Command="{Binding SelectCategoryCommand}" CommandParameter="{Binding LowStockCard}"
                                ToolTip="Kam qolgan va tugagan tovarlar — buyurtma ro'yxati uchun">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18"><Path Style="{StaticResource Ic}" Data="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z M12 9v4M12 17h.01"/></Viewbox>
                                <TextBlock Text="Kam qolganlar" Margin="8,0,8,0" VerticalAlignment="Center"/>
                                <Border CornerRadius="9" Padding="7,1" Background="{DynamicResource Warn}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LowStockCard.Count}" FontSize="12" Foreground="{DynamicResource OnAccent}"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolBtn}" Command="{Binding OpenTransferModalCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18"><Path Style="{StaticResource Ic}" Data="M7 4L3 8l4 4M3 8h14M17 20l4-4-4-4M21 16H7"/></Viewbox>
                                <TextBlock Text="Omborlararo ko'chirish" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BtnPrimary}" Height="44" Padding="16,0" Margin="10,0,0,0" Command="{Binding OpenAddProductCommand}"
                                Visibility="{Binding CanAddProduct, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18"><Path Style="{StaticResource Ic}" StrokeThickness="2.4" Data="M12 5v14M5 12h14"/></Viewbox>
                                <TextBlock Text="Yangi tovar" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <!-- Omborlar -->
                        <TextBlock Text="Omborlar" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}" Margin="0,0,0,8"/>
                        <ItemsControl Focusable="False" Margin="3,3,3,0">
                            <ItemsControl.Resources>
                            <!-- Ombor kartasi (2.1): 118px, tanlangani Accent 2px + halqa -->
                            <DataTemplate DataType="{x:Type models:Warehouse}">
                                <Button Height="118" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.SelectWarehouseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Tag>
                                        <MultiBinding Converter="{StaticResource SameValueMultiConverter}">
                                            <Binding Path="Guid"/>
                                            <Binding Path="DataContext.SelectedWarehouse.Guid" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </Button.Tag>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ring" CornerRadius="15" BorderThickness="3" BorderBrush="Transparent" Margin="-3">
                                                <Border x:Name="bd" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                        CornerRadius="12" Padding="16,14">
                                                    <ContentPresenter/>
                                                </Border>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                                    <Setter TargetName="bd" Property="Padding" Value="15,13"/>
                                                    <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource AccentRing}"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="9">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource IllusBg}"/>
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink2}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource OnAccent}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Viewbox Width="18" Height="18">
                                                    <Path Data="M3 21h18M5 21V8l7-5l7 5v13M9 21v-6h6v6" Width="24" Height="24" Stretch="None" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"/>
                                                </Viewbox>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Ink}"
                                                       Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <!-- Asosiy ombor belgisi yoki amallar -->
                                            <Border Grid.Column="2" Padding="8,2" CornerRadius="6" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center"
                                                    Visibility="{Binding IsPrimary, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="ASOSIY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentInk}"/>
                                            </Border>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding IsPrimary, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                <Button Style="{StaticResource CardIconBtn}" ToolTip="Asosiy ombor qilish" Focusable="False"
                                                        Command="{Binding DataContext.SetPrimaryWarehouseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Viewbox Width="15" Height="15"><Path Style="{StaticResource Ic}" Data="M12 3l2.8 5.7l6.2.9l-4.5 4.4l1.1 6.2L12 17.3l-5.6 2.9l1.1-6.2L3 9.6l6.2-.9z"/></Viewbox>
                                                </Button>
                                                <Button Style="{StaticResource CardIconBtn}" ToolTip="Omborni o'chirish" Focusable="False" Margin="2,0,0,0"
                                                        Visibility="{Binding CanDelete, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Command="{Binding DataContext.DeleteWarehouseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Viewbox Width="15" Height="15"><Path Style="{StaticResource Ic}" Data="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/></Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <!-- Statistika -->
                                        <WrapPanel Grid.Row="2" TextElement.FontSize="13" TextElement.Foreground="{DynamicResource Ink2}">
                                            <TextBlock Margin="0,0,16,0">
                                                <Run Text="{Binding TotalProductCount, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                                                <Run Text="tovar"/>
                                            </TextBlock>
                                            <TextBlock Margin="0,0,16,0">
                                                <Run Text="{Binding TotalStockQuantity, Mode=OneWay, StringFormat='{}{0:#,0.##}'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                                                <Run Text="birlik"/>
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Tan narxi" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TotalStockValue, StringFormat='{}{0:N0}'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="4,0,0,0"
                                                           Visibility="{Binding CanSeeSecrets, Source={x:Static services:AdminGate.Current}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0" ToolTip="Admin PIN bilan ko'rinadi"
                                                            Visibility="{Binding CanSeeSecrets, Source={x:Static services:AdminGate.Current}, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                    <TextBlock Text="••••" FontWeight="Bold" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                                                    <Viewbox Width="12" Height="12" Margin="4,0,0,0" VerticalAlignment="Center">
                                                        <Path Data="M6 11h12a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2z M8 11V7a4 4 0 0 1 8 0v4" Width="24" Height="24" Stretch="None"
                                                              Stroke="{DynamicResource Ink3}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    </Viewbox>
                                                </StackPanel>
                                            </StackPanel>
                                        </WrapPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>

                            <!-- "Yangi ombor" (oxirgi karta, uzuq chiziqli) -->
                            <DataTemplate DataType="{x:Type sys:String}">
                                <Button Height="118" Cursor="Hand" Command="{Binding DataContext.OpenAddWarehouseModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Background="Transparent">
                                                <Rectangle x:Name="dash" RadiusX="12" RadiusY="12" Stroke="{DynamicResource LineStrong}" StrokeThickness="1.5" StrokeDashArray="4 3"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Viewbox Width="18" Height="18">
                                                        <Path Data="M12 5v14M5 12h14" Width="24" Height="24" Stretch="None" Stroke="{DynamicResource Ink2}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    </Viewbox>
                                                    <TextBlock Text="Yangi ombor" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="dash" Property="Stroke" Value="{DynamicResource Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                            </ItemsControl.Resources>
                            <ItemsControl.ItemsSource>
                                <CompositeCollection>
                                    <CollectionContainer Collection="{Binding Source={StaticResource WarehouseCardsSource}}"/>
                                    <sys:String>+</sys:String>
                                </CompositeCollection>
                            </ItemsControl.ItemsSource>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:AdaptiveGridPanel MinItemWidth="260" ItemHeight="118" Spacing="12"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>

                        <!-- Kategoriyalar -->
                        <Grid Margin="0,16,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center">
                                    <Run Text="Kategoriyalar ·"/>
                                    <Run Text="{Binding CurrentWarehouseTitle, Mode=OneWay}" Foreground="{DynamicResource Ink}"/>
                                </TextBlock>
                                <Button Style="{StaticResource LinkBtn}" Margin="8,0,0,0" Content="Barcha omborlar" FontSize="13"
                                        Command="{Binding BackToWarehousesCommand}"
                                        Visibility="{Binding CanGoBackToWarehouses, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                            <Button Style="{StaticResource LinkBtn}" HorizontalAlignment="Right" Content="+ Yangi kategoriya"
                                    Command="{Binding OpenAddCategoryModalCommand}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding GridCategoryCards}" Focusable="False" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:AdaptiveGridPanel MinItemWidth="260" ItemHeight="104" Spacing="12"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Height="104" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                        CornerRadius="12" Padding="16,14">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Direction="270" Opacity="0.05" Color="#0F1B21"/>
                                                    </Border.Effect>
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource IllusBg}" HorizontalAlignment="Left">
                                                    <Viewbox Width="20" Height="20">
                                                        <Path Data="{Binding IconData}" Width="24" Height="24" Stretch="None" Stroke="{DynamicResource Ink2}" StrokeThickness="2"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                    </Viewbox>
                                                </Border>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                    <Button Style="{StaticResource CardIconBtn}" ToolTip="Kategoriya nomini o'zgartirish" Focusable="False" Margin="0,0,6,0"
                                                            Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Command="{Binding DataContext.OpenEditCategoryModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Name}">
                                                        <Viewbox Width="15" Height="15"><Path Style="{StaticResource Ic}" Data="M12 20h9 M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1l1-4z"/></Viewbox>
                                                    </Button>
                                                    <Border Padding="8,3" CornerRadius="6" VerticalAlignment="Center"
                                                            Visibility="{Binding HasBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource WarnSoft}"/>
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Warn}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOutBadge}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource BadSoft}"/>
                                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Bad}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding BadgeText}" FontSize="12" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat='{}{0} tovar'}" FontSize="13" Foreground="{DynamicResource Ink2}" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                                            </Grid>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============ 2.2 TOVARLAR JADVALI ============ -->
            <Grid Margin="16" Visibility="{Binding IsProductsListVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Yo'l (breadcrumb) va amallar -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource BtnSecondary}" Width="40" Height="40" Padding="0" BorderBrush="{DynamicResource Line}"
                            Command="{Binding BackToCategoriesCommand}" ToolTip="Ortga (kategoriyalarga)">
                        <Viewbox Width="18" Height="18"><Path Style="{StaticResource Ic}" StrokeThickness="2.2" Data="M15 18l-6-6l6-6"/></Viewbox>
                    </Button>
                    <WrapPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center" TextElement.FontSize="14">
                        <Button Style="{StaticResource LinkBtn}" Foreground="{DynamicResource Ink2}" FontWeight="Normal" Padding="4,0" Content="Omborlar"
                                Command="{Binding BackToWarehousesCommand}"/>
                        <TextBlock Text="›" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" Margin="2,0"/>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedWarehouse}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Style="{StaticResource LinkBtn}" Foreground="{DynamicResource Ink2}" FontWeight="Normal" Padding="4,0"
                                    Content="{Binding CurrentWarehouseTitle}" Command="{Binding BackToCategoriesCommand}"/>
                            <TextBlock Text="›" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" Margin="2,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CurrentCategoryTitle}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,8,0"/>
                        <Border CornerRadius="10" Padding="8,2" Background="{DynamicResource Line}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CategoryAllCount}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}"/>
                        </Border>
                    </WrapPanel>
                    <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Height="44" Padding="16,0" Command="{Binding OpenAddProductCommand}"
                            Visibility="{Binding CanAddProduct, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18"><Path Style="{StaticResource Ic}" StrokeThickness="2.4" Data="M12 5v14M5 12h14"/></Viewbox>
                            <TextBlock Text="Yangi tovar" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Qidiruv va filtrlar -->
                <Grid Grid.Row="1" Margin="0,12,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="ProductSearchBox" Style="{StaticResource SearchField}"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{Binding ProductSearchPlaceholder}"
                                 IsVisibleChanged="ProductSearchBox_IsVisibleChanged"/>
                        <Button Style="{StaticResource CardIconBtn}" HorizontalAlignment="Right" Margin="0,0,8,0" Focusable="False"
                                Command="{Binding ClearSearchCommand}" ToolTip="Qidiruvni tozalash"
                                Visibility="{Binding HasSearchQuery, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Viewbox Width="14" Height="14"><Path Style="{StaticResource Ic}" StrokeThickness="2.4" Data="M18 6L6 18M6 6l12 12"/></Viewbox>
                        </Button>
                    </Grid>
                    <Border Grid.Column="1" Margin="10,0,0,0" Padding="3" CornerRadius="10" Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SegTab}" Height="36" Padding="14,0" Command="{Binding SetStockFilterCommand}" CommandParameter="0"
                                    Tag="{Binding StockFilter, Converter={StaticResource EqualsConverter}, ConverterParameter=0}">
                                <TextBlock Margin="14,0"><Run Text="Hammasi"/> <Run Text="{Binding CategoryAllCount, Mode=OneWay}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource SegTab}" Height="36" Margin="4,0,0,0" Command="{Binding SetStockFilterCommand}" CommandParameter="1"
                                    Tag="{Binding StockFilter, Converter={StaticResource EqualsConverter}, ConverterParameter=1}">
                                <TextBlock Margin="14,0"><Run Text="Kam qolgan"/> <Run Text="{Binding CategoryLowCount, Mode=OneWay}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource SegTab}" Height="36" Margin="4,0,0,0" Command="{Binding SetStockFilterCommand}" CommandParameter="2"
                                    Tag="{Binding StockFilter, Converter={StaticResource EqualsConverter}, ConverterParameter=2}">
                                <TextBlock Margin="14,0"><Run Text="Tugagan"/> <Run Text="{Binding CategoryOutCount, Mode=OneWay}"/></TextBlock>
                            </Button>
                        </StackPanel>
                    </Border>

                </Grid>

                <!-- Jadval -->
                <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <!-- Ustun kengliklari (sarlavha va qatorlar uchun bir xil) -->
                            <Style x:Key="TableCols" TargetType="Grid">
                                <Setter Property="Margin" Value="12,0"/>
                            </Style>
                        </Grid.Resources>

                        <!-- Sarlavha -->
                        <Border x:Name="ProductTableHeader" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                                CornerRadius="12,12,0,0" Padding="12,0">
                            <Grid TextElement.FontSize="12" TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource Ink3}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*" MinWidth="150"/>
                                    <ColumnDefinition Width="162"/>
                                    <ColumnDefinition Width="122"/>
                                    <ColumnDefinition Width="162"/>
                                    <ColumnDefinition Width="132"/>
                                    <ColumnDefinition Width="182"/>
                                    <ColumnDefinition Width="132"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource SmallCheck}" VerticalAlignment="Center" ToolTip="Barchasini tanlash / bekor qilish"
                                          IsChecked="{Binding IsAllLowStockSelected, Mode=TwoWay}"
                                          Visibility="{Binding IsLowStockCategorySelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Grid.Column="2" Text="MAHSULOT" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="SHTRIX-KOD" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="TAN NARXI"/>
                                    <Viewbox Width="11" Height="11" Margin="4,0,0,0"
                                             Visibility="{Binding CanSeeSecrets, Source={x:Static services:AdminGate.Current}, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                        <Path Data="M6 11h12a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2z M8 11V7a4 4 0 0 1 8 0v4" Width="24" Height="24" Stretch="None"
                                              Stroke="{DynamicResource Ink3}" StrokeThickness="2.4" StrokeStartLineCap="Round"/>
                                    </Viewbox>
                                </StackPanel>
                                <TextBlock Grid.Column="5" Text="SOTISH NARXI" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="6" Text="QOLDIQ" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="7" Text="IZOH (ZAKAZ UCHUN)" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="8" Text="AMALLAR" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Qatorlar -->
                        <ListBox x:Name="ProductRowsList" Grid.Row="1" ItemsSource="{Binding Products}" ItemContainerStyle="{StaticResource BareItem}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.ScrollChanged="ProductRows_ScrollChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="row" Height="54" Padding="12,0" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1"
                                            Background="{DynamicResource Surface}" MouseLeftButtonDown="ProductRow_MouseLeftButtonDown"
                                            ToolTip="Tahrirlash uchun 2 marta bosing">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*" MinWidth="150"/>
                                                <ColumnDefinition Width="162"/>
                                                <ColumnDefinition Width="122"/>
                                                <ColumnDefinition Width="162"/>
                                                <ColumnDefinition Width="132"/>
                                                <ColumnDefinition Width="182"/>
                                                <ColumnDefinition Width="132"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Style="{StaticResource SmallCheck}" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                      Visibility="{Binding DataContext.IsLowStockCategorySelected, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                            <!-- Rasm: bor bo'lsa kattalashtirish, yo'q bo'lsa biriktirish -->
                                            <Button Grid.Column="1" Width="40" Height="40" HorizontalAlignment="Left" Cursor="Hand" Focusable="False"
                                                    Command="{Binding DataContext.OpenProductImagePreviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" ToolTip="Rasmni kattalashtirish"
                                                    Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="8" Background="{DynamicResource IllusBg}">
                                                            <Border.OpacityMask>
                                                                <VisualBrush>
                                                                    <VisualBrush.Visual>
                                                                        <Border Width="40" Height="40" CornerRadius="8" Background="Black"/>
                                                                    </VisualBrush.Visual>
                                                                </VisualBrush>
                                                            </Border.OpacityMask>
                                                            <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Grid.Column="1" Width="40" Height="40" HorizontalAlignment="Left" Cursor="Hand" Focusable="False"
                                                    Command="{Binding DataContext.AttachProductImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" ToolTip="Rasm biriktirish"
                                                    Visibility="{Binding HasImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" CornerRadius="8" Background="{DynamicResource IllusBg}" BorderBrush="Transparent" BorderThickness="1">
                                                            <Viewbox Width="18" Height="18">
                                                                <Path Data="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M8 10a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0-3 0 M21 15l-5-5L5 21"
                                                                      Width="24" Height="24" Stretch="None" Stroke="{DynamicResource Ink3}" StrokeThickness="1.8"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                            </Viewbox>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding UnitDisplay}" FontSize="12" Foreground="{DynamicResource Ink3}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding Barcode}" FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource Ink2}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                            <Grid Grid.Column="4" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CostPriceDisplay}" HorizontalAlignment="Right" Foreground="{DynamicResource Ink2}"
                                                           Visibility="{Binding CanSeeSecrets, Source={x:Static services:AdminGate.Current}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <TextBlock Text="••••" HorizontalAlignment="Right" Foreground="{DynamicResource Ink3}"
                                                           Visibility="{Binding CanSeeSecrets, Source={x:Static services:AdminGate.Current}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                            </Grid>
                                            <StackPanel Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding SellingPrice, StringFormat='{}{0:N0}'}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding SellingPrice2, StringFormat='{}{0:N0} · 2-narx'}" FontSize="12" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Right"
                                                           Visibility="{Binding HasSellingPrice2, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                            <!-- Qoldiq: bosilsa kirim oynasi -->
                                            <Button Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Cursor="Hand" Focusable="False"
                                                    Command="{Binding DataContext.OpenQuickStockAddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" ToolTip="Qoldiq qo'shish (kirim)">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="pill" Style="{StaticResource StockPill}" Padding="9,3" BorderThickness="1" BorderBrush="Transparent">
                                                            <TextBlock Text="{Binding StockPillText}" FontSize="13" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <TextBlock Grid.Column="7" FontSize="13" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,12,0" ToolTip="{Binding Note}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Note}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Note}" Value="{x:Null}"><Setter Property="Text" Value="—"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Note}" Value=""><Setter Property="Text" Value="—"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- Amallar -->
                                            <StackPanel Grid.Column="8" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Style="{StaticResource RowActBtn}" ToolTip="Tahrirlash" Focusable="False"
                                                        Command="{Binding DataContext.OpenEditProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Viewbox Width="18" Height="18"><Path Style="{StaticResource Ic}" Data="M12 20h9 M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1l1-4z"/></Viewbox>
                                                </Button>
                                                <Button Style="{StaticResource RowActBtn}" ToolTip="Stiker chop etish" Focusable="False" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.PrintProductBarcodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Viewbox Width="18" Height="18"><Path Style="{StaticResource Ic}" Data="M6 9V3h12v6 M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2 M6 14h12v7H6z"/></Viewbox>
                                                </Button>
                                                <Grid Margin="4,0,0,0">
                                                    <ToggleButton x:Name="MoreBtn" Width="40" Height="40" Cursor="Hand" Focusable="False" ToolTip="Boshqa amallar"
                                                                  Foreground="{DynamicResource Ink2}">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                        <Viewbox Width="18" Height="18"><Path Style="{StaticResource Ic}" StrokeThickness="3" Data="M5 12h.01M12 12h.01M19 12h.01"/></Viewbox>
                                                    </ToggleButton>
                                                    <Popup IsOpen="{Binding IsChecked, ElementName=MoreBtn, Mode=TwoWay}" PlacementTarget="{Binding ElementName=MoreBtn}"
                                                           Placement="Bottom" HorizontalOffset="-176" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                                        <Border Width="230" Margin="0,4,12,16" Padding="6" CornerRadius="12" Background="{DynamicResource Surface}"
                                                                BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.18" Color="#0F1B21"/>
                                                            </Border.Effect>
                                                            <StackPanel>
                                                                <Button Style="{StaticResource MenuItemBtn}" Click="RowMenuItem_Click"
                                                                        Command="{Binding DataContext.OpenQuickStockAddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Viewbox Width="16" Height="16"><Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink2}" Data="M12 5v14M5 12h14"/></Viewbox>
                                                                        <TextBlock Text="Qoldiq qo'shish (kirim)" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Style="{StaticResource MenuItemBtn}" Click="RowMenuItem_Click"
                                                                        Command="{Binding DataContext.AttachProductImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Viewbox Width="16" Height="16"><Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink2}" Data="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M8 10a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0-3 0 M21 15l-5-5L5 21"/></Viewbox>
                                                                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text" Value="Rasm biriktirish"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasImage}" Value="True"><Setter Property="Text" Value="Rasmni almashtirish"/></DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Style="{StaticResource MenuItemBtn}" Click="RowMenuItem_Click"
                                                                        Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                        Command="{Binding DataContext.RemoveProductImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Viewbox Width="16" Height="16"><Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ink2}" Data="M18 6L6 18M6 6l12 12"/></Viewbox>
                                                                        <TextBlock Text="Rasmni o'chirish" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Border Height="1" Background="{DynamicResource Line}" Margin="4,4"/>
                                                                <Button Style="{StaticResource MenuItemBtn}" Click="RowMenuItem_Click" Foreground="{DynamicResource Bad}"
                                                                        Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Viewbox Width="16" Height="16"><Path Style="{StaticResource Ic}" Data="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/></Viewbox>
                                                                        <TextBlock Text="Tovarni o'chirish" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="row" Property="Background" Value="{DynamicResource Surface2}"/>
                                        </DataTrigger>
                                        <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="row" Property="Background" Value="{DynamicResource Surface2}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Bo'sh natija -->
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsEmptySearchResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource IllusBg}" HorizontalAlignment="Center">
                                <Viewbox Width="28" Height="28">
                                    <Path Data="M4 11a7 7 0 1 0 14 0a7 7 0 1 0-14 0 M20 20l-3.5-3.5" Width="24" Height="24" Stretch="None" Stroke="{DynamicResource Ink3}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="Hech narsa topilmadi" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                            <TextBlock Text="So'rov yoki filtrni o'zgartirib ko'ring" FontSize="13" Foreground="{DynamicResource Ink2}" HorizontalAlignment="Center"/>
                            <Button Style="{StaticResource BtnSecondary}" Height="40" Margin="0,14,0,0" HorizontalAlignment="Center" Content="Qidiruvni tozalash"
                                    Command="{Binding ClearSearchCommand}" Visibility="{Binding HasSearchQuery, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tanlanganlar paneli (kam qolganlardan buyurtma ro'yxati) -->
                <Border Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Padding="16,8,8,8" CornerRadius="12"
                        Background="{DynamicResource ToastBg}"
                        Visibility="{Binding HasSelectedLowStock, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.25" Color="#0F1B21"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource ToastFg}">
                        <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Run Text="{Binding SelectedLowStockCount, Mode=OneWay}"/><Run Text=" ta tovar tanlandi"/>
                        </TextBlock>
                        <Button Height="36" Padding="12,0" Cursor="Hand" Command="{Binding OpenReorderListDialogCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{DynamicResource OnAccentChip}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="Buyurtma ro'yxatiga" FontWeight="SemiBold" Foreground="{DynamicResource ToastFg}" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="36" Height="36" Margin="6,0,0,0" Cursor="Hand" ToolTip="Tanlovni bekor qilish" Command="{Binding ClearSelectedLowStockCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <Viewbox Width="16" Height="16">
                                            <Path Data="M18 6L6 18M6 6l12 12" Width="24" Height="24" Stretch="None" Stroke="{DynamicResource ToastFg}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Viewbox>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>


        <!-- ========================================================= -->
        <!-- 2. MAHSULOT QO'SHISH VA TAHRIRLASH (TO'LIQ EKRANLI SAHIFA) -->
        <!-- ========================================================= -->
        <Grid Margin="20" Visibility="{Binding IsAddEditFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <!-- Sarlavha va Ortga tugmasi -->
                <RowDefinition Height="Auto"/>
                <!-- Asosiy forma va amallar -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TEPADAGI NAVIGATSIYA -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding CancelAddEditCommand}"
                            Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            Padding="14,9" Margin="0,0,16,0" Cursor="Hand" FontWeight="SemiBold" FontSize="13">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnCancelBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Stretch="Uniform" Data="M10 19l-7-7m0 0l7-7m-7 7h18" Stroke="{DynamicResource Ink2}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Ortga qaytish" Foreground="{TemplateBinding Foreground}" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnCancelBorder" Property="Background" Value="{DynamicResource Line}"/>
                                        <Setter TargetName="btnCancelBorder" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="{Binding FormTitle}" Foreground="{DynamicResource Ink}" FontSize="20" FontWeight="Black" VerticalAlignment="Center"/>

                    <!-- Tanlangan Ombor Belgisi -->
                    <Border Background="{DynamicResource OkSoft}" BorderBrush="{DynamicResource Ok}" BorderThickness="1.5" CornerRadius="8" Padding="12,5" Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Stretch="Uniform" Data="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                                  Stroke="{DynamicResource Ok}" StrokeThickness="1.5" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Ombor: " Foreground="{DynamicResource Ok}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedWarehouseNameDisplay}" Foreground="{DynamicResource OnAccent}" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 2 TA ZAMONAVIY BLOK (ASOSIY VA NARXLAR) VA AMALLAR -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <!-- 1. Ikkala karta qatori (Balandligi 100% teng) -->
                        <RowDefinition Height="Auto"/>
                        <!-- 2. Qulay amallar paneli (Kartalar ostida) -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 2 TA KARTA QATORI -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 1-BLOK: ASOSIY MA'LUMOTLAR -->
                        <Border Grid.Column="0" Background="{DynamicResource Surface}" CornerRadius="16" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="20" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Stretch="Uniform" Data="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                                  Stroke="{DynamicResource AccentInk}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="MAHSULOT ASOSIY MA'LUMOTLARI" Foreground="{DynamicResource AccentInk}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Mahsulot Nomi -->
                        <TextBlock Text="Mahsulot nomi *" Foreground="{DynamicResource Ink2}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" 
                                 TextChanged="ProductNameTextBox_TextChanged"
                                 Style="{StaticResource ModernTextBox}" FontSize="14" Padding="12,0" Height="42" Margin="0,0,0,10"/>

                        <!-- Shtrix-kod va Generatsiya / Chop etish tugmalari -->
                        <TextBlock Text="Shtrix-kod (Skaner orqali o'qing yoki 'Yaratish' tugmasini bosing)" Foreground="{DynamicResource Ink2}" FontSize="12" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding FormBarcode, UpdateSourceTrigger=PropertyChanged}"
                                     services:KeyboardLayoutHelper.IsScannerField="True"
                                     Style="{StaticResource ModernTextBox}" FontSize="14" Padding="12,0" Height="42" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Command="{Binding GenerateBarcodeCommand}"
                                    ToolTip="Shtrix-kodi yo'q tovar uchun yangi 13 xonali EAN-13 kod yaratish"
                                    Background="{DynamicResource AccentHover}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                                    Height="42" Padding="12,0" Margin="0,0,6,0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Stretch="Uniform" Data="M13 10V3L4 14h7v7l9-11h-7z" Fill="{DynamicResource Accent}" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Yaratish" Foreground="{DynamicResource AccentInk}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding PrintBarcodeCommand}"
                                    ToolTip="Xprinter XP-365B orqali ushbu tovar uchun etiketka (stiker) chiqarish"
                                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1.5"
                                    Height="42" Padding="12,0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Stretch="Uniform" Data="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v8H6v-8z"
                                                  Stroke="{DynamicResource Ink}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Chop etish" Foreground="{DynamicResource Ink}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Kategoriya (Har doim Dropdown + Tahrirlash + Yangi qo'shish tugmasi) -->
                        <TextBlock Text="Kategoriya *" Foreground="{DynamicResource Ink2}" FontSize="12" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 1. Har doim Dropdown (ComboBox) -->
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding ExistingCategories}"
                                      SelectedItem="{Binding FormCategory}"
                                      Height="42" FontSize="13" VerticalContentAlignment="Center"/>

                            <!-- 2. Yonidagi [ Tahrirlash] tanlangan kategoriya nomini o'zgartirish tugmasi -->
                            <Button Grid.Column="1"
                                    Command="{Binding OpenEditCategoryModalCommand}"
                                    ToolTip="Tanlangan kategoriya nomini o'zgartirish"
                                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                                    Height="42" Padding="12,0" Margin="6,0,0,0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Stretch="Uniform" Data="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"
                                                  Stroke="{DynamicResource AccentInk}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tahrirlash" Foreground="{DynamicResource AccentInk}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 3. Yonidagi [ Yangi] kategoriya qo'shish tugmasi (Modal ochadi) -->
                            <Button Grid.Column="2"
                                    Command="{Binding OpenAddCategoryModalCommand}"
                                    ToolTip="Yangi kategoriya qo'shish oynasini ochish"
                                    Background="{DynamicResource AccentHover}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                                    Height="42" Padding="12,0" Margin="6,0,0,0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Stretch="Uniform" Data="M12 4v16m8-8H4"
                                                  Stroke="{DynamicResource AccentInk}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Yangi" Foreground="{DynamicResource AccentInk}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Izoh (Zakaz uchun telefon raqam va yetkazib beruvchi ma'lumoti) -->
                        <TextBlock Text="Izoh (Zakaz berish uchun telefon nomer va ma'lumot) [Ixtiyoriy]" Foreground="{DynamicResource Ink2}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormNote, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ModernTextBox}" 
                                 FontSize="13" Padding="10,8" Height="65" 
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"/>

                        <!-- Mahsulot Rasmi [Ixtiyoriy] -->
                        <TextBlock Text="Mahsulot rasmi [Ixtiyoriy]" Foreground="{DynamicResource Ink2}" FontSize="12" Margin="0,12,0,6"/>
                        <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="10">
                            <Grid>
                                <!-- 1. Rasm tanlanmagan holat: "+ Rasm biriktirish" tugmasi -->
                                <Button Command="{Binding PickFormImageCommand}"
                                        Visibility="{Binding FormHasImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Border BorderBrush="{DynamicResource LineStrong}" BorderThickness="1.5" CornerRadius="8" Padding="14,10" Background="{DynamicResource Surface}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Stretch="Uniform" Width="18" Height="18" Margin="0,0,8,0"
                                                  Data="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" 
                                                  Stroke="{DynamicResource AccentInk}" StrokeThickness="1.5" Fill="Transparent" VerticalAlignment="Center"/>
                                            <TextBlock Text="+ Rasm biriktirish (ixtiyoriy)" Foreground="{DynamicResource AccentInk}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <!-- 2. Rasm tanlangan holat: Miniatyura va boshqarish -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding FormHasImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <!-- Miniatyura -->
                                    <Border Width="64" Height="64" CornerRadius="8" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" Background="{DynamicResource Bg}" SnapsToDevicePixels="True" Margin="0,0,12,0">
                                        <Image Source="{Binding FormImagePath}" Stretch="UniformToFill">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,61,61" RadiusX="6" RadiusY="6"/>
                                            </Image.Clip>
                                        </Image>
                                    </Border>

                                    <!-- Amallar -->
                                    <StackPanel VerticalAlignment="Center">
                                        <Button Command="{Binding PickFormImageCommand}"
                                                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                                Padding="10,5" Cursor="Hand" Margin="0,0,0,6" HorizontalAlignment="Left">
                                            <Button.Resources>
                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Stretch="Uniform" Width="11" Height="11" Margin="0,0,5,0"
                                                      Data="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"
                                                      Stroke="{DynamicResource AccentInk}" StrokeThickness="1.5" Fill="Transparent"/>
                                                <TextBlock Text="Almashtirish" Foreground="{DynamicResource AccentInk}" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Command="{Binding RemoveFormImageCommand}"
                                                Background="Transparent" BorderThickness="0"
                                                Padding="4,2" Cursor="Hand" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Stretch="Uniform" Width="10" Height="10" Margin="0,0,4,0"
                                                      Data="M6 18L18 6M6 6l12 12"
                                                      Stroke="{DynamicResource Bad}" StrokeThickness="1.8"/>
                                                <TextBlock Text="Rasmni o'chirish" Foreground="{DynamicResource Bad}" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 2-BLOK: NARXLAR VA QOLDIQ -->
                <Border Grid.Column="1" Background="{DynamicResource Surface}" CornerRadius="16" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="20" Margin="8,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Stretch="Uniform" Data="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                  Stroke="{DynamicResource Ok}" StrokeThickness="1.5" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="NARX VA OMBOR QOLDIG'I" Foreground="{DynamicResource Ok}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Tan Narxi (Katta va Aniq Valyuta Switch bilan) -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{Binding FormCostPriceLabel}" Foreground="{DynamicResource Ink2}" FontSize="12" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource Bg}" CornerRadius="8" Padding="2" BorderBrush="{DynamicResource Line}" BorderThickness="1" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="SO'M (UZS)" 
                                                 GroupName="FormCurrencyGroup"
                                                 IsChecked="{Binding FormIsUzs}" 
                                                 Style="{StaticResource CurrencySegmentRadio}"
                                                 FontSize="11" Padding="6,2"/>
                                    <RadioButton Content="DOLLAR ($)" 
                                                 GroupName="FormCurrencyGroup"
                                                 IsChecked="{Binding FormIsUsd}" 
                                                 Style="{StaticResource CurrencySegmentRadio}"
                                                 FontSize="11" Padding="6,2"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid>
                            <TextBox Text="{Binding FormCostPrice, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="PriceTextBox_TextChanged"
                                     Style="{StaticResource ModernTextBox}" FontSize="14" Padding="12,0" Height="42"
                                     Visibility="{Binding IsFormCostMasked, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            <!-- Admin PIN qulfi yopiq: mavjud tovarning tan narxi yashirin, qiymati o'zgarmaydi -->
                            <Border Height="42" CornerRadius="10" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="12,0"
                                    Visibility="{Binding IsFormCostMasked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <TextBlock Text="•••••• (yashirin)" Foreground="{DynamicResource Ink3}" FontSize="14" VerticalAlignment="Center"/>
                                    <Button Command="{Binding UnlockCommand, Source={x:Static services:AdminGate.Current}}" Style="{StaticResource ModernButton}"
                                            Background="{DynamicResource Surface2}" Foreground="{DynamicResource AccentInk}" Padding="12,2" FontSize="12"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Content="Ko'rish (PIN)"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding FormUsdConversion}" Foreground="{DynamicResource AccentInk}" FontSize="11" Margin="0,2,0,8" 
                                   Visibility="{Binding IsFormUsdConversionVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- Sotish Narxi -->
                        <TextBlock Text="Sotish narxi (so'm) *" Foreground="{DynamicResource Ink2}" FontSize="12" Margin="0,2,0,4"/>
                        <TextBox Text="{Binding FormSellingPrice, UpdateSourceTrigger=PropertyChanged}" 
                                 TextChanged="PriceTextBox_TextChanged"
                                 Style="{StaticResource ModernTextBox}" FontSize="14" Padding="12,0" Height="42" Margin="0,0,0,8"/>

                        <!-- 2-Sotish Narxi (Ustalarga/Optom) [Ixtiyoriy] -->
                        <TextBlock Text="2-sotish narxi (Ustalarga / doimiy mijozlar uchun, so'm) [Ixtiyoriy]" Foreground="{DynamicResource Ink2}" FontSize="12" Margin="0,2,0,4"/>
                        <TextBox Text="{Binding FormSellingPrice2, UpdateSourceTrigger=PropertyChanged}" 
                                 TextChanged="PriceTextBox_TextChanged"
                                 Style="{StaticResource ModernTextBox}" FontSize="14" Padding="12,0" Height="42" Margin="0,0,0,10"/>

                        <!-- Qoldiq miqdori, Birlik va Kam qolganlik ogohlantirishi (Bitta qatorda 3 ta ustun) -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Qoldiq miqdori *" Foreground="{DynamicResource Ink2}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormStockQuantity, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}" FontSize="14" Padding="12,0" Height="42"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                <TextBlock Text="O'lchov birligi" Foreground="{DynamicResource Ink2}" FontSize="12" Margin="0,0,0,4"/>
                                <ComboBox SelectedIndex="{Binding FormUnitTypeIndex}" Height="42" FontSize="13" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="dona (sht)"/>
                                    <ComboBoxItem Content="metr (m)"/>
                                    <ComboBoxItem Content="kilogram (kg)"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                <TextBlock Text="Kam qolganda chegara" Foreground="{DynamicResource Ink2}" FontSize="12" Margin="0,0,0,4" 
                                           TextTrimming="CharacterEllipsis" ToolTip="Kam qolganlik ogohlantirish chegarasi"/>
                                <TextBox Text="{Binding FormMinStockAlert, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}" FontSize="14" Padding="12,0" Height="42"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- BEVOSITA KARTALAR OSTIDAGI QULAY AMAL TUGMALARI VA XATOLIK -->
            <Grid Grid.Row="1" Margin="0,16,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Xatolik xabari -->
                <TextBlock Grid.Column="0" Text="{Binding FormErrorMessage}" 
                           Foreground="{DynamicResource Bad}" FontSize="13" FontWeight="SemiBold" 
                           VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap" 
                           Visibility="{Binding HasFormError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Bekor qilish va Saqlash tugmalari -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding CancelAddEditCommand}"
                            IsCancel="True"
                            Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"
                            Height="44" Padding="18,0" Margin="0,0,12,0" Cursor="Hand" FontWeight="SemiBold" FontSize="13">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Stretch="Uniform" Data="M6 18L18 6M6 6l12 12" Stroke="{DynamicResource Ink2}" StrokeThickness="2" StrokeStartLineCap="Round" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Bekor qilish" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                        <Border Background="{DynamicResource Line}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Esc" Foreground="{DynamicResource Ink2}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Line}"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Command="{Binding SaveProductFormCommand}"
                            IsDefault="True"
                            Background="{DynamicResource OkSolid}" Foreground="White" BorderBrush="{DynamicResource Ok}" BorderThickness="1.5"
                            Height="44" Padding="26,0" Cursor="Hand" FontWeight="Bold" FontSize="14">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Stretch="Uniform" Data="M5 13l4 4L19 7" Stroke="White" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Saqlash" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                        <Border Background="{DynamicResource OkSolid}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Enter ↵" Foreground="{DynamicResource Ok}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource OkSolid}"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Ok}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Grid>

        <!-- YANGI KATEGORIYA QO'SHISH MODAL OYNASI -->
        <Grid Visibility="{Binding IsAddCategoryModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="{DynamicResource Scrim}" Panel.ZIndex="2000">
            <Border Background="{DynamicResource Surface}" CornerRadius="16" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                    Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.8" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Modal Sarlavhasi -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5">
                                <Path Stretch="Uniform" Data="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"
                                      Stroke="{DynamicResource AccentInk}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Yangi Kategoriya Qo'shish" Foreground="{DynamicResource Ink}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Command="{Binding CloseAddCategoryModalCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                ToolTip="Yopish"
                                Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                Width="32" Height="32" Cursor="Hand" Padding="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="16"/>
                                </Style>
                            </Button.Resources>
                            <Path Stretch="Uniform" Data="M6 18L18 6M6 6l12 12" Stroke="{DynamicResource Ink2}" StrokeThickness="2" StrokeStartLineCap="Round" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Separator Background="{DynamicResource Line}" Margin="0,0,0,16"/>

                    <TextBlock Text="Kategoriya nomini kiriting:" Foreground="{DynamicResource Ink2}" FontSize="13" Margin="0,0,0,8"/>

                    <!-- Kategoriya nomi inputi (Aniq oq matn, ko'k hoshiya va kontrast fon) -->
                    <TextBox Text="{Binding NewCategoryInput, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             Background="{DynamicResource Bg}"
                             Foreground="{DynamicResource OnAccent}"
                             CaretBrush="{DynamicResource AccentInk}"
                             BorderBrush="{DynamicResource Accent}"
                             BorderThickness="1.5"
                             FontSize="15" FontWeight="SemiBold"
                             Height="46" Padding="14,0" Margin="0,0,0,0"/>

                    <!-- Xatolik xabari -->
                    <TextBlock Text="{Binding NewCategoryErrorMessage}" Foreground="{DynamicResource Bad}" FontSize="13" FontWeight="SemiBold"
                               Margin="0,6,0,16" TextWrapping="Wrap"/>

                    <!-- Tugmalar -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Bekor qilish (Esc)"
                                Command="{Binding CloseAddCategoryModalCommand}"
                                Background="{DynamicResource Line}" Foreground="{DynamicResource Ink2}"
                                Height="42" FontSize="14" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Grid.Column="2" Content="Qo'shish (Enter)"
                                Command="{Binding SaveNewCategoryCommand}"
                                IsDefault="True"
                                Style="{StaticResource ModernButton}"
                                Height="42" FontSize="14" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- 2.1 KATEGORIYANI TAHRIRLASH MODAL DIALOGI                 -->
        <!-- ========================================================= -->
        <Grid Visibility="{Binding IsEditCategoryModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="{DynamicResource Scrim}">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                    CornerRadius="16" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="24">
                <StackPanel>
                    <!-- Sarlavha va Yopish tugmasi -->
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Stretch="Uniform" Data="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"
                                                  Stroke="{DynamicResource AccentInk}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Kategoriya Nomini Tahrirlash" Foreground="{DynamicResource Ink}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Command="{Binding CloseEditCategoryModalCommand}" HorizontalAlignment="Right"
                                Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                Width="32" Height="32" Cursor="Hand" Padding="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="16"/>
                                </Style>
                            </Button.Resources>
                            <Path Stretch="Uniform" Data="M6 18L18 6M6 6l12 12" Stroke="{DynamicResource Ink2}" StrokeThickness="2" StrokeStartLineCap="Round" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Separator Background="{DynamicResource Line}" Margin="0,0,0,16"/>

                    <TextBlock Text="Yangi nomni kiriting:" Foreground="{DynamicResource Ink2}" FontSize="13" Margin="0,0,0,8"/>

                    <!-- Kategoriya nomi inputi -->
                    <TextBox Text="{Binding EditCategoryInput, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             Background="{DynamicResource Bg}"
                             Foreground="{DynamicResource OnAccent}"
                             CaretBrush="{DynamicResource AccentInk}"
                             BorderBrush="{DynamicResource Accent}"
                             BorderThickness="1.5"
                             FontSize="15" FontWeight="SemiBold"
                             Height="46" Padding="14,0" Margin="0,0,0,0"/>

                    <!-- Xatolik xabari -->
                    <TextBlock Text="{Binding EditCategoryErrorMessage}" Foreground="{DynamicResource Bad}" FontSize="13" FontWeight="SemiBold"
                               Margin="0,6,0,16" TextWrapping="Wrap"/>

                    <!-- Tugmalar -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Bekor qilish (Esc)"
                                Command="{Binding CloseEditCategoryModalCommand}"
                                Background="{DynamicResource Line}" Foreground="{DynamicResource Ink2}"
                                Height="42" FontSize="14" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Grid.Column="2" Content="Saqlash (Enter)"
                                Command="{Binding SaveEditCategoryCommand}"
                                IsDefault="True"
                                Style="{StaticResource ModernButton}"
                                Height="42" FontSize="14" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- 3. YANGI OMBOR QO'SHISH MODAL DIALOGI                     -->
        <!-- ========================================================= -->
        <Grid Visibility="{Binding IsAddWarehouseModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="{DynamicResource Scrim}">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                    CornerRadius="16" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Yangi Ombor Yaratish" Foreground="{DynamicResource Ink}" FontSize="18" FontWeight="Bold"/>
                        <Button Command="{Binding CloseAddWarehouseModalCommand}" HorizontalAlignment="Right"
                                Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                Width="32" Height="32" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="16"/>
                                </Style>
                            </Button.Resources>
                            <Path Stretch="Uniform" Data="M6 18L18 6M6 6l12 12" Stroke="{DynamicResource Ink2}" StrokeThickness="2" StrokeStartLineCap="Round" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                    <Separator Background="{DynamicResource Line}" Margin="0,0,0,16"/>

                    <TextBlock Text="Ombor nomi (masalan: Uydagi ombor, Garaj):" Foreground="{DynamicResource Ink2}" FontSize="13" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding NewWarehouseName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}"
                             FontSize="15" Height="44" Padding="12,8" Margin="0,0,0,12"/>

                    <CheckBox IsChecked="{Binding NewWarehouseIsPrimary}" Margin="0,0,0,12" VerticalAlignment="Center">
                        <TextBlock Text="Asosiy ombor qilib belgilash (savatda birinchi yechiladi)" Foreground="{DynamicResource Ink}" FontSize="13"/>
                    </CheckBox>

                    <TextBlock Text="{Binding NewWarehouseErrorMessage}" Foreground="{DynamicResource Bad}" FontSize="13"
                               Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Bekor qilish (Esc)" Command="{Binding CloseAddWarehouseModalCommand}"
                                Background="{DynamicResource Line}" Foreground="{DynamicResource Ink2}" Height="40" FontSize="14" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                            </Button.Resources>
                        </Button>
                        <Button Grid.Column="2" Content="Saqlash (Enter)" Command="{Binding SaveNewWarehouseCommand}"
                                IsDefault="True" Style="{StaticResource SuccessButton}" Height="40" FontSize="14" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- 4. OMBORLARARO KO'CHIRISH (TRANSFER) MODAL DIALOGI         -->
        <!-- ========================================================= -->
        <Grid Visibility="{Binding IsTransferModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="{DynamicResource Scrim}">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                    CornerRadius="16" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Omborlararo Ko'chirish (Transfer)" Foreground="{DynamicResource Ink}" FontSize="18" FontWeight="Bold"/>
                        <Button Command="{Binding CloseTransferModalCommand}" HorizontalAlignment="Right"
                                Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                Width="32" Height="32" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="16"/>
                                </Style>
                            </Button.Resources>
                            <Path Stretch="Uniform" Data="M6 18L18 6M6 6l12 12" Stroke="{DynamicResource Ink2}" StrokeThickness="2" StrokeStartLineCap="Round" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                    <Separator Background="{DynamicResource Line}" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Chiqish ombori:" Foreground="{DynamicResource Ink2}" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding TransferFromWarehouse}"
                                      DisplayMemberPath="Name" Height="38"/>
                        </StackPanel>
                        <Path Stretch="Uniform" Grid.Column="1" Data="M14 5l7 7m0 0l-7 7m7-7H3"
                              Stroke="{DynamicResource AccentInk}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,14,0,0"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Qabul qiluvchi ombor:" Foreground="{DynamicResource Ink2}" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding TransferToWarehouse}"
                                      DisplayMemberPath="Name" Height="38"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Ko'chiriladigan mahsulot:" Foreground="{DynamicResource Ink2}" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding TransferProduct}"
                              DisplayMemberPath="Name" Height="38" Margin="0,0,0,14"/>

                    <TextBlock Text="Ko'chirish miqdori:" Foreground="{DynamicResource Ink2}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding TransferQuantity, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}"
                             FontSize="15" Height="42" Padding="10,6" Margin="0,0,0,12"/>

                    <TextBlock Text="{Binding TransferErrorMessage}" Foreground="{DynamicResource Bad}" FontSize="13"
                               Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Bekor qilish (Esc)" Command="{Binding CloseTransferModalCommand}"
                                Background="{DynamicResource Line}" Foreground="{DynamicResource Ink2}" Height="40" FontSize="14" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                            </Button.Resources>
                        </Button>
                        <Button Grid.Column="2" Content="Ko'chirish (Enter)" Command="{Binding ExecuteTransferCommand}"
                                IsDefault="True" Style="{StaticResource ModernButton}" Height="40" FontSize="14" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
