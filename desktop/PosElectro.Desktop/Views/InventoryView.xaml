<UserControl x:Class="PosElectro.Desktop.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1150">
    <Grid Background="#0F172A" Margin="20">

        <!-- ========================================================= -->
        <!-- 1. KATEGORIYALAR VA MAHSULOTLAR RO'YXATI (ASOSIY OYNA)   -->
        <!-- ========================================================= -->
        <Grid Visibility="{Binding IsMainViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <!-- Qidiruv va boshqaruv paneli -->
                <RowDefinition Height="Auto"/>
                <!-- Asosiy Kontent: Kategoriyalar yoki Tovarlar Jadvali -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- QIDIRUV VA YANGI TOVAR QO'SHISH TUGMASI -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Barcha omborlarga qaytish tugmasi -->
                <Button Grid.Column="0" Command="{Binding BackToWarehousesCommand}"
                        Visibility="{Binding CanGoBackToWarehouses, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="#1E293B" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1.5"
                        Padding="14,8" Margin="0,0,12,0" Cursor="Hand" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Stretch="Uniform" Data="M10 19l-7-7m0 0l7-7m-7 7h18" Stroke="#38BDF8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Barcha omborlar" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text=" | " Foreground="#475569" Margin="6,0,6,0"/>
                        <TextBlock Text="{Binding CurrentWarehouseTitle}" Foreground="#F8FAFC" FontSize="13"/>
                    </StackPanel>
                </Button>

                <!-- Qidiruv maydoni (Placeholder va  Tozalash tugmasi bilan) -->
                <Grid Grid.Column="1">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource ModernTextBox}"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Height="42" Padding="14,0,40,0" VerticalContentAlignment="Center"/>

                    <!-- Placeholder / Suv belgisi -->
                    <TextBlock Text="Qidirish (Nomi yoki shtrix-kodi)..."
                               Foreground="#64748B" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0"
                               IsHitTestVisible="False"
                               Visibility="{Binding HasSearchQuery, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                    <!--  Tozalash tugmasi (Matn kiritilganda chiqadi) -->
                    <Button Command="{Binding ClearSearchCommand}"
                            Visibility="{Binding HasSearchQuery, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                            Cursor="Hand" Width="26" Height="26" 
                            ToolTip="Qidiruvni tozalash"/>

                    <!-- Qidiruv ikonchasi (Matn yo'qligida ko'rinadi) -->
                    <Path Stretch="Uniform" Data="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" 
                          Stroke="#64748B" StrokeThickness="2" StrokeStartLineCap="Round" 
                          Width="14" Height="14"
                          HorizontalAlignment="Right" 
                          VerticalAlignment="Center" 
                          Margin="0,0,14,0" 
                          IsHitTestVisible="False"
                          Visibility="{Binding HasSearchQuery, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                </Grid>

                <!-- Yangilash va Yangi mahsulot qo'shish -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Command="{Binding RefreshCommand}"
                            ToolTip="Ro'yxatni yangilash"
                            Style="{StaticResource ModernButton}" 
                            Background="#334155"
                            Width="40" Height="40" Padding="0" Margin="0,0,10,0">
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="Button.Click">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="InventoryRefreshIcon"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:0.6"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                        <Path Stretch="Uniform" x:Name="InventoryRefreshIcon"
                              Data="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                              Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="InventoryRefreshRotate" Angle="0"/>
                            </Path.RenderTransform>
                        </Path>
                    </Button>

                    <Button Content="+ Yangi Mahsulot" Command="{Binding OpenAddProductCommand}"
                            Style="{StaticResource ModernButton}" Padding="20,10" FontSize="14" FontWeight="Bold"
                            Visibility="{Binding CanAddProduct, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>

            <!-- =================================================== -->
            <!-- 1.0 OMBORLAR GRID PANELI (Kartalar ko'rinishi)       -->
            <!-- =================================================== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                          Visibility="{Binding IsWarehousesGridVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <!-- Sarlavha va Asboblar -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Stretch="Uniform" Data="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                              Stroke="#38BDF8" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="OMBORLAR BOSHQARUVI" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding OpenTransferModalCommand}"
                                    Style="{StaticResource ModernButton}" Background="#334155" Padding="14,8" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Stretch="Uniform" Data="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"
                                          Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Omborlararo Ko'chirish" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Content="+ Yangi Ombor" Command="{Binding OpenAddWarehouseModalCommand}"
                                    Style="{StaticResource ModernButton}"
                                    Padding="14,8" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>

                    <!-- Omborlar Kartalari -->
                    <ItemsControl ItemsSource="{Binding Warehouses}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="16" Padding="18,16" Margin="0,0,16,16" Width="320" Height="170"
                                        Background="#1E293B" BorderThickness="1.5" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" 
                                                      Command="{Binding DataContext.SelectWarehouseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#334155"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#10B981"/>
                                                    <Setter Property="Background" Value="#064E3B"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="#2DD4BF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Yuqori: Icon va Nom, O'ngda Asosiy ombor Yulduzcha vektor ikonka (Oq) -->
                                        <Grid Grid.Row="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <Border CornerRadius="8" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1.5" Width="34" Height="34" Margin="0,0,10,0">
                                                    <Path Data="M3 13h1v7c0 .55.45 1 1 1h14c.55 0 1-.45 1-1v-7h1a1 1 0 0 0 1-1V9a1 1 0 0 0-.29-.71l-4-4A1 1 0 0 0 17 4H7a1 1 0 0 0-.71.29l-4 4A1 1 0 0 0 2 9v3a1 1 0 0 0 1 1zm3-7h12l3 3H3l3-3zm1 7h10v6H7v-6z"
                                                          Fill="#34D399" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                                                           MaxWidth="195" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- O'ng tomon yuqorida: Asosiy ombor yulduzcha vektor ikonka (Oq rangda) -->
                                            <Button Command="{Binding DataContext.SetPrimaryWarehouseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4"
                                                    Focusable="False">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="ToolTip" Value="Asosiy ombor qilish"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                                <Setter Property="ToolTip" Value="Asosiy ombor"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Grid Width="22" Height="22">
                                                    <!-- To'lgan star vektor ikonka (Asosiy ombor bo'lsa) -->
                                                    <Path Stretch="Uniform"
                                                          Data="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
                                                          Fill="White"
                                                          Width="18" Height="18"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Visibility="{Binding IsPrimary, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                                    <!-- Ichi bo'sh star vektor ikonka (Asosiy ombor bo'lmasa) -->
                                                    <Path Stretch="Uniform"
                                                          Data="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
                                                          Fill="Transparent" Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round"
                                                          Width="18" Height="18"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Visibility="{Binding IsPrimary, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                </Grid>
                                            </Button>
                                        </Grid>

                                        <!-- O'rta: Statistika va Asosiy nishoni -->
                                        <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,8">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding SummaryDisplay}" Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding TotalStockValue, StringFormat='Qiymati: {0:N0} so\'m'}" Foreground="#38BDF8" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border CornerRadius="8" Background="#10B981" Padding="10,4" 
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                                    Visibility="{Binding IsPrimary, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="ASOSIY" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>

                                        <!-- Pastki: Amallar -->
                                        <Grid Grid.Row="2">
                                            <Button Command="{Binding DataContext.DeleteWarehouseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanDelete, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    ToolTip="O'chirish" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Path Data="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2m3 0v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6h14zM10 11v6M14 11v6"
                                                      Stroke="#F87171" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                            <Path Stretch="Uniform" Data="M9 5l7 7-7 7" Stroke="White" StrokeThickness="2.5" 
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" 
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- =================================================== -->
            <!-- 1.1 KATEGORIYALAR GRID PANELI (Appdagi kabi kartalar) -->
            <!-- =================================================== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                          Visibility="{Binding IsCategoriesGridVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <!-- Sarlavha -->
                    <TextBlock Text="OMBOR KATEGORIYALARI" Foreground="#94A3B8" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>

                    <!-- Kategoriyalar kartalari wrap paneli -->
                    <ItemsControl ItemsSource="{Binding CategoryCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,14,14" Width="250" Height="120"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="16" Padding="14,12" BorderThickness="1.5">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#1E293B"/>
                                                        <Setter Property="BorderBrush" Value="#334155"/>
                                                        <Style.Triggers>
                                                            <!-- Barchasi kategoriyasi -->
                                                            <DataTrigger Binding="{Binding IsAll}" Value="True">
                                                                <Setter Property="Background" Value="#0B6477"/>
                                                                <Setter Property="BorderBrush" Value="#2DD4BF"/>
                                                            </DataTrigger>
                                                            <!-- Kam qolgan tovarlar ogohlantirishi -->
                                                            <DataTrigger Binding="{Binding HasLowStockWarning}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#EF4444"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="BorderBrush" Value="#2DD4BF"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <!-- 1-Qator: Icon va ko'rsatkich (oraliq 10px bo'shliq bilan) -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                                        <Border CornerRadius="8" Background="#074F61" BorderBrush="#2DD4BF" BorderThickness="1" Width="36" Height="36" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" FontSize="18" Foreground="#2DD4BF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <Button Command="{Binding DataContext.OpenEditCategoryModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding Name}"
                                                                    Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    ToolTip="Kategoriya nomini o'zgartirish"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Padding="4" Margin="0,0,6,0" Cursor="Hand">
                                            <Path Stretch="Uniform" Data="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"
                                                  Stroke="#38BDF8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" VerticalAlignment="Center"/>
                                                            </Button>
                                        <Path Stretch="Uniform" Data="M9 5l7 7-7 7" Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <!-- 2-Qator: Kategoriya nomi va soni (ustiga minib qolmaydi) -->
                                                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                                                        <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding CountText}" Foreground="#94A3B8" FontSize="13" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- =================================================== -->
            <!-- 1.2 TOVARLAR JADVALI (Kategoriya tanlanganda)        -->
            <!-- =================================================== -->
            <Grid Grid.Row="1" Visibility="{Binding IsProductsListVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Navigatsiya va Sarlavha: [ Ortga] Kategoriya nomi + Kam qolgan tovarlar buyurtma paneli -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding BackToCategoriesCommand}"
                                Style="{StaticResource ModernButton}" Background="#334155" Padding="14,8" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Stretch="Uniform" Data="M10 19l-7-7m0 0l7-7m-7 7h18" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding BackButtonText}" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{Binding CurrentCategoryTitle}" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ProductsCountHeader}" Foreground="#94A3B8" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- KAM QOLGAN TOVARLAR BUYURTMA BOSHQARUV PANELI -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsLowStockCategorySelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <!-- 1. Barchasini tanlash / Tozalash -->
                        <Button Command="{Binding SelectAllLowStockCommand}"
                                ToolTip="Barcha kam qolgan tovarlarni belgilash"
                                Background="#1E293B" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1"
                                Padding="10,6" Margin="0,0,6,0" Cursor="Hand" FontWeight="SemiBold" FontSize="12">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                            </Button.Resources>
                            <TextBlock Text="✓ Hammasi"/>
                        </Button>

                        <Button Command="{Binding ClearSelectedLowStockCommand}"
                                ToolTip="Barcha tanlanganlarni bekor qilish"
                                Background="#1E293B" Foreground="#94A3B8" BorderBrush="#475569" BorderThickness="1"
                                Padding="10,6" Margin="0,0,10,0" Cursor="Hand" FontSize="12">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                            </Button.Resources>
                            <TextBlock Text="✕ Tozalash"/>
                        </Button>

                        <!-- 2. Alohida Buyurtma Ro'yxati Modali -->
                        <Button Command="{Binding OpenReorderListDialogCommand}"
                                ToolTip="Buyurtmaga yig'ilgan tovarlarni alohida ko'rish va boshqarish"
                                Background="#0B6477" Foreground="White" BorderBrush="#2DD4BF" BorderThickness="1"
                                Padding="12,6" Margin="0,0,8,0" Cursor="Hand" FontWeight="Bold" FontSize="12">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                            </Button.Resources>
                            <TextBlock Text="{Binding ReorderButtonText}"/>
                        </Button>

                        <!-- 3. Chek chiqarish -->
                        <Button Command="{Binding PrintReorderReceiptCommand}"
                                ToolTip="Tanlangan tovarlar buyurtma ro'yxatini chek printeriga chiqarish"
                                Background="#0F766E" Foreground="White" BorderBrush="#14B8A6" BorderThickness="1"
                                Padding="10,6" Margin="0,0,6,0" Cursor="Hand" FontWeight="Bold" FontSize="12">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                            </Button.Resources>
                            <TextBlock Text="🖨️ Chek"/>
                        </Button>

                        <!-- 4. Excelga saqlash -->
                        <Button Command="{Binding ExportReorderExcelCommand}"
                                ToolTip="Buyurtma ro'yxatini Excel (.xls) qilib saqlash"
                                Background="#1E3A5F" Foreground="White" BorderBrush="#38BDF8" BorderThickness="1"
                                Padding="10,6" Cursor="Hand" FontWeight="Bold" FontSize="12">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                            </Button.Resources>
                            <TextBlock Text="📊 Excel"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Tovarlar Jadvali -->
                <Border Grid.Row="1" Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="8">
                    <Grid>
                        <DataGrid ItemsSource="{Binding Products}" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  CanUserResizeColumns="True"
                                  IsReadOnly="True"
                                  Background="Transparent" 
                                  RowBackground="#1E293B" 
                                  AlternatingRowBackground="#0F172A" 
                                  Foreground="#F8FAFC" 
                                  BorderThickness="0" 
                                  GridLinesVisibility="Horizontal" 
                                  HorizontalGridLinesBrush="#334155" 
                                  HeadersVisibility="Column" 
                                  EnableRowVirtualization="True" 
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                            <DataGrid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#0F172A"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridColumnHeader">
                                                <Border Background="{TemplateBinding Background}" 
                                                        BorderBrush="#334155" 
                                                        BorderThickness="0,0,0,1" 
                                                        Padding="10,10">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}" 
                                                        BorderThickness="0" 
                                                        Padding="10,8" 
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" 
                                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#0B6477"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Padding" Value="0,2"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="ToolTip" Value="Tahrirlash uchun 2 marta bosing"/>
                                    <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <!-- Tanlash Checkbox (Kam qolgan tovarlarda ko'rinadi) -->
                                <DataGridTemplateColumn Width="50" MinWidth="46"
                                                        Visibility="{Binding DataContext.IsLowStockCategorySelected, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="Tanlash" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Mahsulot nomi -->
                                <DataGridTextColumn Header="Mahsulot nomi" Binding="{Binding Name}" Width="2.5*" MinWidth="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#F8FAFC"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Amallar (Tahrirlash, Shtrix-kod, O'chirish) -->
                                <DataGridTemplateColumn Header="Amallar" Width="125" MinWidth="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <!-- Tahrirlash -->
                                                <Button Command="{Binding DataContext.OpenEditProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Tahrirlash"
                                                        Background="#1E3A5F" BorderBrush="#0284C7" BorderThickness="1"
                                                        Width="28" Height="28" Cursor="Hand" Margin="0,0,4,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                                <Path Data="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" 
                                                                      Stroke="#38BDF8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" 
                                                                      Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#0284C7"/>
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#7DD3FC"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Shtrix-kod chop etish -->
                                                <Button Command="{Binding DataContext.PrintProductBarcodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Shtrix-kod etiketkasini chop etish"
                                                        Background="#0F3642" BorderBrush="#0B6477" BorderThickness="1"
                                                        Width="28" Height="28" Cursor="Hand" Margin="0,0,4,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                                <Path Data="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v8H6v-8z" 
                                                                      Stroke="#2DD4BF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" 
                                                                      Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#0B6477"/>
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#2DD4BF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- O'chirish -->
                                                <Button Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="O'chirish"
                                                        Background="#3B1824" BorderBrush="#EF4444" BorderThickness="1"
                                                        Width="28" Height="28" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                                <Path Data="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2m3 0v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6h14zM10 11v6M14 11v6" 
                                                                      Stroke="#F87171" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" 
                                                                      Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#7F1D1D"/>
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#FCA5A5"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Shtrix-kod -->
                                <DataGridTextColumn Header="Shtrix-kod" Binding="{Binding Barcode}" Width="1.2*" MinWidth="100" Foreground="#94A3B8"/>

                                <!-- Tan narxi -->
                                <DataGridTextColumn Header="Tan narxi" Binding="{Binding CostPriceFormatted}" Width="1.2*" MinWidth="90" Foreground="#94A3B8"/>

                                <!-- Sotish narxi -->
                                <DataGridTextColumn Header="Sotish narxi" Binding="{Binding PriceFormatted}" Width="1.2*" MinWidth="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#38BDF8"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Qoldiq -->
                                <DataGridTemplateColumn Header="Qoldiq" Width="1*" MinWidth="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenQuickStockAddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Qoldiqni oshirish (kirim qilish) uchun bosing"
                                                    Cursor="Hand" HorizontalAlignment="Left">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" CornerRadius="6" Padding="8,3" BorderThickness="1" BorderBrush="Transparent">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#14532D"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                            <Setter Property="Background" Value="#7F1D1D"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StockQuantity}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#4ADE80"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#F87171"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text=" ➕" FontSize="9" VerticalAlignment="Center" Opacity="0.75"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Izoh (Zakaz uchun telefon raqam / ma'lumot) -->
                                <DataGridTextColumn Header="Izoh (Zakaz uchun)" Binding="{Binding Note}" Width="1.2*" MinWidth="110" Foreground="#94A3B8"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Bo'sh qidiruv / kategoriya natijasi -->
                        <Border Background="#1E293B" CornerRadius="12"
                                Visibility="{Binding IsEmptySearchResult, Converter={StaticResource BooleanToVisibilityConverter}}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,24" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Stretch="Uniform" Data="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" 
                                      Stroke="#64748B" StrokeThickness="2" StrokeStartLineCap="Round" 
                                      Width="36" Height="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Kiritilgan so'rov bo'yicha hech qanday tovar topilmadi" Foreground="#94A3B8" FontSize="13" Margin="0,4,0,14" HorizontalAlignment="Center"/>
                                <Button Command="{Binding ClearSearchCommand}"
                                        Style="{StaticResource ModernButton}" Background="#334155" HorizontalAlignment="Center" Padding="14,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Stretch="Uniform" Data="M6 18L18 6M6 6l12 12" Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Qidiruvni tozalash" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>


        <!-- ========================================================= -->
        <!-- 2. MAHSULOT QO'SHISH VA TAHRIRLASH (TO'LIQ EKRANLI SAHIFA) -->
        <!-- ========================================================= -->
        <Grid Visibility="{Binding IsAddEditFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <!-- Sarlavha va Ortga tugmasi -->
                <RowDefinition Height="Auto"/>
                <!-- Asosiy forma: 2 ustunli karta (scroll-siz sig'adi) -->
                <RowDefinition Height="*"/>
                <!-- Xatolik matni -->
                <RowDefinition Height="Auto"/>
                <!-- Saqlash va Bekor qilish tugmalari -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TEPADAGI NAVIGATSIYA -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding CancelAddEditCommand}"
                        Style="{StaticResource ModernButton}" Background="#334155" Padding="14,8" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Stretch="Uniform" Data="M10 19l-7-7m0 0l7-7m-7 7h18" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Ortga qaytish" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                    <TextBlock Text="{Binding FormTitle}" Foreground="#F8FAFC" FontSize="20" FontWeight="Black" VerticalAlignment="Center"/>

                    <!-- Tanlangan Ombor Belgisi -->
                    <Border Background="#064E3B" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="8" Padding="12,5" Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Stretch="Uniform" Data="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                              Stroke="#A7F3D0" StrokeThickness="1.5" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Ombor: " Foreground="#A7F3D0" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedWarehouseNameDisplay}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 2 TA ZAMONAVIY BLOK (ASOSIY VA NARXLAR) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 1-BLOK: ASOSIY MA'LUMOTLAR -->
                <Border Grid.Column="0" Background="#1E293B" CornerRadius="16" BorderBrush="#334155" BorderThickness="1" Padding="16,14" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Stretch="Uniform" Data="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                                  Stroke="#38BDF8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="MAHSULOT ASOSIY MA'LUMOTLARI" Foreground="#38BDF8" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Mahsulot Nomi -->
                        <TextBlock Text="Mahsulot nomi *" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" 
                                 TextChanged="ProductNameTextBox_TextChanged"
                                 Style="{StaticResource ModernTextBox}" FontSize="14" Padding="12,0" Height="42" Margin="0,0,0,10"/>

                        <!-- Shtrix-kod va Generatsiya / Chop etish tugmalari -->
                        <TextBlock Text="Shtrix-kod (Skaner orqali o'qing yoki 'Yaratish' tugmasini bosing)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding FormBarcode, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBox}" FontSize="14" Padding="12,0" Height="42" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Command="{Binding GenerateBarcodeCommand}"
                                    ToolTip="Shtrix-kodi yo'q tovar uchun yangi 13 xonali EAN-13 kod yaratish"
                                    Background="#074F61" BorderBrush="#2DD4BF" BorderThickness="1.5"
                                    Height="42" Padding="12,0" Margin="0,0,6,0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Stretch="Uniform" Data="M13 10V3L4 14h7v7l9-11h-7z" Fill="#2DD4BF" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Yaratish" Foreground="#2DD4BF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding PrintBarcodeCommand}"
                                    ToolTip="Xprinter XP-365B orqali ushbu tovar uchun etiketka (stiker) chiqarish"
                                    Background="#1E293B" BorderBrush="#334155" BorderThickness="1.5"
                                    Height="42" Padding="12,0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Stretch="Uniform" Data="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v8H6v-8z"
                                                  Stroke="#F8FAFC" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Chop etish" Foreground="#F8FAFC" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Kategoriya (Har doim Dropdown + Tahrirlash + Yangi qo'shish tugmasi) -->
                        <TextBlock Text="Kategoriya *" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 1. Har doim Dropdown (ComboBox) -->
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding ExistingCategories}"
                                      SelectedItem="{Binding FormCategory}"
                                      Height="42" FontSize="13" VerticalContentAlignment="Center"/>

                            <!-- 2. Yonidagi [ Tahrirlash] tanlangan kategoriya nomini o'zgartirish tugmasi -->
                            <Button Grid.Column="1"
                                    Command="{Binding OpenEditCategoryModalCommand}"
                                    ToolTip="Tanlangan kategoriya nomini o'zgartirish"
                                    Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1.5"
                                    Height="42" Padding="12,0" Margin="6,0,0,0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Stretch="Uniform" Data="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"
                                                  Stroke="#38BDF8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tahrirlash" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 3. Yonidagi [ Yangi] kategoriya qo'shish tugmasi (Modal ochadi) -->
                            <Button Grid.Column="2"
                                    Command="{Binding OpenAddCategoryModalCommand}"
                                    ToolTip="Yangi kategoriya qo'shish oynasini ochish"
                                    Background="#074F61" BorderBrush="#2DD4BF" BorderThickness="1.5"
                                    Height="42" Padding="12,0" Margin="6,0,0,0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Stretch="Uniform" Data="M12 4v16m8-8H4"
                                                  Stroke="#2DD4BF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Yangi" Foreground="#2DD4BF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Izoh (Zakaz uchun telefon raqam va yetkazib beruvchi ma'lumoti) -->
                        <TextBlock Text="Izoh (Zakaz berish uchun telefon nomer va ma'lumot) [Ixtiyoriy]" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormNote, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ModernTextBox}" 
                                 FontSize="13" Padding="10,8" Height="60" 
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

                <!-- 2-BLOK: NARXLAR VA QOLDIQ -->
                <Border Grid.Column="1" Background="#1E293B" CornerRadius="16" BorderBrush="#334155" BorderThickness="1" Padding="16,14" Margin="8,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Stretch="Uniform" Data="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                  Stroke="#16A34A" StrokeThickness="1.5" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="NARX VA OMBOR QOLDIG'I" Foreground="#16A34A" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Tan Narxi (Katta va Aniq Valyuta Switch bilan) -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{Binding FormCostPriceLabel}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                            <Border Background="#0F172A" CornerRadius="8" Padding="2" BorderBrush="#334155" BorderThickness="1" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="SO'M (UZS)" 
                                                 GroupName="FormCurrencyGroup"
                                                 IsChecked="{Binding FormIsUzs}" 
                                                 Style="{StaticResource CurrencySegmentRadio}"
                                                 FontSize="11" Padding="6,2"/>
                                    <RadioButton Content="DOLLAR ($)" 
                                                 GroupName="FormCurrencyGroup"
                                                 IsChecked="{Binding FormIsUsd}" 
                                                 Style="{StaticResource CurrencySegmentRadio}"
                                                 FontSize="11" Padding="6,2"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBox Text="{Binding FormCostPrice, UpdateSourceTrigger=PropertyChanged}" 
                                 TextChanged="PriceTextBox_TextChanged"
                                 Style="{StaticResource ModernTextBox}" FontSize="14" Padding="12,0" Height="42"/>
                        <TextBlock Text="{Binding FormUsdConversion}" Foreground="#2DD4BF" FontSize="11" Margin="0,2,0,8" 
                                   Visibility="{Binding IsFormUsdConversionVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- Sotish Narxi -->
                        <TextBlock Text="Sotish narxi (so'm) *" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,4"/>
                        <TextBox Text="{Binding FormSellingPrice, UpdateSourceTrigger=PropertyChanged}" 
                                 TextChanged="PriceTextBox_TextChanged"
                                 Style="{StaticResource ModernTextBox}" FontSize="14" Padding="12,0" Height="42" Margin="0,0,0,8"/>

                        <!-- 2-Sotish Narxi (Ustalarga/Optom) [Ixtiyoriy] -->
                        <TextBlock Text="2-sotish narxi (Ustalarga / doimiy mijozlar uchun, so'm) [Ixtiyoriy]" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,4"/>
                        <TextBox Text="{Binding FormSellingPrice2, UpdateSourceTrigger=PropertyChanged}" 
                                 TextChanged="PriceTextBox_TextChanged"
                                 Style="{StaticResource ModernTextBox}" FontSize="14" Padding="12,0" Height="42" Margin="0,0,0,10"/>

                        <!-- Qoldiq miqdori, Birlik va Kam qolganlik ogohlantirishi (Bitta qatorda 3 ta ustun) -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Qoldiq miqdori *" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormStockQuantity, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}" FontSize="14" Padding="12,0" Height="42"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                <TextBlock Text="O'lchov birligi" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                <ComboBox SelectedIndex="{Binding FormUnitTypeIndex}" Height="42" FontSize="13" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="dona (sht)"/>
                                    <ComboBoxItem Content="metr (m)"/>
                                    <ComboBoxItem Content="kilogram (kg)"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                <TextBlock Text="Kam qolganda chegara" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4" 
                                           TextTrimming="CharacterEllipsis" ToolTip="Kam qolganlik ogohlantirish chegarasi"/>
                                <TextBox Text="{Binding FormMinStockAlert, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}" FontSize="14" Padding="12,0" Height="42"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            </ScrollViewer>

            <!-- XATOLIK XABARI -->
            <TextBlock Grid.Row="2" Text="{Binding FormErrorMessage}" 
                       Foreground="#EF4444" FontSize="13" FontWeight="SemiBold" 
                       Margin="0,8,0,0" TextWrapping="Wrap" 
                       Visibility="{Binding HasFormError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- PASTDAGI SAQLASH VA BEKOR QILISH TUGMALARI -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Command="{Binding CancelAddEditCommand}"
                        Background="#334155" Foreground="White" FontSize="13" FontWeight="SemiBold"
                        Style="{StaticResource ModernButton}" Padding="20,10" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Stretch="Uniform" Data="M6 18L18 6M6 6l12 12" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Bekor qilish" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding SaveProductFormCommand}"
                        Style="{StaticResource SuccessButton}" Padding="30,10" FontSize="14" FontWeight="Bold">
                    <StackPanel Orientation="Horizontal">
                        <Path Stretch="Uniform" Data="M5 13l4 4L19 7" Stroke="White" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Saqlash" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- YANGI KATEGORIYA QO'SHISH MODAL OYNASI -->
        <Grid Visibility="{Binding IsAddCategoryModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#CC000000" Panel.ZIndex="2000">
            <Border Background="#1E293B" CornerRadius="16" BorderBrush="#0284C7" BorderThickness="1.5"
                    Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.8" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Modal Sarlavhasi -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1E3A8A" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0" BorderBrush="#38BDF8" BorderThickness="1.5">
                                <Path Stretch="Uniform" Data="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"
                                      Stroke="#38BDF8" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Yangi Kategoriya Qo'shish" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Command="{Binding CloseAddCategoryModalCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                ToolTip="Yopish"
                                Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
                                Width="32" Height="32" Cursor="Hand" Padding="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="16"/>
                                </Style>
                            </Button.Resources>
                            <Path Stretch="Uniform" Data="M6 18L18 6M6 6l12 12" Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Separator Background="#334155" Margin="0,0,0,16"/>

                    <TextBlock Text="Kategoriya nomini kiriting:" Foreground="#94A3B8" FontSize="13" Margin="0,0,0,8"/>

                    <!-- Kategoriya nomi inputi (Aniq oq matn, ko'k hoshiya va kontrast fon) -->
                    <TextBox Text="{Binding NewCategoryInput, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             Background="#0F172A"
                             Foreground="#FFFFFF"
                             CaretBrush="#38BDF8"
                             BorderBrush="#0284C7"
                             BorderThickness="1.5"
                             FontSize="15" FontWeight="SemiBold"
                             Height="46" Padding="14,0" Margin="0,0,0,0"/>

                    <!-- Xatolik xabari -->
                    <TextBlock Text="{Binding NewCategoryErrorMessage}" Foreground="#EF4444" FontSize="13" FontWeight="SemiBold"
                               Margin="0,6,0,16" TextWrapping="Wrap"/>

                    <!-- Tugmalar -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Bekor qilish"
                                Command="{Binding CloseAddCategoryModalCommand}"
                                Background="#334155" Foreground="#CBD5E1"
                                Height="42" FontSize="14" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Grid.Column="2" Content="Qo'shish"
                                Command="{Binding SaveNewCategoryCommand}"
                                IsDefault="True"
                                Style="{StaticResource ModernButton}"
                                Height="42" FontSize="14" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- 2.1 KATEGORIYANI TAHRIRLASH MODAL DIALOGI                 -->
        <!-- ========================================================= -->
        <Grid Visibility="{Binding IsEditCategoryModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#80000000">
            <Border Background="#1E293B" BorderBrush="#0284C7" BorderThickness="1.5"
                    CornerRadius="16" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="24">
                <StackPanel>
                    <!-- Sarlavha va Yopish tugmasi -->
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Stretch="Uniform" Data="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"
                                                  Stroke="#38BDF8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Kategoriya Nomini Tahrirlash" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Command="{Binding CloseEditCategoryModalCommand}" HorizontalAlignment="Right"
                                Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
                                Width="32" Height="32" Cursor="Hand" Padding="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="16"/>
                                </Style>
                            </Button.Resources>
                            <Path Stretch="Uniform" Data="M6 18L18 6M6 6l12 12" Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Separator Background="#334155" Margin="0,0,0,16"/>

                    <TextBlock Text="Yangi nomni kiriting:" Foreground="#94A3B8" FontSize="13" Margin="0,0,0,8"/>

                    <!-- Kategoriya nomi inputi -->
                    <TextBox Text="{Binding EditCategoryInput, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             Background="#0F172A"
                             Foreground="#FFFFFF"
                             CaretBrush="#38BDF8"
                             BorderBrush="#0284C7"
                             BorderThickness="1.5"
                             FontSize="15" FontWeight="SemiBold"
                             Height="46" Padding="14,0" Margin="0,0,0,0"/>

                    <!-- Xatolik xabari -->
                    <TextBlock Text="{Binding EditCategoryErrorMessage}" Foreground="#EF4444" FontSize="13" FontWeight="SemiBold"
                               Margin="0,6,0,16" TextWrapping="Wrap"/>

                    <!-- Tugmalar -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Bekor qilish"
                                Command="{Binding CloseEditCategoryModalCommand}"
                                Background="#334155" Foreground="#CBD5E1"
                                Height="42" FontSize="14" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Grid.Column="2" Content="Saqlash"
                                Command="{Binding SaveEditCategoryCommand}"
                                IsDefault="True"
                                Style="{StaticResource ModernButton}"
                                Height="42" FontSize="14" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- 3. YANGI OMBOR QO'SHISH MODAL DIALOGI                     -->
        <!-- ========================================================= -->
        <Grid Visibility="{Binding IsAddWarehouseModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#80000000">
            <Border Background="#1E293B" BorderBrush="#0284C7" BorderThickness="1.5"
                    CornerRadius="16" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Yangi Ombor Yaratish" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold"/>
                        <Button Command="{Binding CloseAddWarehouseModalCommand}" HorizontalAlignment="Right"
                                Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
                                Width="32" Height="32" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="16"/>
                                </Style>
                            </Button.Resources>
                            <Path Stretch="Uniform" Data="M6 18L18 6M6 6l12 12" Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                    <Separator Background="#334155" Margin="0,0,0,16"/>

                    <TextBlock Text="Ombor nomi (masalan: Uydagi ombor, Garaj):" Foreground="#94A3B8" FontSize="13" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding NewWarehouseName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Background="#0F172A" Foreground="#F8FAFC"
                             FontSize="15" Height="44" Padding="12,8" Margin="0,0,0,12"/>

                    <CheckBox IsChecked="{Binding NewWarehouseIsPrimary}" Margin="0,0,0,12" VerticalAlignment="Center">
                        <TextBlock Text="Asosiy ombor qilib belgilash (savatda birinchi yechiladi)" Foreground="#F8FAFC" FontSize="13"/>
                    </CheckBox>

                    <TextBlock Text="{Binding NewWarehouseErrorMessage}" Foreground="#EF4444" FontSize="13"
                               Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Bekor qilish" Command="{Binding CloseAddWarehouseModalCommand}"
                                Background="#334155" Foreground="#CBD5E1" Height="40" FontSize="14" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                            </Button.Resources>
                        </Button>
                        <Button Grid.Column="2" Content="Saqlash" Command="{Binding SaveNewWarehouseCommand}"
                                IsDefault="True" Style="{StaticResource SuccessButton}" Height="40" FontSize="14" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- 4. OMBORLARARO KO'CHIRISH (TRANSFER) MODAL DIALOGI         -->
        <!-- ========================================================= -->
        <Grid Visibility="{Binding IsTransferModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#80000000">
            <Border Background="#1E293B" BorderBrush="#0284C7" BorderThickness="1.5"
                    CornerRadius="16" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Omborlararo Ko'chirish (Transfer)" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold"/>
                        <Button Command="{Binding CloseTransferModalCommand}" HorizontalAlignment="Right"
                                Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
                                Width="32" Height="32" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="16"/>
                                </Style>
                            </Button.Resources>
                            <Path Stretch="Uniform" Data="M6 18L18 6M6 6l12 12" Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                    <Separator Background="#334155" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Chiqish ombori:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding TransferFromWarehouse}"
                                      DisplayMemberPath="Name" Height="38"/>
                        </StackPanel>
                        <Path Stretch="Uniform" Grid.Column="1" Data="M14 5l7 7m0 0l-7 7m7-7H3"
                              Stroke="#38BDF8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,14,0,0"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Qabul qiluvchi ombor:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding TransferToWarehouse}"
                                      DisplayMemberPath="Name" Height="38"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Ko'chiriladigan mahsulot:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding TransferProduct}"
                              DisplayMemberPath="Name" Height="38" Margin="0,0,0,14"/>

                    <TextBlock Text="Ko'chirish miqdori:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding TransferQuantity, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Background="#0F172A" Foreground="#F8FAFC"
                             FontSize="15" Height="42" Padding="10,6" Margin="0,0,0,12"/>

                    <TextBlock Text="{Binding TransferErrorMessage}" Foreground="#EF4444" FontSize="13"
                               Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Bekor qilish" Command="{Binding CloseTransferModalCommand}"
                                Background="#334155" Foreground="#CBD5E1" Height="40" FontSize="14" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                            </Button.Resources>
                        </Button>
                        <Button Grid.Column="2" Content="Ko'chirish" Command="{Binding ExecuteTransferCommand}"
                                IsDefault="True" Style="{StaticResource ModernButton}" Height="40" FontSize="14" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
